v-if="record.adName && record.adName !== record.adSetName" class="text-[10px] text-slate-400 mt-1">广告：{{ record.adName }}</div></td><td class="p-3.5 font-extrabold text-amber-600">{{ formatMoney(record.spend,record.currency) }}</td><td class="p-3.5">{{ Number(record.impressions||0).toLocaleString() }}</td><td class="p-3.5">{{ Number(record.clicks||0).toLocaleString() }}</td><td class="p-3.5 font-bold text-blue-600">{{ Number(record.leads||0).toLocaleString() }}</td><td class="p-3.5 font-bold text-violet-600">{{ Number(record.conversions||0).toLocaleString() }}</td><td class="p-3.5 font-extrabold text-emerald-600">{{ formatMoney(record.revenue,record.currency) }}</td><td v-if="selectedAdsPlatform==='FB'" class="p-3.5"><div class="grid grid-cols-2 gap-x-3 gap-y-1 text-[10px]"><span>CPM <b>{{ adRecordMetrics(record).cpmText }}</b></span><span>Reach <b>{{ adRecordMetrics(record).reachText }}</b></span><span>Freq <b>{{ adRecordMetrics(record).frequencyText }}</b></span><span>CTR <b>{{ adRecordMetrics(record).ctrText }}</b></span><span>CPC <b>{{ adRecordMetrics(record).cpcText }}</b></span><span>CVR <b>{{ adRecordMetrics(record).cvrText }}</b></span><span>CPA <b>{{ adRecordMetrics(record).cpaText }}</b></span><span>ROAS <b>{{ adRecordMetrics(record).roasText }}</b></span></div></td><td v-if="selectedAdsPlatform==='FB'" class="p-3.5"><div class="text-[10px] space-y-1"><div>3秒 <b>{{ percentText(record.video3sRate) }}</b> · 完播 <b>{{ percentText(record.videoCompleteRate) }}</b></div><div class="text-slate-500">25% {{ percentText(record.video25Rate) }} · 50% {{ percentText(record.video50Rate) }}</div><div class="text-slate-500">75% {{ percentText(record.video75Rate) }} · 95% {{ percentText(record.video95Rate) }}</div></div></td><td class="p-3.5 text-slate-500 max-w-[180px] truncate">{{ record.note || '—' }}</td><td class="p-3.5 text-right"><div class="flex justify-end gap-1.5"><button @click="editAdDataRecord(record)" class="w-8 h-8 rounded-lg bg-cyan-50 text-cyan-700" title="更新这条数据"><i class="fa-regular fa-pen-to-square"></i></button><button type="button" @click="deleteAdDataRecord(record)" class="w-8 h-8 rounded-lg bg-rose-50 text-rose-500" title="删除这条数据"><i class="fa-regular fa-trash-can"></i></button></div></td></tr></tbody></table></div>
              </div>
              <div v-else class="py-12 text-center"><i class="fa-solid fa-chart-line text-3xl text-slate-200"></i><div class="text-sm font-extrabold text-slate-600 mt-3">暂无广告数据记录</div><div class="text-xs text-slate-400 mt-1">保存广告方案后，可持续记录每日或阶段性投放数据。</div></div>
            </div>

            <div v-if="!selectedAdsAccount" class="bg-white border border-slate-200 rounded-2xl py-16 text-center"><i class="fa-solid fa-circle-exclamation text-3xl text-amber-400"></i><div class="text-sm font-extrabold mt-3">当前客户暂无可用广告账户</div><p class="text-xs text-slate-400 mt-1">请先在客户资料中添加 Facebook 或 TikTok 广告账户。</p><button @click="openClientForm(selectedAdsClient)" class="mt-4 h-9 px-4 rounded-xl bg-slate-950 text-white text-xs font-bold">编辑客户账号资产</button></div>
          </div>
        </section>

        <!-- Leads / 潜在客户 -->
        <section v-else-if="currentPage==='leads'" key="leads" class="space-y-5">
          <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
            <div><div class="text-[11px] font-bold tracking-[.16em] text-violet-500">LEAD PIPELINE</div><h2 class="text-2xl font-extrabold tracking-tight mt-1">潜在客户</h2><p class="text-xs text-slate-500 mt-1">默认只展示仍需跟进的潜客；确认合作并完成正式客户建档后，线索会自动移入成交历史，不再占用当前潜客池。</p></div>
            <button @click="openLeadModal()" class="h-10 px-4 rounded-xl bg-violet-600 text-white text-xs font-bold shadow-sm"><i class="fa-solid fa-user-plus mr-1.5"></i>新增潜在客户</button>
          </div>

          <div class="grid grid-cols-2 xl:grid-cols-4 gap-3">
            <button type="button" @click="leadPoolFilter='ACTIVE';leadQuickFilter='ALL'" class="text-left bg-white border rounded-2xl p-4 soft-shadow transition hover:-translate-y-0.5" :class="leadPoolFilter==='ACTIVE'&&leadQuickFilter==='ALL'?'border-violet-300 ring-2 ring-violet-50':'border-slate-200'"><div class="flex items-center justify-between gap-2"><div class="text-[10px] text-slate-400">当前潜客</div><i class="fa-solid fa-arrow-pointer text-[9px] text-slate-300"></i></div><div class="text-2xl font-black mt-1">{{ leadStats.total }}</div><div class="text-[10px] text-slate-400 mt-1">点击查看全部进行中潜客</div></button>
            <button type="button" @click="leadPoolFilter='ACTIVE';leadQuickFilter='DUE'" class="text-left bg-white border rounded-2xl p-4 soft-shadow transition hover:-translate-y-0.5" :class="leadPoolFilter==='ACTIVE'&&leadQuickFilter==='DUE'?'border-amber-300 ring-2 ring-amber-50':'border-amber-100'"><div class="flex items-center justify-between gap-2"><div class="text-[10px] text-amber-600">待跟进 / 已逾期</div><i class="fa-solid fa-arrow-pointer text-[9px] text-amber-300"></i></div><div class="text-2xl font-black text-amber-600 mt-1">{{ leadStats.due }}</div><div class="text-[10px] text-slate-400 mt-1">点击查看今天及以前需跟进的潜客</div></button>
            <button type="button" @click="leadPoolFilter='ACTIVE';leadQuickFilter='HIGH'" class="text-left bg-white border rounded-2xl p-4 soft-shadow transition hover:-translate-y-0.5" :class="leadPoolFilter==='ACTIVE'&&leadQuickFilter==='HIGH'?'border-cyan-300 ring-2 ring-cyan-50':'border-cyan-100'"><div class="flex items-center justify-between gap-2"><div class="text-[10px] text-cyan-600">高意向</div><i class="fa-solid fa-arrow-pointer text-[9px] text-cyan-300"></i></div><div class="text-2xl font-black text-cyan-600 mt-1">{{ leadStats.qualified }}</div><div class="text-[10px] text-slate-400 mt-1">点击查看已确认需求 / 报价中的潜客</div></button>
            <button type="button" @click="leadPoolFilter='WON';leadQuickFilter='ALL'" class="text-left bg-white border rounded-2xl p-4 soft-shadow transition hover:-translate-y-0.5" :class="leadPoolFilter==='WON'?'border-emerald-300 ring-2 ring-emerald-50':'border-emerald-100'"><div class="flex items-center justify-between gap-2"><div class="text-[10px] text-emerald-600">历史成交</div><i class="fa-solid fa-arrow-pointer text-[9px] text-emerald-300"></i></div><div class="text-2xl font-black text-emerald-600 mt-1">{{ leadStats.won }}</div><div class="text-[10px] text-slate-400 mt-1">点击查看已确认合作 / 已转正式客户</div></button>
          </div>

          <div class="bg-white border border-slate-200 rounded-2xl soft-shadow overflow-hidden">
            <div class="p-4 border-b border-slate-100 flex flex-col md:flex-row md:items-center justify-between gap-3">
              <div class="font-extrabold text-sm">{{ leadPoolFilter==='ACTIVE' && leadQuickFilter==='DUE' ? '待跟进 / 已逾期客户' : leadPoolFilter==='ACTIVE' && leadQuickFilter==='HIGH' ? '高意向客户' : '潜在客户跟进列表' }}</div>
              <div class="flex flex-col sm:flex-row gap-2">
                <div class="relative"><i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-slate-300 text-xs"></i><input v-model.trim="leadSearch" class="h-9 w-full sm:w-64 rounded-xl border border-slate-200 pl-9 pr-3 text-xs outline-none" placeholder="搜索公司 / 联系人 / 来源" /></div>
                <select v-model="leadPoolFilter" @change="leadQuickFilter='ALL'" class="h-9 rounded-xl border border-slate-200 bg-white px-3 text-xs font-semibold"><option value="ACTIVE">进行中</option><option value="WON">已成交</option><option value="LOST">已流失</option><option value="HISTORY">全部历史</option></select>
              </div>
            </div>
            <div v-if="filteredLeads.length" class="overflow-x-auto scrollbar">
              <table class="w-full min-w-[1240px] text-left text-xs"><thead class="bg-slate-50 text-slate-400"><tr><th class="p-4">潜在客户</th><th class="p-4">来源 / 平台</th><th class="p-4">预计预算</th><th class="p-4">投放报价</th><th class="p-4">阶段</th><th class="p-4">下次跟进</th><th class="p-4">负责人</th><th class="p-4">备注</th><th class="p-4 text-right">操作</th></tr></thead>
                <tbody class="divide-y divide-slate-100"><tr v-for="lead in filteredLeads" :key="lead.id" class="hover:bg-slate-50/70"><td class="p-4"><div class="font-extrabold text-slate-900">{{ lead.company }}</div><div class="text-[10px] text-slate-400 mt-1">{{ lead.contact || '未填联系人' }} <span v-if="lead.contactInfo">· {{ lead.contactInfo }}</span></div></td><td class="p-4"><div class="font-semibold">{{ lead.source || '—' }}</div><div class="mt-1"><platform-badges :platform="lead.platformInterest || 'FB+TK'"></platform-badges></div></td><td class="p-4 font-extrabold text-emerald-600">{{ lead.expectedBudget ? formatMoney(lead.expectedBudget,lead.budgetCurrency) : '—' }}</td><td class="p-4"><div class="font-extrabold text-violet-600">{{ lead.adQuote ? formatMoney(lead.adQuote,lead.quoteCurrency || lead.budgetCurrency || 'USD') : '—' }}</div><div v-if="lead.adQuote" class="text-[10px] text-slate-400 mt-1">投放合作报价</div></td><td class="p-4"><span class="px-2 py-1 rounded-full text-[10px] font-extrabold" :class="leadStageStyle(lead.stage)">{{ leadStageText(lead.stage) }}</span></td><td class="p-4"><div class="font-mono font-bold" :class="leadFollowupClass(lead)">{{ lead.nextFollowUp || '未设置' }}</div><div v-if="lead.nextFollowUp" class="text-[10px] text-slate-400 mt-1">{{ followupLabel(lead.nextFollowUp) }}</div></td><td class="p-4 font-semibold">{{ lead.owner || '—' }}</td><td class="p-4 max-w-[260px]"><div class="truncate text-slate-500" :title="lead.notes">{{ lead.notes || '—' }}</div></td><td class="p-4 text-right"><div class="flex justify-end gap-1"><button v-if="lead.convertedClientId" @click="openConvertedLeadClient(lead)" title="查看已创建的正式客户" class="h-8 px-2.5 rounded-lg bg-slate-100 text-slate-600 font-bold"><i class="fa-solid fa-arrow-up-right-from-square mr-1"></i>查看正式客户</button><button v-else-if="lead.stage==='WON'" @click="convertLeadToClient(lead)" title="该线索已成交但尚未建立正式客户档案" class="h-8 px-2.5 rounded-lg bg-emerald-50 text-emerald-700 font-bold"><i class="fa-solid fa-user-check mr-1"></i>创建正式客户</button><button v-else-if="lead.stage!=='LOST'" @click="convertLeadToClient(lead)" title="确认合作并完善正式客户资料" class="h-8 px-2.5 rounded-lg bg-emerald-50 text-emerald-700 font-bold">确认合作并建档</button><button @click="openLeadModal(lead)" class="w-8 h-8 rounded-lg hover:bg-violet-50 text-violet-600"><i class="fa-solid fa-pen"></i></button><button type="button" @click="deleteLead(lead)" class="w-8 h-8 rounded-lg hover:bg-rose-50 text-rose-500"><i class="fa-regular fa-trash-can"></i></button></div></td></tr></tbody></table>
            </div>
            <div v-else class="py-16 text-center"><i class="fa-regular fa-address-card text-3xl text-slate-300"></i><div class="text-sm font-extrabold mt-3">{{ leadPoolFilter==='ACTIVE' && leadQuickFilter==='DUE' ? '当前没有待跟进或已逾期客户' : leadPoolFilter==='ACTIVE' && leadQuickFilter==='HIGH' ? '当前没有高意向客户' : leadPoolFilter==='ACTIVE' ? '当前没有需要跟进的潜在客户' : leadPoolFilter==='WON' ? '暂无成交历史' : leadPoolFilter==='LOST' ? '暂无流失线索' : '暂无历史线索' }}</div><p class="text-xs text-slate-400 mt-1">{{ leadPoolFilter==='ACTIVE' ? '新增潜客后会显示在这里；完成正式客户建档后会自动移入成交历史。' : '可通过右侧分类切换回进行中的潜客。' }}</p></div>
          </div>
        </section>

        <!-- Account Opening Channels / 开户商渠道 -->
        <section v-else-if="currentPage==='account-opening'" key="account-opening" class="space-y-5">
          <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-4">
            <div><div class="text-[11px] font-bold tracking-[.16em] text-blue-500">ACCOUNT OPENING CHANNELS</div><h2 class="text-2xl font-extrabold tracking-tight mt-1">开户商渠道</h2><p class="text-xs text-slate-500 mt-1">维护开户商、多位对接人及各自返点政策和客户开户关系，并自动按客户所选对接人核算广告消耗与返点金额。</p><div v-if="unboundOpeningDealCount" class="mt-2 inline-flex items-center gap-1.5 rounded-lg bg-amber-50 border border-amber-100 px-2.5 py-1.5 text-[10px] font-bold text-amber-700"><i class="fa-solid fa-triangle-exclamation"></i>{{ unboundOpeningDealCount }} 条开户记录未绑定有效对接人，返点按 0 计算</div></div>
            <div class="flex flex-wrap gap-2"><button v-if="canManageProviders()" type="button" @click="exportRebateExcel" class="h-10 px-4 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-700 text-xs font-bold shadow-sm hover:bg-emerald-100 transition"><i class="fa-solid fa-file-excel mr-1.5"></i>导出返点 Excel</button><button v-if="canManageProviders()" type="button" @click="openProviderModal()" class="h-10 px-4 rounded-xl bg-white border border-blue-200 text-blue-700 text-xs font-bold shadow-sm hover:bg-blue-50 transition"><i class="fa-solid fa-building-circle-check mr-1.5"></i>添加开户商</button><button type="button" @click="openOpeningModal()" class="h-10 px-4 rounded-xl bg-blue-600 text-white text-xs font-bold shadow-sm"><i class="fa-solid fa-folder-plus mr-1.5"></i>新增客户开户</button></div>
          </div>

          <div class="bg-white border border-slate-200 rounded-2xl p-4 soft-shadow space-y-4">
            <div class="flex flex-col xl:flex-row xl:items-center justify-between gap-3">
              <div><div class="font-extrabold text-sm">广告消耗统计周期</div><div class="text-[10px] text-slate-400 mt-1">{{ openingSpendPeriodLabel }} · {{ openingSelectedProviderName }} · 消耗来自已关联广告账户的「广告数据记录」，返点按每条开户记录所选对接人的独立返点政策自动计算</div></div>
              <div class="inline-flex p-1 rounded-xl bg-slate-100 self-start"><button v-for="p in [{k:'MONTH',l:'月'},{k:'QUARTER',l:'季'},{k:'YEAR',l:'年'}]" :key="p.k" @click="openingSpendPeriod=p.k" class="h-8 px-4 rounded-lg text-xs font-bold transition" :class="openingSpendPeriod===p.k?'bg-white text-blue-700 shadow-sm':'text-slate-500'">{{ p.l }}</button></div>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-3">
              <div><label class="text-[10px] font-bold text-slate-500 block mb-1.5">统计代理商 / 开户商</label><select v-model="openingProviderFilter" class="h-10 w-full rounded-xl border border-slate-200 px-3 text-xs font-bold bg-white outline-none focus:ring-2 focus:ring-blue-100"><option value="ALL">全部代理商</option><option v-for="p in openingProviders" :key="p.id" :value="p.id">{{ p.name }}</option></select></div>
              <div v-if="openingSpendPeriod==='MONTH'"><label class="text-[10px] font-bold text-slate-500 block mb-1.5">选择月份</label><input v-model="openingMonthKey" type="month" class="h-10 w-full rounded-xl border border-slate-200 px-3 text-xs font-bold bg-white outline-none focus:ring-2 focus:ring-blue-100" /></div>
              <template v-else-if="openingSpendPeriod==='QUARTER'"><div><label class="text-[10px] font-bold text-slate-500 block mb-1.5">选择年份</label><select v-model.number="openingQuarterYear" class="h-10 w-full rounded-xl border border-slate-200 px-3 text-xs font-bold bg-white outline-none focus:ring-2 focus:ring-blue-100