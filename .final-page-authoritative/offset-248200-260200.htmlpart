投放工具”，按客户 → 账号完成绑定。</p></div>
        </section>

        <!-- Client Form -->
        <!-- System, permissions & backup -->
        <section v-else-if="currentPage==='system'" key="system" class="space-y-5">
          <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-4"><div><div class="text-[11px] font-bold tracking-[.16em] text-indigo-500">ACCESS & BACKUP</div><h2 class="text-2xl font-extrabold tracking-tight mt-1">权限与数据备份</h2><p class="text-xs text-slate-500 mt-1">④ 登录角色、页面权限、操作审计和全量数据备份。当前单文件版仍是本地数据仓库，正式上线可无缝替换为服务器数据库。</p></div><div class="flex gap-2"><button @click="createBackupSnapshot(true)" class="h-10 px-4 rounded-xl bg-indigo-600 text-white text-xs font-bold"><i class="fa-solid fa-database mr-1.5"></i>创建快照</button><button @click="downloadFullBackup" class="h-10 px-4 rounded-xl bg-slate-950 text-white text-xs font-bold"><i class="fa-solid fa-download mr-1.5"></i>导出全量备份</button></div></div>
          <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
            <div class="bg-white border border-slate-200 rounded-2xl p-5 soft-shadow"><div class="flex items-center justify-between"><div><div class="font-extrabold text-sm">当前登录</div><div class="text-[10px] text-slate-400 mt-1">会话仅保存在当前浏览器</div></div><div class="w-10 h-10 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center"><i class="fa-solid fa-user-shield"></i></div></div><div class="mt-4 font-black text-lg">{{ currentUser?.name || '未登录' }}</div><div class="text-xs text-indigo-600 font-bold mt-1">{{ currentRoleLabel }}</div><button @click="logout" class="mt-4 h-9 px-3 rounded-xl border border-slate-200 text-xs font-bold">退出登录</button></div>
            <div class="bg-white border border-slate-200 rounded-2xl p-5 soft-shadow"><div class="font-extrabold text-sm">备份状态</div><div class="text-2xl font-black mt-4">{{ backupSnapshots.length }} 个</div><div class="text-[10px] text-slate-400 mt-1">最多保留最近 5 个本地快照</div><div class="text-xs font-semibold text-slate-600 mt-3">最近：{{ lastBackupText }}</div></div>
            <div class="bg-white border border-slate-200 rounded-2xl p-5 soft-shadow"><div class="font-extrabold text-sm">导入 / 恢复</div><p class="text-[10px] text-slate-400 mt-2 leading-relaxed">支持本系统导出的 JSON 全量备份。导入前会先创建当前数据快照。</p><label v-if="currentUser?.role==='ADMIN'" class="mt-4 h-10 px-4 rounded-xl bg-emerald-600 text-white text-xs font-bold inline-flex items-center cursor-pointer"><i class="fa-solid fa-upload mr-1.5"></i>导入备份文件<input type="file" accept="application/json,.json" class="hidden" @change="importFullBackup"></label><div v-else class="mt-4 text-[10px] font-bold text-slate-400"><i class="fa-solid fa-lock mr-1"></i>仅管理员可导入或恢复备份</div></div>
          </div>
          <div v-if="currentUser?.role==='ADMIN'" class="bg-white border border-slate-200 rounded-2xl soft-shadow overflow-hidden"><div class="p-4 border-b border-slate-100 flex items-center justify-between"><div><div class="font-extrabold text-sm">用户与角色权限</div><div class="text-[10px] text-slate-400 mt-1">管理员、财务、投手 / 运营、销售四种角色；页面菜单会按角色自动隐藏。</div></div><button @click="openUserModal()" class="h-9 px-3 rounded-xl bg-indigo-600 text-white text-xs font-bold"><i class="fa-solid fa-user-plus mr-1.5"></i>添加用户</button></div><div class="overflow-x-auto"><table class="w-full min-w-[800px] text-xs"><thead class="bg-slate-50 text-slate-400"><tr><th class="p-4 text-left">姓名</th><th class="p-4 text-left">登录账号</th><th class="p-4 text-left">角色</th><th class="p-4 text-left">状态</th><th class="p-4 text-left">可访问范围</th><th class="p-4 text-right">操作</th></tr></thead><tbody class="divide-y divide-slate-100"><tr v-for="u in authUsers" :key="u.id"><td class="p-4 font-bold">{{ u.name }}</td><td class="p-4 font-mono">{{ u.username }}</td><td class="p-4"><span class="px-2 py-1 rounded-full bg-indigo-50 text-indigo-700 font-bold">{{ roleLabel(u.role) }}</span></td><td class="p-4"><span :class="u.enabled!==false?'text-emerald-600':'text-slate-400'" class="font-bold">{{ u.enabled!==false?'启用':'停用' }}</span></td><td class="p-4 text-slate-500">{{ roleScopeText(u.role) }}</td><td class="p-4 text-right"><div class="flex justify-end gap-1"><button type="button" @click="openUserModal(u)" class="w-8 h-8 rounded-lg hover:bg-blue-50 text-blue-600" title="编辑用户"><i class="fa-solid fa-pen"></i></button><button type="button" @click="deleteAuthUser(u)" class="w-8 h-8 rounded-lg" :class="canDeleteAuthUser(u)?'hover:bg-rose-50 text-rose-500':'text-slate-300 cursor-not-allowed'" :title="canDeleteAuthUser(u)?'删除用户':(u.id===currentUser?.id?'当前登录账号不能删除':'至少需要保留一个管理员')"><i :class="canDeleteAuthUser(u)?'fa-regular fa-trash-can':'fa-solid fa-lock'"></i></button></div></td></tr></tbody></table></div></div>
          <div class="rounded-2xl border border-indigo-100 bg-indigo-50/60 p-4 text-[10px] text-indigo-800 leading-relaxed"><i class="fa-solid fa-shield-halved mr-1.5"></i><b>安全提示：</b>当前仍是单机 HTML 版本。系统已做页面权限、敏感凭证隐藏、审计日志、月结锁定和备份容量保护；真正多人协作时仍应迁移到后端数据库与服务端登录认证，避免浏览器本地数据被直接读取。</div>
          <div class="rounded-2xl border p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3" :class="storageWarning?'border-amber-200 bg-amber-50':'border-emerald-100 bg-emerald-50/50'"><div><div class="text-xs font-extrabold" :class="storageWarning?'text-amber-800':'text-emerald-800'"><i class="fa-solid fa-hard-drive mr-1.5"></i>本地存储容量 {{ storageUsageText }}</div><div class="text-[10px] mt-1" :class="storageWarning?'text-amber-700':'text-slate-500'">{{ storageWarning?'数据量已较大，建议立即导出备份，并尽快迁移到数据库。':'当前本地数据容量正常。自动快照仅保留最近 5 份，避免浏览器空间被占满。' }}</div></div><button @click="downloadFullBackup" class="h-9 px-3 rounded-xl bg-slate-950 text-white text-[10px] font-bold"><i class="fa-solid fa-download mr-1.5"></i>立即导出</button></div>

          <div class="grid grid-cols-1 lg:grid-cols-2 gap-4"><div class="bg-white border border-slate-200 rounded-2xl soft-shadow overflow-hidden"><div class="p-4 border-b border-slate-100"><div class="font-extrabold text-sm">本地数据快照</div><div class="text-[10px] text-slate-400 mt-1">恢复快照会覆盖当前业务数据。</div></div><div class="divide-y divide-slate-100 max-h-[420px] overflow-y-auto"><div v-for="snap in backupSnapshots" :key="snap.id" class="p-4 flex items-center justify-between gap-3"><div><div class="font-bold text-xs">{{ snap.name }}</div><div class="text-[10px] text-slate-400 mt-1">{{ formatBackupTime(snap.createdAt) }}</div></div><div v-if="currentUser?.role==='ADMIN'" class="flex items-center gap-1.5"><button type="button" @click="restoreBackupSnapshot(snap)" class="h-8 px-3 rounded-lg bg-indigo-50 text-indigo-700 text-[10px] font-bold">恢复</button><button type="button" @click="deleteBackupSnapshot(snap)" class="w-8 h-8 rounded-lg bg-rose-50 text-rose-500 text-[10px]" title="删除快照"><i class="fa-regular fa-trash-can"></i></button></div><span v-else class="text-[10px] text-slate-300" title="仅管理员可恢复或删除快照"><i class="fa-solid fa-lock"></i></span></div><div v-if="!backupSnapshots.length" class="py-12 text-center text-xs text-slate-400">暂无快照</div></div></div><div class="bg-white border border-slate-200 rounded-2xl soft-shadow overflow-hidden"><div class="p-4 border-b border-slate-100"><div class="font-extrabold text-sm">操作审计</div><div class="text-[10px] text-slate-400 mt-1">记录客户、账号、广告、回款、返点、成本、开户商、工具、月结和备份等关键动作。</div></div><div class="divide-y divide-slate-100 max-h-[420px] overflow-y-auto"><div v-for="log in auditLogs.slice(0,40)" :key="log.id" class="p-4"><div class="flex items-center justify-between gap-3"><div class="font-bold text-xs">{{ log.action }}</div><div class="text-[9px] text-slate-400">{{ formatBackupTime(log.at) }}</div></div><div class="text-[10px] text-slate-500 mt-1">{{ log.user || '系统' }} · {{ log.detail }}</div></div><div v-if="!auditLogs.length" class="py-12 text-center text-xs text-slate-400">暂无审计记录</div></div></div></div>
        </section>

        <section v-else-if="currentPage==='client-form'" key="client-form" class="max-w-5xl mx-auto space-y-5">
          <div class="flex items-start justify-between gap-4"><div class="flex items-start gap-3"><button @click="navigateTo(form.id?'client-detail':'clients')" class="w-10 h-10 rounded-xl border border-slate-200 bg-white"><i class="fa-solid fa-arrow-left"></i></button><div><h2 class="text-2xl font-extrabold tracking-tight">{{ form.id?'编辑客户':'新增客户' }}</h2><p class="text-xs text-slate-500 mt-1">客户、合同、账号资产与运营环境一次录入。</p></div></div></div>
          <form @submit.prevent="saveClient" class="space-y-5">
            <div class="bg-white border border-slate-200 rounded-2xl p-5 sm:p-6 soft-shadow"><div class="flex items-center gap-2 font-extrabold text-sm"><span class="w-7 h-7 rounded-lg bg-indigo-50 text-indigo-600 flex items-center justify-center text-xs">1</span>基本信息与合同</div><div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-5"><form-field label="客户名称 *"><input v-model.trim="form.name" required class="field" /></form-field><form-field label="产品 / 服务 *"><input v-model.trim="form.product" required class="field" /></form-field><form-field label="投放平台 *"><select v-model="form.platform" class="field"><option value="FB">Facebook</option><option value="TK">TikTok</option><option value="FB+TK">Facebook + TikTok</option></select></form-field><form-field label="合作项目 *"><input v-model.trim="form.project" required class="field" /></form-field><form-field label="月服务费 *"><div class="money-input-group"><select v-model="form.currency" class="field money-currency"><option value="USD">USD</option><option value="CNY">CNY</option></select><input v-model.number="form.monthlyFee" type="number" min="0" step="0.01" required inputmode="decimal" placeholder="请输入金额" class="field money-amount" /></div></form-field><form-field label="投放服务费计费方式"><select v-model="form.billingMode" class="field"><option value="FULL_MONTH">整月计费</option><option value="PRORATE">按实际服务天数折算</option><option value="MANUAL">手工账单确认</option></select></form-field><form-field label="每月付款到期日"><input v-model.number="form.renewalAlertDay" type="number" min="1" max="31" class="field" /></form-field><form-field label="合同开始日期"><input v-model="form.startDate" type="date" class="field" /></form-field><form-field label="合同到期日期 *"><input v-model="form.endDate" type="date" required class="field" /></form-field></div></div>

            <div v-if="!canManageAssets()" class="rounded-2xl border border-amber-100 bg-amber-50 px-4 py-3 text-[11px] text-amber-800"><i class="fa-solid fa-lock mr-1.5"></i>当前角色仅可维护客户基本资料与合同。BM / BC、广告账号、登录凭证和网络环境由管理员或投手 / 运营维护。</div>

            <div v-if="canManageAssets() && form.platform.includes('FB')" class="bg-white border border-blue-100 rounded-2xl p-5 sm:p-6 soft-shadow">
              <div class="flex flex-col sm:flex-ro