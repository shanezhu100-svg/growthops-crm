w sm:items-center justify-between gap-3">
                <div><div class="flex items-center gap-2 font-extrabold text-sm text-blue-900"><i class="fa-brands fa-facebook text-blue-600"></i>Facebook 资产</div><p class="text-[11px] text-slate-400 mt-1">一个客户可以添加多个 BM / 广告账号与登录资料。</p></div>
                <button type="button" @click="addPlatformAccount('FB')" class="h-9 px-3.5 rounded-xl bg-blue-600 hover:bg-blue-500 text-white text-xs font-bold transition shrink-0"><i class="fa-solid fa-plus mr-1.5"></i>添加 Facebook 账号</button>
              </div>
              <div v-if="form.fbAccounts && form.fbAccounts.length" class="mt-5 space-y-4">
                <div v-for="(account,idx) in form.fbAccounts" :key="account.id" class="rounded-2xl border border-blue-100 bg-blue-50/30 p-4 sm:p-5">
                  <div class="flex items-center justify-between gap-3 mb-4"><div class="flex items-center gap-2"><span class="w-7 h-7 rounded-lg bg-blue-600 text-white flex items-center justify-center text-[10px] font-black">{{ idx + 1 }}</span><div><div class="text-xs font-extrabold text-blue-900">{{ account.accountName || `Facebook 账号 ${idx + 1}` }}</div><div class="text-[10px] text-slate-400 mt-0.5">独立 BM / 广告账号 / 登录凭证</div></div></div><button type="button" @click="removePlatformAccount('FB',idx)" class="h-8 px-2.5 rounded-lg bg-white border border-rose-100 text-rose-500 hover:bg-rose-50 text-[11px] font-bold transition"><i class="fa-regular fa-trash-can mr-1"></i>删除</button></div>
                  <div class="grid grid-cols-1 md:grid-cols-2 gap-4"><div class="md:col-span-2"><form-field label="账号名称"><input v-model.trim="account.accountName" class="field" placeholder="例如：主投账号 / 美国备用号 / TK 店铺 2 号" /></form-field></div><form-field label="BM ID"><input v-model.trim="account.bmId" class="field font-mono" placeholder="例如：89123456789" /></form-field><form-field label="广告账号 ID"><input v-model.trim="account.adAccountId" class="field font-mono" placeholder="例如：act_99812039" /></form-field><form-field label="返点类型"><select v-model="account.rebateMode" class="field"><option value="CHANNEL">有渠道返点</option><option value="NONE">无返点 / 客户自有账户</option></select><div class="mt-1.5 text-[9px] text-slate-400">选择“有渠道返点”时，该账户产生消耗后必须绑定已开户渠道；否则月结会提示未归属消耗。</div></form-field><form-field label="登录账号"><input v-model.trim="account.loginAccount" class="field font-mono" placeholder="邮箱 / 个人号" /></form-field><form-field label="密码 / 2FA"><input v-model.trim="account.loginPassword" class="field font-mono" placeholder="密码 / 2FA Token" /></form-field></div>
                </div>
              </div>
              <div v-else class="mt-5 rounded-2xl border border-dashed border-blue-200 bg-blue-50/20 px-5 py-8 text-center"><i class="fa-brands fa-facebook text-2xl text-blue-300"></i><div class="text-xs font-bold text-slate-600 mt-2">暂无 Facebook 账号</div><button type="button" @click="addPlatformAccount('FB')" class="mt-3 text-xs font-bold text-blue-600">+ 添加第一个账号</button></div>
            </div>

            <div v-if="canManageAssets() && form.platform.includes('TK')" class="bg-white border border-slate-200 rounded-2xl p-5 sm:p-6 soft-shadow">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                <div><div class="flex items-center gap-2 font-extrabold text-sm"><i class="fa-brands fa-tiktok"></i>TikTok 资产</div><p class="text-[11px] text-slate-400 mt-1">一个客户可以添加多个 BC / 广告账号与登录资料。</p></div>
                <button type="button" @click="addPlatformAccount('TK')" class="h-9 px-3.5 rounded-xl bg-slate-950 hover:bg-slate-800 text-white text-xs font-bold transition shrink-0"><i class="fa-solid fa-plus mr-1.5"></i>添加 TikTok 账号</button>
              </div>
              <div v-if="form.tkAccounts && form.tkAccounts.length" class="mt-5 space-y-4">
                <div v-for="(account,idx) in form.tkAccounts" :key="account.id" class="rounded-2xl border border-slate-200 bg-slate-50/70 p-4 sm:p-5">
                  <div class="flex items-center justify-between gap-3 mb-4"><div class="flex items-center gap-2"><span class="w-7 h-7 rounded-lg bg-slate-950 text-white flex items-center justify-center text-[10px] font-black">{{ idx + 1 }}</span><div><div class="text-xs font-extrabold">{{ account.accountName || `TikTok 账号 ${idx + 1}` }}</div><div class="text-[10px] text-slate-400 mt-0.5">独立 BC / 广告账号 / 登录凭证</div></div></div><button type="button" @click="removePlatformAccount('TK',idx)" class="h-8 px-2.5 rounded-lg bg-white border border-rose-100 text-rose-500 hover:bg-rose-50 text-[11px] font-bold transition"><i class="fa-regular fa-trash-can mr-1"></i>删除</button></div>
                  <div class="grid grid-cols-1 md:grid-cols-2 gap-4"><div class="md:col-span-2"><form-field label="账号名称"><input v-model.trim="account.accountName" class="field" placeholder="例如：主投账号 / 美国备用号 / TK 店铺 2 号" /></form-field></div><form-field label="BC ID"><input v-model.trim="account.bcId" class="field font-mono" placeholder="例如：BC-99120391" /></form-field><form-field label="广告账号 ID"><input v-model.trim="account.adAccountId" class="field font-mono" placeholder="例如：tt_552190" /></form-field><form-field label="返点类型"><select v-model="account.rebateMode" class="field"><option value="CHANNEL">有渠道返点</option><option value="NONE">无返点 / 客户自有账户</option></select><div class="mt-1.5 text-[9px] text-slate-400">选择“有渠道返点”时，该账户产生消耗后必须绑定已开户渠道；否则月结会提示未归属消耗。</div></form-field><form-field label="登录账号"><input v-model.trim="account.loginAccount" class="field font-mono" placeholder="邮箱 / TikTok 账号" /></form-field><form-field label="密码 / 2FA"><input v-model.trim="account.loginPassword" class="field font-mono" placeholder="密码 / 2FA Token" /></form-field></div>
                </div>
              </div>
              <div v-else class="mt-5 rounded-2xl border border-dashed border-slate-300 bg-slate-50 px-5 py-8 text-center"><i class="fa-brands fa-tiktok text-2xl text-slate-300"></i><div class="text-xs font-bold text-slate-600 mt-2">暂无 TikTok 账号</div><button type="button" @click="addPlatformAccount('TK')" class="mt-3 text-xs font-bold text-slate-800">+ 添加第一个账号</button></div>
            </div>

            <div v-if="canManageAssets()" class="bg-white border border-slate-200 rounded-2xl p-5 sm:p-6 soft-shadow">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                <div><div class="flex items-center gap-2 font-extrabold text-sm"><span class="w-7 h-7 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center text-xs">4</span>网络环境与到期节点</div><p class="text-[11px] text-slate-400 mt-1">一个客户可以添加多个独立 IP / 指纹浏览器环境，每个环境单独计算到期提醒。</p></div>
                <button type="button" @click="addNetworkEnvironment" class="h-9 px-3.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold transition shrink-0"><i class="fa-solid fa-plus mr-1.5"></i>添加网络环境</button>
              </div>
              <div v-if="form.networkEnvironments && form.networkEnvironments.length" class="mt-5 space-y-4">
                <div v-for="(env,idx) in form.networkEnvironments" :key="env.id" class="rounded-2xl border border-emerald-100 bg-emerald-50/25 p-4 sm:p-5">
                  <div class="flex items-center justify-between gap-3 mb-4"><div class="flex items-center gap-2"><span class="w-7 h-7 rounded-lg bg-emerald-600 text-white flex items-center justify-center text-[10px] font-black">{{ idx + 1 }}</span><div><div class="text-xs font-extrabold text-emerald-900">网络环境 {{ idx + 1 }}</div><div class="text-[10px] text-slate-400 mt-0.5">独立 IP / Profile / 到期节点 / 月费</div></div></div><button type="button" @click="removeNetworkEnvironment(idx)" class="h-8 px-2.5 rounded-lg bg-white border border-rose-100 text-rose-500 hover:bg-rose-50 text-[11px] font-bold transition"><i class="fa-regular fa-trash-can mr-1"></i>删除</button></div>
                  <div class="grid grid-cols-1 md:grid-cols-2 gap-4"><form-field label="网络环境名称"><input v-model.trim="env.networkName" class="field" placeholder="例如：US 静态住宅 IP" /></form-field><form-field label="指纹 Profile / 环境"><input v-model.trim="env.ipEnvironment" class="field" placeholder="例如：AdsPower Profile #03" /></form-field><form-field label="IP 到期日期"><input v-model="env.ipDueDate" type="date" class="field" /></form-field><form-field label="IP 月费"><div class="money-input-group"><select v-model="env.ipCurrency" class="field money-currency"><option value="USD">USD</option><option value="CNY">CNY</option></select><input v-model.number="env.ipMonthlyFee" type="number" min="0" step="0.01" inputmode="decimal" placeholder="请输入金额" class="field money-amount" /></div></form-field><div class="md:col-span-2"><label class="flex items-center justify-between gap-3 rounded-xl border border-emerald-100 bg-white px-3 py-3 cursor-pointer"><div><div class="text-xs font-extrabold text-slate-700">自动计入每月成本</div><div class="text-[10px] text-slate-400 mt-1">开启后，系统每月自动生成一笔“IP / 网络”客户成本，不需要财务重复录入。</div></div><input v-model="env.autoCost" type="checkbox" class="w-4 h-4 accent-emerald-600" /></label></div></div>
                </div>
              </div>
              <div v-else class="mt-5 rounded-2xl border border-dashed border-emerald-200 bg-emerald-50/20 px-5 py-8 text-center"><i class="fa-solid fa-network-wired text-2xl text-emerald-300"></i><div class="text-xs font-bold text-slate-600 mt-2">暂无网络环境</div><button type="button" @click="addNetworkEnvironment" class="mt-3 text-xs font-bold text-emerald-600">+ 添加第一个网络环境</button></div>
            </div>

            <div class="flex justify-end gap-2"><button type="button" @click="navigateTo(form.id?'client-detail':'clients')" class="h-10 px-4 rounded-xl border border-slate-200 bg-white text-xs font-bold">取消</button><button type="submit" class="h-10 px-5 rounded-xl bg-indigo-600 text-white text-xs font-bold"><i class="fa-solid fa-check mr-1.5"></i>{{ form.id?'保存修改':'确认合作并创建客户' }}</button></div>
          </form>
        </section>
      </transition>
    </div>
  </main>

  <!-- Google / Instagram Asset Modal -->
  <div v-if="showExternalAssetModal" class="fixed inset-0 z-[115] modal-backdrop flex items-center justify-center p-4" @click.self="showExternalAssetModal=false">
    <form @submit.prevent="saveExternalAsset" class="bg-white w-full max-w-2xl rounded-3xl soft-shadow overflow-hidden">
      <div class="p-5 border-b border-slate-100 flex items-center justify-between gap-3">
        <div><div class="text-[10px] font-bold tracking-[.16em]" :class="externalAssetType==='GOOGLE'?'text-red-500':'text-fuchsia-600'">{{ externalAssetType==='GOOGLE'?'GOOGLE ASSET':'INSTAGRAM ASSET' }}</div><h3 class="font-extrabold mt-1">{{ externalAssetForm.id?'编辑':'添加' }}{{ externalAssetType==='GOOGLE'?' Google':' Instagram' }} 账号</h3><p class="text-[10px] text-slate-400 mt-1">当前客户：{{ selectedAssetsClient?.name || '—' }}</p></div>
        <button type="button" @click="showExternalAssetModal=false" class="w-9 h-9 rounded-xl hover:bg-slate-100" title="关闭"><i class="fa-solid fa-xmark"></i></button>
      </div>
      <div class="p-5 grid grid-cols-1 md:grid-cols-2 gap-4">
        <form-field label="账号名称 *"><input v-model.trim="externalAssetForm.accountName" required class="field" :placeholder="externalAssetType==='GOOGLE'?'例如：Google 美国主账号':'例如：Instagram 品牌主页'" /></form-field>
        <template v-if="externalAssetType==='GOOGLE'">
          <form-field label="Google Ads 客户 ID"><input v-model.trim="externalAssetForm.customerId" class="field" placeholder="例如：123-456-7890" /></form-field>
          <form-field label="MCC ID"><input v-model.trim="externalAssetForm.mccId" class="field" placeholder="例如：987-654-3210" /></form-field>
          <form-field label="Google 登录邮箱"><input v-model.trim="externalAssetForm.loginAccount" class="field" placeholder="name@gmail.com" /></form-field>
        </template>
        <template v-else>
          <form-field label="Instagram 用户名"><input v-model.trim="externalAssetForm.username" class="field" placeholder="例如：@brand_global" /></form-field>
          <form-field label="Instagram ID"><input v-model.trim="externalAssetForm.profileId" class="field" placeholder="主页 / 用户 ID" /></form-field>
          <form-field label="登录邮箱 / 手机号"><input v-model.trim="externalAssetForm.loginAccount" class="field" placeholder="邮箱或手机号" /></form-field>
        </template>
        <form-field label="密码 / 2FA"><input v-model="externalAssetForm.loginPassword" type="text" class="field" placeholder="密码或 2FA 备注" /></form-field>
        <div class="md:col-span-2"><form-field label="账号备注"><textarea v-model.trim="externalAssetForm.note" rows="3" class="w-full rounded-xl border border-slate-200 p-3 text-xs outline-none focus:ring-2 focus:ring-indigo-100" placeholder="账号用途、绑定主体、授权关系等"></textarea></form-field></div>
      </div>
      <div class="p-5 pt-0 flex justify-end gap-2"><button type="button" @click="showExternalAssetModal=false" class="h-10 px-4 rounded-xl border border-slate-200 text-xs font-bold">取消</button><button type="submit" class="h-10 px-5 rounded-xl text-white text-xs font-bold" :class="externalAssetType==='GOOGLE'?'bg-red-500 hover:bg-red-600':'bg-fuchsia-600 hover:bg-fuchsia-700'"><i class="fa-solid fa-check mr-1.5"></i>保存账号</button></div>
    </form>
  </div>

  <!-- Add Standalone Alert Modal -->
  <div v-if="showAddAlertModal" class="fixed inset-0 z-50 modal-backdrop flex items-center justify-center p-4" @click.self="showAddAlertModal=false">
    <div class="w-full max-w-lg bg-white rounded-3xl soft-shadow overflow-hidden">
      <div class="p-5 border-b border-slate-100 flex items-center justify-between"><div><div class="font-extrabold text-sm">新增独立提醒</div><div class="text-[11px] text-slate-400 mt-1">不会新增或修改客户主档案</div></div><button @click="showAddAlertModal=false" class="w-9 h-9 rounded-xl hover:bg-slate-100" title="关闭"><i class="fa-solid fa-xmark"></i></button></div>
      <form @submit.prevent="saveStandaloneAlert" class="p-5 space-y-4">
        <div>
          <div class="flex items-center justify-between gap-3 mb-1.5">
            <label class="text-[10px] font-bold text-slate-500">提醒类型</label>
            <button v-if="canManageReminderTypes()" type="button" @click="openReminderTypeManager" class="h-7 px-2.5 rounded-lg bg-indigo-50 text-indigo-700 text-[10px] font-extrabold hover:bg-indigo-100"><i class="fa-solid fa-gear mr-1"></i>管理类型</button>
          </div>
          <select v-model="newAlertForm.typeKey" class="field">
            <option v-for="type in reminderTypeOptions" :key="type.key" :value="type.key">{{ type.name }}</option>
          </select>
        </div>
        <form-field label="客户 / 项目名称 *"><input v-model.trim="newAlertForm.clientName" required class="field" /></form-field>
        <form-field label="到期日期 *"><input v-model="newAlertForm.dueDate" type="date" req