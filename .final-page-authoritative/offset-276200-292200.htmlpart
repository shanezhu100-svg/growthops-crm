uired class="field" /></form-field>
        <div class="rounded-2xl border border-indigo-100 bg-indigo-50/40 px-4 py-3.5 flex items-start gap-3">
          <div class="w-9 h-9 rounded-xl bg-white text-indigo-600 flex items-center justify-center shrink-0 border border-indigo-100"><i class="fa-regular fa-bell"></i></div>
          <div class="min-w-0"><div class="text-[10px] font-extrabold text-indigo-800">自动提醒规则</div><div class="text-[11px] text-slate-600 mt-1 leading-relaxed">保存到期事件后，系统会自动在 <b>到期前 7 天、3 天、1 天</b> 分三次提醒，无需手动设置提醒日期。</div></div>
        </div>
        <form-field label="费用"><input v-model.trim="newAlertForm.cost" class="field" /></form-field>
        <form-field :label="reminderTargetLabel(newAlertForm.typeKey)"><input v-model.trim="newAlertForm.target" class="field" :placeholder="reminderTargetPlaceholder(newAlertForm.typeKey)" /></form-field>
        <div class="flex justify-end gap-2 pt-2"><button type="button" @click="showAddAlertModal=false" class="h-10 px-4 rounded-xl border border-slate-200 text-xs font-bold">取消</button><button type="submit" class="h-10 px-5 rounded-xl bg-slate-950 text-white text-xs font-bold"><i class="fa-regular fa-bell mr-1.5"></i>保存提醒</button></div>
      </form>
    </div>
  </div>

  <!-- Reminder Type Manager Modal -->
  <div v-if="showReminderTypeManager" class="fixed inset-0 z-[60] modal-backdrop flex items-center justify-center p-4" @click.self="showReminderTypeManager=false">
    <div class="w-full max-w-xl bg-white rounded-3xl soft-shadow overflow-hidden">
      <div class="p-5 border-b border-slate-100 flex items-center justify-between gap-3">
        <div><div class="font-extrabold text-sm">提醒类型管理</div><div class="text-[11px] text-slate-400 mt-1">系统类型可修改名称；自定义类型可新增、修改和删除。</div></div>
        <button type="button" @click="showReminderTypeManager=false" class="w-9 h-9 rounded-xl hover:bg-slate-100" title="关闭"><i class="fa-solid fa-xmark"></i></button>
      </div>
      <div class="p-5 space-y-4">
        <div class="rounded-2xl border border-indigo-100 bg-indigo-50/30 p-4">
          <div class="text-[10px] font-extrabold text-indigo-700 mb-2">{{ reminderTypeForm.key ? '修改提醒类型' : '新增提醒类型' }}</div>
          <div class="flex flex-col sm:flex-row gap-2">
            <input v-model.trim="reminderTypeForm.name" @keyup.enter="saveReminderType" class="field flex-1" placeholder="例如：域名续费 / 服务器到期 / 证书续期" />
            <button type="button" @click="saveReminderType" class="h-10 px-4 rounded-xl bg-indigo-600 text-white text-xs font-bold hover:bg-indigo-700"><i class="fa-solid fa-check mr-1.5"></i>{{ reminderTypeForm.key ? '保存修改' : '添加类型' }}</button>
            <button v-if="reminderTypeForm.key" type="button" @click="resetReminderTypeForm" class="h-10 px-3 rounded-xl border border-slate-200 text-xs font-bold">取消编辑</button>
          </div>
        </div>

        <div class="rounded-2xl border border-slate-200 overflow-hidden">
          <div class="px-4 py-3 bg-slate-50 flex items-center justify-between"><span class="text-xs font-extrabold text-slate-700">已设置类型</span><span class="text-[10px] text-slate-400">{{ reminderTypeOptions.length }} 个</span></div>
          <div class="divide-y divide-slate-100 max-h-80 overflow-y-auto scrollbar">
            <div v-for="type in reminderTypeOptions" :key="type.key" class="px-4 py-3 flex items-center justify-between gap-3">
              <div class="min-w-0">
                <div class="flex items-center gap-2"><span class="text-xs font-bold text-slate-800 truncate">{{ type.name }}</span><span v-if="type.system" class="px-2 py-0.5 rounded-full bg-slate-100 text-slate-500 text-[9px] font-extrabold">系统</span><span v-else class="px-2 py-0.5 rounded-full bg-indigo-50 text-indigo-600 text-[9px] font-extrabold">自定义</span></div>
                <div class="text-[9px] text-slate-400 mt-1">{{ type.system ? '系统到期提醒类型，类型本身不可删除' : `${reminderTypeUsageCount(type.key)} 条独立提醒正在使用` }}</div>
              </div>
              <div class="flex items-center gap-1 shrink-0">
                <button type="button" @click="editReminderType(type)" class="w-8 h-8 rounded-lg text-indigo-600 hover:bg-indigo-50" title="修改提醒类型"><i class="fa-solid fa-pen"></i></button>
                <button type="button" @click="deleteReminderType(type)" class="w-8 h-8 rounded-lg text-rose-500 hover:bg-rose-50 disabled:opacity-30 disabled:cursor-not-allowed" :disabled="type.system" :title="type.system?'系统类型不能删除':'删除提醒类型'"><i class="fa-regular fa-trash-can"></i></button>
              </div>
            </div>
          </div>
        </div>
        <div class="rounded-xl bg-amber-50 border border-amber-100 px-3 py-2.5 text-[10px] text-amber-800 leading-relaxed"><i class="fa-solid fa-circle-info mr-1"></i>已被独立提醒使用的自定义类型，需要先删除或更换相关提醒后才能删除类型，避免历史提醒失去分类。</div>
      </div>
    </div>
  </div>

  <!-- Renewal Completion Modal -->
  <div v-if="showRenewalModal && renewalTarget" class="fixed inset-0 z-50 modal-backdrop flex items-center justify-center p-4" @click.self="showRenewalModal=false">
    <form @submit.prevent="saveRenewal" class="w-full max-w-xl bg-white rounded-3xl soft-shadow overflow-hidden">
      <div class="p-5 border-b border-slate-100 flex items-start justify-between gap-4">
        <div><div class="text-[10px] font-bold tracking-[.16em] text-emerald-500">RENEWAL</div><h3 class="font-extrabold mt-1">登记续费</h3><p class="text-[10px] text-slate-400 mt-1">选择续费周期或直接填写新的到期日期，保存后系统会重新按 7 / 3 / 1 天规则提醒。</p></div>
        <button type="button" @click="showRenewalModal=false" class="w-9 h-9 rounded-xl hover:bg-slate-100" title="关闭"><i class="fa-solid fa-xmark"></i></button>
      </div>
      <div class="p-5 space-y-4">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div class="rounded-2xl bg-slate-50 border border-slate-100 p-4"><div class="text-[10px] text-slate-400">提醒事项</div><div class="text-sm font-extrabold mt-1">{{ renewalTarget.type || alertTypeName(renewalTarget.typeKey) }}</div><div class="text-[10px] text-slate-400 mt-1">{{ renewalTarget.clientName || '独立提醒' }}</div></div>
          <div class="rounded-2xl bg-emerald-50/60 border border-emerald-100 p-4"><div class="text-[10px] text-emerald-600">当前到期日期</div><div class="text-sm font-extrabold text-emerald-800 mt-1 font-mono">{{ renewalTarget.dueDate || '—' }}</div><div class="text-[10px] text-emerald-600 mt-1">保存后旧周期提醒自动清理</div></div>
        </div>
        <form-field label="续费方式 *">
          <select v-model="renewalForm.mode" @change="syncRenewalPreview" class="field">
            <option value="M1">顺延 1 个月</option><option value="M3">顺延 3 个月</option><option value="M6">顺延 6 个月</option><option value="M12">顺延 12 个月</option><option value="CUSTOM">自定义新到期日期</option>
          </select>
        </form-field>
        <form-field label="新到期日期 *"><input v-model="renewalForm.newDueDate" type="date" required class="field" :readonly="renewalForm.mode!=='CUSTOM'" /></form-field>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
          <button v-for="opt in [{m:'M1',l:'1个月'},{m:'M3',l:'3个月'},{m:'M6',l:'6个月'},{m:'M12',l:'1年'}]" :key="opt.m" type="button" @click="renewalForm.mode=opt.m;syncRenewalPreview()" class="h-9 rounded-xl border text-xs font-bold" :class="renewalForm.mode===opt.m?'border-emerald-300 bg-emerald-50 text-emerald-700':'border-slate-200 bg-white text-slate-600'">{{ opt.l }}</button>
        </div>
        <form-field label="续费备注"><input v-model.trim="renewalForm.note" class="field" placeholder="例如：已续费 1 年 / 已确认付款" /></form-field>
        <div class="rounded-xl border border-blue-100 bg-blue-50/60 px-3 py-2.5 text-[10px] text-blue-700 leading-relaxed"><i class="fa-solid fa-bell mr-1"></i>新的到期日期保存后，系统会自动在到期前 7 天、3 天、1 天重新提醒，无需再次设置提醒时间。</div>
        <div class="flex justify-end gap-2"><button type="button" @click="showRenewalModal=false" class="h-10 px-4 rounded-xl border border-slate-200 text-xs font-bold">取消</button><button type="submit" class="h-10 px-5 rounded-xl bg-emerald-600 text-white text-xs font-bold"><i class="fa-solid fa-check mr-1.5"></i>保存续费</button></div>
      </div>
    </form>
  </div>

  <!-- Ad Recharge Modal -->
  <div v-if="showRechargeModal" class="fixed inset-0 z-50 modal-backdrop flex items-center justify-center p-4" @click.self="showRechargeModal=false">
    <div class="w-full max-w-lg bg-white rounded-3xl soft-shadow overflow-hidden">
      <div class="p-5 border-b border-slate-100 flex items-center justify-between"><div><div class="font-extrabold text-sm">登记广告充值</div><div class="text-[11px] text-slate-400 mt-1">{{ rechargeForm.clientName }} · {{ rechargeForm.accountName }}</div></div><button @click="showRechargeModal=false" class="w-9 h-9 rounded-xl hover:bg-slate-100" title="关闭"><i class="fa-solid fa-xmark"></i></button></div>
      <form @submit.prevent="saveRecharge" class="p-5 space-y-4">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4"><form-field label="充值日期 *"><input v-model="rechargeForm.date" type="date" required class="field" /></form-field><form-field label="充值金额 *"><div class="money-input-group"><select v-model="rechargeForm.currency" class="field money-currency"><option value="USD">USD</option><option value="CNY">CNY</option></select><input v-model.number="rechargeForm.amount" type="number" min="0.01" step="0.01" required class="field money-amount" placeholder="请输入金额" /></div></form-field></div>
        <form-field label="充值备注"><input v-model.trim="rechargeForm.note" class="field" placeholder="例如：8 月第二次预算充值" /></form-field>
        <div class="rounded-2xl bg-amber-50 border border-amber-100 p-4"><div class="text-xs font-extrabold text-amber-800"><i class="fa-solid fa-wallet mr-1.5"></i>广告账户余额两级自动提醒</div><p class="text-[11px] text-amber-800 mt-2 leading-relaxed">系统会按「累计 USD 充值 − USD 广告消耗」自动计算账户余额：余额达到 <strong>$100</strong> 或以下时触发首次充值提醒；如果继续消耗到 <strong>$30</strong> 或以下，会升级为<strong>二次紧急提醒</strong>。充值后余额高于 $100，提醒会自动消失。</p><p class="text-[10px] text-amber-700 mt-2">当前规则仅针对 USD 账户；CNY 数据不会与 USD 自动换算。</p></div>
        <div class="flex justify-end gap-2 pt-2"><button type="button" @click="showRechargeModal=false" class="h-10 px-4 rounded-xl border border-slate-200 text-xs font-bold">取消</button><button type="submit" class="h-10 px-5 rounded-xl bg-emerald-600 text-white text-xs font-bold"><i class="fa-solid fa-check mr-1.5"></i>确认充值</button></div>
      </form>
    </div>
  </div>

  <!-- Ads Plan Detail Modal -->
  <div v-if="showAdsPlanDetailModal && selectedPlanDetail" class="fixed inset-0 z-50 modal-backdrop flex items-center justify-center p-3 sm:p-5" @click.self="showAdsPlanDetailModal=false">
    <div class="w-full max-w-6xl max-h-[92vh] bg-white rounded-3xl soft-shadow overflow-hidden flex flex-col">
      <div class="p-5 border-b border-slate-100 flex items-start justify-between gap-4 shrink-0">
        <div class="min-w-0"><div class="text-[10px] font-bold text-indigo-500">广告设置方案详情</div><div class="font-extrabold text-lg mt-1 truncate">{{ selectedPlanDetail.planName || selectedPlanDetail.name || '广告方案' }}</div><div class="flex flex-wrap gap-2 mt-2"><span class="px-2 py-1 rounded-lg bg-indigo-50 text-indigo-700 text-[10px] font-extrabold">{{ objectiveLabel(selectedPlanDetail.objective) }}</span><span class="px-2 py-1 rounded-lg bg-slate-100 text-slate-600 text-[10px] font-bold">{{ selectedPlanDetail.name || '未命名广告系列' }}</span><span class="px-2 py-1 rounded-lg bg-violet-50 text-violet-700 text-[10px] font-bold">预算 {{ campaignBudgetText(selectedPlanDetail) }}</span></div></div>
        <button @click="showAdsPlanDetailModal=false" class="w-9 h-9 rounded-xl hover:bg-slate-100 shrink-0"><i class="fa-solid fa-xmark"></i></button>
      </div>
      <div class="p-5 overflow-y-auto scrollbar space-y-5">
        <div class="rounded-2xl bg-slate-50 border border-slate-100 p-4"><div class="text-[11px] font-extrabold text-slate-700">广告设置方案 / 测试思路 / 优化备注</div><div class="text-xs text-slate-600 leading-relaxed whitespace-pre-wrap mt-2">{{ selectedPlanDetail.planNotes || '暂无方案备注' }}</div></div>
        <div v-if="selectedPlanDetail.adSets && selectedPlanDetail.adSets.length" class="space-y-4">
          <div v-for="(adset,idx) in selectedPlanDetail.adSets" :key="adset.id" class="rounded-2xl border border-violet-100 overflow-hidden">
            <div class="p-4 bg-violet-50/40 border-b border-violet-100 flex flex-col md:flex-row md:items-center justify-between gap-3"><div><div class="text-[10px] text-violet-500 font-bold">AD SET {{ idx+1 }}</div><div class="font-extrabold text-sm mt-1">{{ adset.name || `广告组 ${idx+1}` }}</div></div><div class="flex gap-2 flex-wrap"><span class="px-2 py-1 rounded-lg bg-white border border-violet-100 text-[10px] font-bold">{{ deliveryMethodLabel(adset.deliveryMethod) }}</span><span class="px-2 py-1 rounded-lg bg-white border border-violet-100 text-[10px] font-bold">预算 {{ formatMoney(adset.budget,adset.budgetCurrency) }}</span><span class="px-2 py-1 rounded-lg bg-white border border-cyan-100 text-cyan-700 text-[10px] font-bold">实际消耗 {{ adSetDetailSpendText(selectedPlanDetail,adset) }}</span></div></div>
            <div class="p-4">
              <div class="grid grid-cols-2 md:grid-cols-5 gap-3 text-xs"><div class="rounded-xl bg-slate-50 p-3"><div class="text-[10px] text-slate-400">国家 / 地区</div><div class="font-bold mt-1">{{ adset.country || '不限' }}</div></div><div class="rounded-xl bg-slate-50 p-3"><div class="text-[10px] text-slate-400">年龄</div><div class="font-bold mt-1">{{ adset.ageMin }}–{{ adset.ageMax }}</div></div><div class="rounded-xl bg-slate-50 p-3"><div class="text-[10px] text-slate-400">性别</div><div class="font-bold mt-1">{{ genderLabel(adset.gender) }}</div></div><div class="rounded-xl bg-slate-50 p-3 md:col-span-2"><div class="text-[10px] text-slate-400">兴趣受众</div><div class="font-bold mt-1 break-words">{{ adset.interests || '未设置' }}</div></div></div>
              <div v-if="adset.ads && adset.ads.length" class="grid grid-cols-1 lg:grid-cols-2 gap-3 mt-4"><div v-for="(ad,adIdx) in adset.ads" :key="ad.id" class="rounded-xl border border-cyan-100 bg-cyan-50/20 p-4"><div class="flex items-center justify-between gap-3"><div><div class="text-[10px] text-cyan-600 font-bold">AD {{ adIdx+1 }}</div><div class="font-extrabold text-xs mt-1">{{ ad.name || `广告 ${adIdx+1}` }}</div></div><span class="px-2 py-1 rounded-lg bg-white border border-cyan-100 text-[10px] font-bold">{{ creativeFormatLabel(ad.format) }}</span></div><div class="space-y-2 mt-3 text-xs"><div><span class="text-slate-400">文案：</span><span class="font-medium whitespace-pre-wrap">{{ ad.primaryText || '—' }}</span></div><div><span class="text-slate-400">标题：</span><span class="font-bold">{{ ad.headline || '—' }}</span></div><div><span class="text-slate-400">描述：</span><span>{{ ad.descr