iption || '—' }}</span></div><div><span class="text-slate-400">行动号召：</span><span class="font-bold text-cyan-700">{{ callToActionLabel(ad.callToAction) }}</span></div></div></div></div>
            </div>
          </div>
        </div>
        <div v-else class="rounded-2xl border border-dashed border-slate-200 py-10 text-center text-xs text-slate-400">该方案暂无广告组设置。</div>
      </div>
      <div class="p-4 border-t border-slate-100 flex justify-end gap-2 shrink-0"><button @click="showAdsPlanDetailModal=false" class="h-9 px-4 rounded-xl border border-slate-200 text-xs font-bold">关闭</button><button @click="showAdsPlanDetailModal=false; openAdDataModal(selectedPlanDetail)" class="h-9 px-4 rounded-xl bg-cyan-600 text-white text-xs font-bold"><i class="fa-solid fa-chart-line mr-1.5"></i>添加广告数据</button></div>
    </div>
  </div>

  <!-- Ad Data Record Modal -->
  <div v-if="showAdDataModal" class="fixed inset-0 z-50 modal-backdrop flex items-center justify-center p-4" @click.self="showAdDataModal=false">
    <div class="w-full max-w-3xl max-h-[92vh] bg-white rounded-3xl soft-shadow overflow-hidden flex flex-col">
      <div class="p-5 border-b border-slate-100 flex items-center justify-between shrink-0"><div><div class="font-extrabold text-sm">{{ editingAdDataRecordId ? '更新广告数据' : '录入广告数据' }}</div><div class="text-[11px] text-slate-400 mt-1">{{ selectedAdsClient?.name }} · {{ selectedAdsAccount?.accountName || selectedAdsAccount?.adAccountId }}</div></div><button @click="showAdDataModal=false" class="w-9 h-9 rounded-xl hover:bg-slate-100" title="关闭"><i class="fa-solid fa-xmark"></i></button></div>
      <form @submit.prevent="saveAdDataRecord" class="p-5 overflow-y-auto scrollbar space-y-4">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <form-field label="记录日期 *"><input v-model="adDataForm.date" type="date" required class="field" /></form-field>
          <form-field label="关联广告方案 *"><select v-model="adDataForm.campaignId" @change="syncAdDataSelections" required class="field"><option value="" disabled>请选择广告方案</option><option v-for="campaign in savedAdsCampaignsForAccount" :key="campaign.id" :value="campaign.id">{{ campaign.planName || campaign.name }} · {{ objectiveLabel(campaign.objective) }}</option></select></form-field>
          <form-field label="关联广告组"><select v-model="adDataForm.adSetId" @change="syncAdDataAdSelection" class="field"><option value="">全部广告组 / 不指定</option><option v-for="adset in adDataAdSets" :key="adset.id" :value="adset.id">{{ adset.name || '未命名广告组' }}</option></select></form-field>
          <form-field label="关联广告"><select v-model="adDataForm.adId" class="field"><option value="">全部广告 / 不指定</option><option v-for="ad in adDataAds" :key="ad.id" :value="ad.id">{{ ad.name || '未命名广告' }}</option></select></form-field>
        </div>
        <div class="rounded-2xl bg-cyan-50/40 border border-cyan-100 p-4">
          <div class="text-xs font-extrabold text-cyan-800"><i class="fa-solid fa-chart-simple mr-1.5"></i>当期投放数据</div>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 mt-4">
            <form-field label="广告消耗 *"><div class="money-input-group"><select v-model="adDataForm.currency" class="field money-currency"><option value="USD">USD</option><option value="CNY">CNY</option></select><input v-model.number="adDataForm.spend" type="number" min="0" step="0.01" required class="field money-amount" placeholder="本次记录消耗" /></div></form-field>
            <form-field label="曝光 Impressions"><input v-model.number="adDataForm.impressions" type="number" min="0" step="1" class="field" /></form-field>
            <form-field label="点击 Clicks"><input v-model.number="adDataForm.clicks" type="number" min="0" step="1" class="field" /></form-field>
            <form-field label="潜在客户 Leads"><input v-model.number="adDataForm.leads" type="number" min="0" step="1" class="field" /></form-field>
            <form-field label="转化 / 订单"><input v-model.number="adDataForm.conversions" type="number" min="0" step="1" class="field" /></form-field>
            <form-field label="转化收入 / 销售额"><div class="money-input-group"><span class="field money-currency flex items-center justify-center font-bold">{{ adDataForm.currency }}</span><input v-model.number="adDataForm.revenue" type="number" min="0" step="0.01" class="field money-amount" placeholder="可选" /></div></form-field>
          </div>
        </div>
        <div v-if="selectedAdsPlatform==='FB'" class="rounded-2xl bg-blue-50/40 border border-blue-100 p-4 space-y-4">
          <div>
            <div class="text-xs font-extrabold text-blue-800"><i class="fa-brands fa-facebook mr-1.5"></i>Facebook 深度投放指标</div>
            <div class="text-[10px] text-slate-500 mt-1">Reach 与视频播放率录入一次；CPM、Frequency、CTR、CPC、CVR、CPA、ROAS 根据基础数据自动计算。</div>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            <form-field label="Reach 覆盖人数"><input v-model.number="adDataForm.reach" type="number" min="0" step="1" class="field" placeholder="例如 8500" /></form-field>
            <form-field label="3秒播放率 %"><input v-model.number="adDataForm.video3sRate" type="number" min="0" max="100" step="0.01" class="field" placeholder="例如 38.5" /></form-field>
            <form-field label="完播率 %"><input v-model.number="adDataForm.videoCompleteRate" type="number" min="0" max="100" step="0.01" class="field" placeholder="例如 12.8" /></form-field>
          </div>
          <div>
            <div class="text-[11px] font-semibold text-slate-500 mb-2">视频播放进度 %</div>
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
              <div><div class="text-[10px] text-slate-400 mb-1">25%</div><input v-model.number="adDataForm.video25Rate" type="number" min="0" max="100" step="0.01" class="field" placeholder="25%播放率" /></div>
              <div><div class="text-[10px] text-slate-400 mb-1">50%</div><input v-model.number="adDataForm.video50Rate" type="number" min="0" max="100" step="0.01" class="field" placeholder="50%播放率" /></div>
              <div><div class="text-[10px] text-slate-400 mb-1">75%</div><input v-model.number="adDataForm.video75Rate" type="number" min="0" max="100" step="0.01" class="field" placeholder="75%播放率" /></div>
              <div><div class="text-[10px] text-slate-400 mb-1">95%</div><input v-model.number="adDataForm.video95Rate" type="number" min="0" max="100" step="0.01" class="field" placeholder="95%播放率" /></div>
            </div>
          </div>
          <div class="grid grid-cols-2 sm:grid-cols-4 xl:grid-cols-7 gap-2">
            <div v-for="m in [{k:'cpmText',l:'CPM'},{k:'frequencyText',l:'Frequency'},{k:'ctrText',l:'CTR'},{k:'cpcText',l:'CPC'},{k:'cvrText',l:'CVR'},{k:'cpaText',l:'CPA'},{k:'roasText',l:'ROAS'}]" :key="m.k" class="rounded-xl bg-white border border-blue-100 p-3">
              <div class="text-[9px] text-slate-400">{{ m.l }} · 自动</div><div class="text-xs font-extrabold text-slate-900 mt-1">{{ adDataDraftMetrics()[m.k] }}</div>
            </div>
          </div>
        </div>
        <form-field label="数据备注"><textarea v-model.trim="adDataForm.note" rows="3" class="w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-xs outline-none focus:ring-2 focus:ring-cyan-100" placeholder="例如：8/11 日报、素材 A 放量、Lead 质量提升"></textarea></form-field>
        <div class="rounded-xl bg-emerald-50 border border-emerald-100 px-3 py-2 text-[10px] text-emerald-700 leading-relaxed"><i class="fa-solid fa-arrows-rotate mr-1.5"></i><b>只录入一次：</b>同一日期 + 广告方案 + 广告组 + 广告视为同一条数据；再次保存会自动更新原记录，不会重复累计。广告管理与投放数据分析共用这份数据。</div>
        <div class="flex justify-end gap-2 pt-2"><button type="button" @click="showAdDataModal=false" class="h-10 px-4 rounded-xl border border-slate-200 text-xs font-bold">取消</button><button type="submit" class="h-10 px-5 rounded-xl bg-cyan-600 text-white text-xs font-bold"><i class="fa-solid fa-check mr-1.5"></i>{{ editingAdDataRecordId ? '更新并同步数据' : '保存并同步数据' }}</button></div>
      </form>
    </div>
  </div>

  <!-- SOP Task Record Modal -->
  <div v-if="showSopTaskModal" class="fixed inset-0 z-[120] modal-backdrop flex items-center justify-center p-4" @click.self="showSopTaskModal=false">
    <div class="w-full max-w-2xl bg-white rounded-3xl soft-shadow overflow-hidden">
      <div class="p-5 border-b border-slate-100 flex items-start justify-between gap-4">
        <div>
          <div class="text-[10px] font-bold tracking-[.16em] text-indigo-500">SOP TASK</div>
          <h3 class="font-extrabold mt-1">{{ sopTaskForm.id ? '修改任务' : '记录任务' }}</h3>
          <p class="text-[11px] text-slate-400 mt-1">{{ selectedSopClient?.name }} · {{ selectedSopAccount?.platformName }} · {{ selectedSopAccount?.account?.accountName || selectedSopAccount?.account?.adAccountId || '未命名账号' }}</p>
        </div>
        <button type="button" @click="showSopTaskModal=false" class="w-9 h-9 rounded-xl hover:bg-slate-100 text-slate-500"><i class="fa-solid fa-xmark"></i></button>
      </div>
      <form @submit.prevent="saveSopTask" class="p-5 space-y-4">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <label class="block sm:col-span-1">
            <span class="block text-[11px] font-bold text-slate-600 mb-1.5">任务日期 *</span>
            <input v-model="sopTaskForm.date" type="date" required class="field" />
          </label>
          <div class="rounded-xl border border-indigo-100 bg-indigo-50/60 px-3 py-2.5 flex items-center gap-3">
            <div class="w-9 h-9 rounded-xl bg-white text-indigo-600 flex items-center justify-center border border-indigo-100"><i class="fa-solid fa-user-check"></i></div>
            <div class="min-w-0"><div class="text-[9px] font-bold text-indigo-400">执行账号</div><div class="text-xs font-extrabold text-indigo-900 truncate">{{ selectedSopAccount?.account?.accountName || selectedSopAccount?.account?.adAccountId || '未命名账号' }}</div></div>
          </div>
        </div>
        <label class="block">
          <span class="block text-[11px] font-bold text-slate-600 mb-1.5">操作步骤 *</span>
          <textarea v-model.trim="sopTaskForm.text" rows="3" required class="w-full rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-xs outline-none focus:ring-2 focus:ring-indigo-100 focus:border-indigo-300" placeholder="例如：检查 Facebook 广告账户昨日消耗、余额和异常提示"></textarea>
        </label>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <label class="block">
            <span class="block text-[11px] font-bold text-slate-600 mb-1.5">计划</span>
            <input v-model.trim="sopTaskForm.plan" class="field" placeholder="例如：09:00 / 上午完成" />
          </label>
          <label class="block">
            <span class="block text-[11px] font-bold text-slate-600 mb-1.5">备注</span>
            <input v-model.trim="sopTaskForm.note" class="field" placeholder="要求、注意事项或异常处理" />
          </label>
        </div>
        <div class="rounded-xl border border-emerald-100 bg-emerald-50 px-3 py-2.5 text-[10px] text-emerald-700 leading-relaxed"><i class="fa-solid fa-circle-check mr-1.5"></i>保存成功后会自动切换到该任务日期，并立即显示在对应的执行 Checklist 中。</div>
        <div class="flex justify-end gap-2 pt-1">
          <button type="button" @click="showSopTaskModal=false" class="h-10 px-4 rounded-xl border border-slate-200 text-xs font-bold text-slate-600 hover:bg-slate-50">取消</button>
          <button type="submit" class="h-10 px-5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-bold shadow-sm"><i class="fa-solid fa-floppy-disk mr-1.5"></i>{{ sopTaskForm.id ? '保存修改' : '保存任务' }}</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Lead Modal -->
  <div v-if="showLeadModal" class="fixed inset-0 z-50 modal-backdrop flex items-center justify-center p-4">
    <div class="w-full max-w-3xl max-h-[92vh] overflow-y-auto scrollbar bg-white rounded-3xl soft-shadow">
      <div class="p-5 border-b border-slate-100 flex items-center justify-between"><div><div class="text-[10px] font-bold tracking-[.16em] text-violet-500">LEAD</div><h3 class="font-extrabold mt-1">{{ leadForm.id ? '编辑潜在客户' : '新增潜在客户' }}</h3></div><button @click="showLeadModal=false" class="w-9 h-9 rounded-xl hover:bg-slate-100" title="关闭"><i class="fa-solid fa-xmark"></i></button></div>
      <form @submit.prevent="saveLead" class="p-5 grid grid-cols-1 md:grid-cols-2 gap-4">
        <form-field label="公司 / 潜在客户名称 *"><input v-model.trim="leadForm.company" required class="field" placeholder="例如：ABC Machinery" /></form-field>
        <form-field label="联系人"><input v-model.trim="leadForm.contact" class="field" placeholder="姓名" /></form-field>
        <form-field label="联系方式"><input v-model.trim="leadForm.contactInfo" class="field" placeholder="WhatsApp / 微信 / 邮箱 / 电话" /></form-field>
        <form-field label="来源平台 / 线索来源"><select v-model="leadForm.source" class="field"><option>网站询盘</option><option>Facebook</option><option>TikTok</option><option>抖音</option><option>小红书</option><option>视频号</option><option>客户转介绍</option><option>WhatsApp</option><option>展会</option><option>主动开发</option><option>其他</option></select></form-field>
        <form-field label="意向投放平台"><select v-model="leadForm.platformInterest" class="field"><option value="FB">Facebook</option><option value="TK">TikTok</option><option value="FB+TK">Facebook + TikTok</option></select></form-field>
        <form-field label="预计月预算"><div class="money-input-group"><select v-model="leadForm.budgetCurrency" class="field money-currency"><option value="USD">USD</option><option value="CNY">CNY</option></select><input v-model.number="leadForm.expectedBudget" type="number" min="0" step="0.01" class="field money-amount" placeholder="预计预算" /></div></form-field>
        <form-field label="投放报价"><div class="money-input-group"><select v-model="leadForm.quoteCurrency" class="field money-currency"><option value="USD">USD</option><option value="CNY">CNY</option></select><input v-model.number="leadForm.adQuote" type="number" min="0" step="0.01" class="field money-amount" placeholder="对客户的投放合作报价" /></div></form-field>
        <form-field label="跟进阶段"><select v-model="leadForm.stage" class="field"><option value="NEW">新线索</option><option value="CONTACTED">已联系</option><option value="QUALIFIED">已确认需求</option><option value="PROPOSAL">报价 / 方案中</option><option value="WON">已成交</option><option value="LOST">已流失</option></select></form-field>
        <form-field label="下次跟进日期"><input v-model="leadForm.nextFollowUp" type="date" class="field" /></form-field>
        <form-field label="负责人"><input v-model.trim="leadForm.owner" class="field" placeholder="销售 / 客户经理" /></form-field>
        <div class="md:col-span-2"><div class="text-[11px] font-semibold text-slate-500 mb-1.5">跟进备注</div><textarea v-model.trim="leadForm.notes" rows="4" class="w-full rounded-xl border border-slate-200 px-3 py-2 text-xs outline-none focus:ring-2 focus:ring-violet-100" placehol