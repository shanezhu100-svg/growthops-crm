laceholder="记录开户要求、充值方式、账期、额度等"></textarea></div>
        <div class="md:col-span-2"><div class="text-[11px] font-semibold text-slate-500 mb-1.5">备注</div><textarea v-model.trim="providerForm.notes" rows="3" class="w-full rounded-xl border border-slate-200 px-3 py-2 text-xs outline-none focus:ring-2 focus:ring-blue-100" placeholder="其他合作信息"></textarea></div>
        <div class="md:col-span-2 flex items-center justify-between gap-2 pt-2"><button v-if="providerForm.id && canManageProviders()" type="button" @click="deleteOpeningProvider(providerForm)" class="h-10 px-4 rounded-xl bg-rose-50 text-rose-600 text-xs font-bold"><i class="fa-regular fa-trash-can mr-1"></i>删除开户商</button><span v-else></span><div class="flex gap-2"><button type="button" @click="showProviderModal=false" class="h-10 px-4 rounded-xl border border-slate-200 text-xs font-bold">取消</button><button type="submit" class="h-10 px-5 rounded-xl bg-blue-600 text-white text-xs font-bold"><i class="fa-solid fa-check mr-1.5"></i>保存开户商</button></div></div>
      </form>
    </div>
  </div>

  <!-- Finance Actual Rebate Modal -->

  <!-- Receivable / Income Item Modal -->
  <div v-if="showReceivableModal" class="fixed inset-0 z-[80] modal-backdrop flex items-center justify-center p-4" @click.self="showReceivableModal=false">
    <form @submit.prevent="saveReceivable" class="bg-white w-full max-w-3xl max-h-[92vh] overflow-y-auto rounded-3xl soft-shadow">
      <div class="p-5 border-b border-slate-100 flex items-center justify-between"><div><div class="text-[10px] font-bold tracking-[.16em] text-emerald-500">INCOME / ACCOUNTS RECEIVABLE</div><h3 class="font-extrabold mt-1">{{ receivableForm.id?'编辑收入项目':'新增收入项目' }}</h3><p class="text-[10px] text-slate-400 mt-1">收入项目可关联客户，也可作为公司独立收入；是否需要后续回款与收入归属相互独立。</p></div><button type="button" @click="showReceivableModal=false" class="w-9 h-9 rounded-xl hover:bg-slate-100" title="关闭"><i class="fa-solid fa-xmark"></i></button></div>
      <div class="p-5 grid grid-cols-1 md:grid-cols-2 gap-4">
        <form-field label="收入归属 *"><select v-model="receivableForm.ownerType" @change="syncReceivableOwnerType" required class="field"><option value="CLIENT">关联客户</option><option value="COMPANY">不关联客户 / 公司收入</option></select></form-field>
        <form-field label="结算月份 *"><input v-model="receivableForm.settlementMonth" @change="syncReceivableCostDate" type="month" required class="field" /></form-field>
        <form-field v-if="receivableForm.ownerType==='CLIENT'" label="关联客户 *"><select v-model="receivableForm.clientId" required class="field"><option value="">请选择客户</option><option v-for="c in clients" :key="c.id" :value="String(c.id)">{{ c.name }}{{ c.archived ? '（已归档）' : '' }}</option></select></form-field>
        <form-field v-else label="收入来源 / 付款方"><input v-model.trim="receivableForm.payerName" class="field" placeholder="例如：零售账号买家、合作方、其他付款方（可选）" /></form-field>
        <form-field label="收入项目 *"><select v-model="receivableForm.incomeType" @change="syncReceivableIncomeType" required class="field"><option value="SERVICE_FEE" :disabled="receivableForm.ownerType==='COMPANY'">投放服务费</option><option value="SHOOTING_SERVICE">拍摄服务费</option><option value="NETWORK_RECHARGE">网络 / IP / 节点代充</option><option value="ACCOUNT_SALE">账号销售</option><option value="OPENING_SERVICE">开户服务费</option><option value="OTHER">其他收入</option></select></form-field>
        <form-field label="项目名称 / 内容"><input v-model.trim="receivableForm.projectName" class="field" :placeholder="financeIncomeTypePlaceholder(receivableForm.incomeType)" /></form-field>
        <form-field label="收入金额 *"><div class="money-input-group"><select v-model="receivableForm.currency" class="field money-currency"><option>USD</option><option>CNY</option></select><input v-model.number="receivableForm.amount" type="number" min="0.01" step="0.01" required class="field money-amount" /></div></form-field>
        <template v-if="!receivableForm.id">
          <form-field label="收款状态 *"><select v-model="receivableForm.collectionMode" required class="field"><option value="RECEIVABLE">需要后续收款</option><option value="PAID">已直接收款</option></select></form-field>
          <form-field v-if="receivableForm.collectionMode==='PAID'" label="实际收款日期 *"><input v-model="receivableForm.receivedDate" type="date" required class="field" /></form-field>
          <template v-if="receivableForm.collectionMode==='PAID'">
            <form-field label="收款方式"><select v-model="receivableForm.paymentMethod" class="field"><option value="">未设置</option><option>银行转账</option><option>PayPal</option><option>Wise</option><option>Stripe</option><option>支付宝</option><option>微信</option><option>现金</option><option>其他</option></select></form-field>
            <form-field label="收款账户"><input v-model.trim="receivableForm.paymentAccount" class="field" placeholder="到账账户 / 钱包（可选）" /></form-field>
          </template>
        </template>
        <form-field v-else label="当前收款状态"><div class="field bg-slate-50 flex items-center"><span class="px-2 py-1 rounded-full text-[9px] font-extrabold" :class="financeReceivableStatusStyle(receivableForm)">{{ financeReceivableStatusText(receivableForm) }}</span><span class="ml-2 text-[10px] text-slate-400">回款请通过下方流水维护</span></div></form-field>
        <form-field v-if="receivableForm.id || receivableForm.collectionMode==='RECEIVABLE'" label="账单到期日"><input v-model="receivableForm.dueDate" type="date" class="field" /></form-field>
        <template v-if="receivableForm.incomeType!=='SERVICE_FEE'">
          <form-field label="项目直接成本"><div class="money-input-group"><div class="field money-currency flex items-center justify-center font-bold text-slate-500">{{ receivableForm.currency }}</div><input v-model.number="receivableForm.directCost" type="number" min="0" step="0.01" class="field money-amount" placeholder="0" /></div></form-field>
          <form-field label="成本发生日"><input v-model="receivableForm.directCostDate" type="date" class="field" /></form-field>
          <form-field label="供应商 / 采购方"><input v-model.trim="receivableForm.costVendor" class="field" placeholder="网络供应商、账号供应商等" /></form-field>
          <div class="rounded-xl border border-emerald-100 bg-emerald-50/60 px-3 py-2.5"><div class="text-[9px] font-bold text-emerald-600">项目差价 / 毛利</div><div class="font-black text-emerald-800 mt-1">{{ formatMoney(financeReceivableMargin(receivableForm),receivableForm.currency) }}</div><div class="text-[9px] text-emerald-700 mt-1">收入 − 项目直接成本<span v-if="Number(receivableForm.amount||0)>0"> · 毛利率 {{ financeReceivableMarginRate(receivableForm) }}</span></div></div>
          <div class="md:col-span-2 rounded-xl border border-amber-100 bg-amber-50/60 px-3 py-2.5 text-[10px] text-amber-800 leading-relaxed"><i class="fa-solid fa-link mr-1"></i><span v-if="receivableForm.ownerType==='CLIENT'">关联客户项目的直接成本会自动生成“客户专属成本”，并与收入项目绑定。</span><span v-else>不关联客户项目的直接成本会自动生成“公司项目成本”，只影响公司总利润，不进入任何客户盈利。</span> 后续修改收入项目会同步对应成本，不需要重复录入。</div>
        </template>
        <form-field label="发票状态"><select v-model="receivableForm.invoiceStatus" class="field"><option value="NONE">无需开票</option><option value="PENDING">待开票</op