div class="text-[11px] font-semibold text-slate-500 mb-1.5">主要用途</div><textarea v-model.trim="toolForm.purpose" rows="3" class="w-full rounded-xl border border-slate-200 px-3 py-2 text-xs outline-none focus:ring-2 focus:ring-emerald-100" placeholder="例如：固定环境登录、素材协作、数据归因、CRM 线索同步等"></textarea></div>
            <div class="md:col-span-2"><div class="text-[11px] font-semibold text-slate-500 mb-1.5">备注</div><textarea v-model.trim="toolForm.notes" rows="3" class="w-full rounded-xl border border-slate-200 px-3 py-2 text-xs outline-none focus:ring-2 focus:ring-emerald-100" placeholder="团队权限、使用规范或其他说明"></textarea></div>
          </div>
        </div>
        <div class="flex justify-end gap-2"><button type="button" @click="showToolModal=false" class="h-10 px-4 rounded-xl border border-slate-200 text-xs font-bold">取消</button><button type="submit" class="h-10 px-5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold transition"><i class="fa-solid fa-check mr-1.5"></i>保存投放工具</button></div>
      </form>
    </div>
  </div>

<script>
const { createApp } = Vue;

const PlatformBadges = {
  props:['platform'],
  template:`<div class="flex items-center gap-1 flex-wrap"><span v-if="platform.includes('FB')" class="inline-flex items-center px-2 py-1 rounded-lg text-[10px] font-extrabold bg-blue-50 text-blue-700 border border-blue-100"><i class="fa-brands fa-facebook mr-1"></i>FB</span><span v-if="platform.includes('TK')" class="inline-flex items-center px-2 py-1 rounded-lg text-[10px] font-extrabold bg-slate-950 text-white"><i class="fa-brands fa-tiktok mr-1"></i>TK</span></div>`
};
const InfoRow = { props:['label','value'], template:`<div class="flex items-start justify-between gap-4"><span class="text-slate-400 shrink-0">{{label}}</span><span class="font-mono font-semibold text-right break-all">{{value || '—'}}</span></div>` };
const FormField = { props:['label'], template:`<label class="block"><span class="block text-[11px] font-semibold text-slate-500 mb-1.5">{{label}}</span><slot></slot></label>` };
const AnalyticsCard = {
  props:['platform','icon','tone','data','spendText','accounts','modelValue'],
  emits:['update:modelValue'],
  computed:{
    metricList(){
      return [
        {k:'leads',l:'Leads'},
        {k:'cpl',l:'CPL'},
        {k:'impressions',l:'Impressions'},
        {k:'cpm',l:'CPM'},
        {k:'ctr',l:'CTR'},
        {k:'cpc',l:'CPC'},
        {k:'cvr',l:'CVR'},
        {k:'cpa',l:'CPA'},
        {k:'roas',l:'ROAS'}
      ];
    }
  },
  methods:{
    metricValue(key){
      if(!this.data || this.data[key]===undefined || this.data[key]===null || this.data[key]==='')return '—';
      const value=this.data[key];
      if(['cpl','cpa','cpm','cpc'].includes(key))return (typeof value==='string' && /^[¥$]/.test(value))?value:`$${value}`;
      if(['ctr','cvr','video3sRate','videoCompleteRate'].includes(key))return String(value).includes('%')?value:`${value}%`;
      return value;
    }
  },
  template:`<div class="bg-white border border-slate-200 rounded-2xl p-5 soft-shadow"><div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3"><div class="flex items-center gap-2 font-extrabold text-sm"><i :class="icon" :class="tone==='blue'?'text-blue-600':'text-slate-950'"></i>{{platform}}</div><div v-if="accounts && accounts.length" class="flex items-center gap-2"><span class="text-[10px] text-slate-400 shrink-0">广告账户</span><select :value="modelValue" @change="$emit('update:modelValue',$event.target.value)" class="h-9 min-w-[190px] max-w-full rounded-xl border border-slate-200 bg-slate-50 px-3 text-[11px] font-bold text-slate-700 outline-none focus:ring-2 focus:ring-indigo-100"><option v-for="(account,idx) in accounts" :key="account.id || idx" :value="account.id">{{ account.accountName || platform + ' 账号 ' + (idx+1) }} · {{ account.adAccountId || '未录入 ID' }}</option></select></div><span v-else-if="!data" class="text-[10px] text-slate-400">未开通</span></div><div v-if="accounts && accounts.length" class="mt-3 text-[10px] text-slate-400">切换广告账户后，CPM、CTR、CPC、CVR、CPA、ROAS 等账户效率指标会从统一广告数据自动重新计算；视频指标仍在广告数据记录表查看。</div><div v-if="data || (spendText && spendText!=='—')" class="grid grid-cols-2 sm:grid-cols-3 xl:grid-cols-4 gap-3 mt-5"><div class="p-3 rounded-xl bg-amber-50 border border-amber-100"><div class="text-[10px] text-amber-600 font-bold">广告账户消耗</div><div class="font-extrabold text-sm mt-1">{{spendText || '—'}}</div></div><div v-for="m in metricList" :key="m.k" class="p-3 rounded-xl bg-slate-50 border border-slate-100"><div class="text-[10px] text-slate-400">{{m.l}}</div><div class="font-extrabold text-sm mt-1">{{metricValue(m.k)}}</div></div></div><div v-else class="py-10 text-center text-xs text-slate-400">当前广告账户暂无投放数据</div></div>`
};

