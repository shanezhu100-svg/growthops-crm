n this.financeReconciliationStatusForScope(this.financeClientFilter==='ALL'?null:this.financeClientFilter,this.financePeriodMonths())},
    financeActualProfitLabel(){return this.financeProfitConfirmation.allLocked&&this.financeProfitConfirmation.complete?'已月结净利润':this.financeProfitConfirmation.complete?'已确认净利润':'当前净利润'},
    financeActualProfitNote(){const s=this.financeProfitConfirmation;if(s.allLocked&&s.complete)return'当前核算周期已完成月结，利润数据已锁定。';if(s.complete)return'当前范围需要返点的渠道均已完成对账，可视为已确认利润。';const parts=[];if(s.pendingReconciliations)parts.push(`${s.pendingReconciliations} 个渠道 / 币种待返点对账`);if(s.unassignedSpendTotal>0.01)parts.push(`存在未归属渠道消耗 ${this.spendGroupsText(s.unassignedSpendGroups)}`);return `${parts.join('；')||'返点数据尚未完成确认'}，当前金额不是最终已确认利润。`},
    financeReconciliationRows(){const snap=this.financeActivePeriodSnapshot;if(snap?.reconciliations){return snap.reconciliations.filter(row=>(this.financeProviderFilter==='ALL'||String(row.providerId)===String(this.financeProviderFilter))&&(this.financeReconciliationStatusFilter==='ALL'||(this.financeReconciliationStatusFilter==='PENDING'?!row.record:this.financeReconciliationStatusFilter==='CONFIRMED'?row.record&&row.record.status!=='VOID':row.record?.status==='VOID'))).sort((a,b)=>String(b.month).localeCompare(String(a.month))||String(a.providerName||'').localeCompare(String(b.providerName||''),'zh-CN'))}const rows=[];const byKey=new Map(this.financeReconciliations.map(r=>[`${r.providerId}|${r.contactId}|${r.settlementMonth}|${r.currency||'USD'}`,r]));this.financeRebateChannelOptions.forEach(opt=>{this.financePeriodMonths().forEach(month=>{const spends=this.financeChannelMonthGroups(opt.providerId,opt.contactId,month,null,'SPEND'),expected=this.financeExpectedRebateForChannelMonth(opt.providerId,opt.contactId,month);const currencies=new Set([...Object.keys(spends),...Object.keys(expected),...this.financeReconciliations.filter(r=>String(r.providerId)===String(opt.providerId)&&String(r.contactId)===String(opt.contactId)&&String(r.settlementMonth)===String(month)).map(r=>r.currency||'USD')]);currencies.forEach(currency=>{const key=`${opt.providerId}|${opt.contactId}|${month}|${currency}`,record=byKey.get(key)||null,systemSpend=Number(spends[currency]||0),expectedRebate=Number(expected[currency]||0);if(!systemSpend&&!expectedRebate&&!record)return;rows.push({key,providerId:opt.providerId,contactId:opt.contactId,providerName:opt.provider.name,contactName:opt.contact.name,month,currency,systemSpend,expectedRebate,record,spendDiff:record?Number(record.confirmedSpend||0)-systemSpend:0})})})});return rows.filter(row=>(this.financeProviderFilter==='ALL'||String(row.providerId)===String(this.financeProviderFilter))&&(this.financeReconciliationStatusFilter==='ALL'||(this.financeReconciliationStatusFilter==='PENDING'?!row.record:this.financeReconciliationStatusFilter==='CONFIRMED'?row.record&&row.record.status!=='VOID':row.record?.status==='VOID'))).sort((a,b)=>String(b.month).localeCompare(String(a.month))||a.providerName.localeCompare(b.providerName,'zh-CN'))},
    financeMonthCheck(){const snap=this.financeMonthSnapshots?.[this.financeMonthKey];return this.isMonthLocked(this.financeMonthKey)&&snap?.check?snap.check:this.getFinanceMonthCheck(this.financeMonthKey)},
    reconciliationProviderContacts(){const provider=this.openingProviders.find(p=>String(p.id)===String(this.reconciliationForm.providerId||''));return provider?.contacts||[]},
    reconciliationSelectedOption(){return this.financeRebateChannelOptions.find(o=>String(o.providerId)===String(this.reconciliationForm.providerId||'')&&String(o.contactId)===String(this.reconciliationForm.contactId||''))||null},
    reconciliationEffectivePolicy(){const c=this.reconciliationSelectedOption?.contact;return this.rebatePolicyForContact(c,this.reconciliationForm.settlementMonth?`${this.reconciliationForm.settlementMonth}-01`:this.localDateKey())||{effectiveDate:'',rebateRate:0,rebatePolicy:''}},
    reconciliationSystemSpend(){const o=this.reconciliationSelectedOption;if(!o||!this.reconciliationForm.settlementMonth)return 0;return Number(this.financeChannelMonthGroups(o.providerId,o.contactId,this.reconciliationForm.settlementMonth,null,'SPEND')[this.reconciliationForm.currency||'USD']||0)},
    reconciliationExpectedRebate(){const o=this.reconciliationSelectedOption;if(!o||!this.reconciliationForm.settlementMonth)return 0;return Number(this.financeExpectedRebateForChannelMonth(o.providerId,o.contactId,this.reconciliationForm.settlementMonth)[this.reconciliationForm.currency||'USD']||0)},
    reconciliationSystemSpendText(){return this.formatMoney(this.reconciliationSystemSpend,this.reconciliationForm.currency||'USD')},
    reconciliationExpectedRebateText(){return this.formatMoney(this.reconciliationExpectedRebate,this.reconciliationForm.currency||'USD')},
    globalSearchResults(){const q=String(this.globalSearchQuery||'').trim().toLowerCase();if(!q)return[];const results=[];this.clients.forEach(client=>{const clientFields=[client.name,client.product,client.project].filter(Boolean).map(String);if(clientFields.some(v=>v.toLowerCase().includes(q)))results.push({key:`client-${client.id}`,kind:'CLIENT',platform:'CLIENT',clientId:client.id,title:client.name||'未命名客户',subtitle:[client.project||client.product||'客户档案',client.archived?'已归档':'合作客户'].filter(Boolean).join(' · '),matchLabel:'客户',matchValue:client.name||''});(client.fbAccounts||[]).forEach((account,idx)=>{const fields=[['账号名称',account.accountName],['广告账户 ID',account.adAccountId],['BM ID',account.bmId],['登录账号',account.loginAccount]];const hit=fields.find(([,v])=>String(v||'').toLowerCase().includes(q));if(hit)results.push({key:`fb-${client.id}-${account.id||idx}`,kind:'ACCOUNT',platform:'FB',clientId:client.id,accountId:account.id,accountIndex:idx,title:account.accountName||`Facebook 账号 ${idx+1}`,subtitle:`${client.name} · Facebook`,matchLabel:hit[0],matchValue:hit[1]||''})});(client.tkAccounts||[]).forEach((account,idx)=>{const fields=[['账号名称',account.accountName],['广告账户 ID',account.adAccountId],['BC ID',account.bcId],['登录账号',account.loginAccount]];const hit=fields.find(([,v])=>String(v||'').toLowerCase().includes(q));if(hit)results.push({key:`tk-${client.id}-${account.id||idx}`,kind:'ACCOUNT',platform:'TK',clientId:client.id,accountId:account.id,accountIndex:idx,title:account.accountName||`TikTok 账号 ${idx+1}`,subtitle:`${client.name} · TikTok`,matchLabel:hit[0],matchValue:hit[1]||''})});(client.googleAccounts||[]).forEach((account,idx)=>{const fields=[['账号名称',account.accountName],['Google Ads 客户 ID',account.customerId],['MCC ID',account.mccId],['登录邮箱',account.loginAccount]];const hit=fields.find(([,v])=>String(v||'').toLowerCase().includes(q));if(hit)results.push({key:`google-${client.id}-${account.id||idx}`,kind:'ACCOUNT',platform:'GOOGLE',clientId:client.id,accountId:account.id,accountIndex:idx,title:account.accountName||`Google 账号 ${idx+1}`,subtitle:`${client.name} · Google`,matchLabel:hit[0],matchValue:hit[1]||''})});(client.instagramAccounts||[]).forEach((account,idx)=>{const fields=[['账号名称',account.accountName],['Instagram 用户名',account.username],['Instagram ID',account.profileId],['登录邮箱 / 手机',account.loginAccount]];const hit=fields.find(([,v])=>String(v||'').toLowerCase().includes(q));if(hit)results.push({key:`instagram-${client.id}-${account.id||idx}`,kind:'ACCOUNT',platform:'INSTAGRAM',clientId:client.id,accountId:account.id,accountIndex:idx,title:account.accountName||`Instagram 账号 ${idx+1}`,subtitle:`${client.name} · Instagram`,matchLabel:hit[0],matchValue:hit[1]||''})})});return results.slice(0,30)},
    filteredClients(){const q=this.searchQuery.trim().toLowerCase();return this.clients.filter(c=>{if(c.archived&&!this.showArchivedClients)return false;const fb=(c.fbAccounts||[]).flatMap(a=>[a.accountName,a.bmId,a.adAccountId,a.loginAccount]);const tk=(c.tkAccounts||[]).flatMap(a=>[a.accountName,a.bcId,a.adAccountId,a.loginAccount]);const networks=(c.networkEnvironments||[]).flatMap(e=>[e.networkName,e.ipEnvironment,e.ipDueDate]);const hay=[c.name,c.product,c.project,...fb,...tk,...networks].filter(Boolean).join(' ').toLowerCase();const mQ=!q||hay.includes(q);const mP=this.platformFilter==='ALL'||(this.platformFilter==='DUAL'?c.platform==='FB+TK':c.platform.includes(this.platformFilter));return mQ&&mP})},
    selectedClient(){return this.clients.find(c=>c.id===this.selectedClientId)||null},
    selectedAssetsClient(){return this.clients.find(c=>c.id===this.selectedAssetsClientId)||this.clients[0]||null},
    selectedSopClient(){return this.clients.find(c=>!c.archived&&String(c.id)===String(this.selectedSopClientId))||null},
    selectedSopAccounts(){const c=this.selectedSopClient;if(!c)return[];return[...(c.fbAccounts||[]).map(a=>({key:`FB:${a.id}`,platform:'FB',platformName:'Facebook',account:a})),...(c.tkAccounts||[]).map(a=>({key:`TK:${a.id}`,platform:'TK',platformName:'TikTok',account:a}))]},
    selectedSopAccount(){return this.selectedSopAccounts.find(item=>item.key===this.selectedSopAccountKey)||null},
    selectedSopConfig(){const c=this.selectedSopClient,key=this.selectedSopAccount?.key;if(!c||!key)return{dailyPlan:'',notes:'',steps:[]};c.sopAccountConfigs=c.sopAccountConfigs&&typeof c.sopAccountConfigs==='object'?c.sopAccountConfigs:{};return c.sopAccountConfigs[key]||{dailyPlan:'',notes:'',steps:[]}},
    selectedSopSteps(){const cfg=this.selectedSopConfig;if(!cfg||!this.selectedSopDate)return[];return Array.isArray(cfg.dailyTasks?.[this.selectedSopDate])?cfg.dailyTasks[this.selectedSopDate]:[]},
    sopSelectedDateBadge(){const date=this.selectedSopDate||this.localDateKey();const today=this.localDateKey();if(date===today)return'今天';const d=new Date(`${date}T12:00:00`),t=new Date(`${today}T12:00:00`);const diff=Math.round((d-t)/86400000);if(diff===-1)return'昨天';if(diff===1)return'明天';return date},
    sopChecklistTitle(){const badge=this.sopSelectedDateBadge;return badge==='今天'?'今日执行 Checklist':badge==='昨天'?'昨日任务 Checklist':badge==='明天'?'明日任务 Checklist':`${badge} Checklist`},
    selectedAnalyticsClient(){if(Number(this.selectedAnalyticsClientId)===0)return null;return this.clients.find(c=>c.id===this.selectedAnalyticsClientId)||null},
    selectedAnalyticsFbAccount(){const list=this.selectedAnalyticsClient?.fbAccounts||[];return list.find(a=>String(a.id)===String(this.selectedAnalyticsFbAccountId))||list[0]||null},
    selectedAnalyticsTkAccount(){const list=this.selectedAnalyticsClient?.tkAccounts||[];return list.find(a=>String(a.id)===String(this.selectedAnalyticsTkAccountId))||list[0]||null},
    selectedAnalyticsFbMetrics(){return this.analyticsMetricsForAccount(this.selectedAnalyticsFbAccount,'FB')},
    selectedAnalyticsTkMetrics(){return this.analyticsMetricsForAccount(this.selectedAnalyticsTkAccount,'TK')},
    analyticsAllFbAccounts(){return this.activeClients.flatMap(c=>c.fbAccounts||[])},
    analyticsAllTkAccounts(){return this.activeClients.flatMap(c=>c.tkAccounts||[])},
    analyticsAllFbAccountCount(){return this.analyticsAllFbAccounts.length},
    analyticsAllTkAccountCount(){return this.analyticsAllTkAccounts.length},
    analyticsAllFbSpendText(){return this.spendGroupsText(this.spendGroups(this.analyticsAllFbAccounts))},
    analyticsAllTkSpendText(){return this.spendGroupsText(this.spendGroups(this.analyticsAllTkAccounts))},
    analyticsAllSpendText(){return this.spendGroupsText(this.spendGroups([...this.analyticsAllFbAccounts,...this.analyticsAllTkAccounts]))},
    analyticsAllRechargeText(){return this.spendGroupsText(this.rechargeGroups([...this.analyticsAllFbAccounts,...this.analyticsAllTkAccounts]))},
    analyticsAllFbMetrics(){return this.aggregateAccountsMetrics(this.analyticsAllFbAccounts)},
    analyticsAllTkMetrics(){return this.aggregateAccountsMetrics(this.analyticsAllTkAccounts)},
    analyticsAllClientRows(){return this.activeClients.map(c=>{const accounts=[...(c.fbAccounts||[]),...(c.tkAccounts||[])];return{client:c,fbAccounts:(c.fbAccounts||[]).length,tkAccounts:(c.tkAccounts||[]).length,spendText:this.clientSpendText(c),rechargeText:this.clientRechargeText(c),records:accounts.reduce((n,a)=>n+(a.adDataRecords||[]).length,0)}}).sort((a,b)=>b.records-a.records||String(a.client.name).localeCompare(String(b.client.name),'zh-CN'))},
    selectedAdsClient(){if(Number(this.selectedAdsClientId)===0)return null;return this.clients.find(c=>c.id===this.selectedAdsClientId)||null},
    selectedAdsAccounts(){const c=this.selectedAdsClient;if(!c)return[];return this.selectedAdsPlatform==='FB'?(c.fbAccounts||[]):(c.tkAccounts||[])},
    selectedAdsAccount(){return this.selectedAdsAccounts.find(a=>a.id===this.selectedAdsAccountId)||this.selectedAdsAccounts[0]||null},
    adsCampaignsForAccount(){const c=this.selectedAdsClient,a=this.selectedAdsAccount;if(!c||!a)return[];return (c.adCampaigns||[]).filter(x=>x.platform===this.selectedAdsPlatform&&x.accountId===a.id)},
    savedAdsCampaignsForAccount(){return this.adsCampaignsForAccount.filter(c=>c.isSaved!==false)},
    draftAdsCampaignsForAccount(){return this.adsCampaignsForAccount.filter(c=>c.isSaved===false)},
    accountAdDataRecords(){return [...(this.selectedAdsAccount?.adDataRecords||[])].sort((a,b)=>String(b.date||'').localeCompare(String(a.date||''))||String(b.createdAt||'').localeCompare(String(a.createdAt||'')))},
    adsAllClientRows(){return this.activeClients.map(c=>{const accounts=[...(c.fbAccounts||[]),...(c.tkAccounts||[])];return{client:c,fbAccounts:(c.fbAccounts||[]).length,tkAccounts:(c.tkAccounts||[]).length,savedPlans:(c.adCampaigns||[]).filter(x=>x.isSaved!==false).length,records:accounts.reduce((n,a)=>n+(a.adDataRecords||[]).length,0),spendText:this.clientSpendText(c),rechargeText:this.clientRechargeText(c)}}).sort((a,b)=>b.records-a.records||b.savedPlans-a.savedPlans||String(a.client.name).localeCompare(String(b.client.name),'zh-CN'))},
    adsAllAccountCount(){return this.adsAllClientRows.reduce((n,r)=>n+r.fbAccounts+r.tkAccounts,0)},
    adsAllSavedPlanCount(){return this.adsAllClientRows.reduce((n,r)=>n+r.savedPlans,0)},
    adsAllDataRecordCount(){return this.adsAllClientRows.reduce((n,r)=>n+r.records,0)},
    adDataAdSets(){const c=this.savedAdsCampaignsForAccount.find(c=>c.id===this.adDataForm.campaignId);return c?.adSets||[]},
    adDataAds(){const a=this.adDataAdSets.find(a=>a.id===this.adDataForm.adSetId);return a?.ads||[]},
    filteredLeads(){const q=this.leadSearch.trim().toLowerCase(),mode=this.leadPoolFilter||'ACTIVE',quick=mode==='ACTIVE'?(this.leadQuickFilter||'ALL'):'ALL',today=this.localDateKey();const matchesPool=l=>{const converted=!!l.convertedClientId;if(mode==='WON')return converted||l.stage==='WON';if(mode==='LOST')return !converted&&l.stage==='LOST';if(mode==='HISTORY')return converted||['WON','LOST'].includes(l.stage);return !converted&&!['WON','LOST'].includes(l.stage)};const matchesQuick=l=>{if(quick==='DUE')return !!l.nextFollowUp&&String(l.nextFollowUp)<=today;if(quick==='HIGH')return ['QUALIFIED','PROPOSAL'].includes(l.stage);return true};const rows=this.leads.filter(l=>{const hay=[l.company,l.contact,l.contactInfo,l.source,l.owner,l.notes].filter(Boolean).join(' ').toLowerCase();return(!q||hay.includes(q))&&matchesPool(l)&&matchesQuick(l)});return rows.sort((a,b)=>mode==='ACTIVE'?String(a.nextFollowUp||'9999').localeCompare(String(b.nextFollowUp||'9999')):String(b.convertedAt||b.createdAt||'').localeCompare(String(a.convertedAt||a.createdAt||'')))},
    leadStats(){const today=this.localDateKey(),active=this.leads.filter(l=>!l.convertedClientId&&!['WON','LOST'].includes(l.stage));return{total:ac