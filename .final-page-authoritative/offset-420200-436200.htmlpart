,base=[{key:'ALL',label:'全部',count:this.alertList.length},{key:'CONTRACT',label:this.reminderTypeLabel('CONTRACT'),count:cnt('CONTRACT')},{key:'IP',label:this.reminderTypeLabel('IP'),count:cnt('IP')},{key:'RECEIVABLE',label:'应收回款',count:cnt('RECEIVABLE')},{key:'AD_RECHARGE',label:'广告余额',count:cnt('AD_RECHARGE')}],custom=this.reminderTypeOptions.filter(t=>!t.system&&cnt(t.key)>0).map(t=>({key:t.key,label:t.name,count:cnt(t.key)}));return[...base,...custom]},
    activeDismissedAlertCount(){const keys=new Set();this.clients.filter(c=>!c.archived).forEach(c=>{const contractStage=this.autoDueReminderStage(c.endDate);if(c.endDate&&contractStage)keys.add(`${'CONTRACT'}-${c.id}|${c.endDate}|${contractStage.reminderIndex}`);(c.networkEnvironments||[]).forEach(env=>{const stage=this.autoDueReminderStage(env.ipDueDate);if(env.ipDueDate&&stage)keys.add(`IP-${c.id}-${env.id}|${env.ipDueDate}|${stage.reminderIndex}`)})});this.financeReceivables.filter(r=>this.financeReceivableUnpaid(r)>0&&r.dueDate).forEach(r=>{const stage=this.autoDueReminderStage(r.dueDate);if(stage)keys.add(`RECEIVABLE-${r.id}|${r.dueDate}|${stage.reminderIndex}`)});return(this.dismissedAlerts||[]).filter(x=>keys.has(String(x.key))).length},
    analyticsAdvice(){const fb=this.selectedAnalyticsFbMetrics,tk=this.selectedAnalyticsTkMetrics;const fbRoas=Number.parseFloat(fb?.roas)||0,tkRoas=Number.parseFloat(tk?.roas)||0;if(fbRoas&&tkRoas){if(Math.abs(fbRoas-tkRoas)<0.01)return`当前选择的 Facebook 与 TikTok 广告账户 ROAS 接近，可暂时保持预算结构，把优化重点放在素材胜率和落地页转化。`;const better=fbRoas>tkRoas?'Facebook':'TikTok';const weak=better==='Facebook'?'TikTok':'Facebook';return`当前选择的 ${better} 广告账户 ROAS 更高。建议优先把新增测试预算放在 ${better}，同时保留 ${weak} 基础预算用于素材验证；建议结合 7–14 天数据稳定性复核。`}if(fbRoas)return`当前选择的 Facebook 广告账户 ROAS 为 ${fbRoas}。优先优化低成本受众包与高质量 Lead 回传，再决定是否扩量。`;if(tkRoas)return`当前选择的 TikTok 广告账户 ROAS 为 ${tkRoas}。建议提高素材迭代频率，并按前 3 秒留存与点击率筛选下一轮素材。`;return'当前选择的广告账户暂无足够 ROAS 数据用于分析。'},
    roasBars(){const fb=Number.parseFloat(this.selectedAnalyticsFbMetrics?.roas)||0,tk=Number.parseFloat(this.selectedAnalyticsTkMetrics?.roas)||0,max=Math.max(fb,tk,1);return[{name:'Facebook',value:fb,width:Math.round(fb/max*100),className:'bg-blue-600'},{name:'TikTok',value:tk,width:Math.round(tk/max*100),className:'bg-slate-950'}]}
  },
  methods:{
    openFirstGlobalSearchResult(){const first=this.globalSearchResults[0];if(first)this.openGlobalSearchResult(first)},
    globalSearchResultIcon(result){if(result?.kind==='CLIENT')return'fa-solid fa-building';if(result?.platform==='FB')return'fa-brands fa-facebook';if(result?.platform==='TK')return'fa-brands fa-tiktok';if(result?.platform==='GOOGLE')return'fa-brands fa-google';if(result?.platform==='INSTAGRAM')return'fa-brands fa-instagram';return'fa-solid fa-user'},
    globalSearchResultIconClass(result){if(result?.kind==='CLIENT')return'bg-slate-100 text-slate-600';if(result?.platform==='FB')return'bg-blue-50 text-blue-600';if(result?.platform==='TK')return'bg-slate-950 text-white';if(result?.platform==='GOOGLE')return'bg-red-50 text-red-500';if(result?.platform==='INSTAGRAM')return'bg-fuchsia-50 text-fuchsia-600';return'bg-slate-100 text-slate-600'},
    openGlobalSearchResult(result){if(!result)return;this.globalSearchOpen=false;this.globalSearchQuery='';this.selectedAssetsClientId=result.clientId;this.navigateTo('assets');if(result.kind==='ACCOUNT'){this.$nextTick(()=>{const platform=result.platform||'FB',client=this.selectedAssetsClient;if(!client)return;const key=platform==='FB'?'fbAccounts':platform==='TK'?'tkAccounts':platform==='GOOGLE'?'googleAccounts':'instagramAccounts',list=client[key]||[],idx=result.accountId?list.findIndex(a=>String(a.id)===String(result.accountId)):Number(result.accountIndex||0);this.setAssetPagerIndex('assets',platform,idx>=0?idx:0,list.length)})}},
    excelLibraryReady(){if(window.XLSX&&window.XLSX.utils)return true;this.notify('Excel 导出组件加载失败，请检查网络后刷新页面');return false},
    excelSafeFilePart(value){return String(value||'全部').replace(/[\\/:*?"<>|]+/g,'-').replace(/\s+/g,'_').slice(0,60)},
    excelSetColumnWidths(ws,widths=[]){if(!ws)return;ws['!cols']=widths.map(w=>({wch:w}))},
    excelAppendJsonSheet(wb,name,rows,widths=[]){const safeRows=Array.isArray(rows)&&rows.length?rows:[{提示:'当前筛选范围暂无数据'}];const ws=XLSX.utils.json_to_sheet(safeRows);this.excelSetColumnWidths(ws,widths);XLSX.utils.book_append_sheet(wb,ws,name.slice(0,31));return ws},
    exportFinanceExcel(){
      if(!this.canManageFinance()){this.notify('当前角色没有财务导出权限');return}if(!this.excelLibraryReady())return;
      const wb=XLSX.utils.book_new(),period=this.financePeriodLabel,clientName=this.financeClientFilter==='ALL'?'全部客户':(this.clients.find(c=>String(c.id)===String(this.financeClientFilter))?.name||'指定客户'),providerName=this.financeProviderFilter==='ALL'?'全部开户商':(this.openingProviders.find(p=>String(p.id)===String(this.financeProviderFilter))?.name||'指定开户商');
      const allGroups=[this.financeTotals.spend,this.financeTotals.expected,this.financeTotals.actual,this.financeReceivableTotals.expected,this.financeReceivableTotals.paid,this.financeReceivableTotals.unpaid,this.financeCostGroups,this.financeExpectedNetProfitGroups,this.financeActualNetProfitGroups];
      const currencies=[...new Set(allGroups.flatMap(g=>Object.keys(g||{})))];if(!currencies.length)currencies.push('USD');
      const summary=[];currencies.forEach(cur=>summary.push({'统计周期':period,'客户筛选':clientName,'币种':cur,'本期收入':Number(this.financeReceivableTotals.expected[cur]||0),'账单已收':Number(this.financeReceivableTotals.paid[cur]||0),'本期实际到账':Number(this.financeCashReceivedGroups[cur]||0),'待收款':Number(this.financeReceivableTotals.unpaid[cur]||0),'广告总消耗':Number(this.financeTotalAdSpendGroups[cur]||0),'已归属渠道消耗':Number(this.financeAttributedSpendGroups[cur]||0),'未归属消耗':Number(this.financeUnassignedSpendGroups[cur]||0),'无返点/客户自有账户消耗':Number(this.financeNoRebateSpendGroups[cur]||0),'预计返点':Number(this.financeTotals.expected[cur]||0),'实际返点':Number(this.financeTotals.actual[cur]||0),'本期总成本/客户归属成本':Number(this.financeCostGroups[cur]||0),'预计净利润':Number(this.financeExpectedNetProfitGroups[cur]||0),'当前/已确认净利润':Number(this.financeActualNetProfitGroups[cur]||0),'利润确认状态':this.financeActualProfitLabel}));
      this.excelAppendJsonSheet(wb,'财务汇总',summary,[16,18,18,10,14,14,14,14,14,14,14,14,14]);
      const profitRows=[];this.financeRows.forEach(row=>{const curs=[...new Set([row.receivableGroups,row.paidGroups,row.spendGroups,row.expectedRebateGroups,row.actualRebateGroups,row.costGroups,row.expectedNetProfitGroups,row.actualNetProfitGroups].flatMap(g=>Object.keys(g||{})))];(curs.length?curs:['USD']).forEach(cur=>profitRows.push({'客户':row.client.name,'项目':row.client.project||row.client.product||'','币种':cur,'账单数量':row.receivableCount,'客户关联收入':Number(row.receivableGroups[cur]||0),'已收款':Number(row.paidGroups[cur]||0),'广告消耗':Number(row.spendGroups[cur]||0),'预计返点':Number(row.expectedRebateGroups[cur]||0),'实际返点归集':Number(row.actualRebateGroups[cur]||0),'归属成本':Number(row.costGroups[cur]||0),'预计净利润':Number(row.expectedNetProfitGroups[cur]||0),'当前/已确认净利润':Number(row.actualNetProfitGroups[cur]||0),'利润确认状态':row.actualProfitLabel,'开户商/对接人':(row.channelLabels||[]).join('；')}))});
      this.excelAppendJsonSheet(wb,'客户盈利明细',profitRows,[24,24,10,10,14,14,14,14,14,14,14,14,38]);
      const receivableRows=this.financeVisibleReceivables.map(r=>{const amount=Number(r.amount||0),paid=this.financeReceivablePaid(r);return{'收入归属':r.ownerType==='COMPANY'?'公司收入':'关联客户','客户/收入来源':this.financeReceivableClientName(r),'结算月份':r.settlementMonth||'','收入项目':this.financeIncomeTypeText(r.incomeType),'项目内容':r.projectName||'','到期日期':r.dueDate||'','币种':r.currency||'USD','收入金额':amount,'项目直接成本':Number(r.directCost||0),'项目差价':this.financeReceivableMargin(r),'项目毛利率':this.financeReceivableMarginRate(r),'已收金额':paid,'未收金额':Math.max(0,amount-paid),'收款状态':this.financeReceivableStatusText(r),'开票状态':r.invoiceStatus==='ISSUED'?'已开票':r.invoiceStatus==='NONE'?'无需开票':'待开票','发票编号':r.invoiceNo||'','回款笔数':(r.payments||[]).length,'备注':r.note||''}});
      this.excelAppendJsonSheet(wb,'应收回款',receivableRows,[24,12,12,10,14,14,14,14,12,18,10,30]);
      const paymentRows=[];this.financeVisibleReceivables.forEach(r=>(r.payments||[]).forEach(p=>paymentRows.push({'收入归属':r.ownerType==='COMPANY'?'公司收入':'关联客户','客户/收入来源':this.financeReceivableClientName(r),'结算月份':r.settlementMonth||'','到账日期':p.date||'','币种':r.currency||'USD','到账金额':Number(p.amount||0),'收款方式':p.method||'','收款账户':p.account||'','备注':p.note||''})));
      this.excelAppendJsonSheet(wb,'回款流水',paymentRows,[24,12,12,10,14,16,22,30]);
      const costRows=this.financeVisibleCosts.map(c=>({'日期':c.date||'','成本类型':this.financeCostCategoryText(c.category),'成本归属':this.financeCostScopeText(c),'关联客户':this.financeCostClientName(c),'供应商/收款方':c.vendor||'','币种':c.currency||'USD','原始金额':Number(c.amount||0),'当前筛选归属金额':this.financeClientFilter==='ALL'?Number(c.amount||0):Number(this.financeCostAllocatedAmountForClient(c,this.clients.find(x=>String(x.id)===String(this.financeClientFilter)))||0),'备注':c.note||''}));
      this.excelAppendJsonSheet(wb,'成本支出',costRows,[12,16,14,24,24,10,14,30]);
      const reconRows=this.financeReconciliationRows.filter(r=>this.financeProviderFilter==='ALL'||String(r.providerId)===String(this.financeProviderFilter)).map(r=>{const active=!!r.record&&r.record.status!=='VOID';return{'月份':r.month,'开户商':r.providerName,'对接人':r.contactName,'币种':r.currency,'系统广告消耗':Number(r.systemSpend||0),'代理商确认消耗':active?Number(r.record.confirmedSpend||0):null,'消耗差额':active?Number(r.spendDiff||0):null,'预计返点':Number(r.expectedRebate||0),'实际返点':active?Number(r.record.actualRebate||0):0,'状态':r.record?.status==='VOID'?'已撤销':(r.record?'已对账':'待对账'),'确认日期':r.record?.confirmedDate||'','备注':r.record?.note||''}});
      this.excelAppendJsonSheet(wb,'代理商返点对账',reconRows,[12,18,18,10,16,16,14,14,14,12,12,30]);
      const filename=`财务核算_${this.excelSafeFilePart(period)}_${this.excelSafeFilePart(clientName)}.xlsx`;XLSX.writeFile(wb,filename,{compression:true});this.logAudit('导出财务 Excel',`${period} · ${clientName} · 返点对账筛选 ${providerName}`);this.notify('财务 Excel 已生成并开始下载')
    },
    exportRebateExcel(){
      if(!this.canManageProviders()){this.notify('当前角色没有返点导出权限');return}if(!this.excelLibraryReady())return;
      const wb=XLSX.utils.book_new(),period=this.openingSpendPeriodLabel,providerFilterName=this.openingSelectedProviderName,months=this.openingSpendPeriod==='MONTH'?[this.openingMonthKey]:this.openingSpendPeriod==='QUARTER'?(()=>{const start=(Number(this.openingQuarter)-1)*3+1;return[0,1,2].map(i=>`${this.openingQuarterYear}-${String(start+i).padStart(2,'0')}`)})():Array.from({length:12},(_,i)=>`${this.openingYear}-${String(i+1).padStart(2,'0')}`);
      const providers=this.openingProviderFilter==='ALL'?this.openingProviders:this.openingProviders.filter(p=>String(p.id)===String(this.openingProviderFilter));
      const summary=[];providers.forEach(provider=>(provider.contacts||[]).forEach(contact=>{const deals=this.openingDeals.filter(d=>String(d.providerId)===String(provider.id)&&String(d.contactId||'')===String(contact.id)),fin=this.openingDealsFinancialsForPeriod(deals,this.openingSpendPeriod),actual={};this.financeReconciliations.filter(r=>r.status!=='VOID'&&String(r.providerId)===String(provider.id)&&String(r.contactId||'')===String(contact.id)&&months.includes(String(r.settlementMonth||''))).forEach(r=>{const cur=r.currency||'USD';actual[cur]=(actual[cur]||0)+Number(r.actualRebate||0)});const curs=[...new Set([...Object.keys(fin.spendGroups||{}),...Object.keys(fin.rebateGroups||{}),...Object.keys(actual)])];(curs.length?curs:['USD']).forEach(cur=>summary.push({'统计周期':period,'开户商':provider.name,'对接人':contact.name,'当前返点比例%':Number(this.contactCurrentRebateRate(contact)||0),'当前返点政策':this.rebatePolicyForContact(contact,this.localDateKey())?.rebatePolicy||'','币种':cur,'关联开户记录':deals.length,'广告消耗':Number(fin.spendGroups[cur]||0),'预计返点':Number(fin.rebateGroups[cur]||0),'实际返点':Number(actual[cur]||0),'返点差额':Number(actual[cur]||0)-Number(fin.rebateGroups[cur]||0)}))}));
      this.excelAppendJsonSheet(wb,'返点汇总',summary,[14,18,18,12,34,10,14,16,14,14,14]);
      const dealRows=[];this.filteredOpeningDeals.forEach(deal=>{const fin=this.openingDealsFinancialsForPeriod([deal],this.openingSpendPeriod),spends=fin.spendGroups||{},rebates=fin.rebateGroups||{},curs=[...new Set([...Object.keys(spends),...Object.keys(rebates)])];(curs.length?curs:['USD']).forEach(cur=>dealRows.push({'客户':this.openingClientName(deal),'平台':deal.platform==='FB'?'Facebook':'TikTok','开户商':this.openingProviderName(deal),'对接人':this.openingContactName(deal),'返点政策口径':'按广告日期匹配历史生效政策','统计周期':period,'币种':cur,'广告消耗':Number(spends[cur]||0),'预计返点':Number(rebates[cur]||0),'开户状态':this.openingStatusText(deal.status),'开户类型':deal.accountType||'标准广告账户','地区':deal.region||this.openingProvider(deal)?.region||'','BM/BC ID':deal.businessId||'','广告账户 ID':deal.accountScope==='ALL'?'当前平台全部账户':(deal.adAccountIds||''),'账户匹配':this.openingDealAccountMatchText(deal),'生效日期':this.openingDealEffectiveStart(deal)||'','结束日期':deal.effectiveEndDate||'','提交日期':deal.submitDate||'','备注':deal.notes||''}}))});
      this.excelAppendJsonSheet(wb,'客户开户返点明细',dealRows,[24,12,18,18,12,14,10,16,14,14,18,16,20,26,34,12,12,12,30]);
      const contactRows=[];providers.forEach(provider=>(provider.contacts||[]).forEach(contact=>contactRows.push({'开户商':provider.name,'对接人':contact.name,'当前返点比例%':Number(this.contactCurrentRebateRate(contact)||0),'当前返点政策':this.rebatePolicyForContact(contact,this.localDateKey())?.rebatePolicy||'','手机/WhatsApp':contact.phone||contact.whatsapp||'','微信':contact.wechat||'','邮箱':contact.email||''})));
      this.excelAppendJsonSheet(wb,'对接人返点政策',contactRows,[18,18,14,40,20,18,28]);const policyHistory=[];providers.forEach(provider=>(provider.contacts||[]).forEach(contact=>(contact.rebatePolicies||[]).forEach(policy=>policyHistory.push({'开户商':provider.name,'对接人':contact.name,'生效日期':policy.effectiveDate||'','返点比例%':Number(policy.rebateRate||0),'政策说明':policy.rebatePolicy||''}))));this.excelAppendJsonSheet(wb,'返点政策历史',policyHistory,[18,18,14,14,44]);
      const reconRows=this.financeReconciliations