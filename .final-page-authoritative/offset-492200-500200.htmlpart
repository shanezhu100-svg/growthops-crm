nth);changed++}});return changed},
    financeSnapshotClientRow(id,row){const client=this.clients.find(c=>String(c.id)===String(id))||{id,name:row.clientName||'历史客户',archived:true},paidGroups=this.financePaidGroupsForClient(client);return{client,deals:[],activeMonths:0,receivableRows:[],receivableCount:Number(row.receivableCount||0),receivableGroups:{...(row.receivableGroups||{})},paidGroups,serviceFeeGroups:{...(row.serviceFeeGroups||{})},spendGroups:{...(row.spendGroups||{})},expectedRebateGroups:{...(row.expectedRebateGroups||{})},actualRebateGroups:{...(row.actualRebateGroups||{})},costGroups:{...(row.costGroups||{})},expectedNetProfitGroups:{...(row.expectedNetProfitGroups||{})},actualNetProfitGroups:{...(row.actualNetProfitGroups||{})},channelLabels:[],actualEntryCount:0,actualProfitConfirmed:true,actualProfitLabel:'已月结',pendingRebateCount:0}},
    ensureFinanceSnapshotsForLocks(){let changed=0;Object.keys(this.financeMonthLocks||{}).forEach(month=>{if(this.financeMonthLocks[month]&&!this.financeMonthSnapshots?.[month]){this.financeMonthSnapshots[month]=this.buildFinanceMonthSnapshot(month);changed++}});return changed},
    runFinanceMonthCheck(month,show=true){this.ensureAutomaticAssetCosts({month,silent:true});this.persist();const check=this.getFinanceMonthCheck(month);if(show)this.notify(check.issues.length?`月结检查未通过：${check.issues.join('；')}`:`${month} 月结检查通过，可以完成月结`);return check},
    defaultCostForm(){return{id:null,date:this.localDateKey(),category:'IP',scope:'COMPANY',clientId:'',currency:'USD',amount:'',vendor:'',note:''}},
    normalizeFinanceCost(cost){const c=JSON.parse(JSON.stringify(cost||{}));if(c.scope==='ALLOCATE')c.scope='ALLOCATE_SERVICE';c.scope=['COMPANY','COMPANY_PROJECT','CLIENT','ALLOCATE_SERVICE','ALLOCATE_SPEND'].includes(c.scope)?c.scope:(c.clientId?'CLIENT':'COMPANY');if(c.scope!=='CLIENT')c.clientId='';c.amount=Number(c.amount||0);c.sourceType=c.sourceType||'';c.sourceId=c.sourceId||'';c.autoGenerated=!!c.autoGenerated;return c},
    openCostModal(cost=null){if(cost?.autoGenerated){this.notify(cost.sourceType==='OPENING_DEAL'?'该成本由开户渠道自动生成，请到「开户商渠道」修改开户费或状态':cost.sourceType==='RECEIVABLE_ITEM'?'该成本由“收入项目”自动生成，请到「收入 / 应收 / 回款」修改项目直接成本':'该成本由客户网络环境自动生成，请到客户资料修改 IP 月费或关闭自动计入成本');return}this.costForm=cost?this.normalizeFinanceCost(cost):this.defaultCostForm();this.showCostModal=true},
    financeCostCategoryText(v){return({IP:'IP / 网络',TOOL:'投放工具',STAFF:'人员',CREATIVE:'素材 / 设计',SERVER:'服务器 / 建站',OUTSOURCE:'外包',OPENING:'开户费用',ACCOUNT_PURCHASE:'账号采购',OTHER:'其他'})[v]||v},
    financeCostClientName(c){return c.clientId?(this.clients.find(x=>String(x.id)===String(c.clientId))?.name||'客户已归档 / 删除'):'—'},
    financeCostScopeText(c){if(c?.sourceType==='RECEIVABLE_ITEM')return(c.scope==='COMPANY_PROJECT'?'收入项目联动 · 公司项目':'收入项目联动 · 客户专属');const scope=c.scope||(c.clientId?'CLIENT':'COMPANY');return scope==='CLIENT'?'手动归属客户':scope==='COMPANY_PROJECT'?'公司项目成本':scope==='ALLOCATE_SERVICE'?'按投放服务费比例分摊':scope==='ALLOCATE_SPEND'?'按广告消耗比例分摊':'公司公共成本 · 不分摊'},
    financeCostAllocatedAmountForClient(cost,client){if(!cost||!client)return 0;const scope=cost.scope||(cost.clientId?'CLIENT':'COMPANY'),cur=cost.currency||'USD',amount=Number(cost.amount||0),month=String(cost.date||'').slice(0,7);if(scope==='CLIENT')return String(cost.clientId)===String(client.id)?amount:0;if(scope==='COMPANY')return 0;if(scope==='ALLOCATE_SERVICE'){const total=this.clients.reduce((sum,c)=>sum+Number(this.financeServiceFeeReceivableGroupsForClientMonth(c,month)[cur]||0),0),mine=Number(this.financeServiceFeeReceivableGroupsForClientMonth(client,month)[cur]||0);return total>0?amount*(mine/total):0}if(scope==='ALLOCATE_SPEND'){const total=this.clients.reduce((sum,c)=>sum+Number(this.financeAdSpendGroups(c.id,[month],'ALL')[cur]||0),0),mine=Number(this.financeAdSpendGroups(client.id,[month],'ALL')[cur]||0);return total>0?amount*(mine/total):0}return 0},
    financeCostAllocatedTotal(cost){if(!cost)return 0;const scope=cost.scope||(cost.clientId?'CLIENT':'COMPANY');if(scope==='CLIENT')return Number(cost.amount||0);return this.clients.reduce((sum,client)=>sum+Number(this.financeCostAllocatedAmountForClient(cost,client)||0),0)},
    financeCostUnallocatedAmount(cost){if(!cost)return 0;const scope=cost.scope||(cost.clientId?'CLIENT':'COMPANY');if(scope==='CLIENT'||scope==='COMPANY_PROJECT')return 0;return Math.max(0,Number(cost.amount||0)-this.financeCostAllocatedTotal(cost))},
    financeClientCostGroups(client){const out={};this.financeCosts.filter(c=>this.financeDateMatch(c.date)).forEach(cost=>{const allocated=this.financeCostAllocatedAmountForClient(cost,client);if(Math.abs(allocated)>0.000001){const cur=cost.currency||'USD';out[cur]=(out[cur]||0)+allocated}});return out},
    financeVisibleCostAllocatedText(cost){if(this.financeClientFilter==='ALL')return this.formatMoney(cost.amount,cost.currency);const client=this.clients.find(c=>String(c.id)===String(this.financeClientFilter));return this.formatMoney(this.financeCostAllocatedAmountForClient(cost,client),cost.currency)},
    syncFinancePeriodAutoCosts(){if(!this.financePeriodMonths)return;this.$nextTick?.(()=>{let changed=0;(this.financePeriodMonths()||[]).forEach(month=>changed+=this.ensureAutomaticAssetCosts({month,silent:true}));if(changed)this.persist()})},
    saveFinanceCost(){const f=this.normalizeFinanceCost({...this.costForm,amount:Number(this.costForm.amount||0)});if(!f.date||f.amount<0){this.notify('请输入有效成本');return}if(f.scope==='CLIENT'&&!f.clientId){this.notify('客户专属成本必须选择客户');return}if(!this.assertMonthUnlocked(String(f.date).slice(0,7),'保存成本'))return;const editing=!!f.id;if(f.id){const i=this.financeCosts.findIndex(x=>x.id===f.id);if(i>=0)this.financeCosts[i]=f}else this.financeCosts.unshift({...f,id:this.accountUid('cost')});this.persist();this.showCostModal=false;this.logAudit(editing?'修改成本':'新增成本',`${this.financeCostCategoryText(f.category)} · ${this.financeCostScopeText(f)} · ${this.formatMoney(f.amount,f.currency)}`);this.notify('成本已保存，净利润已自动更新')},
    deleteFinanceCost(cost){if(cost?.autoGenerated){this.notify(cost.sourceType==='OPENING_DEAL'?'自动开户成本不能单独删除，请修改对应开户渠道':cost.sourceType==='RECEIVABLE_ITEM'?'收入项目联动成本不能单独删除，请修改对应收入项目':'自动 IP / 网络成本不能单独删除，请修改客户网络环境');return}if(!this.assertMonthUnlocked(String(cost.date||'').slice(0,7),'删除成本'))return;this.askConfirm({title:'删除成本记录',message:`确定删除 ${cost.date||''} 的【${this.financeCostCategoryText(cost.category)} · ${this.formatMoney(cost.amount,cost.currency)}】吗？`,confirmText:'确认删除'},()=>{this.financeCosts=this.financeCosts.filter(c=>c.id!==cost.id);this.persist();this.logAudit('删除成本',`${this.financeCostCategoryText(cost.category)} · ${this.formatMoney(cost.amount,cost.currency)}`);this.notify('成本记录已删除，净利润已重新计算')})},
    subtractSpendGroups(income,cost){const out={};new Set([...Object.keys(income||{}),...Object.keys(cost||{})]).forEach(cur=>out[cur]=Number(income?.[cur]||0)-Number(cost?.[cur]||0));return out},
    defaultReconciliationForm(){return{id:null,channelKey:'',providerId:'',contactId:'',settlementMonth:this.financeMonthKey||this.localDateKey().slice(0,7),currency:'USD',confirmedSpend:'',actualRebate:'',confirmedDate:this.localDateKey(),note:''}},
    isMonthLocked(monthKey){return !!this.financeMonthLocks?.[String(monthKey||'')]},
    assertMonthUnlocked(monthKey,action='修改数据'){if(!monthKey)return true;if(this.isMonthLocked(monthKey)){this.notify(`${monthKey} 已完成月结锁定，不能${action}。回款按实际到账月份管理；其他历史数据如需调整，请由管理员先解锁。`);return false}return true},
    toggleFinanceMonthLock(monthKey){if(!monthKey)return;if(!this.canManageFinance()){this.notify('当前角色无财务月结权限');return}const locked=this.isMonthLocked(monthKey);if(locked&&this.currentUser?.role!=='ADMIN'){this.notify('只有管理员可以解除已完成的月结锁定');return}if(locked){this.askConfirm({title:'解除财务月结',message:`确定解除 ${monthKey} 的月结锁定吗？解除后该月广告、渠道返点、应收金额和成本将重新允许修改，月结冻结快照也会失效。`,confirmText:'确认解锁',tone:'warning'},()=>{delete this.financeMonthLocks[monthKey];delete this.financeMonthSnapshots[monthKey];this.persist();this.logAudit('解除财务月结',monthKey);this.notify(`${monthKey} 已解锁`)})}else{this.ensur