eAutomaticAssetCosts({month:monthKey,silent:true});this.persist();const check=this.getFinanceMonthCheck(monthKey);if(check.issues.length){this.notify(`月结检查未通过：${check.issues.join('；')}`);return}this.askConfirm({title:'完成财务月结',message:`确定完成 ${monthKey} 的月结吗？系统会冻结该月广告数据、渠道归属、应收金额与成本，并保存一份月结快照；跨月回款仍可按实际到账月份登记。`,confirmText:'完成月结',tone:'warning'},()=>{this.financeMonthSnapshots[monthKey]=this.buildFinanceMonthSnapshot(monthKey);this.financeMonthLocks[monthKey]={locked:true,lockedAt:new Date().toISOString(),lockedBy:this.currentUser?.name||'系统'};this.persist();this.logAudit('完成财务月结',monthKey);this.notify(`${monthKey} 已完成月结并锁定`)})}},
    syncReconciliationForm(){const cur=this.reconciliationForm.currency||'USD';this.reconciliationForm.confirmedSpend=Number(this.reconciliationSystemSpend||0);this.reconciliationForm.actualRebate=Number(this.reconciliationExpectedRebate||0);const existing=this.financeReconciliations.find(r=>r.status!=='VOID'&&String(r.providerId)===String(this.reconciliationForm.providerId)&&String(r.contactId)===String(this.reconciliationForm.contactId)&&String(r.settlementMonth)===String(this.reconciliationForm.settlementMonth)&&(r.currency||'USD')===cur);if(existing)this.reconciliationForm={...JSON.parse(JSON.stringify(existing)),currency:cur};else{this.reconciliationForm.id=null;this.reconciliationForm.currency=cur;this.reconciliationForm.confirmedSpend=Number(this.reconciliationSystemSpend||0);this.reconciliationForm.actualRebate=Number(this.reconciliationExpectedRebate||0)}},
    syncReconciliationProvider(){const contacts=this.reconciliationProviderContacts,first=contacts[0];this.reconciliationForm.contactId=first?String(first.id):'';this.syncReconciliationForm()},
    syncReconciliationContact(){this.syncReconciliationForm()},
    openReconciliationModal(row=null){const base=this.defaultReconciliationForm();if(row){base.providerId=String(row.providerId);base.contactId=String(row.contactId);base.settlementMonth=row.month;base.currency=row.currency;base.confirmedSpend=row.record?Number(row.record.confirmedSpend||0):Number(row.systemSpend||0);base.actualRebate=row.record?Number(row.record.actualRebate||0):Number(row.expectedRebate||0);base.confirmedDate=row.record?.confirmedDate||this.localDateKey();base.note=row.record?.note||'';base.id=row.record?.id||null}else if(this.financeProviderFilter!=='ALL'){const opt=this.financeRebateChannelOptions.find(o=>String(o.providerId)===String(this.financeProviderFilter));if(opt){base.providerId=String(opt.providerId);base.contactId=String(opt.contactId)}}this.reconciliationForm=base;if(!this.reconciliationForm.contactId&&this.reconciliationProviderContacts[0])this.reconciliationForm.contactId=String(this.reconciliationProviderContacts[0].id);if(!row)this.syncReconciliationForm();this.showReconciliationModal=true},
    saveReconciliation(){const f={...this.reconciliationForm,providerId:String(this.reconciliationForm.providerId||''),contactId:String(this.reconciliationForm.contactId||''),confirmedSpend:Number(this.reconciliationForm.confirmedSpend||0),actualRebate:Number(this.reconciliationForm.actualRebate||0),status:'CONFIRMED',updatedAt:new Date().toISOString()};if(!f.providerId||!f.contactId||!f.settlementMonth||f.confirmedSpend<0||f.actualRebate<0){this.notify('请完整填写代理商确认数据');return}const selected=this.financeRebateChannelOptions.find(o=>String(o.providerId)===String(f.providerId)&&String(o.contactId)===String(f.contactId));if(!selected){this.notify('请选择有效的开户商和对接人');return}if(!this.assertMonthUnlocked(f.settlementMonth,'保存返点对账'))return;f.systemSpend=Number(this.reconciliationSystemSpend||0);f.expectedRebate=Number(this.reconciliationExpectedRebate||0);const existingIndex=this.financeReconciliations.findIndex(r=>r.status!=='VOID'&&String(r.providerId)===String(f.providerId)&&String(r.contactId)===String(f.contactId)&&String(r.settlementMonth)===String(f.settlementMonth)&&(r.currency||'USD')===(f.currency||'USD'));if(existingIndex>=0)f.id=this.financeReconciliations[existingIndex].id;else f.id=f.id||this.accountUid('recon');if(existingIndex>=0)this.financeReconciliations[existingIndex]=f;else this.financeReconciliations.unshift(f);this.persist();this.showReconciliationModal=false;const provider=this.openingProviders.find(p=>String(p.id)===String(f.providerId)),contact=(provider?.contacts||[]).find(c=>String(c.id)===String(f.contactId));this.logAudit('确认代理商返点对账',`${provider?.name||'开户商'} · ${contact?.name||'对接人'} · ${f.settlementMonth} · 消耗 ${this.formatMoney(f.confirmedSpend,f.currency)} · 返点 ${this.formatMoney(f.actualRebate,f.currency)}`);this.notify('返点对账已确认，实际返点与利润已同步更新')},
    voidReconciliation(row){const r=row?.record;if(!r)return;if(!this.assertMonthUnlocked(r.settlementMonth,'撤销返点对账'))return;this.askConfirm({title:'撤销返点对账',message:`确定撤销 ${row.providerName} · ${row.contactName} · ${row.month} 的已确认返点吗？撤销后实际返点将退出利润计算。`,confirmText:'确认撤销'},()=>{r.status='VOID';r.voidedAt=new Date().toISOString();this.persist();this.logAudit('撤销代理商返点对账',`${row.providerName} · ${row.contactName} · ${row.month}`);this.notify('返点对账已撤销')})},
    financeServiceFeeForClientMonth(client,month){if(!client||!month||(client.billingMode||'FULL_MONTH')==='MANUAL')return 0;if(client.startDate&&month<String(client.startDate).slice(0,7))return 0;if(client.endDate&&month>String(client.endDate).slice(0,7))return 0;const fee=Number(client.monthlyFee||0);if(fee<=0)return 0;if((client.billingMode||'FULL_MONTH')!=='PRORATE')return fee;const [y,m]=month.split('-').map(Number),daysInMonth=new Date(y,m,0).getDate(),monthStart=`${month}-01`,monthEnd=`${month}-${String(daysInMonth).padStart(2,'0')}`,start=client.startDate&&client.startDate>monthStart?client.startDate:monthStart,end=client.endDate&&client.endDate<monthEnd?client.endDate:monthEnd;if(start>end)return 0;const serviceDays=Math.floor((new Date(`${end}T12:00:00`)-new Date(`${start}T12:00:00`))/86400000)+1;return Number((fee*serviceDays/daysInMonth).toFixed(2))},
    financeServiceFeeGroupsForClientMonth(client,month){const cur=client?.currency||'USD',amount=this.financeServiceFeeForClientMonth(client,month);return amount>0?{[cur]:amount}:{}},
    financeServiceFeeReceivableGroupsForClientMonth(client,month){const g={};this.financeReceivables.filter(r=>String(r.clientId)===String(client?.id)&&String(r.settlementMonth)===String(month)&&(r.incomeType||'SERVICE_FEE')==='SERVICE_FEE').forEach(r=>{const cur=r.currency||client?.currency||'USD';g[cur]=(g[cur]||0)+Number(r.amount||0)});return g},
    financePeriodMonths(){if(this.financePeriod==='MONTH')return[this.financeMonthKey];if(this.financePeriod==='QUARTER'){const start=(Number(this.financeQuarter)-1)*3+1;return[0,1,2].map(i=>`${this.financeQuarterYear}-${String(start+i).padStart(2,'0')}`)}return Array.from({length:12},(_,i)=>`${this.financeYear}-${String(i+1).padStart(2,'0')}`)},
    clientContractOverlapsMonth(client,month){if(!month)return true;const start=`${month}-01`,[y,m]=month.split('-').map(Number),end=`${month}-${String(new Date(y,m,0).getDate()).padStart(2,'0')}`;return(!client.startDate||client.startDate<=end)&&(!client.endDate||client.endDate>=start)},
    financeClientRow(client){if(!client)return null;const deals=this.openingDeals.filter(d=>d.clientId===client.id&&d.status==='OPENED'&&this.financePeriodMonths().some(m=>this.openingDealOverlapsMonth(d,m))),receivableRows=this.financeReceivablesForClient(client),receivableGroups=this.financeReceivableGroupsForClient(client),paidGroups=this.financePaidGroupsForClient(client),serviceFeeGroups={};receivableRows.filter(r=>(r.incomeType||'SERVICE_FEE')==='SERVICE_FEE').forEach(r=>{const cur=r.currency||client.currency||'USD';serviceFeeGroups[cur]=(serviceFeeGroups[cur]||0)+Number(r.amount||0)});const spendGroups=this.financeAdSpendGroups(client.id,this.financePeriodMonths(),'ALL'),expectedRebateGroups=this.financeClientExpectedRebateGroups(client),actualRebateGroups=this.financeActualRebateGroups(client),costGroups=this.financeClientCostGroups(client),expectedNetProfitGroups=this.subtractSpendGroups(this.financeProfitGroups(receivableGroups,expectedRebateGroups),costGroups),actualNetProfitGroups=this.subtractSpendGroups(this.financeProfitGroups(receivableGroups,actualRebateGroups),costGroups),actualStatus=this.financeReconciliationStatusForScope(client.id,this.financePeriodMonths()),channelLabels=deals.map(d=>`${this.openingProviderName(d)} · ${this.openingContactName(d)} · ${Number(this.openingDealRebateRate(d)||0).toFixed(2)}%`);return{client,deals,activeMonths:new Set(receivableRows.map(r=>r.settlementMonth)).size,receivableRows,receivableCount:receivableRows.length,receivableGroups,paidGroups,serviceFeeGroups,spendGroups,expectedRebateGroups,actualRebateGroups,costGroups,expectedNetProfitGroups,actualNetProfitGroups,channelLabels:[...new Set(channelLabels)],actualEntryCount:actualStatus.confirmedCount,actualProfitConfirmed:actualStatus.complete,actualProfitLabel:actualStatus.complete?'已确认净利润':'当前净利润',pendingRebateCount:actualStatus.pendingReconciliations}},
    financeActualRebateGroups(client){const g={};if(!client)return g;this.financeReconciliations.filter(r=>r.status!=='VOID'&&this.financeSettlementMonthMatch(r.settlementMonth)).forEach(r=>{const amount=this.financeActualRebateClientShare(r,client);if(Math.abs(amount)>0.000001){const cur=r.currency||'USD';g[cur]=(g[cur]||0)+amount}});return g},
    financeReconciliationStatusForScope(clientId=null,months=[]){let required=0,confirmedCount=0,pendingReconciliations=0;this.financeRebateChannelOptions.forEach(opt=>{(months||[]).forEach(month=>{const spends=this.financeChannelMonthGroups(opt.providerId,opt.contactId,month,clientId,'SPEND');Object.entries(spends).forEach(([currency,amount])=>{if(Number(amount||0)<=0)return;required++;const exists=this.financeReconciliations.some(r=>r.status!=='VOID'&&String(r.providerId)===String(opt.providerId)&&String(r.contactId)===String(opt.contactId)&&String(r.settlementMonth)===String(month)&&(r.currency||'USD')===currency);if(exists)confirmedCount++;else pendingReconciliations++})})});const unassignedSpendGroups=this.financeAdSpendGroups(clientId,(months||[]),'UNASSIGNED'),unassignedSpendTotal=Object.values(unassignedSpendGroups).reduce((sum,v)=>sum+Math.abs(Number(v||0)),0),allLocked=(months||[]).length>0&&(months||[]).every(month=>this.isMonthLocked(month));return{required,confirmedCount,pendingReconciliations,unassignedSpendGroups,unassignedSpendTotal,allLocked,complete:pendingReconciliations===0&&unassignedSpendTotal<=0.01}},
    financeProfitGroups(service,rebate){const g={};this.mergeSpendGroups(g,service);this.mergeSpendGroups(g,rebate);return g},
    financeMoneyRows(groups){const entries=Object.entries(groups||{}).filter(([,value])=>Math.abs(Number(value||0))>0.000001);if(!entries.length)return[{currency:'USD',value:0,text:'$0'}];return entries.sort(([a],[b])=>String(a).localeCompare(String(b))).map(([currency,value])=>({currency,value:Number(value||0),text:this.formatMoney(Number(value||0),currency)}))},
    financeProfitBreakdownRows(mode='EXPECTED'){const rebate=mode==='ACTUAL'?this.financeConfirmedActualRebateGroups:this.financeTotals.expected,cost=this.financeCostGroups,receivable=this.financeReceivableTotals.expected,net=mode==='ACTUAL'?this.financeActualNetProfitGroups:this.financeExpectedNetProfitGroups,currencies=new Set([...Object.keys(receivable||{}),...Object.keys(rebate||{}),...Object.keys(cost||{}),...Object.keys(net||{})]);if(!currencies.size)currencies.add('USD');return[...currencies].sort().map(currency=>({currency,receivable:Number(receivable?.[currency]||0),rebate:Number(rebate?.[currency]||0),cost:Number(cost?.[currency]||0),net:Number(net?.[currency]||0),receivableText:this.formatMoney(Number(receivable?.[currency]||0),currency),rebateText:this.formatMoney(Number(rebate?.[currency]||0),currency),costText:this.formatMoney(Number(cost?.[currency]||0),currency),netText:this.formatMoney(Number(net?.[currency]||0),currency)}))},
    financePeriodClientRows(){const months=this.financePeriodMonths();return this.clients.filter(c=>!c.archived).map(client=>({client,receivableGroups:months.reduce((g,m)=>{this.mergeSpendGroups(g,this.financeReceivableGroupsForClient(client));return g},{})}))},
    mergeSpendGroups(target,source){Object.entries(source||{}).forEach(([cur,val])=>target[cur]=(target[cur]||0)+Number(val||0));return target},
    spendGroupsText(groups){const entries=Object.entries(groups||{}).filter(([,v])=>Math.abs(Number(v||0))>0.000001);if(!entries.length)return'$0';return entries.map(([cur,val])=>this.formatMoney(Number(val||0),cur)).join(' + ')},
    financeDateMatch(date){if(!date)return false;const d=String(date),year=Number(d.slice(0,4)),month=Number(d.slice(5,7));if(this.financePeriod==='MONTH')return d.slice(0,7)===this.financeMonthKey;if(this.financePeriod==='QUARTER')return year===Number(this.financeQuarterYear)&&Math.floor((month-1)/3)+1===Number(this.financeQuarter);return year===Number(this.financeYear)},
    financeSettlementMonthMatch(month){if(!month)return false;const y=Number(String(month).slice(0,4)),m=Number(String(month).slice(5,7));if(this.financePeriod==='MONTH')return month===this.financeMonthKey;if(this.financePeriod==='QUARTER')return y===Number(this.financeQuarterYear)&&Math.floor((m-1)/3)+1===Number(this.financeQuarter);return y===Number(this.financeYear)},
    financeDateRangeLabel(){if(this.financePeriod==='MONTH')return this.financeMonthKey;if(this.financePeriod==='QUARTER')return`${this.financeQuarterYear}-Q${this.financeQuarter}`;return String(this.financeYear)},
    financeProviderSpendGroups(providerId,contactId,clientId=null){const groups={};this.openingDeals.filter(d=>d.status==='OPENED'&&String(d.providerId)===String(providerId)&&(!contactId||String(d.contactId||'')===String(contactId))&&(clientId===null||String(d.clientId)===String(clientId))).forEach(deal=>{this.financePeriodMonths().forEach(month=>{const spend=this.openingDealSpendGroups(deal,{mode:'MONTH',monthKey:month,quarterYear:this.financeQuarterYear,quarter:this.financeQuarter,year:this.financeYear});Object.entries(spend).forEach(([cur,val])=>groups[cur]=(groups[cur]||0)+Number(val||0))})});return groups},
    financeClientExpectedRebateGroups(client){const groups={};if(!client)return groups;[['FB',client.fbAccounts||[]],['TK',client.tkAccounts||[]]].forEach(([platform,accounts])=>accounts.forEach(account=>(account.adDataRecords||[]).filter(r=>this.financeDateMatch(r.date)).forEach(r=>{if(this.accountRebateMode(account)!=='CHANNEL')return;const owner=this.openingDealOwnerForRecord(client.id,platform,account,r.date);if(!owner)return;const cur=r.currency||account.adSpendCurrency||'USD',amount=Number(r.spend||0),rate=Number(this.openingDealRebateRate(owner,r.date)||0);groups[cur]=(groups[cur]||0)+amount*rate/100})));return groups},
    financeActualRebateClientShare(record,client){if(!record||record.status==='VOID'||!client)return 0;const contribution=this.financeExpectedRebateForChannelMonth(record.providerId,record.contactId,record.settlementMonth,client.id)[record.currency||'USD']||0,total=this.financeExpectedRebateForChannelMonth(record.providerId,record.contactId,record.settlementMonth)[record.currency||'USD']||0;if(total<=0)return 0;return Number(record.actualRebate||0)*(Number(contribution||0)/Number(total||1))},
    financeSpendForChannelMonth(providerId,contactId,month,clientId=null){return this.financeChannelMonthGroups(providerId,contactId,month,clientId,'SPEND')},
    financeExpectedRebateForChannelMonth(providerId,contactId,month,clientId=null){return this.financeChannelMonthGroups(providerId,contactId,month,clientId,'EXPECTED_REBATE')},
    financeChannelMonthGroups(providerId,contactId,month,clientId=null,mode='SPEND'){const groups={};this.openingDeals.filter(d=>d.status==='OPENED'&&String(d.providerId)===String(providerId)&&String(d.contactId||'')===String(contactId)&&(clientId===null||String(d.clientId)===String(clientId))&&this.openingDealOverlapsMonth(d,month)).forEach(deal=>{const client=this.clients.find(c=>String(c.id)===String(deal.clientId));if(!client)return;const accounts=deal.platform==='TK'?(client.tkAccounts||[]):(client.fbAccounts||[]),allowed=new Set(this.openingDealAccountIds(deal));accounts.filter(account=>allowed.has(String(account.adAccountId||'').trim())).forEach(account=>(account.adDataRecords||[]).filter(r=>String(r.date||'').slice(0,7)===String(month)&&this.openingDealDateActive(deal,r.date)&&this.accountRebateMode(account)==='CHANNEL').forEach(r=>{const cur=r.currency||account.adSpendCurrency||'USD',spend=Number(r.spend||0),value=mode==='EXPECTED_REBATE'?spend*Number(this.openingDealRebateRate(deal,r.date)||0)/100:spend;groups[cur]=(groups[cur]||0)+value}))});return groups},
    financeAdSpendGroups(clientId=null,months=[],mode='ALL'){const groups={};this.clients.filter(c=>clientId===null||clientId===undefined||String(c.id)===String(clientId)).forEach(client=>{[['FB',client.fbAccounts||[]],['TK',client.tkAccounts||[]]].forEach(([platform,accounts])=>accounts.forEach(account=>(account.adDataRecords||[]).filter(r=>!months.length||months.includes(String(r.date||'').slice(0,7))).forEach(r=>{const rebateMode=this.accountRebateMode(account),owner=rebateMode==='CHANNEL'?this.openingDealOwnerForRecord(client.id,platform,account,r.date):null,isAttributed=rebateMode==='CHANNEL'&&!!owner,isUnassigned=rebateMode==='CHANNEL'&&!owner,isNoRebate=rebateMode==='NONE';if(mode==='ATTRIBUTED'&&!isAttributed)return;if(mode==='UNASSIGNED'&&!isUnassigned)return;if(mode==='NO_REBATE'&&!isNoRebate)return;const cur=r.currency||account.adSpendCurrency||'USD';groups[cur]=(groups[cur]||0)+Number(r.spend||0)})))});return groups},
    financeUnassignedSpendGroupsForMonth(month,clientId=null){return this.financeAdSpendGroups(clientId,[month],'UNASSIGNED')},
    openingDealAccountIds(deal){const client=this.clients.find(c=>String(c.id)===String(deal?.clientId)),accounts=(deal?.platform==='TK'?(client?.tkAccounts||[]):(client?.fbAccounts||[])).map(a=>String(a.adAccountId||'').trim()).filter(Boolean);if(deal?.accountScope==='ALL')return accounts;return String(deal?.adAccountIds||'').split(/[\s,，;；]+/).map(v=>v.trim()).filter(Boolean)},
    openingDealUnmatchedIds(deal){const client=this.clients.find(c=>String(c.id)===String(deal?.clientId));if(!client||deal?.accountScope==='ALL')return[];const valid=new Set((deal?.platform==='TK'?(client.tkAccounts||[]):(client.fbAccounts||[])).map(a=>String(a.adAccountId||'').trim()).filter(Boolean));return this.openingDealAccountIds(deal).filter(id=>!valid.has(id))},
    openingDealAccountMatchText(deal){if(!deal?.clientId)return deal?.adAccountIds?'外部项目手工记录':'未关联客户';if(deal.accountScope==='ALL'){const count=this.openingDealAccountIds(deal).length;return count?`当前平台全部账户 · ${count} 个`:'当前平台暂无可归属广告账户'}const ids=this.openingDealAccountIds(deal),bad=this.openingDealUnmatchedIds(deal);if(!ids.length)return'未选择广告账户';if(bad.length)return`有 ${bad.length} 个账号 ID 未匹配客户资产`;return`已匹配 ${ids.length} 个广告账户`},
    openingDealDateActive(deal,date){if(!deal||!date)return false;const start=this.openingDealEffectiveStart(deal),end=deal.effectiveEndDate||'';if(start&&date<start)return false;if(end&&date>end)return false;return true},
    openingDealOwnerForRecord(clientId,platform,account,date){if(!clientId||!account||!date)return null;const accountId=String(account.adAccountId||'').trim();if(!accountId)return null;return this.openingDeals.filter(d=>d.status==='OPENED'&&String(d.clientId)===String(clientId)&&d.platform===platform&&this.openingDealDateActive(d,date)&&this.openingDealAccountIds(d).includes(accountId)).sort((a,b)=>String(this.openingDealEffectiveStart(b)).localeCompare(String(this.openingDealEffectiveStart(a))))[0]||null},
    financeExpectedRebateForDeal(deal){const groups={};const client=this.clients.find(c=>String(c.id)===String(deal.clientId));if(!client)return groups;const accounts=deal.platform==='TK'?(client.tkAccounts||[]):(client.fbAccounts||[]),allowed=new Set(this.openingDealAccountIds(deal));accounts.filter(account=>allowed.has(String(account.adAccountId||'').trim())).forEach(account=>(account.adDataRecords||[]).filter(r=>this.financeDateMatch(r.date)&&this.openingDealDateActive(deal,r.date)&&this.accountRebateMode(account)==='CHANNEL').forEach(r=>{const cur=r.currency||account.adSpendCurrency||'USD',amount=Number(r.spend||0),rate=Number(this.openingDealRebateRate(deal,r.date)||0);groups[cur]=(groups[cur]||0)+amount*rate/100}));return groups},
    financeOpeningDealGroups(deal){const spend={};this.financePeriodMonths().forEach(month=>{const s=this.openingDealSpendGroups(deal,{mode:'MONTH',monthKey:month,quarterYear:this.financeQuarterYear,quarter:this.financeQuarter,year:this.financeYear});Object.entries(s).forEach(([cur,val])=>spend[cur]=(spend[cur]||0)+Number(val||0))});return spend},
    defaultReminderTypes(){return[{key:'CONTRACT',name:'合同到期',system:true},{key:'IP',name:'IP 到期',system:true}]},
    normalizeReminderTypes(types){const built=this.defaultReminderTypes(),arr=Array.isArray(types)?types:[],map=new Map();built.forEach(t=>map.set(t.key,{...t,...(arr.find(x=>x&&x.key===t.key)||{}),system:true}));arr.forEach(t=>{if(!t||!t.key||map.has(t.key))return;map.set(String(t.key),{key:String(t.key),name:String(t.name||'自定义提醒').trim()||'自定义提醒',system:false})});return[...map.values()]},
    reminderTypeLabel(key){return this.reminderTypeOptions.find(t=>t.key===key)?.name||key||'其他提醒'},
    canManageReminderTypes(){return ['ADMIN','OPS'].includes(this.currentUser?.role)},
    reminderTypeUsageCount(key){return this.standaloneAlerts.filter(a=>a.typeKey===key).length},
    resetReminderTypeForm(){this.reminderTypeForm={key:'',name:''}},
    openReminderTypeManager(){if(!this.canManageReminderTypes()){this.notify('当前角色没有提醒类型管理权限');return}this.resetReminderTypeForm();this.showReminderTypeManager=true},
    editReminderType(type){if(!this.canManageReminderTypes())return;this.reminderTypeForm={key:type.key,name:type.name}},
    saveReminderType(){if(!this.canManageReminderTypes()){this.notify('当前角色没有提醒类型管理权限');return}const name=String(this.reminderTypeForm.name||'').trim();if(!name){this.notify('请输入提醒类型名称');return}const key=this.reminderTypeForm.key;if(key){const item=this.reminderTypes.find(t=>t.key===key);if(item)item.name=name;this.logAudit('修改提醒类型',name)}else{const newKey=`CUSTOM_${Date.now().toString(36).toUpperCase()}_${Math.random().toString(36).slice(2,6).toUpperCase()}`;this.reminderTypes.push({key:newKey,name,system:false});this.logAudit('新增提醒类型',name)}this.persist();this.resetReminderTypeForm();this.notify('提醒类型已保存')},
    deleteReminderType(type){if(!this.canManageReminderTypes()){this.notify('当前角色没有提醒类型管理权限');return}if(type.system){this.notify('系统提醒类型不能删除，只能修改名称');return}const usage=this.reminderTypeUsageCount(type.key);if(usage){this.notify(`该类型仍被 ${usage} 条独立提醒使用，请先删除或修改对应提醒`);return}this.askConfirm({title:'删除提醒类型',message:`确定删除提醒类型【${type.name}】吗？`,confirmText:'确认删除'},()=>{this.reminderTypes=this.reminderTypes.filter(t=>t.key!==type.key);if(this.newAlertForm.typeKey===type.key)this.newAlertForm.typeKey='IP';this.persist();this.logAudit('删除提醒类型',type.name);this.notify('提醒类型已删除')})},
    reminderTargetLabel(typeKey){return typeKey==='IP'?'网络环境':'提醒对象 / 账号'},
    reminderTargetPlaceholder(typeKey){if(typeKey==='IP')return'例如 AdsPower Profile / IP 供应商';return`请输入${this.reminderTypeLabel(typeKey)}相关对象或备注`},
    normalizeStandaloneAlert(a){if(!a||typeof a!=='object')return a;if(!a.typeKey)a.typeKey=a.type==='IP 到期'?'IP':a.type==='工具到期'?'TOOL':'CONTRACT';return a},
    normalizeMediaTool(t){const x=JSON.parse(JSON.stringify(t||{}));x.bindings=Array.isArray(x.bindings)?x.bindings:[];if(!x.bindings.length&&Array.isArray(x.clientIds))x.bindings=x.clientIds.map(id=>({clientId:id,platform:'ALL',accountId:'ALL',accountKey:'ALL'}));x.bindings=x.bindings.filter(b=>b&&b.clientId!==undefined&&b.clientId!==null).map(b=>({clientId:b.clientId,platform:b.platform||'ALL',accountId:b.accountId||'ALL',accountKey:b.accountKey||((b.platform&&b.platform!=='ALL'&&b.accountId&&b.accountId!=='ALL')?`${b.platform}:${b.accountId}`:'ALL')}));delete x.clientIds;return x},
    normalizeOpeningProvider(p){const x=JSON.parse(JSON.stringify(p||{}));x.contacts=Array.isArray(x.contacts)?x.contacts:[];x.contacts=x.contacts.map(c=>this.normalizeProviderContact(c));if(!x.contacts.length&&(x.contactName||x.contactPhone||x.contactWechat||x.contactEmail||Number(x.rebateRate||0)>0||x.rebatePolicy)){x.contacts=[this.normalizeProviderContact({id:`contact-legacy-${x.id||this.accountUid('provider')}`,name:x.contactName||'默认对接人',phone:x.contactPhone||'',wechat:x.contactWechat||'',email:x.contactEmail||'',rebateRate:Number(x.rebateRate||0),rebatePolicy:x.rebatePolicy||''})]}return x},
    normalizeProviderContact(contact){const c={id:contact?.id||this.accountUid('contact'),name:String(contact?.name||'').trim(),phone:String(contact?.phone||contact?.whatsapp||'').trim(),wechat:String(contact?.wechat||'').trim(),email:String(contact?.email||'').trim(),rebateRate:Number(contact?.rebateRate||0),rebatePolicy:String(contact?.rebatePolicy||'').trim(),rebatePolicies:Array.isArray(contact?.rebatePolicies)?JSON.parse(JSON.stringify(contact.rebatePolicies)):[]};if(!c.rebatePolicies.length){c.rebatePolicies=[{id:this.accountUid('rebate-policy'),effectiveDate:String(contact?.effectiveDate||''),rebateRate:Number(contact?.rebateRate||0),rebatePolicy:String(contact?.rebatePolicy||'').trim()}]}c.rebatePolicies=c.rebatePolicies.map(p=>({id:p?.id||this.accountUid('rebate-policy'),effectiveDate:String(p?.effectiveDate||''),rebateRate:Number(p?.rebateRate||0),rebatePolicy:String(p?.rebatePolicy||'').trim()})).sort((a,b)=>String(a.effectiveDate||'').localeCompare(String(b.effectiveDate||'')));const latest=this.rebatePolicyForContact(c,this.localDateKey())||c.rebatePolicies[c.rebatePolicies.length-1]||{};c.rebateRate=Number(latest.rebateRate||0);c.rebatePolicy=String(latest.rebatePolicy||'');return c},
    addProviderContact(){this.providerForm.contacts=Array.isArray(this.providerForm.contacts)?this.providerForm.contacts:[];this.providerForm.contacts.push(this.normalizeProviderContact({id:this.accountUid('contact'),name:'',phone:'',wechat:'',email:'',rebateRate:0,rebatePolicy:''}))},
    removeProviderContact(index,contact){const id=contact?.id;if(id&&this.openingDeals.some(d=>String(d.contactId||'')===String(id))){this.notify('该对接人已被客户开户记录使用，不能直接删除。请先调整对应客户开户关系。');return}this.providerForm.contacts.splice(index,1)},
    addContactRebatePolicy(contact){contact.rebatePolicies=Array.isArray(contact.rebatePolicies)?contact.rebatePolicies:[];contact.rebatePolicies.push({id:this.accountUid('rebate-policy'),effectiveDate:this.localDateKey(),rebateRate:Number(this.contactCurrentRebateRate(contact)||0),rebatePolicy:''})},
    removeContactRebatePolicy(contact,index){if(!Array.isArray(contact?.rebatePolicies)||contact.rebatePolicies.length<=1)return;contact.rebatePolicies.splice(index,1)},
    rebatePolicyForContact(contact,date=null){if(!contact)return null;const list=Array.isArray(contact.rebatePolicies)?contact.rebatePolicies:[];if(!list.length)return{id:'legacy',effectiveDate:'',rebateRate:Number(contact.rebateRate||0),rebatePolicy:contact.rebatePolicy||''};const target=String(date||this.localDateKey());const eligible=list.filter(p=>!p.effectiveDate||String(p.effectiveDate)<=target).sort((a,b)=>String(a.effectiveDate||'').localeCompare(String(b.effectiveDate||'')));return eligible[eligible.length-1]||list.slice().sort((a,b)=>String(a.effectiveDate||'').localeCompare(String(b.effectiveDate||'')))[0]||null},
    contactCurrentRebateRate(contact){return Number(this.rebatePolicyForContact(contact,this.localDateKey())?.rebateRate||0)},
    providerRateRangeText(provider){const rates=(provider?.contacts||[]).map(c=>Number(this.contactCurrentRebateRate(c)||0));if(!rates.length)return'未设返点';const min=Math.min(...rates),max=Math.max(...rates);return min===max?`返点 ${min.toFixed(2)}%`:`返点 ${min.toFixed(2)}% - ${max.toFixed(2)}%`},
    providerContactText(contact){return[contact?.phone,contact?.wechat,contact?.email].filter(Boolean).join(' · ')||'未填写联系方式'},
    visibleProviderContactRows(row){const selected=String(this.openingContactSelections?.[row?.provider?.id]||'ALL');const list=Array.isArray(row?.contactRows)?row.contactRows:[];if(selected==='ALL')return list;return list.filter(cr=>String(cr?.contact?.id)===selected)},
    openingContact(deal){const provider=this.openingProvider(deal);if(!provider)return null;return(provider.contacts||[]).find(c=>String(c.id)===String(deal?.contactId||''))||null},
    openingContactName(deal){return this.openingContact(deal)?.name||deal?.contactName||'未选择对接人'},
    openingDealRebateRate(deal,date=null){return Number(this.rebatePolicyForContact(this.openingContact(deal),date||this.localDateKey())?.rebateRate||0)},
    openingDealRebatePolicy(deal,date=null){return this.rebatePolicyForContact(this.openingContact(deal),date||this.localDateKey())?.rebatePolicy||''},
    openingProviderContacts(deal){return this.openingProvider(deal)?.contacts||[]},
    applyOpeningContactToForm(){const c=this.openingContact(this.openingForm);this.openingForm.contactName=c?.name||'';this.openingForm.contactInfo=this.providerContactText(c)},
    validateProviderForm(){const contacts=Array.isArray(this.providerForm.contacts)?this.providerForm.contacts:[];if(contacts.some(c=>!String(c.name||'').trim())){this.notify('请填写每位对接人的名称');return false}for(const contact of contacts){contact.rebatePolicies=Array.isArray(contact.rebatePolicies)?contact.rebatePolicies:[];if(!contact.rebatePolicies.length)contact.rebatePolicies=[{id:this.accountUid('rebate-policy'),effectiveDate:'',rebateRate:0,rebatePolicy:''}];for(const policy of contact.rebatePolicies){const rate=Number(policy.rebateRate||0);if(rate<0||rate>100){this.notify(`对接人【${contact.name||'未命名'}】返点比例需在 0-100 之间`);return false}}const dates=contact.rebatePolicies.map(p=>String(p.effectiveDate||'')).filter(Boolean);if(new Set(dates).size!==dates.length){this.notify(`对接人【${contact.name||'未命名'}】存在重复返点生效日期，请调整后保存`);return false}contact.rebatePolicies.sort((a,b)=>String(a.effectiveDate||'').localeCompare(String(b.effectiveDate||'')));const latest=this.rebatePolicyForContact(contact,this.localDateKey())||contact.rebatePolicies[contact.rebatePolicies.length-1];contact.rebateRate=Number(latest?.rebateRate||0);contact.rebatePolicy=latest?.rebatePolicy||''}return true},
    openingDealEffectiveStart(deal){return String(deal?.effectiveStartDate||deal?.submitDate||deal?.expectedDate||'')},
    openingDealOverlapsMonth(deal,month){if(!deal||!month)return false;const start=`${month}-01`,[y,m]=month.split('-').map(Number),monthEnd=`${month}-${String(new Date(y,m,0).getDate()).padStart(2,'0')}`,effectiveStart=this.openingDealEffectiveStart(deal),effectiveEnd=deal.effectiveEndDate||'';return(!effectiveStart||effectiveStart<=monthEnd)&&(!effectiveEnd||effectiveEnd>=start)},
    migrateOpeningDeals(){let changed=false;this.openingDeals=this.openingDeals.map(d=>{const x={...d};if(x.status==='OPENED'){if(!x.effectiveStartDate){x.effectiveStartDate=x.submitDate||x.expectedDate||this.localDateKey();changed=true}if(!x.accountScope){x.accountScope='SPECIFIC';changed=true}}return x});return changed},
    normalizeFinanceActualRebates(list){return(Array.isArray(list)?list:[]).map(r=>({...r,settlementMonth:String(r.settlementMonth||'').slice(0,7),amount:Number(r.amount||0),currency:r.currency||'USD'})).filter(r=>r.providerId&&r.contactId&&r.settlementMonth&&r.amount>=0)},
    financeSelectedRebateOption(){return null},
    financeActualRebateGroupsFor(clientId=null){const g={};this.financeActualRebates.filter(r=>this.financeSettlementMonthMatch(r.settlementMonth)&&(clientId===null||String(r.clientId||'')===String(clientId))).forEach(r=>{const cur=r.currency||'USD';g[cur]=(g[cur]||0)+Number(r.amount||0)});return g},
    financeActualRebateGroupsForProvider(providerId=null){const g={};this.financeActualRebates.filter(r=>this.financeSettlementMonthMatch(r.settlementMonth)&&(providerId===null||String(r.providerId)===String(providerId))).forEach(r=>{const cur=r.currency||'USD';g[cur]=(g[cur]||0)+Number(r.amount||0)});return g},
    financeActualRebateEntryCount(clientId=null){return this.financeActualRebates.filter(r=>this.financeSettlementMonthMatch(r.settlementMonth)&&(clientId===null||String(r.clientId||'')===String(clientId))).length},
    financeActualRebateEntriesForRow(row){const ids=new Set((row?.deals||[]).map(d=>String(d.id)));return this.financeActualRebates.filter(r=>this.financeSettlementMonthMatch(r.settlementMonth)&&String(r.clientId)===String(row?.client?.id)&&ids.has(String(r.openingDealId)))},
    financeActualRebateStatusForRow(row){return this.financeActualRebateEntriesForRow(row).length?'已确认':'待确认'},
    financeProfitGroups(service,rebate){const out={};this.mergeSpendGroups(out,service);this.mergeSpendGroups(out,rebate);return out},
    safeToolUrl(url){const v=String(url||'').trim();return/^https?:\/\//i.test(v)?v:'#'},
    toolBindingClient(binding){return this.clients.find(c=>String(c.id)===String(binding?.clientId))||null},
    toolBindingDisplay(tool){return(tool?.bindings||[]).map(b=>{const c=this.toolBindingClient(b);if(!c)return{...b,clientName:'客户已删除',accountLabel:'绑定失效',platform:b.platform||'ALL'};if(!b.accountKey||b.accountKey==='ALL'||b.accountId==='ALL')return{...b,clientName:c.name,accountLabel:'该客户全部账号',platform:'ALL'};const [platform,accountId]=String(b.accountKey).split(':'),list=platform==='TK'?(c.tkAccounts||[]):(c.fbAccounts||[]),account=list.find(a=>String(a.id)===String(accountId));return{...b,clientName:c.name,platform,accountLabel:account?`${platform==='TK'?'TikTok':'Facebook'} · ${account.accountName||account.adAccountId||'未命名账号'}`:`${platform==='TK'?'TikTok':'Facebook'} · 账号已删除`}})},
    addToolBinding(){if(!this.toolBindingClientId){this.notify('请先选择客户');return}this.toolForm.bindings=Array.isArray(this.toolForm.bindings)?this.toolForm.bindings:[];let binding={clientId:this.toolBindingClientId,platform:'ALL',accountId:'ALL',accountKey:'ALL'};if(this.toolBindingAccountKey&&this.toolBindingAccountKey!=='ALL'){const [platform,accountId]=this.toolBindingAccountKey.split(':');binding={clientId:this.toolBindingClientId,platform,accountId,accountKey:this.toolBindingAccountKey}}const duplicate=this.toolForm.bindings.some(b=>String(b.clientId)===String(binding.clientId)&&String(b.accountKey||'ALL')===String(binding.accountKey||'ALL'));if(duplicate){this.notify('该客户账号已绑定');return}this.toolForm.bindings.push(binding);this.toolBindingAccountKey='ALL'},
    removeToolBinding(index){this.toolForm.bindings.splice(index,1)},
    toolCategoryText(v){return({BROWSER:'指纹浏览器',CREATIVE:'素材 / 创意',LANDING:'落地页 / 建站',ANALYTICS:'数据分析',CRM:'CRM / 线索',SPY:'广告情报',OTHER:'其他工具'})[v]||v},
    toolCategoryIcon(v){return({BROWSER:'fa-solid fa-fingerprint',CREATIVE:'fa-solid fa-palette',LANDING:'fa-solid fa-window-maximize',ANALYTICS:'fa-solid fa-chart-line',CRM:'fa-solid fa-address-book',SPY:'fa-solid fa-binoculars',OTHER:'fa-solid fa-toolbox'})[v]||'fa-solid fa-toolbox'},
    toggleToolPassword(id){this.toolPasswordVisible={...this.toolPasswordVisible,[id]:!this.toolPasswordVisible[id]}},
    openToolModal(tool=null){const presetClient=this.selectedToolClientId!=='ALL'?this.selectedToolClientId:'',presetAccount=this.selectedToolAccountKey||'ALL';this.toolForm=tool?this.normalizeMediaTool(tool):{id:null,name:'',category:'BROWSER',url:'',loginAccount:'',loginPassword:'',purpose:'',bindings:[],owner:'',status:'ACTIVE',seats:1,notes:''};this.toolBindingClientId=tool?String(tool.bindings?.[0]?.clientId||''):presetClient;this.toolBindingAccountKey=tool?(tool.bindings?.[0]?.accountKey||'ALL'):presetAccount;this.showToolModal=true},
    saveMediaTool(){const f=this.normalizeMediaTool({...this.toolForm,name:String(this.toolForm.name||'').trim()});if(!f.name){this.notify('请输入工具名称');return}if(!f.bindings.length){this.notify('请至少选择一个客户或客户账号进行绑定');return}if(f.id){const i=this.mediaTools.findIndex(t=>t.id===f.id);if(i>=0)this.mediaTools[i]=f}else this.mediaTools.unshift({...f,id:this.accountUid('tool')});this.persist();this.showToolModal=false;this.notify('投放工具已保存')},
    deleteMediaTool(tool){this.askConfirm({title:'删除投放工具',message:`确定删除【${tool.name}】吗？绑定关系会一并移除。`,confirmText:'确认删除'},()=>{this.mediaTools=this.mediaTools.filter(t=>t.id!==tool.id);this.persist();this.notify('投放工具已删除')})},
    openingClientName(deal){if(deal.clientId){const c=this.clients.find(c=>c.id===deal.clientId);if(c)return c.name}return deal.externalClientName||'外部客户'},
    openingProvider(deal){return this.openingProviders.find(p=>String(p.id)===String(deal?.providerId))||null},
    openingProviderName(deal){return this.openingProvider(deal)?.name||deal?.partnerName||'未选择开户商'},
    openingStatusText(v){return({PREPARE:'资料准备',SUBMITTED:'已提交',REVIEWING:'审核中',OPENED:'已开户',REJECTED:'异常 / 驳回'})[v]||v},
    openingStatusStyle(v){return({PREPARE:'bg-slate-100 text-slate-600',SUBMITTED:'bg-blue-50 text-blue-700',REVIEWING:'bg-amber-50 text-amber-700',OPENED:'bg-emerald-50 text-emerald-700',REJECTED:'bg-rose-50 text-rose-600'})[v]||'bg-slate-100 text-slate-600'},
    openLeadModal(lead=null){this.leadForm=lead?JSON.parse(JSON.stringify(lead)):{id:null,company:'',contact:'',contactInfo:'',source:'网站询盘',platformInterest:'FB+TK',budgetCurrency:'USD',expectedBudget:'',quoteCurrency:'USD',adQuote:'',stage:'NEW',nextFollowUp:'',owner:'',notes:'',createdAt:new Date().toISOString().slice(0,10)};if(!this.leadForm.quoteCurrency)this.leadForm.quoteCurrency=this.leadForm.budgetCurrency||'USD';if(this.leadForm.adQuote===undefined)this.leadForm.adQuote='';this.showLeadModal=true},
    saveLead(){const f={...this.leadForm,company:String(this.leadForm.company||'').trim(),expectedBudget:Number(this.leadForm.expectedBudget||0),adQuote:Number(this.leadForm.adQuote||0),quoteCurrency:this.leadForm.quoteCurrency||this.leadForm.budgetCurrency||'USD'};if(!f.company)return;if(f.id){const i=this.leads.findIndex(l=>l.id===f.id);if(i>=0)this.leads[i]=f}else this.leads.unshift({...f,id:this.accountUid('lead')});this.persist();this.showLeadModal=false;this.notify('潜在客户已保存')},
    deleteLead(lead){this.askConfirm({title:'删除潜在客户',message:`确定删除【${lead.company}】吗？删除后该线索和跟进记录将无法恢复。`,confirmText:'确认删除'},()=>{this.leads=this.leads.filter(l=>l.id!==lead.id);this.persist();this.notify('潜在客户已删除')})},
    leadStageText(v){return({NEW:'新线索',CONTACTED:'已联系',QUALIFIED:'已确认需求',PROPOSAL:'报价 / 方案中',WON:'已成交',LOST:'已流失'})[v]||v},
    leadStageStyle(v){return({NEW:'bg-slate-100 text-slate-600',CONTACTED:'bg-blue-50 text-blue-700',QUALIFIED:'bg-cyan-50 text-cyan-700',PROPOSAL:'bg-violet-50 text-violet-700',WON:'bg-emerald-50 text-emerald-700',LOST:'bg-rose-50 text-rose-600'})[v]||'bg-slate-100 text-slate-600'},
    leadFollowupClass(lead){if(!lead.nextFollowUp)return'text-slate-400';return lead.nextFollowUp<=this.localDateKey()?'text-rose-600':'text-slate-700'},
    followupLabel(date){if(!date)return'';const d=this.daysUntil(date);if(d<0)return`已逾期 ${Math.abs(d)} 天`;if(d===0)return'今天跟进';if(d===1)return'明天跟进';return`${d} 天后跟进`},
    convertLeadToClient(lead){if(!lead)return;if(lead.convertedClientId){this.openConvertedLeadClient(lead);return}if(!this.canViewPage('client-form')){this.notify('当前角色没有创建正式客户权限');return}if(!this.isDirtyFormConfirmed(()=>this.convertLeadToClient(lead)))return;const quoteAmount=Math.max(0,Number(lead.adQuote||0));this.selectedClientId=null;this.form=this.createBlankForm({name:lead.company||'',product:'',platform:lead.platformInterest||'FB+TK',project:lead.notes?`潜客转正式：${lead.notes}`:'',currency:lead.quoteCurrency||lead.budgetCurrency||'USD',monthlyFee:quoteAmount,leadId:lead.id,startDate:this.localDateKey(),renewalAlertDay:25});this.formDirty=true;this.currentPage='client-form';this.showLeadModal=false;this.mobileMenuOpen=false;this.notify(quoteAmount>0?'已带入投放报价作为正式客户月服务费，请补齐合同与账号资料后创建客户':'请补齐正式客户资料后创建客户')},
    openConvertedLeadClient(lead){if(!lead?.convertedClientId){this.notify('该潜客还没有正式客户档案');return}const client=this.clients.find(c=>String(c.id)===String(lead.convertedClientId));if(!client){this.notify('对应正式客户档案不存在');return}this.selectedClientId=client.id;this.navigateTo('client-detail')},
    openProviderModal(provider=null){if(!this.canManageProviders()){this.notify('当前角色没有开户商管理权限');return}this.providerForm=provider?this.normalizeOpeningProvider(provider):{id:null,name:'',platforms:'FB+TK',region:'',website:'',contacts:[],policy:'',notes:''};this.showProviderModal=true},
    saveOpeningProvider(){if(!this.canManageProviders()){this.notify('当前角色没有开户商管理权限');return}const f=this.normalizeOpeningProvider(this.providerForm);f.name=String(f.name||'').trim();if(!f.name)return;if(!this.validateProviderForm())return;f.contactName=f.contacts?.[0]?.name||'';f.contactPhone=f.contacts?.[0]?.phone||'';f.contactWechat=f.contacts?.[0]?.wechat||'';f.contactEmail=f.contacts?.[0]?.email||'';f.rebateRate=Number(this.contactCurrentRebateRate(f.contacts?.[0])||0);f.rebatePolicy=this.rebatePolicyForContact(f.contacts?.[0],this.localDateKey())?.rebatePolicy||'';if(f.id){const i=this.openingProviders.findIndex(p=>String(p.id)===String(f.id));if(i>=0)this.openingProviders[i]=f}else{f.id=this.accountUid('provider');this.openingProviders.unshift(f)}this.openingDeals.forEach(deal=>{if(String(deal.providerId)===String(f.id)){deal.partnerName=f.name;const c=f.contacts.find(x=>String(x.id)===String(deal.contactId||''));if(c){deal.contactName=c.name;deal.contactInfo=this.providerContactText(c)}}});this.persist();this.showProviderModal=false;this.notify('开户商信息已保存')},
    deleteOpeningProvider(provider){if(!this.canManageProviders()){this.notify('当前角色没有开户商管理权限');return}if(this.openingDeals.some(d=>String(d.providerId)===String(provider.id))){this.notify('该开户商已有客户开户记录，不能直接删除。请先修改或删除相关开户记录。');return}this.askConfirm({title:'删除开户商',message:`确定删除【${provider.name}】吗？`,confirmText:'确认删除'},()=>{this.openingProviders=this.openingProviders.filter(p=>String(p.id)!==String(provider.id));this.persist();this.showProviderModal=false;this.notify('开户商已删除')})},
    applyProviderToOpeningForm(){const p=this.openingProvider(this.openingForm);if(p){this.openingForm.partnerName=p.name;if(!this.openingForm.region)this.openingForm.region=p.region||'';if(!this.openingForm.contactId||!p.contacts?.some(c=>String(c.id)===String(this.openingForm.contactId))){this.openingForm.contactId=p.contacts?.[0]?.id||''}this.applyOpeningContactToForm()}else{this.openingForm.contactId='';this.openingForm.contactName='';this.openingForm.contactInfo=''}},
    openingAccountOptions(form=this.openingForm){const client=this.clients.find(c=>String(c.id)===String(form?.clientId));if(!client)return[];const list=form?.platform==='TK'?(client.tkAccounts||[]):(client.fbAccounts||[]);return list.map((a,idx)=>({accountId:a.id,id:String(a.adAccountId||'').trim(),name:a.accountName||`${form?.platform==='TK'?'TikTok':'Facebook'} 账号 ${idx+1}`})).filter(x=>x.id)},
    openingAccountSelected(form,accountId){return String(form?.adAccountIds||'').split(/[\s,，;；]+/).map(x=>x.trim()).filter(Boolean).includes(String(accountId||''))},
    toggleOpeningAccount(accountId,checked){const set=new Set(String(this.openingForm.adAccountIds||'').split(/[\s,，;；]+/).map(x=>x.trim()).filter(Boolean));checked?set.add(String(accountId)):set.delete(String(accountId));this.openingForm.adAccountIds=[...set].join(', ')},
    syncOpeningAccountSelection(){if(!this.openingForm.clientId){this.openingForm.accountScope='SPECIFIC';return}if(this.openingForm.accountScope==='ALL'){this.openingForm.adAccountIds=this.openingAccountOptions(this.openingForm).map(a=>a.id).join(', ');return}const valid=new Set(this.openingAccountOptions(this.openingForm).map(a=>a.id)),kept=String(this.openingForm.adAccountIds||'').split(/[\s,，;；]+/).map(x=>x.trim()).filter(id=>valid.has(id));this.openingForm.adAccountIds=[...new Set(kept)].join(', ')},
    openOpeningModal(deal=null){const client=this.selectedAssetsClient||this.activeClients[0]||null;this.openingForm=deal?{...JSON.parse(JSON.stringify(deal)),accountScope:deal.accountScope||'SPECIFIC',effectiveStartDate:deal.effectiveStartDate||deal.submitDate||deal.expectedDate||this.localDateKey(),effectiveEndDate:deal.effectiveEndDate||''}:{id:null,clientId:client?.id||null,externalClientName:'',providerId:this.openingProviders[0]?.id||'',contactId:this.openingProviders[0]?.contacts?.[0]?.id||'',platform:client?.platform?.includes('FB')?'FB':'TK',accountType:'标准广告账户',region:'',quantity:1,currency:'USD',fee:0,status:'PREPARE',submitDate:this.localDateKey(),expectedDate:'',effectiveStartDate:this.localDateKey(),effectiveEndDate:'',businessId:'',adAccountIds:'',accountScope:'SPECIFIC',notes:''};this.applyProviderToOpeningForm();this.syncOpeningAccountSelection();this.showOpeningModal=true},
    saveOpeningDeal(){const f={...this.openingForm,quantity:Math.max(1,Number(this.openingForm.quantity)||1),fee:Number(this.openingForm.fee||0),accountScope:this.openingForm.clientId?(this.openingForm.accountScope||'SPECIFIC'):'SPECIFIC',effectiveStartDate:this.openingForm.effectiveStartDate||this.openingForm.submitDate||this.openingForm.expectedDate||this.localDateKey(),effectiveEndDate:this.openingForm.effectiveEndDate||''};if(!f.providerId){this.notify('请选择开户商渠道');return}const provider=this.openingProvider(f);if(provider?.contacts?.length&&!f.contactId){this.notify('请选择该开户商的对接人');return}if(f.effectiveEndDate&&f.effectiveEndDate<f.effectiveStartDate){this.notify('渠道结束日期不能早于生效日期');return}if(f.clientId){this.syncOpeningAccountSelection();f.adAccountIds=this.openingForm.adAccountIds;if(f.accountScope==='SPECIFIC'&&!this.openingDealAccountIds(f).length){this.notify('请至少选择一个广告账户，或将广告账户归属改为“当前平台全部账户”');return}if(this.openingDealUnmatchedIds(f).length){this.notify('存在未匹配客户资产的广告账户 ID，请重新选择广告账户');return}}f.partnerName=provider?.name||f.partnerName||'';const contact=provider?.contacts?.find(c=>String(c.id)===String(f.contactId));f.contactName=contact?.name||'';f.contactInfo=this.providerContactText(contact);if(f.id){const i=this.openingDeals.findIndex(d=>d.id===f.id);if(i>=0)this.openingDeals[i]=f}else this.openingDeals.unshift({...f,id:this.accountUid('opening')});const saved=this.openingDeals.find(d=>d.id===f.id)||this.openingDeals[0];this.syncOpeningFeeCost(saved);this.persist();this.showOpeningModal=false;this.notify(saved.status==='OPENED'&&Number(saved.fee||0)>0?'客户开户渠道已保存，开户费用已自动进入客户成本':'客户开户渠道已保存')},
    deleteOpeningDeal(deal){const linkedCost=this.financeCosts.find(c=>c.sourceType==='OPENING_DEAL'&&String(c.sourceId)===String(deal.id));if(linkedCost&&this.isMonthLocked(String(linkedCost.date||'').slice(0,7))){this.notify('该开户记录对应的开户费成本月份已月结，不能删除。请先由管理员解锁对应月份。');return}this.askConfirm({title:'删除开户记录',message:`确定删除【${this.openingClientName(deal)} · ${this.openingProviderName(deal)}】的开户记录吗？关联的自动开户费成本也会同步删除。`,confirmText:'确认删除'},()=>{this.openingDeals=this.openingDeals.filter(d=>d.id!==deal.id);this.financeCosts=this.financeCosts.filter(c=>!(c.sourceType==='OPENING_DEAL'&&String(c.sourceId)===String(deal.id)));this.persist();this.notify('开户记录及关联自动成本已删除')})},
    normalizeAccount(account,platform,idx=0){const a=account?JSON.parse(JSON.stringify(account)):{};const prefix=platform==='FB'?'FB':'TK';return{...a,id:a.id||this.accountUid(prefix.toLowerCase()),accountName:a.accountName||`${prefix} 账号 ${idx+1}`,bmId:platform==='FB'?(a.bmId||''):undefined,bcId:platform==='TK'?(a.bcId||''):undefined,adAccountId:a.adAccountId||'',loginAccount:a.loginAccount||'',loginPassword:a.loginPassword||'',rebateMode:a.rebateMode||'CHANNEL',adSpendCurrency:a.adSpendCurrency||'USD',adSpend:Number(a.adSpend||0),spendRecords:Array.isArray(a.spendRecords)?a.spendRecords:[],rechargeHistory:Array.isArray(a.rechargeHistory)?a.rechargeHistory:[],adDataRecords:Array.isArray(a.adDataRecords)?a.adDataRecords:[],data:a.data||null}},
    normalizeNetworkEnvironment(env,idx=0){const e=env?JSON.parse(JSON.stringify(env)):{};return{...e,id:e.id||this.accountUid('net'),networkName:e.networkName||`网络环境 ${idx+1}`,ipEnvironment:e.ipEnvironment||'',ipDueDate:e.ipDueDate||'',ipCurrency:e.ipCurrency||'USD',ipMonthlyFee:Number(e.ipMonthlyFee||0),autoCost:e.autoCost!==false}},
    normalizeExternalAssetAccount(account,type,idx=0){const a=account?JSON.parse(JSON.stringify(account)):{};if(type==='GOOGLE')return{...a,id:a.id||this.accountUid('google'),accountName:a.accountName||`Google 账号 ${idx+1}`,customerId:a.customerId||'',mccId:a.mccId||'',loginAccount:a.loginAccount||'',loginPassword:a.loginPassword||'',note:a.note||''};return{...a,id:a.id||this.accountUid('instagram'),accountName:a.accountName||`Instagram 账号 ${idx+1}`,username:a.username||'',profileId:a.profileId||'',loginAccount:a.loginAccount||'',loginPassword:a.loginPassword||'',note:a.note||''}},
    normalizeClient(client){const c=JSON.parse(JSON.stringify(client||{}));if(!Array.isArray(c.fbAccounts)){c.fbAccounts=[];if(c.fbBmId||c.fbAdAccountId||c.fbLoginAccount||c.fbLoginPassword)c.fbAccounts.push({bmId:c.fbBmId,adAccountId:c.fbAdAccountId,loginAccount:c.fbLoginAccount,loginPassword:c.fbLoginPassword,adSpend:Number(c.fbData?.spend||0),data:c.fbData||null})}if(!Array.isArray(c.tkAccounts)){c.tkAccounts=[];if(c.tkBcId||c.tkAdAccountId||c.tkLoginAccount||c.tkLoginPassword)c.tkAccounts.push({bcId:c.tkBcId,adAccountId:c.tkAdAccountId,loginAccount:c.tkLoginAccount,loginPassword:c.tkLoginPassword,adSpend:Number(c.tkData?.spend||0),data:c.tkData||null})}c.fbAccounts=c.fbAccounts.map((a,i)=>this.normalizeAccount(a,'FB',i));c.tkAccounts=c.tkAccounts.map((a,i)=>this.normalizeAccount(a,'TK',i));if(!Array.isArray(c.networkEnvironments)){c.networkEnvironments=[];if(c.networkName||c.ipEnvironment||c.ipDueDate||Number(c.ipMonthlyFee||0)>0)c.networkEnvironments.push({networkName:c.networkName,ipEnvironment:c.ipEnvironment,ipDueDate:c.ipDueDate,ipCurrency:c.ipCurrency,ipMonthlyFee:c.ipMonthlyFee})}c.networkEnvironments=c.networkEnvironments.map((e,i)=>this.normalizeNetworkEnvironment(e,i));c.googleAccounts=(Array.isArray(c.googleAccounts)?c.googleAccounts:[]).map((a,i)=>this.normalizeExternalAssetAccount(a,'GOOGLE',i));c.instagramAccounts=(Array.isArray(c.instagramAccounts)?c.instagramAccounts:[]).map((a,i)=>this.normalizeExternalAssetAccount(a,'INSTAGRAM',i));c.renewalHistory=Array.isArray(c.renewalHistory)?c.renewalHistory:[];c.adCampaigns=Array.isArray(c.adCampaigns)?c.adCampaigns:[];c.archived=!!c.archived;c.sopAccountConfigs=c.sopAccountConfigs&&typeof c.sopAccountConfigs==='object'?c.sopAccountConfigs:{};if(!Object.keys(c.sopAccountConfigs).length){const legacySteps=Array.isArray(c.sopSteps)?c.sopSteps:[];[...c.fbAccounts.map(a=>`FB:${a.id}`),...c.tkAccounts.map(a=>`TK:${a.id}`)].forEach(key=>{c.sopAccountConfigs[key]={dailyPlan:'',notes:c.riskRules||'',steps:legacySteps.map((text,idx)=>({id:`${key}-${idx}-${Math.random().toString(36).slice(2,6)}`,text,plan:''})),dailyTasks:{}}})}Object.values(c.sopAccountConfigs).forEach(cfg=>{cfg.dailyPlan=cfg.dailyPlan||'';cfg.notes=cfg.notes||'';cfg.steps=Array.isArray(cfg.steps)?cfg.steps:[];cfg.dailyTasks=cfg.dailyTasks&&typeof cfg.dailyTasks==='object'?cfg.dailyTasks:{};Object.keys(cfg.dailyTasks).forEach(date=>{cfg.dailyTasks[date]=Array.isArray(cfg.dailyTasks[date])?cfg.dailyTasks[date].map(task=>({id:task?.id||this.accountUid('sop-task'),text:String(task?.text||''),plan:String(task?.plan||''),note:String(task?.note||''),createdAt:task?.createdAt||new Date().toISOString()})):[]})});c.billingMode=c.billingMode||'FULL_MONTH';c.renewalAlertDay=Number(c.renewalAlertDay||25);delete c.fbBmId;delete c.fbAdAccountId;delete c.fbLoginAccount;delete c.fbLoginPassword;delete c.tkBcId;delete c.tkAdAccountId;delete c.tkLoginAccount;delete c.tkLoginPassword;delete c.networkName;delete c.ipEnvironment;delete c.ipDueDate;delete c.ipCurrency;delete c.ipMonthlyFee;return c},
    accountRebateMode(account){return account?.rebateMode==='NONE'?'NONE':'CHANNEL'},
    accountRebateModeText(account){return this.accountRebateMode(account)==='NONE'?'无返点 / 客户自有账户':'有渠道返点'},
    createBlankForm(overrides={}){return this.normalizeClient({id:null,name:'',product:'',platform:'FB+TK',project:'',currency:'USD',monthlyFee:0,billingMode:'FULL_MONTH',startDate:'',endDate:'',renewalAlertDay:25,status:'ACTIVE',archived:false,leadId:null,fbAccounts:[],tkAccounts:[],networkEnvironments:[],googleAccounts:[],instagramAccounts:[],sopSteps:[],riskRules:'',renewalHistory:[],...overrides})},
    isDirtyFormConfirmed(callback){if(this.currentPage==='client-form'&&this.formDirty){this.askConfirm({title:'放弃未保存的客户修改？',message:'当前客户表单有尚未保存的修改，继续切换页面会丢失这些内容。',confirmText:'放弃修改',tone:'warning'},()=>{this.formDirty=false;callback()});return false}return true},
    accountUid(prefix){return `${prefix}-${Date.now().toString(36)}-${Math.random().toString(36).slice(2,7)}`},
    addPlatformAccount(platform){const key=platform==='FB'?'fbAccounts':'tkAccounts';if(!Array.isArray(this.form[key]))this.form[key]=[];this.form[key].push(this.normalizeAccount({},platform,this.form[key].length))},
    removePlatformAccount(platform,index){const key=platform==='FB'?'fbAccounts':'tkAccounts',arr=this.form[key];if(!Array.isArray(arr))return;const account=arr[index];this.askConfirm({title:'删除账号资产',message:`确定删除【${account?.accountName||`${platform} 账号 ${index+1}`}】吗？对应的账号登录资料将一并移除。`,confirmText:'确认删除'},()=>{this.form[key].splice(index,1);this.notify('账号资产已删除')})},
    addNetworkEnvironment(){if(!Array.isArray(this.form.networkEnvironments))this.form.networkEnvironments=[];this.form.networkEnvironments.push(this.normalizeNetworkEnvironment({},this.form.networkEnvironments.length))},
    removeNetworkEnvironment(index){const env=this.form.networkEnvironments?.[index];if(!env)return;this.askConfirm({title:'删除网络环境',message:`确定删除【${env.networkName||`网络环境 ${index+1}`}】吗？IP 到期和月费信息会一并移除。`,confirmText:'确认删除'},()=>{this.form.networkEnvironments.splice(index,1);this.notify('网络环境已删除')})},
    externalAssetList(client,type){if(!client)return[];return type==='GOOGLE'?(client.googleAccounts||[]): (client.instagramAccounts||[])},
    externalAssetName(type){return type==='GOOGLE'?'Google':'Instagram'},
    externalAssetIcon(type){return type==='GOOGLE'?'fa-brands fa-google':'fa-brands fa-instagram'},
    openExternalAssetModal(type,account=null){if(!this.selectedAssetsClient){this.notify('请先选择客户');return}this.externalAssetType=type;this.externalAssetForm=account?JSON.parse(JSON.stringify(account)):(type==='GOOGLE'?{id:null,accountName:'',customerId:'',mccId:'',loginAccount:'',loginPassword:'',note:''}:{id:null,accountName:'',username:'',profileId:'',loginAccount:'',loginPassword:'',note:''});this.showExternalAssetModal=true},
    saveExternalAsset(){const client=this.selectedAssetsClient;if(!client)return;const type=this.externalAssetType,key=type==='GOOGLE'?'googleAccounts':'instagramAccounts';client[key]=Array.isArray(client[key])?client[key]:[];const normalized=this.normalizeExternalAssetAccount(this.externalAssetForm,type,client[key].length);normalized.accountName=String(normalized.accountName||'').trim();if(!normalized.accountName){this.notify('请输入账号名称');return}if(normalized.id){const idx=client[key].findIndex(a=>String(a.id)===String(normalized.id));if(idx>=0)client[key][idx]=normalized;else client[key].push(normalized)}else client[key].push({...normalized,id:this.accountUid(type==='GOOGLE'?'google':'instagram')});this.persist();this.showExternalAssetModal=false;this.notify(`${this.externalAssetName(type)} 账号已保存`)},
    deleteExternalAsset(type,account){const client=this.selectedAssetsClient;if(!client||!account)return;const key=type==='GOOGLE'?'googleAccounts':'instagramAccounts';this.askConfirm({title:`删除 ${this.externalAssetName(type)} 账号`,message:`确定删除【${account.accountName||this.externalAssetName(type)+' 账号'}】吗？该账号登录资料会一并删除。`,confirmText:'确认删除'},()=>{client[key]=(client[key]||[]).filter(a=>String(a.id)!==String(account.id));this.setAssetPagerIndex('assets',type,0,client[key].length);this.persist();this.notify(`${this.externalAssetName(type)} 账号已删除`)})},
    deleteAssetAccount(platform,account){const client=this.selectedAssetsClient;if(!client||!account)return;const key=platform==='FB'?'fbAccounts':'tkAccounts';const isAccountReferenced=this.openingDeals.some(d=>String(d.clientId)===String(client.id)&&d.platform===platform&&this.openingDealAccountIds(d).includes(String(account.adAccountId||'').trim())),hasCampaign=(client.adCampaigns||[]).some(c=>c.platform===platform&&String(c.accountId)===String(account.id)),hasData=(account.adDataRecords||[]).length>0,hasRecharge=(account.rechargeHistory||[]).length>0;if(isAccountReferenced||hasCampaign||hasData||hasRecharge){const reasons=[];if(isAccountReferenced)reasons.push('开户渠道');if(hasCampaign)reasons.push('广告方案');if(hasData)reasons.push('广告数据');if(hasRecharge)reasons.push('充值记录');this.notify(`该账号仍被 ${reasons.join(' / ')} 使用，不能直接删除。请先处理关联数据。`);return}this.askConfirm({title:`删除 ${platform==='FB'?'Facebook':'TikTok'} 账号`,message:`确定删除【${account.accountName||account.adAccountId||'未命名账号'}】吗？登录资料会一并移除。`,confirmText:'确认删除'},()=>{client[key]=(client[key]||[]).filter(a=>String(a.id)!==String(account.id));this.setAssetPagerIndex('assets',platform,0,client[key].length);this.persist();this.syncAnalyticsAccountSelection();this.syncAdsAccountSelection();this.syncSopAccountSelection(true);this.notify('账号资产已删除')})},
    globalAccountCards(){return this.clients.flatMap(c=>[...c.fbAccounts.map(a=>({client:c,platform:'FB',platformName:'Facebook',account:a})),...c.tkAccounts.map(a=>({client:c,platform:'TK',platformName:'TikTok',account:a}))])},
    assetClients(platform){return this.clients.filter(c=>platform==='FB'?c.fbAccounts.length>0:c.tkAccounts.length>0)},
    selectedAssetIndex(scope,platform,length){const idx=Number(this.assetPager?.[scope]?.[platform]||0);if(length<=0)return 0;return Math.min(Math.max(0,idx),length-1)},
    setAssetPagerIndex(scope,platform,index,length){const next=length<=0?0:Math.min(Math.max(0,index),length-1);this.assetPager[scope][platform]=next},
    shiftAssetPager(scope,platform,delta,length){this.setAssetPagerIndex(scope,platform,this.selectedAssetIndex(scope,platform,length)+delta,length)},
    resetAssetPager(scope){['FB','TK','GOOGLE','INSTAGRAM'].forEach(p=>{if(this.assetPager?.[scope])this.assetPager[scope][p]=0})},
    clampedAssetPagerIndex(scope,platform,length){const idx=this.selectedAssetIndex(scope,platform,length);if(this.assetPager?.[scope]&&this.assetPager[scope][platform]!==idx)this.assetPager[scope][platform]=idx;return idx},
    daysUntil(date){if(!date)return 999;const target=new Date(`${date}T12:00:00`),now=new Date(),today=new Date(now.getFullYear(),now.getMonth(),now.getDate(),12);return Math.ceil((target-today)/86400000)},
    formatMoney(v,c='USD'){return new Intl.NumberFormat(c==='CNY'?'zh-CN':'en-US',{style:'currency',currency:c,maximumFractionDigits:0}).format(Number(v)||0)},
    clientSpendGroups(c,mode='TOTAL'){const g={};[...c.fbAccounts,...c.tkAccounts].forEach(a=>{if(mode==='SPEND')this.mergeSpendGroups(g,this.accountSpendGroups(a));else if(mode==='RECHARGE')this.mergeSpendGroups(g,this.accountRechargeGroups(a));else this.mergeSpendGroups(g,this.accountSpendGroups(a))});return g},
    clientSpendText(c){return this.spendGroupsText(this.clientSpendGroups(c,'SPEND'))},
    clientRechargeText(c){const g={};[...c.fbAccounts,...c.tkAccounts].forEach(a=>this.mergeSpendGroups(g,this.accountRechargeGroups(a)));return this.spendGroupsText(g)},
    monthlySpendText(c){return this.clientSpendText(c)},
    adBalanceGroups(c){const g={};[...c.fbAccounts,...c.tkAccounts].forEach(a=>{const r=this.accountRechargeGroups(a),s=this.accountSpendGroups(a);new Set([...Object.keys(r),...Object.keys(s)]).forEach(cur=>g[cur]=(g[cur]||0)+Number(r[cur]||0)-Number(s[cur]||0))});return g},
    adBalanceText(c){return this.spendGroupsText(this.adBalanceGroups(c))},
    trendInfo(c){const now=this.clientSpendGroups(c,'SPEND'),prev=this.clientPreviousSpendGroups(c),cur=Number(now.USD||now.CNY||0),old=Number(prev.USD||prev.CNY||0);if(!old&&!cur)return{label:'暂无',className:'text-slate-400'};if(!old)return{label:'+100%',className:'text-rose-500'};const pct=(cur-old)/old*100;return{label:`${pct>=0?'+':''}${pct.toFixed(1)}%`,className:pct>10?'text-rose-500':pct<0?'text-emerald-600':'text-slate-500'}},
    clientPreviousSpendGroups(c){const g={};[...c.fbAccounts,...c.tkAccounts].forEach(a=>{(a.adDataRecords||[]).filter(r=>!this.isCurrentMonth(r.date)).forEach(r=>g[r.currency||'USD']=(g[r.currency||'USD']||0)+Number(r.spend||0))});return g},
    isCurrentMonth(date){return String(date||'').slice(0,7)===new Date().toISOString().slice(0,7)},
    accountSpendGroups(a){const g={};(a?.adDataRecords||[]).forEach(r=>g[r.currency||a.adSpendCurrency||'USD']=(g[r.currency||a.adSpendCurrency||'USD']||0)+Number(r.spend||0));if(!Object.keys(g).length&&Number(a?.adSpend||0)>0)g[a.adSpendCurrency||'USD']=Number(a.adSpend||0);return g},
    accountSpendText(a){return this.spendGroupsText(this.accountSpendGroups(a))},
    accountRechargeGroups(a){const g={};(a?.rechargeHistory||[]).forEach(r=>g[r.currency||'USD']=(g[r.currency||'USD']||0)+Number(r.amount||0));return g},
    accountRechargeText(a){return this.spendGroupsText(this.accountRechargeGroups(a))},
    accountUsdBalance(a){return Number(this.accountRechargeGroups(a).USD||0)-Number(this.accountSpendGroups(a).USD||0)},
    accountLowBalanceLevel(a){const recharge=Number(this.accountRechargeGroups(a).USD||0);if(recharge<=0)return 0;const balance=this.accountUsdBalance(a);if(balance<=30)return 2;if(balance<=100)return 1;return 0},
    accountLowBalanceText(a){const level=this.accountLowBalanceLevel(a),balance=this.formatMoney(this.accountUsdBalance(a),'USD');return level===2?`二次紧急提醒 · 余额 ${balance}`:level===1?`首次充值提醒 · 余额 ${balance}`:''},
    spendGroups(list){const g={};list.forEach(a=>this.mergeSpendGroups(g,this.accountSpendGroups(a)));return g},
    rechargeGroups(list){const g={};list.forEach(a=>this.mergeSpendGroups(g,this.accountRechargeGroups(a)));return g},
    spendGroupsFromRecords(records){const g={};(records||[]).forEach(r=>g[r.currency||'USD']=(g[r.currency||'USD']||0)+Number(r.spend||0));return g},
    adRecordMetrics(record){const spend=Number(record?.spend||0),impressions=Number(record?.impressions||0),reach=Number(record?.reach||0),clicks=Number(record?.clicks||0),leads=Number(record?.leads||0),conversions=Number(record?.conversions||0),revenue=Number(record?.revenue||0),frequency=reach>0?impressions/reach:0,ctr=impressions>0?clicks/impressions*100:0,cpc=clicks>0?spend/clicks:0,cvr=clicks>0?conversions/clicks*100:0,cpa=conversions>0?spend/conversions:0,cpm=impressions>0?spend/impressions*1000:0,roas=spend>0?revenue/spend:0;return{spend,impressions,reach,clicks,leads,conversions,revenue,cpm,frequency,ctr,cpc,cvr,cpa,roas,cpmText:impressions>0?this.formatMoney(cpm,record?.currency||'USD'):'—',reachText:reach>0?reach.toLocaleString():'—',frequencyText:reach>0?frequency.toFixed(2):'—',ctrText:impressions>0?`${ctr.toFixed(2)}%`:'—',cpcText:clicks>0?this.formatMoney(cpc,record?.currency||'USD'):'—',cvrText:clicks>0?`${cvr.toFixed(2)}%`:'—',cpaText:conversions>0?this.formatMoney(cpa,record?.currency||'USD'):'—',roasText:spend>0?roas.toFixed(2):'—'}},
    percentText(value){if(value===undefined||value===null||value==='')return'—';return`${Number(value||0).toFixed(2)}%`},
    adDataDraftMetrics(){return this.adRecordMetrics({...this.adDataForm,currency:this.adDataForm?.currency||'USD'})},
