    revenueGroupsFromRecords(records){const g={};(records||[]).forEach(r=>g[r.currency||'USD']=(g[r.currency||'USD']||0)+Number(r.revenue||0));return g},
    adDataDates(a){return[...new Set((a?.adDataRecords||[]).map(r=>r.date).filter(Boolean))].sort((x,y)=>String(y).localeCompare(String(x)))},
    analyticsMetricsForAccount(account,platform){if(!account)return null;const records=account.adDataRecords||[];if(records.length){const s=this.accountDataSummary(account);return{spend:s.spend,currency:records[0]?.currency||'USD',impressions:s.impressions,reach:s.reach,clicks:s.clicks,conversions:s.conversions,leads:s.leads,cpl:s.leads?s.cpl.toFixed(2):0,ctr:s.impressions?s.ctr.toFixed(2):0,cpm:s.impressions?s.cpm.toFixed(2):0,frequency:s.reach?s.frequency.toFixed(2):0,cpc:s.clicks?s.cpc.toFixed(2):0,cvr:s.clicks?s.cvr.toFixed(2):0,cpa:s.conversions?s.cpa.toFixed(2):0,roas:s.spend?s.roas.toFixed(2):0,video3sRate:this.averageRecordMetric(records,'video3sRate'),video25Rate:this.averageRecordMetric(records,'video25Rate'),video50Rate:this.averageRecordMetric(records,'video50Rate'),video75Rate:this.averageRecordMetric(records,'video75Rate'),video95Rate:this.averageRecordMetric(records,'video95Rate'),videoCompleteRate:this.averageRecordMetric(records,'videoCompleteRate')}}const legacy=account.data;if(!legacy)return null;const spend=Number(this.accountSpendGroups(account).USD||this.accountSpendGroups(account).CNY||legacy.spend||0),impressions=Number(String(legacy.impressions||'0').replace(/,/g,''))||0,clicks=legacy.clicks!==undefined?Number(legacy.clicks||0):impressions*Number(legacy.ctr||0)/100,conversions=legacy.conversions!==undefined?Number(legacy.conversions||0):Number(legacy.leads||0),cpm=impressions?spend/impressions*1000:Number(legacy.cpm||0),cpc=clicks?spend/clicks:Number(legacy.cpc||0),cvr=clicks?conversions/clicks*100:Number(legacy.cvr||0),cpa=conversions?spend/conversions:Number(legacy.cpa||legacy.cpl||0);return{...legacy,spend,impressions,clicks,conversions,cpm:cpm?cpm.toFixed(2):0,cpc:cpc?cpc.toFixed(2):0,cvr:cvr?cvr.toFixed(2):0,cpa:cpa?cpa.toFixed(2):0}},
    averageRecordMetric(records,key){const values=(records||[]).map(r=>Number(r?.[key])).filter(v=>Number.isFinite(v)&&v>=0);if(!values.length)return 0;return Number((values.reduce((a,b)=>a+b,0)/values.length).toFixed(2))},
    aggregateAccountsMetrics(accounts){const list=accounts||[],records=list.flatMap(a=>a.adDataRecords||[]);if(records.length){const spendGroups=this.spendGroupsFromRecords(records),spend=Object.values(spendGroups).reduce((s,v)=>s+Number(v||0),0),impressions=records.reduce((s,r)=>s+Number(r.impressions||0),0),reach=records.reduce((s,r)=>s+Number(r.reach||0),0),clicks=records.reduce((s,r)=>s+Number(r.clicks||0),0),leads=records.reduce((s,r)=>s+Number(r.leads||0),0),conversions=records.reduce((s,r)=>s+Number(r.conversions||0),0),revenue=records.reduce((s,r)=>s+Number(r.revenue||0),0),ctr=impressions?clicks/impressions*100:0,cpl=leads?spend/leads:0,roas=spend?revenue/spend:0,frequency=reach?impressions/reach:0,cpc=clicks?spend/clicks:0,cvr=clicks?conversions/clicks*100:0,cpa=conversions?spend/conversions:0,cpm=impressions?spend/impressions*1000:0;return{spendText:this.spendGroupsText(spendGroups),impressions,reach,clicks,leads,conversions,revenue,ctrText:impressions?`${ctr.toFixed(2)}%`:'—',cplText:leads?`$${cpl.toFixed(2)}`:'—',roasText:spend?roas.toFixed(2):'—',frequencyText:reach?frequency.toFixed(2):'—',cpcText:clicks?`$${cpc.toFixed(2)}`:'—',cvrText:clicks?`${cvr.toFixed(2)}%`:'—',cpaText:conversions?`$${cpa.toFixed(2)}`:'—',cpmText:impressions?`$${cpm.toFixed(2)}`:'—',video3sRateText:this.percentText(this.averageRecordMetric(records,'video3sRate')),videoCompleteRateText:this.percentText(this.averageRecordMetric(records,'videoCompleteRate'))}}const metrics=list.map(a=>this.analyticsMetricsForAccount(a)).filter(Boolean);if(!metrics.length)return null;const spend=metrics.reduce((s,m)=>s+Number(m.spend||0),0),impressions=metrics.reduce((s,m)=>s+Number(String(m.impressions||0).replace(/,/g,'')),0),clicks=metrics.reduce((s,m)=>s+Number(m.clicks||0),0),leads=metrics.reduce((s,m)=>s+Number(m.leads||0),0),conversions=metrics.reduce((s,m)=>s+Number(m.conversions||m.leads||0),0),weightedRoas=spend?metrics.reduce((s,m)=>s+Number(m.roas||0)*Number(m.spend||0),0)/spend:0,cpm=impressions?spend/impressions*1000:0,cpc=clicks?spend/clicks:0,cvr=clicks?conversions/clicks*100:0,cpa=conversions?spend/conversions:0;return{spendText:this.spendGroupsText(this.spendGroups(list)),impressions,clicks,leads,conversions,ctrText:impressions?`${(clicks/impressions*100).toFixed(2)}%`:'—',cplText:leads?`$${(spend/leads).toFixed(2)}`:'—',roasText:weightedRoas?weightedRoas.toFixed(2):'—',frequencyText:'—',cpcText:clicks?`$${cpc.toFixed(2)}`:'—',cvrText:clicks?`${cvr.toFixed(2)}%`:'—',cpaText:conversions?`$${cpa.toFixed(2)}`:'—',cpmText:impressions?`$${cpm.toFixed(2)}`:'—',video3sRateText:'—',videoCompleteRateText:'—'}},
    campaignBudgetGroups(campaign){const g={};(campaign?.adSets||[]).forEach(a=>g[a.budgetCurrency||'USD']=(g[a.budgetCurrency||'USD']||0)+Number(a.budget||0));return g},
    campaignBudgetText(campaign){return this.spendGroupsText(this.campaignBudgetGroups(campaign))},
    campaignAdCount(campaign){return(campaign?.adSets||[]).reduce((n,a)=>n+(a.ads||[]).length,0)},
    campaignDataRecords(campaign){const account=this.selectedAdsAccounts.find(a=>String(a.id)===String(campaign?.accountId))||this.selectedAdsAccount;return(account?.adDataRecords||[]).filter(r=>r.campaignId===campaign?.id)},
    campaignDataRecordCount(campaign){return this.campaignDataRecords(campaign).length},
    campaignDataSpendText(campaign){return this.spendGroupsText(this.spendGroupsFromRecords(this.campaignDataRecords(campaign)))},
    adSetDataSpendText(campaign,adset){return this.spendGroupsText(this.spendGroupsFromRecords(this.campaignDataRecords(campaign).filter(r=>!r.adSetId||r.adSetId===adset.id)))},
    adSetDetailSpendText(campaign,adset){return this.adSetDataSpendText(campaign,adset)},
    objectiveLabel(v){return({TRAFFIC:'流量',ENGAGEMENT:'互动',LEADS:'潜在客户'})[v]||v},
    deliveryMethodLabel(v){return({AUTO:'自动投放',MANUAL:'手动定向'})[v]||v},
    creativeFormatLabel(v){return({PHOTO:'照片',VIDEO:'视频'})[v]||v},
    genderLabel(v){return({ALL:'不限',MALE:'男性',FEMALE:'女性'})[v]||v},
    callToActionLabel(v){return({LEARN_MORE:'了解更多',CONTACT_US:'联系我们',GET_QUOTE:'获取报价',SIGN_UP:'注册',APPLY_NOW:'立即申请',SHOP_NOW:'立即购买',DOWNLOAD:'下载'})[v]||v},
    syncAnalyticsAccountSelection(){const c=this.selectedAnalyticsClient;if(!c){this.selectedAnalyticsFbAccountId=null;this.selectedAnalyticsTkAccountId=null;return}if(!(c.fbAccounts||[]).some(a=>String(a.id)===String(this.selectedAnalyticsFbAccountId)))this.selectedAnalyticsFbAccountId=c.fbAccounts?.[0]?.id||null;if(!(c.tkAccounts||[]).some(a=>String(a.id)===String(this.selectedAnalyticsTkAccountId)))this.selectedAnalyticsTkAccountId=c.tkAccounts?.[0]?.id||null},
    selectAnalyticsClient(id){this.selectedAnalyticsClientId=Number(id);this.syncAnalyticsAccountSelection()},
    selectAdsClient(id){this.selectedAdsClientId=Number(id);this.syncAdsAccountSelection()},
    latestRechargeLabel(a){const r=(a?.rechargeHistory||[])[0];return r?`${r.date} · ${this.formatMoney(r.amount,r.currency)}`:'暂无充值记录'},
    latestRechargeDate(a){const r=(a?.rechargeHistory||[])[0];return r?.date||'暂无'},
    openRechargeModal(client,platform,account){this.rechargeForm={clientId:client.id,platform,accountId:account.id,clientName:client.name,accountName:account.accountName||account.adAccountId||'未命名账户',currency:'USD',amount:'',date:this.localDateKey(),note:''};this.showRechargeModal=true},
    saveRecharge(){const c=this.clients.find(c=>c.id===this.rechargeForm.clientId),list=this.rechargeForm.platform==='FB'?(c?.fbAccounts||[]):(c?.tkAccounts||[]),a=list.find(a=>a.id===this.rechargeForm.accountId),amount=Number(this.rechargeForm.amount||0);if(!a||amount<=0)return;a.rechargeHistory=Array.isArray(a.rechargeHistory)?a.rechargeHistory:[];a.rechargeHistory.unshift({id:this.accountUid('recharge'),date:this.rechargeForm.date||this.localDateKey(),currency:this.rechargeForm.currency||'USD',amount,note:this.rechargeForm.note||''});this.persist();this.showRechargeModal=false;this.notify('广告充值已登记')},
    syncAdsAccountSelection(){const c=this.selectedAdsClient;if(!c){this.selectedAdsAccountId=null;return}if(this.selectedAdsPlatform==='FB'&&!(c.fbAccounts||[]).length&&c.tkAccounts?.length)this.selectedAdsPlatform='TK';if(this.selectedAdsPlatform==='TK'&&!(c.tkAccounts||[]).length&&c.fbAccounts?.length)this.selectedAdsPlatform='FB';const list=this.selectedAdsPlatform==='FB'?(c.fbAccounts||[]):(c.tkAccounts||[]);if(!list.some(a=>a.id===this.selectedAdsAccountId))this.selectedAdsAccountId=list[0]?.id||null},
    addAdCampaign(){if(!this.selectedAdsClient||!this.selectedAdsAccount)return;const c=this.selectedAdsClient;c.adCampaigns=Array.isArray(c.adCampaigns)?c.adCampaigns:[];c.adCampaigns.unshift({id:this.accountUid('campaign'),platform:this.selectedAdsPlatform,accountId:this.selectedAdsAccount.id,planName:'新广告方案',name:'新广告系列',objective:'LEADS',planNotes:'',isSaved:false,createdAt:new Date().toISOString(),updatedAt:new Date().toISOString(),adSets:[]});this.persist();this.notify('已创建广告方案编辑器')},
    saveAdsPlan(campaign){if(!campaign)return;campaign.planName=String(campaign.planName||campaign.name||'').trim();campaign.name=String(campaign.name||'').trim();if(!campaign.planName||!campaign.name){this.notify('请填写方案名称和广告系列名称');return}campaign.isSaved=true;campaign.savedAt=campaign.savedAt||new Date().toISOString();campaign.updatedAt=new Date().toISOString();this.persist();this.notify('广告方案已保存到列表')},
    editAdCampaign(campaign){campaign.isSaved=false;campaign.updatedAt=new Date().toISOString();this.persist();this.notify('广告方案已切换为编辑状态')},
    removeAdCampaign(campaign){this.askConfirm({title:'删除广告方案',message:`确定删除【${campaign.planName||campaign.name}】吗？该方案下的广告数据记录会保留在账号历史中，但方案本身将被移除。`,confirmText:'确认删除'},()=>{const c=this.selectedAdsClient;c.adCampaigns=(c.adCampaigns||[]).filter(x=>x.id!==campaign.id);this.persist();this.notify('广告方案已删除')})},
    addAdSet(campaign){campaign.adSets=Array.isArray(campaign.adSets)?campaign.adSets:[];campaign.adSets.push({id:this.accountUid('adset'),name:`广告组 ${campaign.adSets.length+1}`,deliveryMethod:'AUTO',country:'',gender:'ALL',ageMin:18,ageMax:65,interests:'',budgetCurrency:'USD',budget:0,ads:[]});campaign.updatedAt=new Date().toISOString();this.persist()},
    removeAdSet(campaign,adset){campaign.adSets=(campaign.adSets||[]).filter(x=>x.id!==adset.id);campaign.updatedAt=new Date().toISOString();this.persist()},
    addCreative(adset){adset.ads=Array.isArray(adset.ads)?adset.ads:[];adset.ads.push({id:this.accountUid('ad'),name:`广告 ${adset.ads.length+1}`,format:'PHOTO',primaryText:'',headline:'',description:'',callToAction:'LEARN_MORE'});this.persist()},
    removeCreative(adset,ad){adset.ads=(adset.ads||[]).filter(x=>x.id!==ad.id);this.persist()},
    openAdsPlanDetail(campaign){this.selectedPlanDetail=JSON.parse(JSON.stringify(campaign));this.showAdsPlanDetailModal=true},
    defaultAdDataForm(campaign=null){const c=campaign||this.savedAdsCampaignsForAccount[0]||null;return{date:this.localDateKey(),campaignId:c?.id||'',adSetId:'',adId:'',currency:'USD',spend:'',impressions:'',reach:'',clicks:'',leads:'',conversions:'',revenue:'',video3sRate:'',video25Rate:'',video50Rate:'',video75Rate:'',video95Rate:'',videoCompleteRate:'',note:''}},
    openAdDataModal(campaign=null){if(!this.selectedAdsAccount){this.notify('请先选择广告账户');return}if(!this.savedAdsCampaignsForAccount.length){this.notify('请先保存至少一个广告方案');return}this.editingAdDataRecordId=null;this.adDataForm=this.defaultAdDataForm(campaign);this.syncAdDataSelections();this.showAdDataModal=true},
    editAdDataRecord(record){this.editingAdDataRecordId=record.id;this.adDataForm={...this.defaultAdDataForm(),...JSON.parse(JSON.stringify(record))};this.syncAdDataSelections();this.showAdDataModal=true},
    syncAdDataSelections(){const campaign=this.savedAdsCampaignsForAccount.find(c=>c.id===this.adDataForm.campaignId);if(!campaign){this.adDataForm.adSetId='';this.adDataForm.adId='';return}if(!campaign.adSets?.some(a=>a.id===this.adDataForm.adSetId))this.adDataForm.adSetId='';this.syncAdDataAdSelection()},
    syncAdDataAdSelection(){const adset=this.adDataAdSets.find(a=>a.id===this.adDataForm.adSetId);if(!adset?.ads?.some(ad=>ad.id===this.adDataForm.adId))this.adDataForm.adId=''},
    adDataRecordKey(record){return[record?.date||'',record?.campaignId||'',record?.adSetId||'',record?.adId||''].join('|')},
    saveAdDataRecord(){const a=this.selectedAdsAccount;if(!a)return;const f={...this.adDataForm,spend:Number(this.adDataForm.spend||0),impressions:Number(this.adDataForm.impressions||0),reach:Number(this.adDataForm.reach||0),clicks:Number(this.adDataForm.clicks||0),leads:Number(this.adDataForm.leads||0),conversions:Number(this.adDataForm.conversions||0),revenue:Number(this.adDataForm.revenue||0),video3sRate:Number(this.adDataForm.video3sRate||0),video25Rate:Number(this.adDataForm.video25Rate||0),video50Rate:Number(this.adDataForm.video50Rate||0),video75Rate:Number(this.adDataForm.video75Rate||0),video95Rate:Number(this.adDataForm.video95Rate||0),videoCompleteRate:Number(this.adDataForm.videoCompleteRate||0)};if(!f.date||!f.campaignId){this.notify('请选择日期和广告方案');return}if(this.isMonthLocked(String(f.date).slice(0,7))){this.notify(`${String(f.date).slice(0,7)} 已完成月结锁定，不能新增或修改广告数据。`);return}const campaign=this.savedAdsCampaignsForAccount.find(c=>c.id===f.campaignId),adset=(campaign?.adSets||[]).find(x=>x.id===f.adSetId),ad=(adset?.ads||[]).find(x=>x.id===f.adId);f.planName=campaign?.planName||'';f.campaignName=campaign?.name||'';f.adSetName=adset?.name||'';f.adName=ad?.name||'';a.adDataRecords=Array.isArray(a.adDataRecords)?a.adDataRecords:[];const key=this.adDataRecordKey(f),sameKeyIndex=a.adDataRecords.findIndex(r=>r.id!==this.editingAdDataRecordId&&this.adDataRecordKey(r)===key);if(this.editingAdDataRecordId){const i=a.adDataRecords.findIndex(r=>r.id===this.editingAdDataRecordId);if(i>=0){const createdAt=a.adDataRecords[i].createdAt||new Date().toISOString();a.adDataRecords[i]={...a.adDataRecords[i],...f,id:a.adDataRecords[i].id,createdAt,updatedAt:new Date().toISOString()}}else if(sameKeyIndex>=0){const old=a.adDataRecords[sameKeyIndex];a.adDataRecords[sameKeyIndex]={...old,...f,id:old.id,createdAt:old.createdAt||new Date().toISOString(),updatedAt:new Date().toISOString()}}else{a.adDataRecords.unshift({...f,id:this.accountUid('data'),createdAt:new Date().toISOString(),updatedAt:new Date().toISOString()})}this.persist();this.showAdDataModal=false;const updatedExisting=!!this.editingAdDataRecordId||sameKeyIndex>=0;this.editingAdDataRecordId=null;this.notify(updatedExisting?'广告数据已更新，并已同步到投放数据分析':'广告数据已保存，并已同步到投放数据分析')},
    deleteAdDataRecord(record){if(!record||!this.selectedAdsAccount)return;if(this.isMonthLocked(String(record.date||'').slice(0,7))){this.notify(`${String(record.date||'').slice(0,7)} 已完成月结锁定，不能删除广告数据。`);return}this.askConfirm({title:'删除广告数据',message:`确定删除 ${record.date||''} 的这条广告数据吗？删除后广告管理与投放数据分析会同时更新。`,confirmText:'确认删除'},()=>{this.selectedAdsAccount.adDataRecords=(this.selectedAdsAccount.adDataRecords||[]).filter(r=>r.id!==record.id);this.persist();this.notify('广告数据已删除，两个页面已同步更新')})},
    accountSpendByDate(account,date){if(!account||!date)return 0;return(account.adDataRecords||[]).filter(r=>r.date===date).reduce((s,r)=>s+Number(r.spend||0),0)},
    openingPeriodMatches(date,mode=this.openingSpendPeriod){if(!date)return false;if(mode==='ALL')return true;const d=String(date),year=Number(d.slice(0,4)),month=Number(d.slice(5,7));if(mode==='MONTH')return d.slice(0,7)===this.openingMonthKey;if(mode==='QUARTER')return year===Number(this.openingQuarterYear)&&Math.floor((month-1)/3)+1===Number(this.openingQuarter);if(mode==='YEAR')return year===Number(this.openingYear);return true},
    openingPeriodMatchesConfig(date,config={}){if(!date)return false;const mode=config.mode||'ALL';if(mode==='ALL')return true;const d=String(date),year=Number(d.slice(0,4)),month=Number(d.slice(5,7));if(mode==='MONTH')return d.slice(0,7)===(config.monthKey||this.openingMonthKey);if(mode==='QUARTER')return year===Number(config.quarterYear??this.openingQuarterYear)&&Math.floor((month-1)/3)+1===Number(config.quarter??this.openingQuarter);if(mode==='YEAR')return year===Number(config.year??this.openingYear);return true},
    openingDealSpendGroups(deal,config={}){const groups={};if(!deal||deal.status!=='OPENED')return groups;const client=this.clients.find(c=>c.id===deal.clientId);if(!client)return groups;const accounts=deal.platform==='TK'?(client.tkAccounts||[]):(client.fbAccounts||[]),allowed=new Set(this.openingDealAccountIds(deal));accounts.filter(a=>allowed.has(String(a.adAccountId||'').trim())).forEach(a=>{(a.adDataRecords||[]).filter(r=>this.openingPeriodMatchesConfig(r.date,config)&&this.openingDealDateActive(deal,r.date)&&this.accountRebateMode(a)==='CHANNEL').forEach(r=>groups[r.currency||a.adSpendCurrency||'USD']=(groups[r.currency||a.adSpendCurrency||'USD']||0)+Number(r.spend||0))});return groups},
    openingDealsSpendGroupsUnique(deals,config={mode:this.openingSpendPeriod}){const groups={},ids=new Set((deals||[]).map(d=>d.id));this.clients.forEach(client=>{[['FB',client.fbAccounts||[]],['TK',client.tkAccounts||[]]].forEach(([platform,accounts])=>accounts.forEach(account=>{if(this.accountRebateMode(account)!=='CHANNEL')return;(account.adDataRecords||[]).filter(r=>this.openingPeriodMatchesConfig(r.date,config)).forEach(r=>{const owner=this.openingDealOwnerForRecord(client.id,platform,account,r.date);if(!owner||!ids.has(owner.id))return;const cur=r.currency||account.adSpendCurrency||'USD';groups[cur]=(groups[cur]||0)+Number(r.spend||0)})}))});return groups},
    openingDealRebateGroups(deal,config={}){const groups={};if(!deal||deal.status!=='OPENED')return groups;const client=this.clients.find(c=>c.id===deal.clientId);if(!client)return groups;const accounts=deal.platform==='TK'?(client.tkAccounts||[]):(client.fbAccounts||[]),allowed=new Set(this.openingDealAccountIds(deal));accounts.filter(a=>allowed.has(String(a.adAccountId||'').trim())).forEach(a=>{(a.adDataRecords||[]).filter(r=>this.openingPeriodMatchesConfig(r.date,config)&&this.openingDealDateActive(deal,r.date)&&this.accountRebateMode(a)==='CHANNEL').forEach(r=>{const cur=r.currency||a.adSpendCurrency||'USD',amount=Number(r.spend||0),rate=Number(this.openingDealRebateRate(deal,r.date)||0);groups[cur]=(groups[cur]||0)+amount*rate/100})});return groups},
    openingDealsFinancialsForPeriod(deals,mode=this.openingSpendPeriod){const config={mode,monthKey:this.openingMonthKey,quarterYear:this.openingQuarterYear,quarter:this.openingQuarter,year:this.openingYear},spendGroups=this.openingDealsSpendGroupsUnique(deals,config),rebateGroups={};(deals||[]).forEach(deal=>{const r=this.openingDealRebateGroups(deal,config);Object.entries(r).forEach(([cur,val])=>rebateGroups[cur]=(rebateGroups[cur]||0)+Number(val||0))});return{spendGroups,rebateGroups}},
    openingDealSpendText(deal){return this.spendGroupsText(this.openingDealSpendGroups(deal,{mode:this.openingSpendPeriod,monthKey:this.openingMonthKey,quarterYear:this.openingQuarterYear,quarter:this.openingQuarter,year:this.openingYear}))},
    openingDealRebateText(deal){return this.spendGroupsText(this.openingDealRebateGroups(deal,{mode:this.openingSpendPeriod,monthKey:this.openingMonthKey,quarterYear:this.openingQuarterYear,quarter:this.openingQuarter,year:this.openingYear}))},
    openingProvidersRebateGroups(mode=this.openingSpendPeriod,providerId='ALL'){const groups={},config={mode,monthKey:this.openingMonthKey,quarterYear:this.openingQuarterYear,quarter:this.openingQuarter,year:this.openingYear};this.openingDeals.filter(d=>providerId==='ALL'||String(d.providerId)===String(providerId)).forEach(deal=>{const r=this.openingDealRebateGroups(deal,config);Object.entries(r).forEach(([cur,val])=>groups[cur]=(groups[cur]||0)+Number(val||0))});return groups},
    openRenewalModal(alert){this.renewalTarget=alert;this.renewalForm={mode:'M1',newDueDate:this.addMonthsToDate(alert.dueDate,1),note:''};this.showRenewalModal=true},
    addMonthsToDate(date,months){if(!date)return'';const [y,m,d]=String(date).split('-').map(Number);const targetMonthIndex=(y*12+(m-1))+Number(months||0),ty=Math.floor(targetMonthIndex/12),tm=targetMonthIndex%12+1,lastDay=new Date(ty,tm,0).getDate(),day=Math.min(d||1,lastDay);return`${ty}-${String(tm).padStart(2,'0')}-${String(day).padStart(2,'0')}`},
    syncRenewalPreview(){if(!this.renewalTarget)return;if(this.renewalForm.mode==='CUSTOM'){if(!this.renewalForm.newDueDate)this.renewalForm.newDueDate=this.renewalTarget.dueDate;return}const months=Number(this.renewalForm.mode.replace('M',''))||1;this.renewalForm.newDueDate=this.addMonthsToDate(this.renewalTarget.dueDate,months)},
    saveRenewal(){const a=this.renewalTarget,newDate=this.renewalForm.newDueDate;if(!a||!newDate)return;if(newDate<=a.dueDate){this.notify('新到期日期必须晚于当前到期日期');return}if(a.isStandalone){const target=this.standaloneAlerts.find(x=>x.id===a.id);if(target){target.renewalHistory=Array.isArray(target.renewalHistory)?target.renewalHistory:[];target.renewalHistory.unshift({id:this.accountUid('renewal'),oldDate:target.dueDate,newDate,date:this.localDateKey(),note:this.renewalForm.note||''});target.dueDate=newDate}}else{const c=this.clients.find(c=>c.id===a.clientId);if(c){c.renewalHistory=Array.isArray(c.renewalHistory)?c.renewalHistory:[];c.renewalHistory.unshift({id:this.accountUid('renewal'),type:a.typeKey,networkId:a.networkId||null,oldDate:a.dueDate,newDate,date:this.localDateKey(),note:this.renewalForm.note||''});if(a.typeKey==='CONTRACT')c.endDate=newDate;if(a.typeKey==='IP'){const env=(c.networkEnvironments||[]).find(e=>e.id===a.networkId);if(env)env.ipDueDate=newDate}}}this.clearDismissedAlertKey(a);this.persist();this.showRenewalModal=false;this.notify(`续费已登记，新到期日：${newDate}`)},
    alertDismissKey(a){return`${a.id}|${a.dueDate}|${a.reminderIndex??'x'}`},
    isAlertDismissed(a){return this.dismissedAlerts.some(x=>x.key===this.alertDismissKey(a))},
    dismissAlert(a){this.dismissedAlerts.push({key:this.alertDismissKey(a),at:new Date().toISOString()});this.persist();this.notify('当前阶段提醒已确认，本次不会重复出现')},
    clearDismissedAlertKey(a){this.dismissedAlerts=this.dismissedAlerts.filter(x=>!String(x.key).startsWith(`${a.id}|`))},
    resetDismissedAlerts(){this.dismissedAlerts=[];this.persist();this.notify('已恢复所有已确认提醒')},
    localDateKey(date=new Date()){const d=date instanceof Date?date:new Date(date);return`${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`},
    autoDueReminderStage(date){if(!date)return null;const d=this.daysUntil(date);if(d<0)return{reminderIndex:3,reminderLabel:`已逾期 ${Math.abs(d)} 天`,reminderTone:'OVERDUE'};if(d===0)return{reminderIndex:2,reminderLabel:'到期日提醒',reminderTone:'DUE'};if(d<=1)return{reminderIndex:2,reminderLabel:'第 3 次提醒 · 到期前 1 天',reminderTone:'FINAL'};if(d<=3)return{reminderIndex:1,reminderLabel:'第 2 次提醒 · 到期前 3 天',reminderTone:'SECOND'};if(d<=7)return{reminderIndex:0,reminderLabel:'第 1 次提醒 · 到期前 7 天',reminderTone:'FIRST'};return null},
    pushDueAlert(list,c,typeKey,dueDate,type,cost,target,networkId=null){if(!dueDate)return;const d=this.daysUntil(dueDate),stage=this.autoDueReminderStage(dueDate);if(stage)list.push({id:`${typeKey}-${c.id}${networkId?'-'+networkId:''}`,typeKey,clientId:c.id,clientName:c.name,type,dueDate,daysLeft:d,cost,target,networkId,...stage,isStandalone:false})},
    pushRechargeAlert(list,c,platform,account,index){const level=this.accountLowBalanceLevel(account);if(!level)return;const balance=this.accountUsdBalance(account),threshold=level===2?30:100,accountName=account.accountName||`${platform} 账号 ${index+1}`;list.push({id:`AD_RECHARGE-${c.id}-${platform}-${account.id}`,typeKey:'AD_RECHARGE',clientId:c.id,clientName:c.name,type:level===2?'广告充值 · 二次紧急提醒':'广告充值 · 首次提醒',dueDate:this.localDateKey(),daysLeft:0,cost:`余额 ${this.formatMoney(balance,'USD')}`,target:`${platform==='FB'?'Facebook':'TikTok'} · ${accountName} · ${account.adAccountId||'未录入广告账户 ID'} · 阈值 ≤ $${threshold}`,platform,accountId:account.id,reminderIndex:level,reminderLabel:level===2?'二次紧急提醒 · 余额 ≤ $30':'首次充值提醒 · 余额 ≤ $100',reminderTone:level===2?'OVERDUE':'FIRST',isStandalone:false})},
    alertTypeName(key){if(key==='AD_RECHARGE')return'广告充值提醒';if(key==='RECEIVABLE')return'应收回款提醒';return this.reminderTypeLabel(key)},
    alertIcon(a){if(a.typeKey==='CONTRACT')return'fa-solid fa-file-signature';if(a.typeKey==='IP')return'fa-solid fa-network-wired';if(a.typeKey==='RECEIVABLE')return'fa-solid fa-file-invoice-dollar';if(a.typeKey==='AD_RECHARGE')return'fa-solid fa-coins';return'fa-regular fa-bell'},
    alertTone(a){if(a.typeKey==='AD_RECHARGE'&&a.reminderIndex===2)return'bg-rose-100 text-rose-700';if(a.daysLeft<0)return'bg-rose-50 text-rose-600';if(a.daysLeft<=1)return'bg-amber-50 text-amber-600';if(a.daysLeft<=3)return'bg-orange-50 text-orange-600';return'bg-blue-50 text-blue-600'},
    alertDueClass(a){return a.daysLeft<0?'text-rose-600 font-bold':a.daysLeft<=3?'text-amber-600 font-bold':'text-slate-500'},
    alertDayText(a){if(a.typeKey==='AD_RECHARGE')return a.reminderIndex===2?'立即充值':'需要充值';if(a.daysLeft<0)return`已逾期 ${Math.abs(a.daysLeft)} 天`;if(a.daysLeft===0)return'今天到期';return`${a.daysLeft} 天后`},
    saveStandaloneAlert(){const a={...this.newAlertForm,id:`sa-${Date.now()}`,typeKey:this.newAlertForm.typeKey||'IP',clientName:String(this.newAlertForm.clientName||'').trim(),dueDate:this.newAlertForm.dueDate,cost:String(this.newAlertForm.cost||'').trim(),target:String(this.newAlertForm.target||'').trim(),renewalHistory:[]};if(!a.clientName||!a.dueDate)return;this.standaloneAlerts.push(a);this.persist();this.newAlertForm={typeKey:'IP',clientName:'',dueDate:'',cost:'',target:''};this.showAddAlertModal=false;this.notify('提醒已保存，将在到期前 7 / 3 / 1 天自动提醒')},
    deleteStandaloneAlert(a){this.askConfirm({title:'删除独立提醒',message:`确定删除【${a.clientName} · ${a.type||this.alertTypeName(a.typeKey)}】吗？`,confirmText:'确认删除'},()=>{this.standaloneAlerts=this.standaloneAlerts.filter(x=>x.id!==a.id);this.persist();this.notify('提醒已删除')})},
    canEditClient(c){return !c.archived&&['ADMIN','OPS','SALES','FINANCE'].includes(this.currentUser?.role)},
    statusText(v){return v==='ACTIVE'?'合作中':v==='PAUSED'?'暂停':'已结束'},
    statusStyle(v){return v==='ACTIVE'?'bg-emerald-50 text-emerald-700 border border-emerald-100':v==='PAUSED'?'bg-amber-50 text-amber-700 border border-amber-100':'bg-slate-100 text-slate-500 border border-slate-200'},
    notify(t){this.toastMessage=t;clearTimeout(this._tt);this._tt=setTimeout(()=>this.toastMessage='',2400)},
    askConfirm(options,action){this.confirmDialog={show:true,title:options?.title||'请确认',message:options?.message||'',confirmText:options?.confirmText||'确认删除',tone:options?.tone||'danger'};this.confirmAction=action},
    closeConfirm(){this.confirmDialog.show=false;this.confirmAction=null},
    runConfirm(){const action=this.confirmAction;this.confirmDialog.show=false;this.confirmAction=null;if(typeof action==='function')action()},
    navigateTo(p){if(!this.canViewPage(p)&&!['client-detail','client-form'].includes(p))return;if(!this.isDirtyFormConfirmed(()=>this.navigateTo(p)))return;this.currentPage=p;this.mobileMenuOpen=false;this.globalSearchOpen=false;if(p==='assets')this.$nextTick(()=>{this.resetAssetPager('assets')});if(p==='ads')this.$nextTick(this.syncAdsAccountSelection);if(p==='analytics')this.$nextTick(this.syncAnalyticsAccountSelection);if(p==='sop')this.$nextTick(()=>{if(!this.selectedSopClientId&&this.activeClients[0])this.selectedSopClientId=this.activeClients[0].id;this.syncSopAccountSelection()});if(p==='finance')this.$nextTick(()=>this.ensureAutomaticReceivables({silent:true}))},
    startNewClient(){if(!this.canViewPage('client-form'))return;this.form=this.createBlankForm();this.formDirty=false;this.currentPage='client-form'},
    openClient(c){this.selectedClientId=c.id;this.currentPage='client-detail';this.resetAssetPager('detail')},
    editClient(c){if(!this.canViewPage('client-form'))return;this.form=this.createBlankForm(c);this.formDirty=false;this.currentPage='client-form'},
    markLeadConverted(client){if(!client?.leadId)return;const lead=this.leads.find(l=>String(l.id)===String(client.leadId));if(!lead)return;lead.stage='WON';lead.convertedClientId=client.id;lead.convertedAt=new Date().toISOString();lead.wonAt=lead.wonAt||this.localDateKey();lead.nextFollowUp=''},
    saveClient(){const f=this.createBlankForm(this.form);f.name=String(this.form.name||'').trim();f.product=String(this.form.product||'').trim();f.project=String(this.form.project||'').trim();f.monthlyFee=Math.max(0,Number(this.form.monthlyFee||0));f.renewalAlertDay=Math.min(31,Math.max(1,Number(this.form.renewalAlertDay)||25));if(!f.name||!f.product||!f.project||!f.endDate){this.notify('请完整填写必填字段');return}let saved=null;if(f.id){const i=this.clients.findIndex(c=>c.id===f.id);if(i>=0){const old=this.clients[i],changedToManual=(old.billingMode||'FULL_MONTH')!=='MANUAL'&&f.billingMode==='MANUAL';if(changedToManual&&this.financeReceivables.some(r=>String(r.clientId)===String(f.id)&&(r.incomeType||'SERVICE_FEE')==='SERVICE_FEE')){this.notify('该客户已有投放服务费账单，不能直接改为手工账单。请先处理现有账单。');return}this.clients[i]=f;saved=this.clients[i]}}else{saved={...f,id:Date.now(),renewalHistory:[]};this.clients.push(saved)}if(!saved)return;this.markLeadConverted(saved);this.ensureClientFirstReceivable(saved);this.ensureAutomaticReceivables({clientId:saved.id,silent:true});this.financePeriodMonths().forEach(month=>this.ensureAutomaticAssetCosts({clientId:saved.id,month,silent:true}));this.persist();this.selectedClientId=saved.id;this.formDirty=false;this.currentPage='client-detail';this.notify(f.id?'客户资料已更新':'合作客户已创建，并已生成首笔投放服务费账单')},
    archiveClient(c){if(!this.canArchiveClients()){this.notify('当前角色没有客户归档权限');return}if(c.archived){c.archived=false;this.persist();this.notify('客户已恢复为在管客户');return}this.askConfirm({title:'归档客户',message:`确定归档【${c.name}】吗？客户不会被物理删除，财务账单、广告数据、开户渠道和审计记录会继续保留。`,confirmText:'确认归档',tone:'warning'},()=>{c.archived=true;c.archivedAt=new Date().toISOString();this.persist();this.logAudit('归档客户',c.name);if(this.selectedClientId===c.id)this.currentPage='clients';this.notify('客户已归档，历史财务与投放数据已保留')})},
    daysUntilOrLarge(d){return d?this.daysUntil(d):999},
    clientHistory(c){return (c.renewalHistory||[]).slice(0,3)},
    objectiveSafe(v){return v||'LEADS'},
    addToRenewalHistory(c,type,oldDate,newDate,note){c.renewalHistory=Array.isArray(c.renewalHistory)?c.renewalHistory:[];c.renewalHistory.unshift({id:this.accountUid('renewal'),type,oldDate,newDate,date:this.localDateKey(),note:note||''})},
    sopProgressKey(){return this.selectedSopClientId?`growthOpsSop-${this.selectedSopClientId}`:''},
    loadSopProgress(){if(!this.selectedSopClientId){this.sopChecked={};return}try{this.sopChecked=JSON.parse(localStorage.getItem(this.sopProgressKey()))||{}}catch(e){this.sopChecked={}}},
    syncSopAccountSelection(reset=false){const accounts=this.selectedSopAccounts;if(!accounts.length){this.selectedSopAccountKey='';this.sopChecked={};return}if(reset||!accounts.some(a=>a.key===this.selectedSopAccountKey))this.selectedSopAccountKey=accounts[0].key;this.loadSopProgress()},
    sopConfigFor(c,key,create=true){if(!c||!key)return null;c.sopAccountConfigs=c.sopAccountConfigs&&typeof c.sopAccountConfigs==='object'?c.sopAccountConfigs:{};if(create&&!c.sopAccountConfigs[key])c.sopAccountConfigs[key]={dailyPlan:'',notes:'',steps:[],dailyTasks:{}};const cfg=c.sopAccountConfigs[key];if(cfg){cfg.dailyPlan=cfg.dailyPlan||'';cfg.notes=cfg.notes||'';cfg.steps=Array.isArray(cfg.steps)?cfg.steps:[];cfg.dailyTasks=cfg.dailyTasks&&typeof cfg.dailyTasks==='object'?cfg.dailyTasks:{}}return cfg},
    selectedSopTaskBucket(create=true,date=this.selectedSopDate){const c=this.selectedSopClient,key=this.selectedSopAccountKey;if(!c||!key||!date)return null;const cfg=this.sopConfigFor(c,key,create);if(!cfg)return null;if(create&&!Array.isArray(cfg.dailyTasks[date]))cfg.dailyTasks[date]=[];return Array.isArray(cfg.dailyTasks[date])?cfg.dailyTasks[date]:null},
    updateSelectedSopDailyPlan(value){const c=this.selectedSopClient,key=this.selectedSopAccountKey;if(!c||!key)return;const cfg=this.sopConfigFor(c,key,true);cfg.dailyPlan=value;this.persist()},
    updateSelectedSopNotes(value){const c=this.selectedSopClient,key=this.selectedSopAccountKey;if(!c||!key)return;const cfg=this.sopConfigFor(c,key,true);cfg.notes=value;this.persist()},
    openSopTaskModal(task=null){if(!this.selectedSopClient||!this.selectedSopAccount){this.notify('请先选择客户和广告账号');return}this.sopTaskForm=task?{id:task.id,originalDate:this.selectedSopDate,date:this.selectedSopDate,text:String(task.text||''),plan:String(task.plan||''),note:String(task.note||'')}:{id:null,originalDate:this.selectedSopDate,date:this.selectedSopDate||this.localDateKey(),text:'',plan:'',note:''};this.showSopTaskModal=true},
    saveSopTask(){const c=this.selectedSopClient,key=this.selectedSopAccountKey,f={...this.sopTaskForm,date:String(this.sopTaskForm.date||''),text:String(this.sopTaskForm.text||'').trim(),plan:String(this.sopTaskForm.plan||'').trim(),note:String(this.sopTaskForm.note||'').trim()};if(!c||!key||!f.date||!f.text){this.notify('请填写任务日期和操作步骤');return}const cfg=this.sopConfigFor(c,key,true),newBucket=Array.isArray(cfg.dailyTasks[f.date])?cfg.dailyTasks[f.date]:(cfg.dailyTasks[f.date]=[]);if(f.id){const originalDate=f.originalDate||this.selectedSopDate,oldBucket=Array.isArray(cfg.dailyTasks[originalDate])?cfg.dailyTasks[originalDate]:[],idx=oldBucket.findIndex(x=>x.id===f.id),payload={id:f.id,text:f.text,plan:f.plan,note:f.note,createdAt:idx>=0?(oldBucket[idx].createdAt||new Date().toISOString()):new Date().toISOString(),updatedAt:new Date().toISOString()};if(originalDate===f.date){if(idx>=0)oldBucket[idx]=payload;else newBucket.unshift(payload)}else{if(idx>=0)oldBucket.splice(idx,1);newBucket.unshift(payload);if(!oldBucket.length)delete cfg.dailyTasks[originalDate]}}else newBucket.unshift({id:this.accountUid('sop-task'),text:f.text,plan:f.plan,note:f.note,createdAt:new Date().toISOString()});this.persist();this.selectedSopDate=f.date;this.loadSopProgress();this.showSopTaskModal=false;this.sopExpandedTasks={};this.notify(f.id?'任务已更新并显示在对应日期':'任务已记录并显示在对应日期')},
    editSopTask(task){this.openSopTaskModal(task)},
    deleteSopTask(task){if(!task)return;this.askConfirm({title:'删除 SOP 任务',message:`确定删除【${task.text}】吗？`,confirmText:'确认删除'},()=>{const bucket=this.selectedSopTaskBucket(false);if(!bucket)return;const idx=bucket.findIndex(x=>x.id===task.id);if(idx>=0)bucket.splice(idx,1);if(!bucket.length){const cfg=this.sopConfigFor(this.selectedSopClient,this.selectedSopAccountKey,true);delete cfg.dailyTasks[this.selectedSopDate]}delete this.sopChecked[task.id];localStorage.setItem(this.sopProgressKey(),JSON.stringify(this.sopChecked));this.persist();this.sopExpandedTasks={...this.sopExpandedTasks,[task.id]:false};this.notify('SOP 任务已删除')})},
    toggleSopTaskExpanded(taskId){this.sopExpandedTasks={...this.sopExpandedTasks,[taskId]:!this.sopExpandedTasks[taskId]}},
    changeSopDate(delta){const base=new Date(`${this.selectedSopDate||this.localDateKey()}T12:00:00`);base.setDate(base.getDate()+Number(delta||0));this.selectedSopDate=this.localDateKey(base);this.loadSopProgress();this.sopExpandedTasks={}},
    goSopToday(){this.selectedSopDate=this.localDateKey();this.loadSopProgress();this.sopExpandedTasks={}},
    toggleSop(step){this.sopChecked[step.id]=!this.sopChecked[step.id];localStorage.setItem(this.sopProgressKey(),JSON.stringify(this.sopChecked))},
    notifySopSaved(){this.notify('SOP 设置已保存')},
    displaySafeError(e){this.notify(e?.message||'操作失败')}
  },
  mounted(){this.loadData();this.migrateLegacyAccountSpendRecords();this.ensureFinanceSnapshotsForLocks();const autoReceivables=this.ensureAutomaticReceivables({silent:true}),autoOpeningCosts=this.ensureAutomaticOpeningFeeCosts();this.ensureReceivableLinkedCosts();const autoAssetCosts=this.ensureAutomaticAssetCosts({month:this.localDateKey().slice(0,7),silent:true});if(autoOpeningCosts||autoAssetCosts)this.persist();this.updateStorageUsage();this.ensureDailyBackup();this.selectedClientId=this.activeClients[0]?.id||null;this.selectedAssetsClientId=this.activeClients[0]?.id||null;this.selectedSopClientId=this.activeClients[0]?.id||null;this.selectedAnalyticsClientId=this.activeClients[0]?.id||0;this.selectedAdsClientId=this.activeClients[0]?.id||0;this.syncAnalyticsAccountSelection();this.syncAdsAccountSelection();this.syncSopAccountSelection(true);if(!this.reminderTypeOptions.some(t=>t.key===this.newAlertForm.typeKey))this.newAlertForm.typeKey=this.reminderTypeOptions[0]?.key||'IP';if(this.currentUser&&!this.canViewPage(this.currentPage))this.currentPage='dashboard';if(!this.currentUser)this.currentPage='dashboard';if(this.storageWarning)this.notify('本地数据量较大，建议立即导出备份并迁移到数据库')}
}).mount('#app');
</script>
</body>
</html>
