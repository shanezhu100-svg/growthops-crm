nter mb-5"><i class="fa-solid fa-shield-halved"></i></div>
      <div class="text-[10px] font-bold tracking-[.18em] text-indigo-500">SECURE WORKSPACE</div><h1 class="text-2xl font-black mt-1">登录客户增长运营中台</h1><p class="text-xs text-slate-400 mt-2">角色权限演示已启用。正式部署时请接服务器认证和数据库。</p>
      <div class="mt-6 space-y-4"><div><label class="text-[11px] font-bold text-slate-500 block mb-1.5">账号</label><input v-model.trim="loginForm.username" autocomplete="username" class="field" placeholder="请输入登录账号" /></div><div><label class="text-[11px] font-bold text-slate-500 block mb-1.5">密码</label><input v-model="loginForm.password" type="password" autocomplete="current-password" class="field" placeholder="请输入登录密码" /></div><button class="w-full h-11 rounded-xl bg-slate-950 text-white text-sm font-extrabold">登录</button></div>
      <div class="mt-5 rounded-2xl bg-amber-50 border border-amber-100 p-4 text-[10px] text-amber-700 leading-relaxed"><b class="text-amber-800">部署提示：</b> 当前文件仍是浏览器本地数据版本。正式公网部署前请切换到服务端认证与数据库，避免在前端保存真实账号密码、2FA 与财务敏感数据。</div>
    </form>
  </div>
  <!-- Global operation feedback -->
  <div v-if="currentUser && toastMessage" class="fixed top-5 left-1/2 -translate-x-1/2 z-[300] w-[calc(100%-2rem)] max-w-xl pointer-events-none">
    <div class="rounded-2xl border border-slate-200 bg-slate-950/95 text-white shadow-2xl px-4 py-3 flex items-start gap-3 backdrop-blur">
      <div class="mt-0.5 w-7 h-7 rounded-lg bg-white/10 text-emerald-300 flex items-center justify-center shrink-0"><i class="fa-solid fa-circle-info text-xs"></i></div>
      <div class="min-w-0 flex-1"><div class="text-[10px] font-extrabold text-slate-300">操作提示</div><div class="text-xs font-semibold leading-relaxed mt-0.5 break-words">{{ toastMessage }}</div></div>
    </div>
  </div>

  <!-- In-page confirmation dialog: avoids browser confirm() being blocked in preview/iframe environments -->
  <div v-if="currentUser && confirmDialog.show" class="fixed inset-0 z-[420] modal-backdrop flex items-center justify-center p-4" @click.self="cancelConfirmDialog">
    <div class="w-full max-w-md rounded-3xl bg-white border border-slate-200 shadow-2xl overflow-hidden">
      <div class="p-5 border-b border-slate-100 flex items-start gap-3">
        <div class="w-10 h-10 rounded-xl flex items-center justify-center shrink-0" :class="confirmDialog.tone==='warning'?'bg-amber-50 text-amber-600':'bg-rose-50 text-rose-600'">
          <i :class="confirmDialog.tone==='warning'?'fa-solid fa-triangle-exclamation':'fa-solid fa-trash-can'"></i>
        </div>
        <div class="min-w-0 flex-1">
          <h3 class="font-extrabold text-slate-900">{{ confirmDialog.title || '确认操作' }}</h3>
          <p class="mt-2 text-xs leading-relaxed text-slate-500 whitespac