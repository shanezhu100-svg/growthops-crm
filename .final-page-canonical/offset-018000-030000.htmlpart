e-pre-line">{{ confirmDialog.message }}</p>
        </div>
        <button type="button" @click="cancelConfirmDialog" class="w-8 h-8 rounded-lg hover:bg-slate-100 text-slate-400"><i class="fa-solid fa-xmark"></i></button>
      </div>
      <div class="p-4 bg-slate-50 flex items-center justify-end gap-2">
        <button type="button" @click="cancelConfirmDialog" class="h-10 px-4 rounded-xl border border-slate-200 bg-white text-xs font-bold text-slate-600 hover:bg-slate-50">取消</button>
        <button type="button" @click="runConfirmDialog" class="h-10 px-5 rounded-xl text-white text-xs font-extrabold shadow-sm" :class="confirmDialog.tone==='warning'?'bg-amber-500 hover:bg-amber-400':'bg-rose-600 hover:bg-rose-500'">
          {{ confirmDialog.confirmText || '确认删除' }}
        </button>
      </div>
    </div>
  </div>

  <!-- Desktop Sidebar -->
  <aside class="hidden lg:flex fixed inset-y-0 left-0 z-40 w-64 flex-col border-r border-slate-200 bg-slate-950 text-white">
    <div class="h-20 px-5 flex items-center border-b border-white/10">
      <button @click="navigateTo('dashboard')" class="w-full flex items-center gap-3 text-left">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-indigo-500 to-violet-600 flex items-center justify-center shadow-lg shadow-indigo-950/40">
          <i class="fa-solid fa-chart-simple"></i>
        </div>
        <div class="min-w-0">
          <div class="font-extrabold tracking-tight truncate">客户增长运营中台</div>
          <div class="text-[10px] text-slate-400 mt-0.5">CLIENT GROWTH OPS</div>
        </div>
      </button>
    </div>

    <nav class="flex-1 px-3 py-5 space-y-1 overflow-y-auto scrollbar">
      <div class="px-3 pb-2 text-[10px] font-bold tracking-[.18em] text-slate-500">WORKSPACE</div>
      <button v-for="item in visibleMenuItems" :key="item.key" @click="navigateTo(item.key)"
              class="w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm transition"
              :class="currentPage === item.key ? 'bg-white text-slate-950 shadow-sm font-bold' : 'text-slate-300 hover:bg-white/10 hover:text-white'">
        <span class="w-8 h-8 rounded-lg flex items-center justify-center" :class="currentPage === item.key ? item.activeIconBg : 'bg-white/5'">
          <i :class="item.icon"></i>
        </span>
        <span class="flex-1 text-left">{{ item.label }}</span>
        <span v-if="item.key === 'alerts' && alertList.length" class="min-w-6 h-6 px-1.5 rounded-full bg-amber-400 text-slate-950 text-[10px] font-black flex items-center justify-center">{{ alertList.length }}</span>
      </button>
    </nav>

    <div class="p-3 border-t border-white/10">
      <div class="rounded-2xl bg-white/5 border border-white/10 p-3">
        <div class="text-xs font-semibold text-slate-200">{{ currentUser ? currentUser.name + ' · ' + currentRoleLabel : '未登录' }}</div>
        <div class="text-[10px] text-slate-500 mt-1 leading-relaxed">已启用角色权限、全量数据备份与恢复。当前单文件版仍使用本地数据仓库，正式上线可替换为服务器数据库。</div>
      </div>
    </div>
  </aside>

  <!-- Mobile Header -->
  <header class="lg:hidden sticky top-0 z-40 glass border-b border-slate-200">
    <div class="h-16 px-4 flex items-center justify-between gap-3">
      <button @click="mobileMenuOpen = !mobileMenuOpen" class="w-10 h-10 rounded-xl border border-slate-200 bg-white text-slate-700">
        <i class="fa-solid fa-bars"></i>
      </button>
      <div class="flex-1 min-w-0">
        <div class="font-extrabold text-sm truncate">客户增长运营中台</div>
        <div class="text-[10px] text-slate-400 truncate">FB / TikTok · 合同 · 资产 · SOP · 数据</div>
      </div>
      <button @click="openClientForm()" class="w-10 h-10 rounded-xl bg-slate-950 text-white">
        <i class="fa-solid fa-plus"></i>
      </button>
    </div>
    <div v-if="mobileMenuOpen" class="border-t border-slate-200 bg-white px-3 py-3 grid grid-cols-2 gap-2">
      <button v-for="item in visibleMenuItems" :key="item.key" @click="navigateTo(item.key); mobileMenuOpen=false" class="px-3 py-2.5 rounded-xl text-left text-xs font-semibold border" :class="currentPage===item.key ? 'border-indigo-200 bg-indigo-50 text-indigo-700' : 'border-slate-200 text-slate-600'">
        <i :class="item.icon" class="mr-2"></i>{{ item.label }}
      </button>
    </div>
  </header>

  <main class="lg:ml-64 min-h-screen">
    <!-- Topbar -->
    <div class="hidden lg:flex sticky top-0 z-30 h-20 items-center justify-between gap-4 px-7 xl:px-10 border-b border-slate-200 glass">
      <div>
        <div class="text-[11px] font-semibold uppercase tracking-[.16em] text-slate-400">{{ pageEyebrow }}</div>
        <div class="text-xl font-extrabold tracking-tight mt-0.5">{{ pageTitle }}</div>
      </div>
      <div class="flex items-center gap-2">
        <div class="hidden xl:flex items-center text-xs text-slate-500">
          <span>{{ todayText }}</span>
        </div>
        <button v-if="currentUser" @click="logout" class="h-10 px-3 rounded-xl border border-slate-200 bg-white text-xs font-semibold text-slate-600 hover:bg-slate-50" title="退出当前账号"><i class="fa-solid fa-arrow-right-from-bracket mr-1.5"></i>退出</button>
        <button v-if="currentUser?.role==='ADMIN'" @click="resetDemoData" class="h-10 px-3 rounded-xl border border-slate-200 bg-white text-xs font-semibold text-slate-600 hover:bg-slate-50" title="恢复初始演示数据">
          <i class="fa-solid fa-rotate-left mr-1.5"></i>重置演示
        </button>
        <button @click="openClientForm()" class="h-10 px-4 rounded-xl bg-slate-950 text-white text-xs font-bold hover:bg-slate-800 shadow-sm">
          <i class="fa-solid fa-plus mr-1.5"></i>新增客户
        </button>
      </div>
    </div>

    <div class="px-4 sm:px-6 lg:px-7 xl:px-10 py-6 lg:py-8 max-w-[1600px] mx-auto">
      <transition name="page" mode="out-in">
        <!-- Dashboard -->
        <section v-if="currentPage==='dashboard'" key="dashboard" class="space-y-6">
          <div class="rounded-3xl overflow-hidden bg-slate-950 text-white soft-shadow relative">
            <div class="absolute inset-0 metric-grid opacity-40"></div>
            <div class="relative p-6 md:p-8 flex flex-col xl:flex-row xl:items-end xl:justify-between gap-6">
              <div class="max-w-2xl">
                <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full bg-white/10 border border-white/10 text-[11px] font-semibold text-slate-300">
                  <span class="w-1.5 h-1.5 bg-emerald-400 rounded-full"></span>运营数据实时概览
                </div>
                <h1 class="text-2xl md:text-3xl font-extrabold tracking-tight mt-4">客户、合同、资产和投放数据，集中在一个工作台。</h1>
                <p class="text-sm text-slate-400 mt-3 leading-relaxed">快速识别临期合同、账号资产风险和投放表现，把续费、交付与优化动作放在同一条运营链路里。</p>
              </div>
              <div class="flex gap-2 flex-wrap">
                <button @click="navigateTo('alerts')" class="px-4 h-10 rounded-xl bg-white text-slate-950 text-xs font-bold"><i class="fa-regular fa-bell mr-1.5"></i>处理 {{ alertList.length }} 个预警</button>
                <button @click="navigateTo('clients')" class="px-4 h-10 rounded-xl bg-white/10 border border-white/10 text-xs font-bold"><i class="fa-solid fa-users mr-1.5"></i>查看客户</button>
              </div>
            </div>
          </div>

          <div class="grid grid-cols-2 xl:grid-cols-4 gap-3 sm:gap-4">
            <div v-for="card in dashboardCards" :key="card.label" class="bg-white border border-slate-200 rounded-2xl p-4 sm:p-5 soft-shadow">
              <div class="flex items-start justify-between gap-3">
                <div>
                  <div class="text-[11px] sm:text-xs font-semibold text-slate-500">{{ card.label }}</div>
                  <div class="text-xl sm:text-2xl font-extrabold tracking-tight mt-2" :class="card.valueClass">{{ card.value }}</div>
                  <div class="text-[10px] sm:text-[11px] text-slate-400 mt-1">{{ card.hint }}</div>
                </div>
                <div class="w-10 h-10 rounded-xl flex items-center justify-center" :class="card.iconBg"><i :class="card.icon"></i></div>
              </div>
            </div>
          </div>

          <div class="grid grid-cols-1 xl:grid-cols-3 gap-5">
            <div class="xl:col-span-2 bg-white border border-slate-200 rounded-2xl soft-shadow overflow-hidden">
              <div class="p-5 flex items-center justify-between border-b border-slate-100">
                <div>
                  <h3 class="font-extrabold text-sm">近期客户与合作状态</h3>
                  <p class="text-[11px] text-slate-400 mt-1">点击客户可直接进入详情页</p>
                </div>
                <button @click="navigateTo('clients')" class="text-xs font-semibold text-indigo-600">查看全部 <i class="fa-solid fa-arrow-right ml-1"></i></button>
              </div>
              <div class="overflow-x-auto scrollbar">
                <table class="w-full min-w-[780px] text-xs">
                  <thead class="bg-slate-50 text-slate-500">
                    <tr><th class="p-3.5 text-left font-semibold">客户</th><th class="p-3.5 text-left font-semibold">平台</th><th class="p-3.5 text-left font-semibold">服务费</th><th class="p-3.5 text-left font-semibold">合同</th><th class="p-3.5 text-left font-semibold">投放状态</th><th class="p-3.5 text-right font-semibold">操作</th></tr>
                  </thead>
                  <tbody class="divide-y divide-slate-100">
                    <tr v-for="client in clients.slice(0,6)" :key="client.id" class="hover:bg-slate-50/70">
                      <td class="p-3.5"><button @click="openClientDetail(client.id)" class="text-left"><div class="font-bold text-slate-900">{{ client.name }}</div><div class="text-[10px] text-slate-400 mt-0.5">{{ client.product }}</div></button></td>
                      <td class="p-3.5"><platform-badges :platform="client.platform"></platform-badges></td>
                      <td class="p-3.5 font-bold">{{ formatMoney(client.monthlyFee, client.currency) }}</td>
                      <td class="p-3.5"><span class="font-mono">{{ client.endDate }}</span><div class="text-[10px] mt-0.5" :class="daysUntil(client.endDate)<=7 ? 'text-amber-600 font-bold' : 'text-slate-400'">{{ contractStatusText(client) }}</div></td>
                      <td class="p-3.5"><span class="inline-flex px-2 py-1 rounded-full text-[10px] font-bold" :class="client.status==='ACTIVE' ? 'bg-emerald-50 text-emerald-700' : 'bg-slate-100 text-slate-600'">{{ client.status==='ACTIVE'?'合作中':'暂停' }}</span></td>
                      <td class="p-3.5 text-right"><button @click="openClientDetail(client.id)" class="w-8 h-8 rounded-lg hover:bg-slate-100 text-slate-500"><i class="fa-solid fa-chevron-right"></i></button></td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>

            <div class="bg-white border border-slate-200 rounded-2xl soft-shadow overflow-hidden">
              <div class="p-5 border-b border-slate-100">
                <div class="flex items-center justify-between">
                  <h3 class="font-extrabold text-sm">运营预警</h3>
                  <span class="text-[10px] font-black px-2 py-1 rounded-full bg-amber-50 text-amber-700">{{ alertList.length }}</span>
                </div>
                <p class="text-[11px] text-slate-400 mt-1">按紧急程度自动排序</p>
              </div>
              <div class="p-3 space-y-2 max-h-[385px] overflow-y-auto scrollbar">
                <button v-for="item in alertList.slice(0,7)" :key="item.id" @click="navigateTo('alerts')" class="w-full 