 <div class="p-5 border-b border-slate-100 flex items-center justify-between"><div><h3 class="font-extrabold text-sm">平台资产与账号</h3><p class="text-[11px] text-slate-400 mt-1">BM / BC / 广告账号 / 登录资料集中归档；费用数据在投放分析维护</p></div><button v-if="canViewCredentials()" @click="credentialsVisible=!credentialsVisible" class="text-xs font-semibold text-indigo-600"><i :class="credentialsVisible?'fa-regular fa-eye-slash':'fa-regular fa-eye'" class="mr-1"></i>{{ credentialsVisible?'隐藏登录资料':'查看登录资料' }}</button><span v-else class="text-[10px] font-bold text-slate-400"><i class="fa-solid fa-lock mr-1"></i>登录凭证仅管理员 / 运营可见</span></div>
                <div class="p-5 grid grid-cols-1 md:grid-cols-2 gap-4">
                  <div v-if="selectedClient.platform.includes('FB') || (selectedClient.fbAccounts || []).length" class="rounded-2xl border border-blue-100 bg-blue-50/40 p-4">
                    <div class="flex items-center justify-between gap-3 flex-wrap">
                      <div class="flex items-center gap-2 font-extrabold text-sm text-blue-900"><i class="fa-brands fa-facebook text-blue-600"></i>Facebook</div>
                      <div class="flex items-center gap-2 flex-wrap justify-end">
                        <span class="text-[10px] font-bold bg-white text-blue-700 border border-blue-100 px-2 py-1 rounded-full">{{ (selectedClient.fbAccounts || []).length }} 个账号</span>
                        <div v-if="(selectedClient.fbAccounts || []).length>1" class="inline-flex items-center gap-1.5">
                          <select :value="clampedAssetPagerIndex('detail','FB',(selectedClient.fbAccounts||[]).length)" @change="setAssetPagerIndex('detail','FB',$event.target.value,(selectedClient.fbAccounts||[]).length)" class="h-7 max-w-[150px] rounded-lg border border-blue-100 bg-white px-2 text-[10px] font-bold text-blue-700 outline-none focus:ring-2 focus:ring-blue-100" title="直接选择 Facebook 账号"><option v-for="(a,i) in (selectedClient.fbAccounts||[])" :key="a.id || i" :value="i">{{ a.accountName || `Facebook 账号 ${i+1}` }}</option></select>
                          <button type="button" @click="changeAssetPager('detail','FB',-1,(selectedClient.fbAccounts||[]).length)" class="w-7 h-7 rounded-lg border border-blue-100 bg-white text-blue-700 disabled:opacity-40" :disabled="clampedAssetPagerIndex('detail','FB',(selectedClient.fbAccounts||[]).length)===0"><i class="fa-solid fa-chevron-left text-[10px]"></i></button>
                          <span class="text-[10px] font-bold text-blue-700 min-w-[52px] text-center">{{ clampedAssetPagerIndex('detail','FB',(selectedClient.fbAccounts||[]).length)+1 }} / {{ (selectedClient.fbAccounts || []).length }}</span>
                          <button type="button" @click="changeAssetPager('detail','FB',1,(selectedClient.fbAccounts||[]).length)" class="w-7 h-7 rounded-lg border border-blue-100 bg-white text-b