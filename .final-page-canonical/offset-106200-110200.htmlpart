"text-[11px] font-bold text-amber-300">所有客户累计广告消耗</div><div class="text-2xl font-black mt-2">{{ analyticsAllSpendText }}</div><div class="text-[10px] text-slate-400 mt-2">{{ activeClients.length }} 个在管客户 · 不同币种分别汇总</div></div>
              <div class="bg-white border border-emerald-100 rounded-2xl p-5 soft-shadow"><div class="text-[11px] font-bold text-emerald-600">全部累计广告充值</div><div class="text-2xl font-black mt-2 text-emerald-700">{{ analyticsAllRechargeText }}</div><div class="text-[10px] text-slate-400 mt-2">来自全部客户广告账户充值记录</div></div>
            </div>

            <div class="grid grid-cols-1 xl:grid-cols-2 gap-4">
              <div class="bg-white border border-blue-100 rounded-2xl p-5 soft-shadow">
                <div class="flex items-center justify-between gap-3"><div><div class="font-extrabold text-sm text-blue-900"><i class="fa-brands fa-facebook text-blue-600 mr-1.5"></i>Facebook 全客户汇总</div><div class="text-[10px] text-slate-400 mt-1">统一广告数据自动汇总</div></div><span class="text-[10px] font-bold text-blue-700 bg-blue-50 px-2 py-1 rounded-full">{{ analyticsAllFbMetrics.records }} 条数据</span></div>
                <div class="grid grid-cols-3 sm:grid-cols-6 gap-2 mt-4"><div v-for="m in [{l:'CPM',v:analyticsAllFbMetrics.cpmText},{l:'CTR',v:analyticsAllFbMetrics.ctrText},{l:'CPC',v:analyticsAllFbMetrics.cpcText},{l:'CVR',v:analyticsAllFbMetrics.cvrText},{l:'CPA',v:analyticsAllFbMetrics.cpaText},{l:'ROAS',v:analyticsAllFbMetrics.roasText}]" :key="m.l" class="rounded-xl bg-slate-50 border border-slate-100 p-3 text-center"><div class="text-[9px] text-slate-400">{{ m.l }}</div><div class="text-xs font-black mt-1">{{ m.v }}</div></div></div>
              </div>
              <div class="bg-white border border-slate-200 rounded-2xl p-5 soft-shadow">
                <div class="flex items-center justify-between gap-3"><div><div class="font-extrabold text-sm text-slate-900"><i class="fa-brands fa-tiktok mr-1.5"></i>TikTok 全客户汇总</div><div class="text-[10px] text-slate-400 mt-1">统一广告数据自动汇总</div></div><span class="text-[10px] font-bold text-slate-700 bg-slate-100 px-2 py-1 rounded-full">{{ analyticsAllTkMetrics.records }} 条数据</span></div>
                <div class="grid grid-cols-3 sm:grid-cols-6 gap-2 mt-4"><div v-for="m in [{l:'CPM',v:analyticsAllTkMetrics.cpmText},{l:'CTR',v:analyticsAllTkMetrics.ctrText},{l:'CPC',v:analyticsAllTkMetrics.cpcText},{l:'CVR',v:analyticsAllTkMetrics.cvrText},{l:'CPA',v:analyticsAllTkMetrics.cpaText},{l:'ROAS',v:analyticsAllTkMetrics.roasText}]" :key="m.l" class="rounded-xl bg-slate-50 border border-slate-100 p-3 text-center"><div class="text-[9px] text-slate-400">{{ m.l }}</div><div class="text-xs font-black mt-1">{{ m.v }}</div></div></div>
              </div>
            </div>

            <div class="bg-white border border-slate-200 rounded-2xl soft-shadow overflow-hidden">
              <div class="p-5 border-b border-slate-100"><h3 class="font-extrabold text-sm">所有客户投放数据</h3><p class="text-[11px] text-slate-400 mt-1">选择「所有客户」时展示客户级汇总；点击查看后进入该客户的广告账户明细分析。</p></div>
              <div class="overflow-x-auto scrollbar"><table class="w-full min-w-[980px] text-xs"><thead class="bg-slate-50 text-slate-500"><tr><th class="p-3.5 text-left">客户</th><th class="p-3.5 text-left">FB 账户</th><th class="p-3.5 text-left">TK 账户</th><th class="p-3.5 text-left">广告消耗</th><th class="p-3.5 text-left">累计充值</th><th class="p-3.5 text-left">数据记录</th><th class="p-3.5 text-left">操作</th></tr></thead><tbody class="divide-y divide-slate-100"><tr v-for="row in analyticsAllClientRows" :key="row.client.id" class="hover:bg-slate-50/70"><td class="p-3.5"><div class="font-extrabold text-slate-900">{{ row.client.name }}</div><div class="text-