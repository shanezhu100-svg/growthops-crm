"text-[11px] font-bold text-amber-300">所有客户累计广告消耗</div><div class="text-2xl font-black mt-2">{{ analyticsAllSpendText }}</div><div class="text-[10px] text-slate-400 mt-2">{{ activeClients.length }} 个在管客户 · 不同币种分别汇总</div></div>
              <div class="bg-white border border-emerald-100 rounded-2xl p-5 soft-shadow"><div class="text-[11px] font-bold text-emerald-600">全部累计广告充值</div><div class="text-2xl font-black mt-2 text-emerald-700">{{ analyticsAllRechargeText }}</div><div class="text-[10px] text-slate-400 mt-2">来自全部客户广告账户充值记录</div></div>
            </div>

            <div class="grid grid-cols-1 xl:grid-cols-2 gap-4">
              <div class="bg-white border border-blue-100 rounded-2xl p-5 soft-shadow">
                <div class="flex items-center justify-between gap-3"><div><div class="font-extrabold text-sm text-blue-900"><i class="fa-brands fa-facebook text-blue-600 mr-1.5"></i>Facebook 全客户汇总</div><div class="text-[10px] text-slate-400 mt-1">统一广告数据自动汇总</div></div><span class="text-[10px] font-bold text-blue-700 bg-blue-50 px-2 py-1 rounded-full">{{ analyticsAllFbMetrics.records }} 条数据</span></div>
                <div class="grid grid-cols-3 sm:grid-cols-6 gap-2 mt-4"><div v-for="m in [{l:'CPM',v:analyticsAllFbMetrics.cpmText},{l:'CTR',v:analyticsAllFbMetrics.ctrText},{l:'CPC',v:analyticsAllFbMetrics.cpcText},{l:'CVR',v:analyticsAllFbMetrics.cvrText},{l:'CPA',v:analyticsAllFbMetrics.cpaText},{l:'ROAS',v:analyticsAllFbMetrics.roasText}]" :key="m.l" class="rounded-xl bg-slate-50 border border-slate-100 p-3 text-center"><div class="text-[9px] text-slate-400">{{ m.l }}</div><div class="text-xs font-black mt-1">{{ m.v }}</div></div></div>
              </div>
              <div class="bg-white border border-slate-200 rounded-2xl p-5 soft-shadow">
                <div class="flex items-center justify-between gap-3"><div><div class="font-extrabold text-sm text-slate-900"><i class="fa-brands fa-tiktok mr-1.5"></i>TikTok 全客户汇总</div><div class="text-[10px] text-slate-400 mt-1">统一广告数据自动汇总</div></div><span class="text-[10px] font-bold text-slate-700 bg-slate-100 px-2 py-1 rounded-full">{{ analyticsAllTkMetrics.records }} 条数据</span></div>
                <div class="grid grid-cols-3 sm:grid-cols-6 gap-2 mt-4"><div v-for="m in [{l:'CPM',v:analyticsAllTkMetrics.cpmText},{l:'CTR',v:analyticsAllTkMetrics.ctrText},{l:'CPC',v:analyticsAllTkMetrics.cpcText},{l:'CVR',v:analyticsAllTkMetrics.cvrText},{l:'CPA',v:analyticsAllTkMetrics.cpaText},{l:'ROAS',v:analyticsAllTkMetrics.roasText}]" :key="m.l" class="rounded-xl bg-slate-50 border border-slate-100 p-3 text-center"><div class="text-[9px] text-slate-400">{{ m.l }}</div><div class="text-xs font-black mt-1">{{ m.v }}</div></div></div>
              </div>
            </div>

            <div class="bg-white border border-slate-200 rounded-2xl soft-shadow overflow-hidden">
              <div class="p-5 border-b border-slate-100"><h3 class="font-extrabold text-sm">所有客户投放数据</h3><p class="text-[11px] text-slate-400 mt-1">选择「所有客户」时展示客户级汇总；点击查看后进入该客户的广告账户明细分析。</p></div>
              <div class="overflow-x-auto scrollbar"><table class="w-full min-w-[980px] text-xs"><thead class="bg-slate-50 text-slate-500"><tr><th class="p-3.5 text-left">客户</th><th class="p-3.5 text-left">FB 账户</th><th class="p-3.5 text-left">TK 账户</th><th class="p-3.5 text-left">广告消耗</th><th class="p-3.5 text-left">累计充值</th><th class="p-3.5 text-left">数据记录</th><th class="p-3.5 text-left">操作</th></tr></thead><tbody class="divide-y divide-slate-100"><tr v-for="row in analyticsAllClientRows" :key="row.client.id" class="hover:bg-slate-50/70"><td class="p-3.5"><div class="font-extrabold text-slate-900">{{ row.client.name }}</div><div class="text-[10px] text-slate-400 mt-1">{{ row.client.project || row.client.product || '客户项目' }}</div></td><td class="p-3.5"><span class="font-bold text-blue-700">{{ row.fbAccounts }}</span></td><td class="p-3.5"><span class="font-bold text-slate-800">{{ row.tkAccounts }}</span></td><td class="p-3.5 font-black text-amber-600">{{ row.spendText }}</td><td class="p-3.5 font-black text-emerald-600">{{ row.rechargeText }}</td><td class="p-3.5"><span class="inline-flex px-2 py-1 rounded-full bg-cyan-50 text-cyan-700 font-extrabold text-[10px]">{{ row.records }} 条</span></td><td class="p-3.5 text-left"><button @click="selectAnalyticsClient(row.client.id)" class="h-8 px-3 rounded-lg bg-cyan-50 text-cyan-700 font-bold text-[11px]"><i class="fa-solid fa-chart-column mr-1"></i>查看分析</button></td></tr></tbody></table></div>
              <div v-if="!analyticsAllClientRows.length" class="py-12 text-center text-xs text-slate-400">暂无客户广告数据</div>
            </div>
          </div>

          <div v-else-if="selectedAnalyticsClient" class="space-y-5">
            <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4">
              <div class="bg-white border border-blue-100 rounded-2xl p-5 soft-shadow"><div class="text-[11px] font-bold text-blue-600">FACEBOOK 广告消耗</div><div class="text-2xl font-black mt-2">{{ platformSpendText(selectedAnalyticsClient,'FB') }}</div><div class="text-[10px] text-slate-400 mt-2">{{ (selectedAnalyticsClient.fbAccounts || []).length }} 个广告账户</div></div>
              <div class="bg-white border border-slate-200 rounded-2xl p-5 soft-shadow"><div class="text-[11px] font-bold text-slate-700">TIKTOK 广告消耗</div><div class="text-2xl font-black mt-2">{{ platformSpendText(selectedAnalyticsClient,'TK') }}</div><div class="text-[10px] text-slate-400 mt-2">{{ (selectedAnalyticsClient.tkAccounts || []).length }} 个广告账户</div></div>
              <div class="bg-slate-950 text-white rounded-2xl p-5 soft-shadow"><div class="text-[11px] font-bold text-amber-300">客户累计广告消耗</div><div class="text-2xl font-black mt-2">{{ clientSpendText(selectedAnalyticsClient) }}</div><div class="text-[10px] text-slate-400 mt-2">不同币种分别汇总</div></div>
              <div class="bg-white border border-emerald-100 rounded-2xl p-5 soft-shadow"><div class="text-[11px] font-bold text-emerald-600">累计广告充值</div><div class="text-2xl font-black mt-2 text-emerald-700">{{ clientRechargeText(selectedAnalyticsClient) }}</div><div class="text-[10px] text-slate-400 mt-2">来自各广告账户充值记录</div></div>
            </div>

            <div class="grid grid-cols-1 xl:grid-cols-2 gap-5"><analytics-card v-model="selectedAnalyticsFbAccountId" platform="Facebook" icon="fa-brands fa-facebook" tone="blue" :accounts="selectedAnalyticsClient.fbAccounts || []" :data="selectedAnalyticsFbMetrics" :spend-text="selectedAnalyticsFbAccount ? accountSpendText(selectedAnalyticsFbAccount) : '—'"></analytics-card><analytics-card v-model="selectedAnalyticsTkAccountId" platform="TikTok" icon="fa-brands fa-tiktok" tone="dark" :accounts="selectedAnalyticsClient.tkAccounts || []" :data="selectedAnalyticsTkMetrics" :spend-text="selectedAnalyticsTkAccount ? accountSpendText(selectedAnalyticsTkAccount) : '—'"></analytics-card></div>
            <div class="rounded-xl border border-emerald-100 bg-emerald-50/60 px-4 py-3 text-[11px] text-emerald-800"><i class="fa-solid fa-link mr-1.5"></i><b>统一广告数据：</b>只需要录入一次。同一条记录后续直接更新，广告管理、账户消耗、CTR、CPL、ROAS、余额提醒都会自动重新计算。</div>

            <div class="bg-white border border-slate-200 rounded-2xl soft-shadow overflow-hidden">
              <div class="p-5 border-b border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                <div><h3 class="font-extrabold text-sm">广告账户费用管理</h3><p class="text-[11px] text-slate-400 mt-1">切换广告账户后，只查看当前账户的消耗、累计充值与实时余额；USD 余额 ≤ $100 时自动生成广告费充值提醒。</p></div>
                <div class="text-[10px] text-indigo-600 bg-indigo-50 border border-indigo-100 px-3 py-1.5 rounded-full font-bold"><i class="fa-solid fa-arrows-rotate mr-1"></i>支持按广告账户切换费用数据</div>
              </div>
              <div class="p-5 grid grid-cols-1 xl:grid-cols-2 gap-5">
                <div>
                  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-3">
                    <div class="text-xs font-extrabold text-blue-900"><i class="fa-brands fa-facebook text-blue-600 mr-1.5"></i>Facebook 广告账户</div>
                    <span class="text-[10px] font-bold text-amber-700 bg-amber-50 px-2 py-1 rounded-full">累计消耗 {{ selectedAnalyticsFbAccount ? accountSpendText(selectedAnalyticsFbAccount) : '—' }}</span>
                  </div>
                  <div v-if="selectedAnalyticsClient.fbAccounts && selectedAnalyticsClient.fbAccounts.length" class="space-y-3">
                    <div class="rounded-xl border border-blue-100 bg-blue-50/40 p-3">
                      <div class="text-[10px] font-bold text-blue-700 mb-1.5">更换 Facebook 广告账户</div>
                      <select v-model="selectedAnalyticsFbAccountId" class="field bg-white font-bold text-blue-900">
                        <option v-for="(a,idx) in selectedAnalyticsClient.fbAccounts" :key="a.id || idx" :value="a.id">{{ a.accountName || `Facebook 账号 ${idx+1}` }} · {{ a.adAccountId || '未录入广告账号 ID' }}</option>
                      </select>
                    </div>
                    <div v-for="account in [selectedAnalyticsFbAccount]" :key="account.id" class="rounded-2xl border border-blue-100 bg-blue-50/25 p-4">
                      <div class="flex items-start justify-between gap-3"><div class="min-w-0"><div class="text-xs font-extrabold text-blue-900 truncate">{{ account.accountName || 'Facebook 广告账户' }}</div><div class="text-[10px] text-slate-400 font-mono mt-1 truncate">{{ account.adAccountId || '未录入广告账号 ID' }}</div></div><span class="shrink-0 text-[10px] font-bold text-blue-600 bg-white border border-blue-100 px-2 py-1 rounded-full">FB</span></div>
                      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mt-4">
                        <div v-if="account.adDataRecords && account.adDataRecords.length" class="sm:col-span-2 rounded-xl bg-cyan-50 border border-cyan-100 p-3"><div class="flex items-center justify-between gap-3"><div><div class="text-[10px] font-semibold text-cyan-700">账户累计消耗 · 广告数据自动同步</div><div class="text-lg font-black text-slate-900 mt-1">{{ accountSpendText(account) }}</div></div><span class="text-[10px] font-bold text-cyan-700 bg-white border border-cyan-100 px-2 py-1 rounded-full">{{ account.adDataRecords.length }} 条数据</span></div></div>
                        <div v-else class="sm:col-span-2 rounded-xl border border-dashed border-cyan-200 bg-cyan-50/30 p-3"><div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3"><div><div class="text-[10px] font-extrabold text-cyan-700">暂无广告数据</div><div class="text-[10px] text-slate-400 mt-1">无需单独填写消耗，录入一次广告数据后会自动计算并同步两处。</div></div><button @click="openAdDataFromAnalytics('FB',account)" class="h-9 px-3 rounded-xl bg-cyan-600 text-white text-[11px] font-bold shrink-0"><i class="fa-solid fa-plus mr-1"></i>录入广告数据</button></div></div>
                        <div class="rounded-xl bg-white border border-emerald-100 p-3"><div class="text-[10px] text-slate-400">累计充值</div><div class="text-sm font-extrabold text-emerald-600 mt-1">{{ accountRechargeText(account) }}</div></div>
                        <div class="rounded-xl bg-white border p-3" :class="hasUsdBalanceData(account) && isLowBalance(account) ? 'border-rose-200 bg-rose-50/40' : 'border-amber-100'"><div class="text-[10px] text-slate-400">当前账户余额</div><div class="text-sm font-black mt-1" :class="hasUsdBalanceData(account) ? (isLowBalance(account)?'text-rose-600':'text-emerald-600') : 'text-slate-400'">{{ accountBalanceText(account) }}</div></div>
                        <div class="rounded-xl bg-white border border-slate-100 p-3"><div class="text-[10px] text-slate-400">余额计算方式</div><div class="text-[11px] font-bold text-slate-700 mt-1">累计 USD 充值 − USD 广告消耗</div></div>
                        <div class="rounded-xl border p-3" :class="hasUsdBalanceData(account) && isCriticalBalance(account) ? 'bg-red-50 border-red-200' : (hasUsdBalanceData(account) && isLowBalance(account) ? 'bg-rose-50 border-rose-200' : 'bg-amber-50 border-amber-100')"><div class="text-[10px] font-semibold" :class="hasUsdBalanceData(account) && isCriticalBalance(account)?'text-red-700':(hasUsdBalanceData(account) && isLowBalance(account)?'text-rose-600':'text-amber-700')">自动充值提醒</div><div class="text-xs font-extrabold mt-1">≤ $100 首次提醒 · ≤ $30 再次提醒</div><div class="text-[10px] text-slate-500 mt-1">{{ !hasUsdBalanceData(account) ? '登记一笔 USD 充值后开始自动监控' : (isCriticalBalance(account) ? '余额已到 $30 或以下：已触发二次紧急充值提醒' : (isLowBalance(account) ? '余额已到 $100 或以下：已触发首次充值提醒' : '当前余额充足，无需充值')) }}</div></div>
                      </div>
                      <div v-if="account.adDataRecords && account.adDataRecords.length" class="mt-4 pt-4 border-t border-cyan-100"><div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3"><div><div class="text-[10px] font-extrabold text-cyan-700">广告数据同步分析</div><div class="text-[10px] text-slate-400 mt-1">数据来自「广告管理 → 广告数据记录」· 可按日期切换</div></div><div class="flex flex-wrap items-center gap-1.5"><select v-model="selectedAnalyticsFbDataDate" class="h-8 rounded-lg border border-cyan-100 bg-white px-2 text-[10px] font-bold text-cyan-800"><option value="ALL">全部日期</option><option v-for="date in accountDataDates(account)" :key="date" :value="date">{{ date }}</option></select><button @click="openAdDataFromAnalytics('FB',account)" class="h-8 px-2.5 rounded-lg bg-cyan-600 text-white text-[10px] font-bold"><i class="fa-solid fa-arrows-rotate mr-1"></i>录入/更新</button><button @click="selectedAdsClientId=selectedAnalyticsClient.id; selectedAdsPlatform='FB'; selectedAdsAccountId=account.id; navigateTo('ads')" class="h-8 px-2.5 rounded-lg bg-cyan-50 text-cyan-700 text-[10px] font-bold">查看数据记录</button></div></div><div class="mt-2 text-[10px] text-slate-400">当前范围：{{ selectedAnalyticsFbDataDate==='ALL' ? '全部日期' : selectedAnalyticsFbDataDate }} · {{ accountDataSummary(account,selectedAnalyticsFbDataDate).records }} 条记录</div><div class="grid grid-cols-2 sm:grid-cols-4 gap-2 mt-3"><div class="rounded-lg bg-white border border-slate-100 p-2"><div class="text-[9px] text-slate-400">曝光</div><div class="text-[11px] font-extrabold mt-0.5">{{ accountDataSummary(account,selectedAnalyticsFbDataDate).impressions.toLocaleString() }}</div></div><div class="rounded-lg bg-white border border-slate-100 p-2"><div class="text-[9px] text-slate-400">点击</div><div class="text-[11px] font-extrabold mt-0.5">{{ accountDataSummary(account,selectedAnalyticsFbDataDate).clicks.toLocaleString() }}</div></div><div class="rounded-lg bg-white border border-slate-100 p-2"><div class="text-[9px] text-slate-400">潜客</div><div class="text-[11px] font-extrabold mt-0.5">{{ accountDataSummary(account,selectedAnalyticsFbDataDate).leads.toLocaleString() }}</div></div><div class="rounded-lg bg-white border border-slate-100 p-2"><div class="text-[9px] text-slate-400">转化</div><div class="text-[11px] font-extrabold mt-0.5">{{ accountDataSummary(account,selectedAnalyticsFbDataDate).conversions.toLocaleString() }}</div></div></div><div class="grid grid-cols-2 sm:grid-cols-4 xl:grid-cols-8 gap-2 mt-2"><div v-for="m in [{l:'CPM',v:accountDataSummary(account,selectedAnalyticsFbDataDate).cpmText},{l:'CTR',v:accountDataSummary(account,selectedAnalyticsFbDataDate).ctrText},{l:'CPC',v:accountDataSummary(account,selectedAnalyticsFbDataDate).cpcText},{l:'CPL',v:accountDataSummary(account,selectedAnalyticsFbDataDate).cplText},{l:'CVR',v:accountDataSummary(account,selectedAnalyticsFbDataDate).cvrText},{l:'CPA',v:accountDataSummary(account,selectedAnalyticsFbDataDate).cpaText},{l:'ROAS',v:accountDataSummary(account,selectedAnalyticsFbDataDate).roasText},{l:'频次',v:accountDataSummary(account,selectedAnalyticsFbDataDate).frequencyText}]" :key="m.l" class="rounded-lg bg-white border border-slate-100 p-2"><div class="text-[9px] text-slate-400">{{ m.l }}</div><div class="text-[11px] font-extrabold mt-0.5">{{ m.v }}</div></div></div><div class="grid grid-cols-2 sm:grid-cols-3 xl:grid-cols-6 gap-2 mt-2"><div v-for="m in [{l:'3 秒播放率',v:accountDataSummary(account,selectedAnalyticsFbDataDate).video3sRateText},{l:'25% 播放率',v:accountDataSummary(account,selectedAnalyticsFbDataDate).video25RateText},{l:'50% 播放率',v:accountDataSummary(account,selectedAnalyticsFbDataDate).video50RateText},{l:'75% 播放率',v:accountDataSummary(account,selectedAnalyticsFbDataDate).video75RateText},{l:'95% 播放率',v:accountDataSummary(account,selectedAnalyticsFbDataDate).video95RateText},{l:'完播率',v:accountDataSummary(account,selectedAnalyticsFbDataDate).videoCompleteRateText}]" :key="m.l" class="rounded-lg bg-white border border-cyan-100 p-2"><div class="text-[9px] text-slate-400">{{ m.l }}</div><div class="text-[11px] font-extrabold text-cyan-700 mt-0.5">{{ m.v }}</div></div></div></div>
                    </div>
                  </div>
                  <div v-else class="py-10 text-center text-xs text-slate-400 border border-dashed border-blue-100 rounded-xl">当前客户暂无 Facebook 广告账户</div>
                </div>

                <div>
                  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-3">
                    <div class="text-xs font-extrabold text-slate-900"><i class="fa-brands fa-tiktok mr-1.5"></i>TikTok 广告账户</div>
                    <span class="text-[10px] font-bold text-amber-700 bg-amber-50 px-2 py-1 rounded-full">累计消耗 {{ selectedAnalyticsTkAccount ? accountSpendText(selectedAnalyticsTkAccount) : '—' }}</span>
                  </div>
                  <div v-if="selectedAnalyticsClient.tkAccounts && selectedAnalyticsClient.tkAccounts.length" class="space-y-3">
                    <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                      <div class="text-[10px] font-bold text-slate-700 mb-1.5">更换 TikTok 广告账户</div>
                      <select v-model="selectedAnalyticsTkAccountId" class="field bg-white font-bold text-slate-900">
                        <option v-for="(a,idx) in selectedAnalyticsClient.tkAccounts" :key="a.id || idx" :value="a.id">{{ a.accountName || `TikTok 账号 ${idx+1}` }} · {{ a.adAccountId || '未录入广告账号 ID' }}</option>
                      </select>
                    </div>
                    <div v-for="account in [selectedAnalyticsTkAccount]" :key="account.id" class="rounded-2xl border border-slate-200 bg-slate-50/60 p-4">
                      <div class="flex items-start justify-between gap-3"><div class="min-w-0"><div class="text-xs font-extrabold text-slate-900 truncate">{{ account.accountName || 'TikTok 广告账户' }}</div><div class="text-[10px] text-slate-400 font-mono mt-1 truncate">{{ account.adAccountId || '未录入广告账号 ID' }}</div></div><span class="shrink-0 text-[10px] font-bold text-slate-700 bg-white border border-slate-200 px-2 py-1 rounded-full">TK</span></div>
                      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mt-4">
                        <div v-if="account.adDataRecords && account.adDataRecords.length" class="sm:col-span-2 rounded-xl bg-cyan-50 border border-cyan-100 p-3"><div class="flex items-center justify-between gap-3"><div><div class="text-[10px] font-semibold text-cyan-700">账户累计消耗 · 广告数据自动同步</div><div class="text-lg font-black text-slate-900 mt-1">{{ accountSpendText(account) }}</div></div><span class="text-[10px] font-bold text-cyan-700 bg-white border border-cyan-100 px-2 py-1 rounded-full">{{ account.adDataRecords.length }} 条数据</span></div></div>
                        <div v-else class="sm:col-span-2 rounded-xl border border-dashed border-cyan-200 bg-cyan-50/30 p-3"><div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3"><div><div class="text-[10px] font-extrabold text-cyan-700">暂无广告数据</div><div class="text-[10px] text-slate-400 mt-1">无需单独填写消耗，录入一次广告数据后会自动计算并同步两处。</div></div><button @click="openAdDataFromAnalytics('TK',account)" class="h-9 px-3 rounded-xl bg-cyan-600 text-white text-[11px] font-bold shrink-0"><i class="fa-solid fa-plus mr-1"></i>录入广告数据</button></div></div>
                        <div class="rounded-xl bg-white border border-emerald-100 p-3"><div class="text-[10px] text-slate-400">累计充值</div><div class="text-sm font-extrabold text-emerald-600 mt-1">{{ accountRechargeText(account) }}</div></div>
                        <div class="rounded-xl bg-white border p-3" :class="hasUsdBalanceData(account) && isLowBalance(account) ? 'border-rose-200 bg-rose-50/40' : 'border-amber-100'"><div class="text-[10px] text-slate-400">当前账户余额</div><div class="text-sm font-black mt-1" :class="hasUsdBalanceData(account) ? (isLowBalance(account)?'text-rose-600':'text-emerald-600') : 'text-slate-400'">{{ accountBalanceText(account) }}</div></div>
                        <div class="rounded-xl bg-white border border-slate-100 p-3"><div class="text-[10px] text-slate-400">余额计算方式</div><div class="text-[11px] font-bold text-slate-700 mt-1">累计 USD 充值 − USD 广告消耗</div></div>
                        <div class="rounded-xl border p-3" :class="hasUsdBalanceData(account) && isCriticalBalance(account) ? 'bg-red-50 border-red-200' : (hasUsdBalanceData(account) && isLowBalance(account) ? 'bg-rose-50 border-rose-200' : 'bg-amber-50 border-amber-100')"><div class="text-[10px] font-semibold" :class="hasUsdBalanceData(account) && isCriticalBalance(account)?'text-red-700':(hasUsdBalanceData(account) && isLowBalance(account)?'text-rose-600':'text-amber-700')">自动充值提醒</div><div class="text-xs font-extrabold mt-1">≤ $100 首次提醒 · ≤ $30 再次提醒</div><div class="text-[10px] text-slate-500 mt-1">{{ !hasUsdBalanceData(account) ? '登记一笔 USD 充值后开始自动监控' : (isCriticalBalance(account) ? '余额已到 $30 或以下：已触发二次紧急充值提醒' : (isLowBalance(account) ? '余额已到 $100 或以下：已触发首次充值提醒' : '当前余额充足，无需充值')) }}</div></div>
                      </div>
                      <div v-if="account.adDataRecords && account.adDataRecords.length" class="mt-4 pt-4 border-t border-cyan-100"><div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3"><div><div class="text-[10px] font-extrabold text-cyan-700">广告数据同步分析</div><div class="text-[10px] text-slate-400 mt-1">数据来自「广告管理 → 广告数据记录」· 可按日期切换</div></div><div class="flex flex-wrap items-center gap-1.5"><select v-model="selectedAnalyticsTkDataDate" class="h-8 rounded-lg border border-cyan-100 bg-white px-2 text-[10px] font-bold text-cyan-800"><option value="ALL">全部日期</option><option v-for="date in accountDataDates(account)" :key="date" :value="date">{{ date }}</option></select><button @click="openAdDataFromAnalytics('TK',account)" class="h-8 px-2.5 rounded-lg bg-cyan-600 text-white text-[10px] font-bold"><i class="fa-solid fa-arrows-rotate mr-1"></i>录入/更新</button><button @click="selectedAdsClientId=selectedAnalyticsClient.id; selectedAdsPlatform='TK'; selectedAdsAccountId=account.id; navigateTo('ads')" class="h-8 px-2.5 rounded-lg bg-cyan-50 text-cyan-700 text-[10px] font-bold">查看数据记录</button></div></div><div class="mt-2 text-[10px] text-slate-400">当前范围：{{ selectedAnalyticsTkDataDate==='ALL' ? '全部日期' : selectedAnalyticsTkDataDate }} · {{ accountDataSummary(account,selectedAnalyticsTkDataDate).records }} 条记录</div><div class="grid grid-cols-2 sm:grid-cols-4 gap-2 mt-3"><div class="rounded-lg bg-white border border-slate-100 p-2"><div class="text-[9px] text-slate-400">曝光</div><div class="text-[11px] font-extrabold mt-0.5">{{ accountDataSummary(account,selectedAnalyticsTkDataDate).impressions.toLocaleString() }}</div></div><div class="rounded-lg bg-white border border-slate-100 p-2"><div class="text-[9px] text-slate-400">点击</div><div class="text-[11px] font-extrabold mt-0.5">{{ accountDataSummary(account,selectedAnalyticsTkDataDate).clicks.toLocaleString() }}</div></div><div class="rounded-lg bg-white border border-slate-100 p-2"><div class="text-[9px] text-slate-400">潜客</div><div class="text-[11px] font-extrabold mt-0.5">{{ accountDataSummary(account,selectedAnalyticsTkDataDate).leads.toLocaleString() }}</div></div><div class="rounded-lg bg-white border border-slate-100 p-2"><div class="text-[9px] text-slate-400">转化</div><div class="text-[11px] font-extrabold mt-0.5">{{ accountDataSummary(account,selectedAnalyticsTkDataDate).conversions.toLocaleString() }}</div></div></div><div class="grid grid-cols-2 sm:grid-cols-4 xl:grid-cols-8 gap-2 mt-2"><div v-for="m in [{l:'CPM',v:accountDataSummary(account,selectedAnalyticsTkDataDate).cpmText},{l:'CTR',v:accountDataSummary(account,selectedAnalyticsTkDataDate).ctrText},{l:'CPC',v:accountDataSummary(account,selectedAnalyticsTkDataDate).cpcText},{l:'CPL',v:accountDataSummary(account,selectedAnalyticsTkDataDate).cplText},{l:'CVR',v:accountDataSummary(account,selectedAnalyticsTkDataDate).cvrText},{l:'CPA',v:accountDataSummary(account,selectedAnalyticsTkDataDate).cpaText},{l:'ROAS',v:accountDataSummary(account,selectedAnalyticsTkDataDate).roasText},{l:'频次',v:accountDataSummary(account,selectedAnalyticsTkDataDate).frequencyText}]" :key="m.l" class="rounded-lg bg-white border border-slate-100 p-2"><div class="text-[9px] text-slate-400">{{ m.l }}</div><div class="text-[11px] font-extrabold mt-0.5">{{ m.v }}</div></div></div></div>
                    </div>
                  </div>
                  <div v-else class="py-10 text-center text-xs text-slate-400 border border-dashed border-slate-200 rounded-xl">当前客户暂无 TikTok 广告账户</div>
                </div>
              </div>
            </div>
          </div>
          <div v-else class="bg-white border border-slate-200 rounded-2xl py-16 text-center text-xs text-slate-400">暂无客户资料</div>
        </section>

        <!-- Finance -->
        <section v-else-if="currentPage==='finance'" key="finance" class="space-y-5">
          <div class="flex flex-col xl:flex-row xl:items-start justify-between gap-4">
            <div><h2 class="text-2xl font-extrabold tracking-tight">财务管理</h2><p class="text-xs text-slate-500 mt-1">围绕收入、回款、广告消耗、开户商返点与成本支出完成财务闭环；每月对账后形成可确认的净利润。</p></div>
            <div class="flex flex-wrap items-center gap-2">
              <button @click="exportFinanceExcel" class="h-10 px-4 rounded-xl bg-emerald-600 text-white text-xs font-bold hover:bg-emerald-500"><i class="fa-solid fa-file-excel mr-1.5"></i>导出 Excel</button>
              <button @click="openReceivableModal" class="h-10 px-4 rounded-xl bg-indigo-600 text-white text-xs font-bold hover:bg-indigo-500"><i class="fa-solid fa-file-invoice-dollar mr-1.5"></i>新增应收</button>
              <button @click="openCostModal" class="h-10 px-4 rounded-xl border border-slate-200 bg-white text-xs font-bold hover:bg-slate-50"><i class="fa-solid fa-receipt mr-1.5"></i>新增成本</button>
              <button @click="openReconciliationModal" class="h-10 px-4 rounded-xl border border-amber-200 bg-amber-50 text-amber-800 text-xs font-bold hover:bg-amber-100"><i class="fa-solid fa-scale-balanced mr-1.5"></i>代理商对账</button>
            </div>
          </div>

          <div class="bg-white border border-slate-200 rounded-2xl p-5 soft-shadow">
            <div class="profit-filter-bar">
              <div class="profit-filter-item">
                <div class="profit-filter-label"><i class="fa-regular fa-calendar"></i><span>统计周期</span></div>
                <select v-model="financePeriod" class="profit-filter-select"><option value="MONTH">按月</option><option value="QUARTER">按季度</option><option value="YEAR">按年度</option></select>
              </div>
              <div v-if="financePeriod==='MONTH'" class="profit-filter-item">
                <div class="profit-filter-label"><i class="fa-regular fa-calendar-days"></i><span>选择月份</span></div>
                <div class="profit-date-control"><input type="month" v-model="financeMonthKey"><button @click="financeMonthKey=localDateKey().slice(0,7)" title="本月"><i class="fa-solid fa-rotate-right text-[10px]"></i></button></div>
              </div>
              <div v-else-if="financePeriod==='QUARTER'" class="profit-filter-item">
                <div class="profit-filter-label"><i class="fa-regular fa-calendar-days"></i><span>季度</span></div>
                <div class="grid grid-cols-2 gap-2"><select v-model.number="financeQuarterYear" class="profit-filter-select"><option v-for="y in financeYearOptions" :value="y" :key="y">{{ y }} 年</option></select><select v-model.number="financeQuarter" class="profit-filter-select"><option :value="1">Q1</option><option :value="2">Q2</option><option :value="3">Q3</option><option :value="4">Q4</option></select></div>
              </div>
              <div v-else class="profit-filter-item">
                <div class="profit-filter-label"><i class="fa-regular fa-calendar-days"></i><span>年度</span></div>
                <select v-model.number="financeYear" class="profit-filter-select"><option v-for="y in financeYearOptions" :value="y" :key="y">{{ y }} 年</option></select>
              </div>
              <div class="profit-filter-item">
                <div class="profit-filter-label"><i class="fa-solid fa-user-group"></i><span>客户</span></div>
                <select v-model="financeClientFilter" class="profit-filter-select"><option value="ALL">全部客户</option><option v-for="c in clients" :key="c.id" :value="String(c.id)">{{ c.name }}</option></select>
              </div>
              <div class="profit-filter-item">
                <div class="profit-filter-label"><i class="fa-solid fa-building-columns"></i><span>开户商</span></div>
                <select v-model="financeProviderFilter" class="profit-filter-select"><option value="ALL">全部开户商</option><option v-for="p in openingProviders" :key="p.id" :value="String(p.id)">{{ p.name }}</option></select>
              </div>
            </div>
            <div class="profit-filter-row-note"><i class="fa-solid fa-circle-info"></i><span>利润核算会自动汇总当前筛选范围内的应收、回款、广告消耗、返点与成本；已锁定月份会冻结历史口径。</span></div>
          </div>

          <div class="finance-kpi-layout">
            <div class="finance-panel">
              <div class="finance-panel-header"><div><div class="finance-panel-title">收入 / 回款</div><div class="finance-panel-desc">当前统计范围内的应收收入、实际回款与待收款。</div></div><span class="finance-panel-tag">{{ financePeriodLabel }}</span></div>
              <div class="finance-kpi-grid finance-kpi-grid-three">
                <div class="finance-kpi-card is-emerald"><div class="metric-label">本期收入</div><div class="metric-money-list"><div v-for="row in financeRevenueRows" :key="'revenue-'+row.currency" class="metric-money-row"><span class="metric-money-currency">{{ row.currency }}</span><span class="metric-money-amount">{{ row.revenueText }}</span></div></div><div class="metric-note">按结算月份统计应收收入</div></div>
                <div class="finance-kpi-card is-blue"><div class="metric-label">账单已收</div><div class="metric-money-list"><div v-for="row in financeRevenueRows" :key="'paid-'+row.currency" class="metric-money-row"><span class="metric-money-currency">{{ row.currency }}</span><span class="metric-money-amount">{{ row.paidText }}</span></div></div><div class="metric-note">按账单归属确认已收款</div></div>
                <div class="finance-kpi-card is-amber"><div class="metric-label">待收款</div><div class="metric-money-list"><div v-for="row in financeRevenueRows" :key="'unpaid-'+row.currency" class="metric-money-row"><span class="metric-money-currency">{{ row.currency }}</span><span class="metric-money-amount">{{ row.unpaidText }}</span></div></div><div class="metric-note">应收金额减已收金额</div></div>
              </div>
            </div>
            <div class="finance-panel">
              <div class="finance-panel-header"><div><div class="finance-panel-title">广告 / 返点 / 成本</div><div class="finance-panel-desc">广告账户消耗、代理商返点与归属成本。</div></div><span class="finance-panel-tag">财务闭环</span></div>
              <div class="finance-kpi-grid finance-kpi-grid-four">
                <div class="finance-kpi-card is-slate"><div class="metric-label">广告总消耗</div><div class="metric-money-list"><div v-for="row in financeSpendRows" :key="'spend-'+row.currency" class="metric-money-row"><span class="metric-money-currency">{{ row.currency }}</span><span class="metric-money-amount">{{ row.spendText }}</span></div></div><div class="metric-note">全部广告账户实际消耗</div></div>
                <div class="finance-kpi-card is-violet"><div class="metric-label">预计返点</div><div class="metric-money-list"><div v-for="row in financeSpendRows" :key="'expected-'+row.currency" class="metric-money-row"><span class="metric-money-currency">{{ row.currency }}</span><span class="metric-money-amount">{{ row.expectedText }}</span></div></div><div class="metric-note">按历史生效返点政策计算</div></div>
                <div class="finance-kpi-card is-emerald"><div class="metric-label">实际返点</div><div class="metric-money-list"><div v-for="row in financeSpendRows" :key="'actual-'+row.currency" class="metric-money-row"><span class="metric-money-currency">{{ row.currency }}</span><span class="metric-money-amount">{{ row.actualText }}</span></div></div><div class="metric-note">来源于代理商返点对账</div></div>
                <div class="finance-kpi-card is-rose"><div class="metric-label">总成本</div><div class="metric-money-list"><div v-for="row in financeSpendRows" :key="'cost-'+row.currency" class="metric-money-row"><span class="metric-money-currency">{{ row.currency }}</span><span class="metric-money-amount">{{ row.costText }}</span></div></div><div class="metric-note">客户归属成本 + 公司成本</div></div>
              </div>
            </div>
            <div class="finance-profit-column">
              <div class="finance-profit-card is-expected"><div><span class="profit-chip"><i class="fa-solid fa-chart-line"></i>预计</span><div class="profit-label mt-3">预计净利润</div><div class="profit-money-list"><div v-for="row in financeProfitRows" :key="'p-exp-'+row.currency" class="profit-money-row"><span class="profit-money-currency">{{ row.currency }}</span><span class="profit-money-amount">{{ row.expectedText }}</span></div></div></div><div class="profit-note">收入 + 预计返点 − 成本</div></div>
              <div class="finance-profit-card is-confirmed"><div><span class="profit-chip"><i class="fa-solid fa-circle-check"></i>当前</span><div class="profit-label mt-3">当前 / 已确认净利润</div><div class="profit-money-list"><div v-for="row in financeProfitRows" :key="'p-act-'+row.currency" class="profit-money-row"><span class="profit-money-currency">{{ row.currency }}</span><span class="profit-money-amount">{{ row.actualText }}</span></div></div></div><div class="profit-note">{{ financeActualProfitLabel }}</div></div>
            </div>
          </div>

          <div class="bg-white border border-slate-200 rounded-2xl soft-shadow overflow-hidden">
            <div class="p-5 border-b border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-3"><div><h3 class="font-extrabold text-sm">客户盈利明细</h3><p class="text-[11px] text-slate-400 mt-1">按客户查看收入、广告消耗、返点、成本与净利润。</p></div><span class="text-[10px] font-bold text-slate-500 bg-slate-50 border border-slate-100 px-3 py-1.5 rounded-full">{{ financeRows.length }} 个客户</span></div>
            <div class="overflow-x-auto scrollbar"><table class="w-full min-w-[1280px] text-xs"><thead class="bg-slate-50 text-slate-500"><tr><th class="p-3.5 text-left">客户</th><th class="p-3.5 text-left">收入</th><th class="p-3.5 text-left">已收</th><th class="p-3.5 text-left">广告消耗</th><th class="p-3.5 text-left">预计返点</th><th class="p-3.5 text-left">实际返点</th><th class="p-3.5 text-left">归属成本</th><th class="p-3.5 text-left">预计净利润</th><th class="p-3.5 text-left">当前净利润</th><th class="p-3.5 text-left">状态</th></tr></thead><tbody class="divide-y divide-slate-100"><tr v-for="row in financeRows" :key="row.client.id" class="hover:bg-slate-50/70"><td class="p-3.5"><div class="font-extrabold text-slate-900">{{ row.client.name }}</div><div class="text-[10px] text-slate-400 mt-1">{{ (row.channelLabels||[]).join(' · ') || '暂无开户商归属' }}</div></td><td class="p-3.5 font-bold text-emerald-700">{{ spendGroupsText(row.receivableGroups) }}</td><td class="p-3.5 font-bold text-blue-700">{{ spendGroupsText(row.paidGroups) }}</td><td class="p-3.5 font-bold text-amber-700">{{ spendGroupsText(row.spendGroups) }}</td><td class="p-3.5 font-bold text-violet-700">{{ spendGroupsText(row.expectedRebateGroups) }}</td><td class="p-3.5 font-bold text-emerald-700">{{ spendGroupsText(row.actualRebateGroups) }}</td><td class="p-3.5 font-bold text-rose-600">{{ spendGroupsText(row.costGroups) }}</td><td class="p-3.5 font-black text-slate-900">{{ spendGroupsText(row.expectedNetProfitGroups) }}</td><td class="p-3.5 font-black text-indigo-700">{{ spendGroupsText(row.actualNetProfitGroups) }}</td><td class="p-3.5"><span class="px-2 py-1 rounded-full text-[10px] font-bold" :class="row.actualProfitConfirmed?'bg-emerald-50 text-emerald-700':'bg-amber-50 text-amber-700'">{{ row.actualProfitLabel }}</span></td></tr></tbody></table></div>
          </div>
