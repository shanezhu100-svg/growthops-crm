                    <span class="text-[10px] font-bold text-amber-700 bg-amber-50 px-2 py-1 rounded-full">累计消耗 {{ selectedAnalyticsFbAccount ? accountSpendText(selectedAnalyticsFbAccount) : '—' }}</span>
