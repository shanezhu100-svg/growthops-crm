e border p-3" :class="hasUsdBalanceData(account) && isLowBalance(account) ? 'border-rose-200 bg-rose-50/40' : 'border-amber-100'"><div class="text-[10px] text-slate-400">当前账户余额</div><div class="text-sm font-black mt-1" :class="hasUsdBalanceData(account) ? (isLowBalance(account)?'text-rose-600':'text-emerald-600') : 'text-slate-400'">{{ accountBalanceText(account) }}</div></div>
                        <div class="rounded-xl bg-white border border-slate-100 p-3"><div class="text-[10px] text-slate-400">余额计算方式</div><div class="text-[11px] font-bold text-slate-700 mt-1">累计 USD 充值 − USD 广告消耗</div></div>
                        <div class="rounded-xl border p-3" :class="hasUsdBalanceData(account) && isCriticalBalance(account) ? 'bg-red-50 border-red-200' : (hasUsdBalanceData(account) && isLowBalance(account) ? 'bg-rose-50 border-rose-200' : 'bg-amber-50 border-amber-100')"><div class="text-[10px] font-semibold" :class="hasUsdBalanceData(account) && isCriticalBalance(account)?'text-red-700':(hasUsdBalanceData(account) && isLowBalance(account)?'text-rose-600':'text-amber-700')">自动充值提醒</div><div class="text-xs font-extrabold mt-1">≤ $100 首次提醒 · ≤ $30 再次提醒</div><div class="text-[10px] text-slate-500 mt-1">{{ !hasUsdBalanceData(account) ? '登记一笔 USD 充值后开始自动监控' : (isCriticalBalance(account) ? '余额已到 $30 或以下：已触发二次紧急充值提醒' : (isLowBalance(account) ? '余额已到 $100 或以下：已触发首次充值提醒' : '当前余额充足，无需充值')) }}</div></div>
                      </div>
                      <div v-if="account.adDataRecords && account.adDataRecords.length" class="mt-4 pt-4 border-t border-cyan-100"><div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3"><div><div class="text-[10px] font-extrabold text-cyan-700">广告数据同步分析</div><div class="text-[10px] text-slate-400 mt-1">数据来自「广告管理 → 广告数据记录」· 可按日期切换</div></div><div class="flex flex-wrap items-center gap-1.5"><select v-model="selectedAnalyticsFbDataDate" class="h-8 rounded-lg border border-cyan-100 bg-white px-2 text-[10px] font-bold text-cyan-800"><option value="ALL">全部日期</option><option v-for="date in accountDataDates(account)" :key="date" :value="date">{{ date }}</option></select><button @click="openAdDataFromAnalytics('FB',account)" class="h-8 px-2.5 rounded-lg bg-cyan-600 text-white text-[10px] font-bold"><i class="fa-solid fa-arrows-rotate mr-1"></i>录入/更新</button><button @click="selectedAdsClientId=selectedAnalyticsClient.id; selectedAdsPlatform='FB'; selectedAdsAccountId=account.id; navigateTo('ads')" class="h-8 px-2.5 rounded-lg bg-cyan-50 text-cyan-700 text-[10px] font-bold">查看数据记录</button></div></div><div class="mt-2 text-[10px] text-slate-400">当前范围：{{ selectedAnalyticsFbDataDate==='ALL' ? '全部日期' : selectedAnalyticsFbDataDate }} · {{ accountDataSummary(account,selectedAnalyticsFbDataDate).records }} 条记录</div><div class="grid grid-cols-2 sm:grid-cols-4 gap-2 mt-3"><div class="rounded-lg bg-white border border-slate-100 p-2"><div class="text-[9px] text-slate-400">曝光</div><div class="text-[11px] font-extrabold mt-0.5">{{ accountDataSummary(account,selectedAnalyticsFbDataDate).impressions.toLocaleString() }}</div></div><div class="rounded-lg bg-white border border-slate-100 p-2"><div class="text-[9px] text-slate-400">点击</div><div class="text-[11px] font-extrabold mt-0.5">{{ accountDataSummary(account,selectedAnalyticsFbDataDate).clicks.toLocaleString() }}</div></div><div class="rounded-lg bg-white border border-slate-100 p-2"><div class="text-[9px] text-slate-400">潜客</div><div class="text-[11px] font-extrabold mt-0.5">{{ accountDataSummary(account,selectedAnalyticsFbDataDate).leads.toLocaleString() }}</div></div><div class="rounded-lg bg-white border border-slate-100 p-2"><div class="text-[9px] text-slate-400">转化</div><div class="text