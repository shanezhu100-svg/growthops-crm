-[9px] text-slate-400">转化</div><div class="text-[11px] font-extrabold mt-0.5">{{ accountDataSummary(account,selectedAnalyticsFbDataDate).conversions.toLocaleString() }}</div></div><div class="rounded-lg bg-white border border-slate-100 p-2"><div class="text-[9px] text-slate-400">CTR</div><div class="text-[11px] font-extrabold mt-0.5">{{ accountDataSummary(account,selectedAnalyticsFbDataDate).ctrText }}</div></div><div class="rounded-lg bg-white border border-slate-100 p-2"><div class="text-[9px] text-slate-400">CPL</div><div class="text-[11px] font-extrabold mt-0.5">{{ accountDataSummary(account,selectedAnalyticsFbDataDate).cplText }}</div></div><div class="rounded-lg bg-white border border-slate-100 p-2"><div class="text-[9px] text-slate-400">ROAS</div><div class="text-[11px] font-extrabold mt-0.5">{{ accountDataSummary(account,selectedAnalyticsFbDataDate).roasText }}</div></div><div class="rounded-lg bg-white border border-slate-100 p-2"><div class="text-[9px] text-slate-400">收入</div><div class="text-[11px] font-extrabold mt-0.5">{{ accountDataSummary(account,selectedAnalyticsFbDataDate).revenueText }}</div></div></div></div>
                      <div class="flex items-center justify-between gap-2 mt-4 pt-4 border-t border-blue-100"><div class="text-[10px] text-slate-400">最近充值：{{ latestRechargeLabel(account) }}</div><button @click="openRechargeModal(selectedAnalyticsClient,'FB',account)" class="h-9 px-3 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white text-[11px] font-bold"><i class="fa-solid fa-plus mr-1"></i>登记广告充值</button></div>
                      <div v-if="account.rechargeHistory && account.rechargeHistory.length" class="mt-3 space-y-2"><div v-for="record in account.rechargeHistory.slice(0,3)" :key="record.id" class="flex items-center justify-between gap-3 rounded-xl bg-white border border-slate-100 px-3 py-2"><div class="min-w-0"><div class="text-[10px] font-bold text-slate-700">{{ record.date }} · {{ record.note |