count,selectedAnalyticsTkDataDate).conversions.toLocaleString() }}</div></div><div class="rounded-lg bg-white border border-slate-100 p-2"><div class="text-[9px] text-slate-400">CTR</div><div class="text-[11px] font-extrabold mt-0.5">{{ accountDataSummary(account,selectedAnalyticsTkDataDate).ctrText }}</div></div><div class="rounded-lg bg-white border border-slate-100 p-2"><div class="text-[9px] text-slate-400">CPL</div><div class="text-[11px] font-extrabold mt-0.5">{{ accountDataSummary(account,selectedAnalyticsTkDataDate).cplText }}</div></div><div class="rounded-lg bg-white border border-slate-100 p-2"><div class="text-[9px] text-slate-400">ROAS</div><div class="text-[11px] font-extrabold mt-0.5">{{ accountDataSummary(account,selectedAnalyticsTkDataDate).roasText }}</div></div><div class="rounded-lg bg-white border border-slate-100 p-2"><div class="text-[9px] text-slate-400">收入</div><div class="text-[11px] font-extrabold mt-0.5">{{ accountDataSummary(account,selectedAnalyticsTkDataDate).revenueText }}</div></div></div></div>
                      <div class="flex items-center justify-between gap-2 mt-4 pt-4 border-t border-slate-200"><div class="text-[10px] text-slate-400">最近充值：{{ latestRechargeLabel(account) }}</div><button @click="openRechargeModal(selectedAnalyticsClient,'TK',account)" class="h-9 px-3 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white text-[11px] font-bold"><i class="fa-solid fa-plus mr-1"></i>登记广告充值</button></div>
                      <div v-if="account.rechargeHistory && account.rechargeHistory.length" class="mt-3 space-y-2"><div v-for="record in account.rechargeHistory.slice(0,3)" :key="record.id" class="flex items-center justify-between gap-3 rounded-xl bg-white border border-slate-100 px-3 py-2"><div class="min-w-0"><div class="text-[10px] font-bold text-slate-700">{{ record.date }} · {{ record.note || '广告账户充值' }}</div></div><div class="text-xs font-extrabold text-emerald-600 shrink-0">{{ formatMoney(record.amount,record.currency) }}</div></div></div>
                    </div>
                  </div>
                  <div v-else class="text-xs text-slate-400 py-10 text-center border border-dashed border-slate-300 rounded-xl">暂无 TikTok 广告账户，请先在客户资料中添加账号资产。</div>
                </div>
              </div>
            </div>

            <div class="grid grid-cols-1 xl:grid-cols-3 gap-5"><div class="xl:col-span-2 bg-white border border-slate-200 rounded-2xl p-5 soft-shadow"><div class="flex items-center justify-between"><div><h3 class="font-extrabold text-sm">跨平台 ROAS 对比</h3><p class="text-[11px] text-slate-400 mt-1">按当前选择的 Facebook / TikTok 广告账户对比，最高 ROAS 归一化为 100%</p></div></div><div class="mt-6 space-y-5"><div v-for="bar in roasBars" :key="bar.name"><div class="flex justify-between text-xs mb-2"><span class="font-bold">{{ bar.name }}</span><span class="font-black">{{ bar.value || 0 }}</span></div><div class="h-3 rounded-full bg-slate-100 overflow-hidden"><div class="h-full rounded-full" :class="bar.className" :style="{width:bar.width+'%'}"></div></div></div></div></div><div class="bg-slate-950 text-white rounded-2xl p-5 soft-shadow"><div class="text-[11px] text-violet-300 font-bold">OPTIMIZATION NOTE</div><h3 class="font-extrabold text-sm mt-2">预算与素材建议</h3><p class="text-xs text-slate-300 leading-relaxed mt-4">{{ analyticsAdvice }}</p></div></div>
          </div>
        </section>

        <!-- Ads Management -->
        <section v-else-if="currentPage==='ads'" key="ads" class="space-y-5">
          <div class="flex flex-col xl:flex-row xl:items-end justify-between gap-4">
            <div>
              <h2 class="text-2xl font-extrabold tracking-tight">广告管理</h2>
              <p class="text-xs text-slate-500 mt-1">广告方案保存后进入列表；广告数据只录入一次，同一条数据更新后会自动同步到投放数据分析。</p>
            </div>
            <div class="flex flex-col sm:flex-row gap-2 sm:items-center">
              <div class="text-[11px] font-bold text-slate-500">当前客户</div>
              <select v-model.number="selectedAdsClientId" @change="syncAdsAccountSelection" class="h-10 min-w-[240px] rounded-xl border border-slate-200 bg-white px-3 text-xs font-bold outline-none focus:ring-2 focus:ring-indigo-100">
                <option :value="0">所有客户</option>
                <option v-for="c in activeClients" :key="c.id" :value="c.id">{{ c.name }}</option>
              </select>
            </div>
          </div>

          <div v-if="selectedAdsClientId===0" class="space-y-5">
            <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-5 gap-4">
              <div class="bg-white border border-indigo-100 rounded-2xl p-5 soft-shadow"><div class="text-[10px] text-indigo-600 font-bold">在管客户</div><div class="text-2xl font-black text-indigo-700 mt-2">{{ activeClients.length }}</div><div class="text-[10px] text-slate-400 mt-1">所有未归档客户</div></div>
              <div class="bg-white border border-blue-100 rounded-2xl p-5 soft-shadow"><div class="text-[10px] text-blue-600 font-bold">广告账户</div><div class="text-2xl font-black text-blue-700 mt-2">{{ adsAllAccountCount }}</div><div class="text-[10px] text-slate-400 mt-1">FB + TikTok</div></div>
              <div class="bg-white border border-fuchsia-100 rounded-2xl p-5 soft-shadow"><div class="text-[10px] text-fuchsia-600 font-bold">已保存方案</div><div class="text-2xl font-black text-fuchsia-700 mt-2">{{ adsAllSavedPlanCount }}</div><div class="text-[10px] text-slate-400 mt-1">全部客户广告方案</div></div>
              <div class="bg-white border border-cyan-100 rounded-2xl p-5 soft-shadow"><div class="text-[10px] text-cyan-600 font-bold">广告数据</div><div class="text-2xl font-black text-cyan-700 mt-2">{{ adsAllDataRecordCount }}</div><div class="text-[10px] text-slate-400 mt-1">统一广告数据记录</div></div>
              <div class="bg-slate-950 text-white rounded-2xl p-5 soft-shadow"><div class="text-[10px] text-amber-300 font-bold">所有客户累计广告消耗</div><div class="text-2xl font-black mt-2">{{ analyticsAllSpendText }}</div><div class="text-[10px] text-slate-400 mt-1">不同币种分别汇总</div></div>
            </div>

            <div class="bg-white border border-slate-200 rounded-2xl soft-shadow overflow-hidden">
              <div class="p-5 border-b border-slate-100"><h3 class="font-extrabold text-sm">所有客户广告管理</h3><p class="text-[11px] text-slate-400 mt-1">总览每个客户的广告账户、方案、数据和消耗。点击「管理广告」进入该客户后再选择平台和广告账户。</p></div>
              <div class="overflow-x-auto scrollbar"><table class="w-full min-w-[1080px] text-xs"><thead class="bg-slate-50 text-slate-500"><tr><th class="p-3.5 text-left">客户</th><th class="p-3.5 text-left">Facebook</th><th class="p-3.5 text-left">TikTok</th><th class="p-3.5 text-left">已保存方案</th><th class="p-3.5 text-left">数据记录</th><th class="p-3.5 text-left">广告消耗</th><th class="p-3.5 text-left">累计充值</th><th class="p-3.5 text-left">操作</th></tr></thead><tbody class="divide-y divide-slate-100"><tr v-for="row in adsAllClientRows" :key="row.client.id" class="hover:bg-slate-50/70"><td class="p-3.5"><div class="font-extrabold text-slate-900">{{ row.client.name }}</div><div class="text-[10px] text-slate-400 mt-1">{{ row.client.project || row.client.product || '客户项目' }}</div></td><td class="p-3.5"><span class="inline-flex px-2 py-1 rounded-lg bg-blue-50 text-blue-700 font-bold text-[10px]">{{ row.fbAccounts }} 个账户</span></td><td class="p-3.5"><span class="inline-flex px-2 py-1 rounded-lg bg-slate-100 text-slate-700 font-bold text-[10px]">{{ row.tkAccounts }} 个账户</span></td><td class="p-3.5 font-extrabold text-fuchsia-600">{{ row.savedPlans }}</td><td class="p-3.5 font-extrabold text-cyan-700">{{ row.records }} 条</td><td class="p-3.5 font-black text-amber-600">{{ row.spendText }}</td><td class="p-3.5 font-black text-emerald-600">{{ row.rechargeText }}</td><td class="p-3.5 text-left"><button @click="selectAdsClient(row.client.id)" class="h-8 px-3 rounded-lg bg-fuchsia-50 text-fuchsia-700 font-bold text-[11px]"><i class="fa-solid fa-rectangle-ad mr-1"></i>管理广告</button></td></tr></tbody></table></div>
              <div v-if="!adsAllClientRows.length" class="py-12 text-center text-xs text-slate-400">暂无在管客户</div>
            </div>
          </div>

          <div v-else-if="selectedAdsClient" class="space-y-5">
            <div class="bg-white border border-slate-200 rounded-2xl p-4 soft-shadow">
              <div class="grid grid-cols-1 lg:grid-cols-[1fr_1fr_auto] gap-3 items-end">
                <form-field label="平台">
                  <select v-model="selectedAdsPlatform" @change="syncAdsAccountSelection" class="field">
                    <option v-if="selectedAdsClient.fbAccounts && selectedAdsClient.fbAccounts.length" value="FB">Facebook</option>
                    <option v-if="selectedAdsClient.tkAccounts && selectedAdsClient.tkAccounts.length" value="TK">TikTok</option>
                  </select>
                </form-field>
                <form-field label="广告账户">
                  <select v-model="selectedAdsAccountId" class="field">
                    <option v-for="(account,idx) in selectedAdsAccounts" :key="account.id" :value="account.id">{{ account.accountName || `${selectedAdsPlatform==='FB'?'Facebook':'TikTok'} 账号 ${idx+1}` }} · {{ account.adAccountId || '未录入 ID' }}</option>
                  </select>
                </form-field>
                <button v-if="selectedAdsAccount" @click="openRechargeModal(selectedAdsClient,selectedAdsPlatform,selectedAdsAccount)" class="h-10 px-4 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold whitespace-nowrap"><i class="fa-solid fa-coins mr-1.5"></i>登记广告充值</button>
              </div>
            </div>

            <div v-if="selectedAdsAccount" class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4">
              <div class="bg-white border border-slate-200 rounded-2xl p-5 soft-shadow"><div class="text-[10px] text-slate-400 font-bold">广告账户</div><div class="text-sm font-extrabold mt-2 truncate">{{ selectedAdsAccount.accountName || selectedAdsAccount.adAccountId || '未命名账户' }}</div><div class="text-[10px] text-slate-400 font-mono mt-1 truncate">{{ selectedAdsAccount.adAccountId || '未录入广告账户 ID' }}</div></div>
              <div class="bg-slate-950 text-white rounded-2xl p-5 soft-shadow"><div class="text-[10px] text-amber-300 font-bold">广告账户消耗</div><div class="text-2xl font-black mt-2">{{ accountSpendText(selectedAdsAccount) }}</div><div class="text-[10px] text-slate-400 mt-1">{{ accountAdDataRecords.length ? `由 ${accountAdDataRecords.length} 条统一广告数据自动汇总` : '暂无数据，请从任一页面录入一次即可同步' }}</div></div>
              <div class="bg-white border border-emerald-100 rounded-2xl p-5 soft-shadow"><div class="text-[10px] text-emerald-600 font-bold">累计广告充值</div><div class="text-2xl font-black text-emerald-700 mt-2">{{ accountRechargeText(selectedAdsAccount) }}</div><div class="text-[10px] text-slate-400 mt-1">{{ (selectedAdsAccount.rechargeHistory || []).length }} 条充值记录</div></div>
              <div class="bg-white border border-amber-100 rounded-2xl p-5 soft-shadow"><div class="text-[10px] text-amber-600 font-bold">最近充值日期</div><div class="text-xl font-black text-amber-700 mt-2">{{ latestRechargeDate(selectedAdsAccount) }}</div><div class="text-[10px] text-slate-400 mt-1">登记充值时自动写入日期</div></div>
            </div>

            <div v-if="selectedAdsAccount && selectedAdsAccount.rechargeHistory && selectedAdsAccount.rechargeHistory.length" class="bg-white border border-slate-200 rounded-2xl soft-shadow overflow-hidden">
              <div class="p-4 border-b border-slate-100"><div class="font-extrabold text-sm">广告费充值记录</div><div class="text-[10px] text-slate-400 mt-1">充值日期会在每次登记时自动记录，可在充值窗口修改当天日期。</div></div>
              <div class="overflow-x-auto"><table class="w-full text-xs"><thead class="bg-slate-50 text-slate-400"><tr><th class="text-left px-4 py-3">日期</th><th class="text-left px-4 py-3">金额</th><th class="text-left px-4 py-3">备注</th></tr></thead><tbody class="divide-y divide-slate-100"><tr v-for="record in selectedAdsAccount.rechargeHistory.slice(0,8)" :key="record.id"><td class="px-4 py-3 font-mono font-bold">{{ record.date }}</td><td class="px-4 py-3 font-extrabold text-emerald-600">{{ formatMoney(record.amount,record.currency) }}</td><td class="px-4 py-3 text-slate-500">{{ record.note || '广告账户充值' }}</td></tr></tbody></table></div>
            </div>

            <!-- Saved Ads Plan List -->
            <div v-if="selectedAdsAccount" class="bg-white border border-slate-200 rounded-2xl soft-shadow overflow-hidden">
              <div class="p-5 border-b border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                <div><h3 class="font-extrabold text-sm">已保存广告方案</h3><p class="text-[11px] text-slate-400 mt-1">方案保存后会变成列表记录；点击「详情」查看完整广告设置方案。</p></div>
                <button @click="addAdCampaign" class="h-9 px-3.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-bold"><i class="fa-solid fa-plus mr-1.5"></i>新建广告方案</button>
              </div>
              <div v-if="savedAdsCampaignsForAccount.length" class="overflow-x-auto scrollbar">
                <table class="w-full min-w-[1080px] text-xs">
                  <thead class="bg-slate-50 text-slate-500"><tr><th class="p-3.5 text-left">方案名称</th><th class="p-3.5 text-left">广告系列</th><th class="p-3.5 text-left">目标</th><th class="p-3.5 text-left">广告组 / 广告</th><th class="p-3.5 text-left">方案预算</th><th class="p-3.5 text-left">数据消耗</th><th class="p-3.5 text-left">数据记录</th><th class="p-3.5 text-left">更新时间</th><th class="p-3.5 text-left">操作</th></tr></thead>
                  <tbody class="divide-y divide-slate-100">
                    <tr v-for="campaign in savedAdsCampaignsForAccount" :key="campaign.id" class="hover:bg-slate-50/70">
                      <td class="p-3.5"><div class="font-extrabold text-slate-900">{{ campaign.planName || '未命名方案' }}</div><div class="text-[10px] text-slate-400 mt-1">{{ selectedAdsPlatform==='FB'?'Facebook':'TikTok' }} · {{ selectedAdsAccount.accountName }}</div></td>
                      <td class="p-3.5 font-bold">{{ campaign.name || '未命名广告系列' }}</td>
                      <td class="p-3.5"><span class="inline-flex px-2 py-1 rounded-lg bg-indigo-50 text-indigo-700 text-[10px] font-extrabold">{{ objectiveLabel(campaign.objective) }}</span></td>
                      <td class="p-3.5"><div class="font-bold">{{ (campaign.adSets||[]).length }} 个广告组</div><div class="text-[10px] text-slate-400 mt-1">{{ campaignAdCount(campaign) }} 个广告</div></td>
                      <td class="p-3.5 font-extrabold text-violet-600">{{ campaignBudgetText(campaign) }}</td>
                      <td class="p-3.5 font-extrabold text-amber-600">{{ campaignDataSpendText(campaign) }}</td>
                      <td class="p-3.5"><span class="inline-flex px-2 py-1 rounded-full bg-cyan-50 text-cyan-700 font-extrabold text-[10px]">{{ campaignDataRecordCount(campaign) }} 条</span></td>
                      <td class="p-3.5 font-mono text-[11px] text-slate-500">{{ campaign.updated