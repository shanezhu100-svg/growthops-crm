ss="flex flex-wrap gap-2"><button @click="generateReceivablesForPeriod" class="h-9 px-3 rounded-xl bg-emerald-50 text-emerald-700 text-xs font-bold hover:bg-emerald-100"><i class="fa-solid fa-rotate mr-1.5"></i>补生成账单</button><button @click="openReceivableModal()" class="h-9 px-3 rounded-xl bg-slate-950 text-white text-xs font-bold"><i class="fa-solid fa-plus mr-1.5"></i>新增收入项目</button></div>
            </div>

            <div class="p-4 border-b border-slate-100 bg-slate-50/50">
              <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-5 gap-3 items-end">
                <div><label class="text-[10px] font-bold text-slate-500 block mb-1.5">收入归属</label><select v-model="receivableOwnerFilter" @change="receivablePage=1" class="field"><option value="ALL">全部归属</option><option value="CLIENT">关联客户</option><option value="COMPANY">不关联客户 / 公司收入</option></select></div>
                <div><label class="text-[10px] font-bold text-slate-500 block mb-1.5">收入项目</label><select v-model="receivableIncomeTypeFilter" @change="receivablePage=1" class="field"><option value="ALL">全部收入项目</option><option value="SERVICE_FEE">投放服务费</option><option value="SHOOTING_SERVICE">拍摄服务费</option><option value="NETWORK_RECHARGE">网络 / IP / 节点代充</option><option value="ACCOUNT_SALE">账号销售</option><option value="OPENING_SERVICE">开户服务费</option><option value="OTHER">其他收入</option></select></div>
                <div><label class="text-[10px] font-bold text-slate-500 block mb-1.5">台账范围</label><select v-model="receivableLedgerMode" @change="receivablePage=1" class="field"><option value="ALL">全部收入项目</option><option value="OUTSTANDING">仅待收 / 应收</option></select></div>
                <div><label class="text-[10px] font-bold text-slate-500 block mb-1.5">回款状态</label><select v-model="receivableStatusFilter" @change="receivablePage=1" class="field"><option value="ALL">全部状态</option><option value="PENDING">待收款</option><option value="PARTIAL">部分收款</option><option value="PAID">已收款</option><option value="OVERDUE">已逾期</option></select></div>
                <div><label class="text-[10px] font-bold text-slate-500 block mb-1.5">每页展示</label><select v-model.number="receivablePageSize" @change="receivablePage=1" class="field"><option :value="10">10 条</option><option :value="20">20 条</option><option :value="30">30 条</option><option :value="50">50 条</option></select></div>
              </div>
              <div class="mt-3 rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-[10px] text-slate-500"><i class="fa-solid fa-filter mr-1.5 text-emerald-500"></i>“全部收入项目”用于查看完整收入台账；“仅待收 / 应收”只显示仍有未收金额的项目。收入归属与回款状态相互独立。</div>
            </div>
            <div v-if="financeVisibleReceivables.length" class="overflow-auto scrollbar max-h-[620px]">
              <table class="w-full min-w-[1640px] text-xs"><thead class="bg-slate-50 text-slate-400 sticky top-0 z-10 shadow-[0_1px_0_0_rgba(226,232,240,1)]"><tr><th class="p-4 text-left">结算月份</th><th class="p-4 text-left">归属 / 客户或来源</th><th class="p-4 text-left">收入项目</th><th class="p-4 text-left">收入金额</th><th class="p-4 text-left">项目成本</th><th class="p-4 text-left">项目差价</th><th class="p-4 text-left">已收</th><th class="p-4 text-left">未收</th><th class="p-4 text-left">到期日</th><th class="p-4 text-left">收款状态</th><th class="p-4 text-left">发票</th><th class="p-4 text-right">操作</th></tr></thead><tbody class="divide-y divide-slate-100"><tr v-for="r in financeReceivablePagedRows" :key="r.id" class="hover:bg-slate-50/60"><td class="p-4 font-mono font-bold">{{ r.settlementMonth }}</td><td class="p-4"><div class="flex items-center gap-2"><span class="px-2 py-1 rounded-full text-[9px] font-extrabold" :class="r.ownerType==='COMPANY'?'bg-violet-50 text-violet-700':'bg-emerald-50 text-emerald-700'">{{ r.ownerType==='COMPANY'?'公司收入':'关联客户' }}</span></div><div class="font-bold mt-1.5">{{ financeReceivableClientName(r) }}</div><div class="text-[10px] text-slate-400 mt-1">{{ r.note || '—' }}</div></td><td class="p-4"><div class="font-extrabold text-slate-800">{{ financeIncomeTypeText(r.incomeType) }}</div><div class="text-[10px] text-slate-400 mt-1">{{ r.projectName || financeIncomeTypeText(r.incomeType) }}</div><div v-if="r.billSource==='AUTO_SERVICE_FEE'" class="text-[9px] text-emerald-600 font-bold mt-1"><i class="fa-solid fa-wand-magic-sparkles mr-1"></i>系统自动出账</div></td><td class="p-4 font-black text-emerald-600">{{ formatMoney(r.amount,r.currency) }}</td><td class="p-4"><div class="font-black text-amber-600">{{ formatMoney(r.directCost||0,r.currency) }}</div><div v-if="Number(r.directCost||0)>0" class="text-[9px] text-slate-400 mt-1">{{ r.ownerType==='COMPANY'?'自动同步公司项目成本':'自动同步客户专属成本' }}</div><span v-else class="text-[9px] text-slate-400">—</span></td><td class="p-4"><div class="font-black" :class="financeReceivableMargin(r)>=0?'text-emerald-700':'text-rose-600'">{{ formatMoney(financeReceivableMargin(r),r.currency) }}</div><div v-if="Number(r.amount||0)>0 && Number(r.directCost||0)>0" class="text-[9px] text-slate-400 mt-1">毛利率 {{ financeReceivableMarginRate(r) }}</div><div v-else class="text-[9px] text-slate-400 mt-1">收入 − 项目直接成本</div></td><td class="p-4"><div class="font-black text-blue-600">{{ formatMoney(financeReceivablePaid(r),r.currency) }}</div><div class="text-[9px] text-slate-400 mt-1">{{ (r.payments||[]).length }} 笔回款</div></td><td class="p-4 font-black text-rose-600">{{ formatMoney(financeReceivableUnpaid(r),r.currency) }}</td><td class="p-4 font-mono">{{ r.dueDate || '—' }}</td><td class="p-4"><span class="px-2 py-1 rounded-full text-[9px] font-extrabold" :class="financeReceivableStatusStyle(r)">{{ financeReceivableStatusText(r) }}</span></td><td class="p-4"><div class="font-semibold">{{ financeInvoiceStatusText(r.invoiceStatus) }}</div><div class="text-[10px] text-slate-400 mt-1">{{ r.invoiceNo || '—' }}</div></td><td class="p-4 text-right"><div class="flex justify-end gap-1"><button v-if="financeReceivableUnpaid(r)>0" @click="openPaymentModal(r)" class="h-8 px-3 rounded-lg bg-emerald-50 text-emerald-700 font-bold"><i class="fa-solid fa-plus mr-1"></i>回款</button><span v-else class="h-8 px-3 rounded-lg bg-slate-100 text-slate-500 text-[10px] font-bold inline-flex items-center"><i class="fa-solid fa-check mr-1"></i>已结清</span><button @click="openReceivableModal(r)" class="h-8 px-3 rounded-lg bg-blue-50 text-blue-700 font-bold">收入</button><button @click="deleteReceivable(r)" class="w-8 h-8 rounded-lg hover:bg-rose-50 text-rose-500"><i class="fa-regular fa-trash-can"></i></button></div></td></tr></tbody></table>
            </div>
            <div v-else class="py-12 text-center text-xs text-slate-400">当前筛选条件下没有收入 / 应收记录。可清除筛选、补生成投放服务费账单，或新增网络代充、账号销售等收入项目。</div>

            <div v-if="financeVisibleReceivables.length" class="px-4 py-3 border-t border-slate-100 bg-white flex flex-col sm:flex-row sm:items-center justify-between gap-2">
              <div class="text-[10px] text-slate-400">显示第 <b class="text-slate-700">{{ receivablePageStart + 1 }}</b> - <b class="text-slate-700">{{ receivablePageEnd }}</b> 条，共 <b class="text-slate-700">{{ financeVisibleReceivables.length }}</b> 条</div>
              <div class="flex items-center gap-1.5"><button @click="receivablePage=Math.max(1,receivablePage-1)" :disabled="receivablePage<=1" class="h-8 px-3 rounded-lg border border-slate-200 text-[10px] font-bold disabled:opacity-40 disabled:cursor-not-allowed hover:bg-slate-50"><i class="fa-solid fa-chevron-left mr-1"></i>上一页</button><span class="h-8 px-3 rounded-lg bg-slate-950 text-white text-[10px] font-bold flex items-center">{{ receivableCurrentPage }} / {{ financeReceivableTotalPages }}</span><button @click="receivablePage=Math.min(financeReceivableTotalPages,receivablePage+1)" :disabled="receivablePage>=financeReceivableTotalPages" class="h-8 px-3 rounded-lg border border-slate-200 text-[10px] font-bold disabled:opacity-40 disabled:cursor-not-allowed hover:bg-slate-50">下一页<i class="fa-solid fa-chevron-right ml-1"></i></button></div>
            </div>
          </div>

          <!-- ② Reconciliation -->
          <div class="bg-white border border-slate-200 rounded-2xl soft-shadow overflow-hidden">
            <div class="p-4 border-b border-slate-100 flex flex-col xl:flex-row xl:items-center justify-between gap-3"><div><div class="font-extrabold text-sm"><span class="text-blue-600 mr-1">②</span>代理商返点对账单</div><div class="text-[10px] text-slate-400 mt-1">实际返点唯一录入口。只有状态为“已开户”的渠道才参与消耗、预计返点、实际返点归集与月结检查。</div></div><div class="flex flex-wrap gap-2"><select v-model="financeProviderFilter" class="h-9 rounded-xl border border-slate-200 bg-white px-3 text-xs font-semibold"><option value="ALL">全部开户商</option><option v-for="p in openingProviders" :key="p.id" :value="String(p.id)">{{ p.name }}</option></select><select v-model="financeReconciliationStatusFilter" class="h-9 rounded-xl border border-slate-200 bg-white px-3 text-xs font-semibold"><option value="ALL">全部状态</option><option value="PENDING">待对账</option><option value="CONFIRMED">已对账</option><option value="VOID">已撤销</option></select><button @click="openReconciliationModal()" :disabled="financePeriod==='MONTH'&&isMonthLocked(financeMonthKey)" class="h-9 px-3 rounded-xl bg-blue-600 text-white text-xs font-bold disabled:opacity-40 disabled:cursor-not-allowed"><i class="fa-solid fa-scale-balanced mr-1.5"></i>新增对账确认</button></div></div>
            <div v-if="financeReconciliationRows.length" class="overflow-x-auto scrollbar"><table class="w-full min-w-[1280px] text-xs"><thead class="bg-slate-50 text-slate-400"><tr><th class="p-4 text-left">月份</th><th class="p-4 text-left">开户商 / 对接人</th><th class="p-4 text-left">系统广告消耗</th><th class="p-4 text-left">代理商确认消耗</th><th class="p-4 text-left">消耗差额</th><th class="p-4 text-left">预计返点</th><th class="p-4 text-left">实际返点</th><th class="p-4 text-left">状态</th><th class="p-4 text-right">操作</th></tr></thead><tbody class="divide-y divide-slate-100"><tr v-for="row in financeReconciliationRows" :key="row.key"><td class="p-4 font-mono font-bold">{{ row.month }}</td><td class="p-4"><div class="font-bold text-blue-700">{{ row.providerName }}</div><div class="text-[10px] text-slate-400 mt-1">{{ row.contactName }}</div></td><td class="p-4 font-black text-amber-600">{{ formatMoney(row.systemSpend,row.currency) }}</td><td class="p-4 font-black text-blue-700">{{ row.record && row.record.status!=='VOID' ? formatMoney(row.record.confirmedSpend||0,row.currency) : '待确认' }}</td><td class="p-4" :class="Math.abs(row.spendDiff)>0.01?'font-black text-rose-600':'text-slate-400'">{{ row.record && row.record.status!=='VOID' ? formatMoney(row.spendDiff,row.currency) : '—' }}</td><td class="p-4 font-black text-violet-600">{{ formatMoney(row.expectedRebate,row.currency) }}</td><td class="p-4 font-black text-emerald-600">{{ row.record && row.record.status!=='VOID' ? formatMoney(row.record.actualRebate||0,row.currency) : '待确认' }}</td><td class="p-4"><span class="px-2 py-1 rounded-full text-[9px] font-extrabold" :class="row.record?.status==='VOID'?'bg-slate-100 text-slate-500':row.record?'bg-emerald-50 text-emerald-700':'bg-amber-50 text-amber-700'">{{ row.record?.status==='VOID'?'已撤销':(row.record?'已对账':'待代理商对账') }}</span><div v-if="isMonthLocked(row.month)" class="text-[9px] text-rose-500 font-bold mt-1"><i class="fa-solid fa-lock mr-1"></i>已月结</div></td><td class="p-4 text-right"><div class="flex justify-end gap-1"><button @click="openReconciliationModal(row)" :disabled="isMonthLocked(row.month)" class="h-8 px-3 rounded-lg bg-blue-50 text-blue-700 font-bold disabled:opacity-40">{{ row.record&&row.record.status!=='VOID'?'修改':'确认' }}</button><button v-if="row.record&&row.record.status!=='VOID'" @click="voidReconciliation(row)" :disabled="isMonthLocked(row.month)" class="h-8 px-2.5 rounded-lg bg-rose-50 text-rose-600 font-bold disabled:opacity-40">撤销</button></div></td></tr></tbody></table></div>
            <div v-else class="py-12 text-center text-xs text-slate-400">当前周期暂无需要对账的渠道消耗。</div>
          </div>

          <!-- ③ Costs -->
          <div class="bg-white border border-slate-200 rounded-2xl soft-shadow overflow-hidden">
            <div class="p-4 border-b border-slate-100 flex flex-col lg:flex-row lg:items-center justify-between gap-3"><div><div class="font-extrabold text-sm"><span class="text-amber-500 mr-1">③</span>成本 / 支出</div><div class="text-[10px] text-slate-400 mt-1">IP 月费、开户费和收入项目直接成本优先由业务来源自动生成；这里只手工补录工具、人员、素材、服务器、外包及其他实际支出。</div></div><button @click="openCostModal()" class="h-9 px-3 rounded-xl bg-amber-500 text-white text-xs font-bold"><i class="fa-solid fa-plus mr-1.5"></i>录入成本</button></div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 p-4 bg-slate-50/60 border-b border-slate-100" :class="financeClientFilter==='ALL'?'xl:grid-cols-3':'xl:grid-cols-1'"><div v-if="financeClientFilter==='ALL'" class="bg-white rounded-xl border border-slate-200 p-3"><div class="text-[10px] text-slate-400">客户专属成本</div><div v-for="item in financeMoneyRows(financeDirectClientCostGroups)" :key="'cost-mini-direct-'+item.currency" class="font-black text-amber-600 mt-1">{{ item.currency }} · {{ item.text }}</div></div><div v-if="financeClientFilter==='ALL'" class="bg-white rounded-xl border border-slate-200 p-3"><div class="text-[10px] text-slate-400">公司项目 / 公共成本</div><div v-for="item in financeMoneyRows(financePublicCostDisplayGroups)" :key="'cost-mini-public-'+item.currency" class="font-black text-amber-600 mt-1">{{ item.currency }} · {{ item.text }}</div></div><div class="bg-white rounded-xl border border-slate-200 p-3"><div class="text-[10px] text-slate-400">{{ financeClientFilter==='ALL'?'本期总成本':'客户归属成本' }}</div><div v-for="item in financeMoneyRows(financeCostGroups)" :key="'cost-mini-total-'+item.currency" class="font-black text-amber-600 mt-1">{{ item.currency }} · {{ item.text }}</div><div v-if="financeClientFilter==='ALL'" class="text-[9px] text-slate-400 mt-1">客户专属 + 公司项目 + 公司公共</div><div v-else class="text-[9px] text-slate-400 mt-1 space-y-0.5"><div>专属 {{ spendGroupsText(financeDirectClientCostGroups) }}</div><div>公共分摊 {{ spendGroupsText(financePublicCostDisplayGroups) }}</div></div></div></div>
            <div v-if="financeVisibleCosts.length" class="overflow-x-auto"><table class="w-full min-w-[1080px] text-xs"><thead class="bg-slate-50 text-slate-400"><tr><th class="p-4 text-left">日期</th><th class="p-4 text-left">成本类型</th><th class="p-4 text-left">归属 / 分摊</th><th class="p-4 text-left">供应商 / 收款方</th><th class="p-4 text-left">原始金额</th><th class="p-4 text-left">{{ financeClientFilter==='ALL'?'本期计入':'本客户归属' }}</th><th class="p-4 text-left">备注</th><th class="p-4 text-right">操作</th></tr></thead><tbody class="divide-y divide-slate-100"><tr v-for="cost in financeVisibleCosts" :key="cost.id"><td clas