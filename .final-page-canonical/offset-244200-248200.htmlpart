s="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center"><i :class="toolCategoryIcon(tool.category)"></i></div><div><div class="font-extrabold text-sm">{{ tool.name }}</div><div class="text-[10px] text-slate-400 mt-1">{{ toolCategoryText(tool.category) }}</div></div></div><span class="px-2 py-1 rounded-full text-[10px] font-extrabold" :class="tool.status==='ACTIVE'?'bg-emerald-50 text-emerald-700':'bg-slate-100 text-slate-500'">{{ tool.status==='ACTIVE'?'使用中':'停用' }}</span></div>
              <div class="mt-4 rounded-xl bg-slate-50 border border-slate-100 p-3 space-y-2 text-[11px]">
                <div class="flex justify-between gap-3"><span class="text-slate-400">登录账号</span><span class="font-mono font-semibold text-right break-all">{{ tool.loginAccount || '—' }}</span></div>
                <div class="flex justify-between gap-3 items-center"><span class="text-slate-400">登录密码</span><div class="flex items-center gap-1.5 min-w-0"><span class="font-mono font-semibold text-right break-all">{{ tool.loginPassword ? (toolPasswordVisible[tool.id] ? tool.loginPassword : '••••••••') : '—' }}</span><button v-if="tool.loginPassword" @click="toggleToolPassword(tool.id)" type="button" class="w-6 h-6 rounded-md hover:bg-white text-slate-400 hover:text-emerald-600"><i :class="toolPasswordVisible[tool.id]?'fa-regular fa-eye-slash':'fa-regular fa-eye'"></i></button></div></div>
                <div class="flex justify-between gap-3"><span class="text-slate-400">席位</span><span class="font-semibold">{{ tool.seats || 1 }}</span></div><div class="flex justify-between gap-3"><span class="text-slate-400">负责人</span><span class="font-semibold">{{ tool.owner || '—' }}</span></div>
              </div>
              <div class="mt-4"><div class="text-[10px] text-slate-400">主要用途</div><div class="text-xs font-semibold mt-1 leading-relaxed min-h-[32px]">{{ tool.purpose || '—' }}</div></div>
              <div class="mt-4"><div class="text-[10px] text-slate-400">绑定客户 / 账号</div><div class="space-y-1.5 mt-2"><div v-for="(binding,idx) in toolBindingDisplay(tool)" :key="`${tool.id}-${idx}`" class="px-2.5 py-2 rounded-xl border border-blue-100 bg-blue-50/60"><div class="text-[10px] font-extrabold text-blue-800">{{ binding.clientName }}</div><div class="text-[10px] text-slate-500 mt-0.5"><i :class="binding.platform==='TK'?'fa-brands fa-tiktok':binding.platform==='FB'?'fa-brands fa-facebook':'fa-solid fa-layer-group'" class="mr-1"></i>{{ binding.accountLabel }}</div></div><span v-if="!toolBindingDisplay(tool).length" class="text-[10px] text-slate-400">未绑定客户账号</span></div></div>
              <div class="mt-5 pt-4 border-t border-slate-100 flex items-center justify-between gap-2"><a v-if="safeToolUrl(tool.url)!=='#'" :href="safeToolUrl(tool.url)" target="_blank" rel="noopener noreferrer" class="h-8 px-3 rounded-lg bg-slate-950 text-white text-[10px] font-bold flex items-center"><i class="fa-solid fa-arrow-up-right-from-square mr-1.5"></i>打开工具</a><span v-else class="text-[10px] text-slate-400">未设置网址</span><div class="flex gap-1"><button @click="openToolModal(tool)" class="w-8 h-8 rounded-lg hover:bg-emerald-50 text-emerald-600"><i class="fa-solid fa-pen"></i></button><button type="button" @click="deleteMediaTool(tool)" class="w-8 h-8 rounded-lg hover:bg-rose-50 text-rose-500"><i class="fa-regular fa-trash-can"></i></button></div></div>
            </div>
          </div>
          <div v-else class="bg-white border border-slate-200 rounded-2xl py-16 text-center soft-shadow"><i class="fa-solid fa-toolbox text-3xl text-slate-300"></i><div class="text-sm font-extrabold mt-3">{{ selectedToolClientId==='ALL' ? '暂无符合条件的投放工具' : (selectedToolAccountKey==='ALL'?'当前客户暂未绑定投放工具':'当前账号暂未绑定投放工具') }}</div><p class="text-xs text-slate-400 mt-1">点击右上角“添加