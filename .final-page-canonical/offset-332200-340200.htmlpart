tion><option value="ISSUED">已开票</option></select></form-field>
        <form-field label="发票编号"><input v-model.trim="receivableForm.invoiceNo" class="field" /></form-field>
        <div class="md:col-span-2"><form-field label="收入备注"><input v-model.trim="receivableForm.note" class="field" placeholder="付款条件、收入来源、业务说明等" /></form-field></div>
        <div v-if="receivableForm.id" class="md:col-span-2 rounded-2xl border border-slate-200 overflow-hidden"><div class="px-4 py-3 bg-slate-50 flex items-center justify-between"><div><div class="text-xs font-extrabold">回款流水</div><div class="text-[10px] text-slate-400 mt-1">已收 {{ formatMoney(financeReceivablePaid(receivableForm),receivableForm.currency) }} · 未收 {{ formatMoney(financeReceivableUnpaid(receivableForm),receivableForm.currency) }}</div></div><button v-if="financeReceivableUnpaid(receivableForm)>0" type="button" @click="openPaymentModal(receivableForm)" class="h-8 px-3 rounded-lg bg-emerald-600 text-white text-[10px] font-bold">+ 新增回款</button><span v-else class="text-[10px] font-bold text-emerald-600"><i class="fa-solid fa-check mr-1"></i>已结清</span></div><div v-if="(receivableForm.payments||[]).length" class="divide-y divide-slate-100 max-h-48 overflow-y-auto"><div v-for="pay in receivableForm.payments" :key="pay.id" class="px-4 py-3 flex items-center justify-between gap-3"><div><div class="text-xs font-black text-emerald-700">{{ formatMoney(pay.amount,receivableForm.currency) }}</div><div class="text-[9px] text-slate-400 mt-1">{{ pay.date }} · {{ pay.method || '未设置方式' }} <span v-if="pay.account">· {{ pay.account }}</span></div><div v-if="pay.note" class="text-[9px] text-slate-500 mt-1">{{ pay.note }}</div></div><button type="button" @click="deleteReceivablePayment(receivableForm,pay)" class="w-8 h-8 rounded-lg text-rose-500 hover:bg-rose-50"><i class="fa-regular fa-trash-can"></i></button></div></div><div v-else class="px-4 py-8 text-center text-[10px] text-slate-400">暂无回款流水</div></div>
        <div class="md:col-span-2 flex justify-end gap-2"><button type="button" @click="showReceivableModal=false" class="h-10 px-4 rounded-xl border border-slate-200 text-xs font-bold">取消</button><button class="h-10 px-5 rounded-xl bg-emerald-600 text-white text-xs font-bold"><i class="fa-solid fa-check mr-1.5"></i>保存收入项目</button></div>
      </div>
    </form>
  </div>

  <!-- Payment Ledger Modal -->
  <div v-if="showPaymentModal" class="fixed inset-0 z-[84] modal-backdrop flex items-center justify-center p-4" @click.self="showPaymentModal=false"><form @submit.prevent="saveReceivablePayment" class="bg-white w-full max-w-lg rounded-3xl soft-shadow"><div class="p-5 border-b border-slate-100 flex items-center justify-between"><div><div class="text-[10px] font-bold tracking-[.16em] text-emerald-500">PAYMENT LEDGER</div><h3 class="font-extrabold mt-1">新增回款流水</h3><p class="text-[10px] text-slate-400 mt-1">{{ paymentTargetReceivable ? financeReceivableClientName(paymentTargetReceivable) : '' }} · {{ paymentTargetReceivable?.settlementMonth }}</p></div><button type="button" @click="showPaymentModal=false" class="w-9 h-9 rounded-xl hover:bg-slate-100" title="关闭"><i class="fa-solid fa-xmark"></i></button></div><div class="p-5 space-y-4"><div v-if="paymentTargetReceivable" class="grid grid-cols-3 gap-2"><div class="rounded-xl bg-slate-50 p-3"><div class="text-[9px] text-slate-400">应收</div><div class="font-black text-xs mt-1">{{ formatMoney(paymentTargetReceivable.amount,paymentTargetReceivable.currency) }}</div></div><div class="rounded-xl bg-blue-50 p-3"><div class="text-[9px] text-blue-400">已收</div><div class="font-black text-blue-700 text-xs mt-1">{{ formatMoney(financeReceivablePaid(paymentTargetReceivable),paymentTargetReceivable.currency) }}</div></div><div class="rounded-xl bg-rose-50 p-3"><div class="text-[9px] text-rose-400">未收</div><div class="font-black text-rose-700 text-xs mt-1">{{ formatMoney(financeReceivableUnpaid(paymentTargetReceivable),paymentTargetReceivable.currency) }}</div></div></div><div class="grid grid-cols-1 sm:grid-cols-2 gap-4"><form-field label="到账日期 *"><input v-model="paymentForm.date" type="date" required class="field" /></form-field><form-field label="到账金额 *"><input v-model.number="paymentForm.amount" type="number" min="0.01" step="0.01" required class="field" /></form-field><form-field label="收款方式"><select v-model="paymentForm.method" class="field"><option value="">未设置</option><option>银行转账</option><option>PayPal</option><option>Wise</option><option>Stripe</option><option>支付宝</option><option>微信</option><option>其他</option></select></form-field><form-field label="收款账户"><input v-model.trim="paymentForm.account" class="field" placeholder="银行 / PayPal / Wise 账户" /></form-field></div><form-field label="回款备注"><input v-model.trim="paymentForm.note" class="field" placeholder="分期、尾款、流水号等" /></form-field><div class="flex justify-end gap-2"><button type="button" @click="showPaymentModal=false" class="h-10 px-4 rounded-xl border border-slate-200 text-xs font-bold">取消</button><button class="h-10 px-5 rounded-xl bg-emerald-600 text-white text-xs font-bold"><i class="fa-solid fa-check mr-1.5"></i>保存回款</button></div></div></form></div>

  <!-- Reconciliation Modal -->
  <div v-if="showReconciliationModal" class="fixed inset-0 z-[82] modal-backdrop flex items-center justify-center p-4" @click.self="showReconciliationModal=false"><form @submit.prevent="saveReconciliation" class="bg-white w-full max-w-2xl max-h-[92vh] overflow-y-auto rounded-3xl soft-shadow"><div class="p-5 border-b border-slate-100 flex items-center justify-between"><div><div class="text-[10px] font-bold tracking-[.16em] text-blue-500">AGENCY RECONCILIATION</div><h3 class="font-extrabold mt-1">代理商返点对账确认</h3><p class="text-[10px] text-slate-400 mt-1">系统数据先预估；代理商给出精确消耗与返点后，确认值将进入实际利润。</p></div><button type="button" @click="showReconciliationModal=false" class="w-9 h-9 rounded-xl hover:bg-slate-100" title="关闭"><i class="fa-solid fa-xmark"></i></button></div><div class="p-5 space-y-4"><div class="grid grid-cols-1 md:grid-cols-2 gap-4"><form-field label="开户商 *"><select v-model="reconciliationForm.providerId" @change="syncReconciliationProvider" required class="field"><option value="">请选择开户商</option><option v-for="provider in openingProviders" :key="`recon-provider-${provider.id}`" :value="String(provider.id)">{{ provider.name }}</option></select></form-field><form-field label="对接人 *"><select v-model="reconciliationForm.contactId" @change="syncReconciliationContact" required class="field" :disabled="!reconciliationForm.providerId || !reconciliationProviderContacts.length"><option value="">{{ !reconciliationForm.providerId ? '请先选择开户商' : (reconciliationProviderContacts.length ? '请选择该开户商的对接人' : '该开户商未维护对接人') }}</option><option v-for="contact in reconciliationProviderContacts" :key="`recon-contact-${contact.id}`" :value="String(contact.id)">{{ contact.name }} · 返点 {{ Number(contactCurrentRebateRate(contact)||0).toFixed(2) }}%</option></select><div v-if="reconciliationForm.providerId && !reconciliationProviderContacts.length" class="mt-1.5 text-[10px] text-amber-600">该开户商暂无对接人，请先到「开户商渠道 → 开户商资料」添加对接人与返点政策。</div></form-field><form-field label="结算月份 *"><input v-model="reconciliationForm.settlementMonth" @change="syncReconciliationForm" type="month" required class="field" /></form-field><form-field label="币种"><select v-model="reconciliationForm.currency" @change="syncReconciliationForm" class="field"><option>USD</option><option>CNY</option></select>