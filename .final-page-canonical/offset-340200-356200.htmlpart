</form-field></div><div v-if="reconciliationSelectedOption" class="rounded-2xl border border-violet-100 bg-violet-50/60 p-4"><div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2"><div><div class="text-[10px] font-bold tracking-[.12em] text-violet-500">SETTLEMENT-MONTH POLICY</div><div class="text-sm font-extrabold text-violet-900 mt-1">{{ reconciliationSelectedOption.provider.name }} · {{ reconciliationSelectedOption.contact.name }}</div></div><span class="self-start sm:self-auto px-3 py-1 rounded-full bg-white border border-violet-200 text-violet-700 text-xs font-black">月初返点 {{ Number(reconciliationEffectivePolicy.rebateRate||0).toFixed(2) }}%</span></div><div class="mt-3 rounded-xl bg-white/80 border border-violet-100 px-3 py-2.5"><div class="text-[10px] text-slate-400">{{ reconciliationForm.settlementMonth }} 月初有效政策 · 生效 {{ reconciliationEffectivePolicy.effectiveDate || '历史起始' }}</div><div class="text-xs font-semibold text-slate-700 mt-1 leading-relaxed">{{ reconciliationEffectivePolicy.rebatePolicy || '未设置详细返点政策' }}</div><div class="text-[10px] text-violet-600 mt-1.5">如月中返点政策发生变化，系统会按每条广告数据的实际日期自动分段计算预计返点。</div></div></div><div v-else-if="reconciliationForm.providerId && reconciliationProviderContacts.length" class="rounded-xl bg-blue-50 border border-blue-100 px-3 py-2.5 text-[10px] text-blue-700"><i class="fa-solid fa-circle-info mr-1"></i>请选择该开户商的对接人，系统会自动带出对应返点比例和返点政策。</div><div class="grid grid-cols-1 sm:grid-cols-2 gap-3"><div class="rounded-2xl bg-amber-50 border border-amber-100 p-4"><div class="text-[10px] text-amber-600">系统广告消耗</div><div class="text-xl font-black text-amber-600 mt-1">{{ reconciliationSystemSpendText }}</div></div><div class="rounded-2xl bg-violet-50 border border-violet-100 p-4"><div class="text-[10px] text-violet-600">按政策预计返点</div><div class="text-xl font-black text-violet-700 mt-1">{{ reconciliationExpectedRebateText }}</div></div></div><div class="grid grid-cols-1 md:grid-cols-2 gap-4"><form-field label="代理商确认广告消耗 *"><input v-model.number="reconciliationForm.confirmedSpend" type="number" min="0" step="0.01" required class="field" /></form-field><form-field label="代理商确认实际返点 *"><input v-model.number="reconciliationForm.actualRebate" type="number" min="0" step="0.01" required class="field" /></form-field><form-field label="确认日期"><input v-model="reconciliationForm.confirmedDate" type="date" class="field" /></form-field><form-field label="对账备注"><input v-model.trim="reconciliationForm.note" class="field" placeholder="代理商账单编号 / 异常说明" /></form-field></div><div class="rounded-xl bg-blue-50 border border-blue-100 p-3 text-[10px] text-blue-700">保存后会同步更新“实际返点”，客户 / 季度 / 年度已确认利润会自动重新计算。</div><div class="flex justify-end gap-2"><button type="button" @click="showReconciliationModal=false" class="h-10 px-4 rounded-xl border border-slate-200 text-xs font-bold">取消</button><button class="h-10 px-5 rounded-xl bg-blue-600 text-white text-xs font-bold"><i class="fa-solid fa-check mr-1.5"></i>确认对账</button></div></div></form></div>

  <!-- Cost Modal -->
  <div v-if="showCostModal" class="fixed inset-0 z-[81] modal-backdrop flex items-center justify-center p-4" @click.self="showCostModal=false"><form @submit.prevent="saveFinanceCost" class="bg-white w-full max-w-2xl max-h-[92vh] overflow-y-auto rounded-3xl soft-shadow"><div class="p-5 border-b border-slate-100 flex items-center justify-between"><div><div class="text-[10px] font-bold tracking-[.16em] text-amber-500">OPERATING COST</div><h3 class="font-extrabold mt-1">录入公司 / 项目成本</h3><p class="text-[10px] text-slate-400 mt-1">公共成本可不分摊，也可按投放服务费或广告消耗比例自动分摊；需要精确归属时可直接指定客户。</p></div><button type="button" @click="showCostModal=false" class="w-9 h-9 rounded-xl hover:bg-slate-100" title="关闭"><i class="fa-solid fa-xmark"></i></button></div><div class="p-5 grid grid-cols-1 md:grid-cols-2 gap-4"><form-field label="日期 *"><input v-model="costForm.date" type="date" required class="field" /></form-field><form-field label="成本类型 *"><select v-model="costForm.category" required class="field"><option value="IP">IP / 网络（手工补录）</option><option value="TOOL">投放工具</option><option value="STAFF">人员</option><option value="CREATIVE">素材 / 设计</option><option value="SERVER">服务器 / 建站</option><option value="OUTSOURCE">外包</option><option value="OPENING">开户费用（手工补录）</option><option value="ACCOUNT_PURCHASE">账号采购</option><option value="OTHER">其他</option></select></form-field><form-field label="成本归属 / 分摊规则 *"><select v-model="costForm.scope" @change="costForm.clientId=costForm.scope==='CLIENT'?costForm.clientId:''" required class="field"><option value="COMPANY">公司公共成本 · 不分摊</option><option value="ALLOCATE_SERVICE">公司公共成本 · 按投放服务费比例</option><option value="ALLOCATE_SPEND">公司公共成本 · 按广告消耗比例</option><option value="CLIENT">手动归属具体客户</option></select></form-field><form-field v-if="costForm.scope==='CLIENT'" label="关联客户 *"><select v-model="costForm.clientId" required class="field"><option value="">请选择客户</option><option v-for="c in clients.filter(x=>!x.archived)" :key="c.id" :value="String(c.id)">{{ c.name }}</option></select></form-field><form-field v-else label="分摊说明"><div class="min-h-10 rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 flex items-center text-[10px] leading-relaxed text-slate-500">{{ costForm.scope==='ALLOCATE_SERVICE'?'按当前财务周期各客户投放服务费占比分摊':costForm.scope==='ALLOCATE_SPEND'?'按当前财务周期各客户广告消耗占比分摊':'只计入公司总成本，不分配到单个客户利润' }}</div></form-field><form-field label="供应商 / 收款方"><input v-model.trim="costForm.vendor" class="field" /></form-field><form-field label="金额 *"><div class="money-input-group"><select v-model="costForm.currency" class="field money-currency"><option>USD</option><option>CNY</option></select><input v-model.number="costForm.amount" type="number" min="0" step="0.01" required class="field money-amount" /></div></form-field><div class="md:col-span-2"><form-field label="备注"><input v-model.trim="costForm.note" class="field" /></form-field></div><div class="md:col-span-2 rounded-xl bg-amber-50 border border-amber-100 px-3 py-2.5 text-[10px] text-amber-800 leading-relaxed"><i class="fa-solid fa-circle-info mr-1"></i>IP / 网络月费与开户费用如果已在客户资产或开户渠道维护，会由系统自动生成并显示“来源联动”，不要再次手工录入；“不分摊”只影响单客户盈利明细，财务总成本始终按原始金额计入。</div><div class="md:col-span-2 flex justify-end gap-2"><button type="button" @click="showCostModal=false" class="h-10 px-4 rounded-xl border border-slate-200 text-xs font-bold">取消</button><button class="h-10 px-5 rounded-xl bg-amber-500 text-white text-xs font-bold"><i class="fa-solid fa-check mr-1.5"></i>保存成本</button></div></div></form></div>

  <!-- User Modal -->
  <div v-if="showUserModal" class="fixed inset-0 z-[90] modal-backdrop flex items-center justify-center p-4" @click.self="showUserModal=false"><form @submit.prevent="saveAuthUser" class="bg-white w-full max-w-lg rounded-3xl soft-shadow"><div class="p-5 border-b border-slate-100 flex items-center justify-between"><div><div class="text-[10px] font-bold tracking-[.16em] text-indigo-500">USER ACCESS</div><h3 class="font-extrabold mt-1">{{ userForm.id?'编辑用户':'添加用户' }}</h3></div><button type="button" @click="showUserModal=false" class="w-9 h-9 rounded-xl hover:bg-slate-100" title="关闭"><i class="fa-solid fa-xmark"></i></button></div><div class="p-5 space-y-4"><form-field label="姓名 *"><input v-model.trim="userForm.name" required class="field" /></form-field><form-field label="登录账号 *"><input v-model.trim="userForm.username" required autocomplete="off" class="field" /></form-field><form-field label="登录密码 *"><input v-model="userForm.password" required type="password" autocomplete="new-password" class="field" /></form-field><form-field label="角色"><select v-model="userForm.role" class="field"><option value="ADMIN">管理员</option><option value="FINANCE">财务</option><option value="OPS">投手 / 运营</option><option value="SALES">销售</option></select></form-field><label class="flex items-center gap-2 text-xs font-bold"><input v-model="userForm.enabled" type="checkbox" class="accent-indigo-600">启用该账号</label><div class="rounded-xl bg-amber-50 border border-amber-100 p-3 text-[10px] text-amber-700">当前为单文件演示版，密码保存在浏览器本地。正式上线必须改用服务器认证、哈希密码与数据库。</div><div class="flex justify-end gap-2"><button type="button" @click="showUserModal=false" class="h-10 px-4 rounded-xl border border-slate-200 text-xs font-bold">取消</button><button class="h-10 px-5 rounded-xl bg-indigo-600 text-white text-xs font-bold">保存用户</button></div></div></form></div>

  <!-- Tool Modal -->
  <div v-if="showToolModal" class="fixed inset-0 z-50 modal-backdrop flex items-center justify-center p-4">
    <div class="w-full max-w-4xl max-h-[92vh] overflow-y-auto scrollbar bg-white rounded-3xl soft-shadow">
      <div class="p-5 border-b border-slate-100 flex items-center justify-between"><div><div class="text-[10px] font-bold tracking-[.16em] text-emerald-500">TOOLKIT BINDING</div><h3 class="font-extrabold mt-1">{{ toolForm.id ? '编辑投放工具' : '添加投放工具' }}</h3><p class="text-[10px] text-slate-400 mt-1">先选择客户，再选择客户账号，最后保存工具资料。</p></div><button @click="showToolModal=false" class="w-9 h-9 rounded-xl hover:bg-slate-100" title="关闭"><i class="fa-solid fa-xmark"></i></button></div>
      <form @submit.prevent="saveMediaTool" class="p-5 space-y-5">
        <div class="rounded-2xl border border-emerald-100 bg-emerald-50/30 p-4 sm:p-5">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-4"><div><div class="text-[10px] font-bold tracking-[.12em] text-emerald-600">STEP 1 · 使用范围</div><div class="text-sm font-extrabold mt-1">客户与账号绑定</div><div class="text-[10px] text-slate-400 mt-1">一个工具可以绑定多个客户账号；每次先选客户，再选该客户的具体 Facebook / TikTok 账号。</div></div><span class="px-2.5 py-1 rounded-full bg-white border border-emerald-100 text-[10px] font-extrabold text-emerald-700">已绑定 {{ (toolForm.bindings||[]).length }} 个范围</span></div>
          <div class="grid grid-cols-1 md:grid-cols-[1fr_40px_1fr_auto] gap-3 items-end">
            <div><div class="text-[11px] font-semibold text-slate-500 mb-1.5">选择客户 *</div><select v-model="toolBindingClientId" @change="toolBindingAccountKey='ALL'" class="field tool-select"><option value="">请选择客户</option><option v-for="c in clients" :key="c.id" :value="String(c.id)">{{ c.name }}</option></select></div>
            <div class="hidden md:flex h-10 items-center justify-center text-emerald-300"><i class="fa-solid fa-arrow-right"></i></div>
            <div><div class="text-[11px] font-semibold text-slate-500 mb-1.5">选择客户账号 *</div><select v-model="toolBindingAccountKey" :disabled="!toolBindingClientId" class="field tool-select account-select"><option value="ALL">{{ toolBindingClientId ? '该客户全部账号（客户级工具）' : '请先选择客户' }}</option><option v-for="item in toolBindingAccounts" :key="item.key" :value="item.key">{{ item.label }}</option></select></div>
            <button type="button" @click="addToolBinding" :disabled="!toolBindingClientId" class="h-10 px-4 rounded-xl bg-emerald-600 hover:bg-emerald-500 disabled:bg-slate-200 disabled:text-slate-400 text-white text-xs font-bold transition"><i class="fa-solid fa-link mr-1.5"></i>加入绑定</button>
          </div>
          <div v-if="toolBindingClientId && !toolBindingAccounts.length" class="mt-2 text-[10px] text-amber-600"><i class="fa-solid fa-triangle-exclamation mr-1"></i>该客户暂未录入 FB / TK 账号，可先选择“该客户全部账号”作为客户级绑定。</div>
          <div class="mt-4 pt-4 border-t border-emerald-100">
            <div v-if="toolForm.bindings && toolForm.bindings.length" class="grid grid-cols-1 md:grid-cols-2 gap-2">
              <div v-for="(binding,idx) in toolBindingDisplay(toolForm)" :key="`${binding.clientId}-${binding.accountKey}-${idx}`" class="rounded-xl bg-white border border-slate-200 px-3 py-2.5 flex items-center justify-between gap-3"><div class="min-w-0"><div class="text-[10px] font-extrabold text-slate-800 truncate">{{ binding.clientName }}</div><div class="text-[10px] text-slate-400 mt-1 truncate"><i :class="binding.platform==='TK'?'fa-brands fa-tiktok':binding.platform==='FB'?'fa-brands fa-facebook':'fa-solid fa-layer-group'" class="mr-1"></i>{{ binding.accountLabel }}</div></div><button type="button" @click="removeToolBinding(idx)" class="w-7 h-7 rounded-lg bg-rose-50 text-rose-500 hover:bg-rose-100 shrink-0"><i class="fa-solid fa-xmark"></i></button></div>
            </div>
            <div v-else class="rounded-xl border border-dashed border-emerald-200 bg-white/70 px-4 py-4 text-center text-[10px] text-slate-400">尚未绑定客户账号，请先完成上方“客户 → 账号”选择并点击「加入绑定」。</div>
          </div>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-white p-4 sm:p-5">
          <div class="text-[10px] font-bold tracking-[.12em] text-slate-400">STEP 2 · 工具资料</div><div class="text-sm font-extrabold mt-1 mb-4">登录与使用信息</div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <form-field label="工具名称 *"><input v-model.trim="toolForm.name" required class="field" placeholder="例如：AdsPower / Canva / GA4" /></form-field>
            <form-field label="工具分类"><select v-model="toolForm.category" class="field tool-select"><option value="BROWSER">指纹浏览器</option><option value="CREATIVE">素材 / 创意</option><option value="LANDING">落地页 / 建站</option><option value="ANALYTICS">数据分析</option><option value="CRM">CRM / 线索</option><option value="SPY">广告情报</option><option value="OTHER">其他工具</option></select></form-field>
            <form-field label="工具网址"><input v-model.trim="toolForm.url" type="url" class="field" placeholder="https://..." /></form-field>
            <form-field label="使用状态"><select v-model="toolForm.status" class="field tool-select"><option value="ACTIVE">使用中</option><option value="INACTIVE">停用</option></select></form-field>
            <form-field label="登录账号"><input v-model.trim="toolForm.loginAccount" class="field font-mono" placeholder="邮箱 / 团队账号" /></form-field>
            <form-field label="登录密码"><input v-model="toolForm.loginPassword" type="password" autocomplete="new-password" class="field font-mono" placeholder="保存工具登录密码" /></form-field>
            <form-field label="负责人"><input v-model.trim="toolForm.owner" class="field" placeholder="运营负责人" /></form-field>
            <form-field label="席位 / 数量"><input v-model.number="toolForm.seats" type="number" min="1" class="field" /></form-field>
            <div class="md:col-span-2"><