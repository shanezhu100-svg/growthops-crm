rageUsageBytes:0,assetPager:{detail:{FB:0,TK:0,GOOGLE:0,INSTAGRAM:0},assets:{FB:0,TK:0,GOOGLE:0,INSTAGRAM:0}},
    clients:[],standaloneAlerts:[],dismissedAlerts:[],leads:[],openingDeals:[],openingProviders:[],mediaTools:[],
    form:{},
    newAlertForm:{typeKey:'IP',clientName:'',dueDate:'',cost:'',target:''},
    rechargeForm:{clientId:null,platform:'FB',accountId:null,clientName:'',accountName:'',currency:'USD',amount:'',date:'',note:''},
    adDataForm:{date:'',campaignId:'',adSetId:'',adId:'',currency:'USD',spend:'',impressions:'',reach:'',clicks:'',leads:'',conversions:'',revenue:'',video3sRate:'',video25Rate:'',video50Rate:'',video75Rate:'',video95Rate:'',videoCompleteRate:'',note:''},
    leadForm:{},openingForm:{},providerForm:{},toolForm:{},
    menuItems:[
      {key:'dashboard',label:'运营总览',icon:'fa-solid fa-border-all',activeIconBg:'bg-indigo-50 text-indigo-600'},
      {key:'leads',label:'潜在客户',icon:'fa-solid fa-user-plus',activeIconBg:'bg-violet-50 text-violet-600'},
      {key:'clients',label:'客户管理',icon:'fa-solid fa-users',activeIconBg:'bg-violet-50 text-violet-600'},
      {key:'account-opening',label:'开户商渠道',icon:'fa-solid fa-building-circle-check',activeIconBg:'bg-blue-50 text-blue-600'},
      {key:'assets',label:'账号与资产',icon:'fa-solid fa-shield-halved',activeIconBg:'bg-blue-50 text-blue-600'},
      {key:'ads',label:'广告管理',icon:'fa-solid fa-rectangle-ad',activeIconBg:'bg-fuchsia-50 text-fuchsia-600'},
      {key:'analytics',label:'投放数据分析',icon:'fa-solid fa-chart-column',activeIconBg:'bg-cyan-50 text-cyan-600'},
      {key:'finance',label:'财务核算',icon:'fa-solid fa-file-invoice-dollar',activeIconBg:'bg-rose-50 text-rose-600'},
      {key:'tools',label:'投放工具',icon:'fa-solid fa-toolbox',activeIconBg:'bg-emerald-50 text-emerald-600'},
      {key:'alerts',label:'提醒中心',icon:'fa-regular fa-bell',activeIconBg:'bg-amber-50 text-amber-600'},
      {key:'sop',label:'SOP 管理',icon:'fa-solid fa-list-check',activeIconBg:'bg-emerald-50 text-emerald-600'},
      {key:'system',label:'权限与备份',icon:'fa-solid fa-database',activeIconBg:'bg-indigo-50 text-indigo-600'}
    ]
  }},
  watch:{
    selectedClientId(){this.resetAssetPager('detail')},
    selectedAssetsClientId(){this.resetAssetPager('assets')},
    selectedAnalyticsClientId(){this.selectedAnalyticsFbDataDate='ALL';this.selectedAnalyticsTkDataDate='ALL'},
    selectedAnalyticsFbAccountId(){this.selectedAnalyticsFbDataDate='ALL'},
    selectedAnalyticsTkAccountId(){this.selectedAnalyticsTkDataDate='ALL'},
    selectedToolClientId(){this.selectedToolAccountKey='ALL'},
    financeClientFilter(){this.profitPage=1},
    financePeriod(){this.profitPage=1;this.syncFinancePeriodAutoCosts()},
    financeMonthKey(){this.profitPage=1;this.syncFinancePeriodAutoCosts()},
    financeQuarterYear(){this.profitPage=1;this.syncFinancePeriodAutoCosts()},
    financeQuarter(){this.profitPage=1;this.syncFinancePeriodAutoCosts()},
    financeYear(){this.profitPage=1;this.syncFinancePeriodAutoCosts()},
    form:{deep:true,handler(){if(this.currentPage==='client-form'&&!this.suppressDirtyWatch)this.formDirty=true}}
  },
  computed:{
    visibleMenuItems(){return this.menuItems.filter(item=>this.canViewPage(item.key))},
    currentRoleLabel(){return this.currentUser?this.roleLabel(this.currentUser.role):'未登录'},
    activeClients(){return this.clients.filter(c=>!c.archived)},
    storageUsageText(){const mb=(Number(this.storageUsageBytes||0)/1024/1024).toFixed(2);return `${mb} MB`},
    storageWarning(){return Number(this.storageUsageBytes||0)>3.8*1024*1024},
    lastBackupText(){const s=this.backupSnapshots[0];return s?this.formatBackupTime(s.createdAt):'尚未创建'},
    financeActivePeriodSnapshot(){const months=this.financePeriodMonths();if(!months.length||!months.every(month=>this.isMonthLocked(month)&&this.financeMonthSnapshots?.[month]))return null;return this.financeAggregateSnapshots(months)},
    financeActiveSnapshotScope(){const snap=this.financeActivePeriodSnapshot;if(!snap)return null;if(this.financeClientFilter==='ALL')return snap.company||null;return snap.clients?.[String(this.financeClientFilter)]||null},
    financeVisibleReceivables(){return [...this.financeReceivables].filter(r=>this.financeSettlementMonthMatch(r.settlementMonth)&&(this.financeClientFilter==='ALL'||String(r.clientId)===String(this.financeClientFilter))&&(this.receivableOwnerFilter==='ALL'||String(r.ownerType||'CLIENT')===String(this.receivableOwnerFilter))&&(this.receivableLedgerMode!=='OUTSTANDING'||this.financeReceivableUnpaid(r)>0)&&(this.receivableIncomeTypeFilter==='ALL'||String(r.incomeType||'SERVICE_FEE')===String(this.receivableIncomeTypeFilter))&&(this.receivableStatusFilter==='ALL'||this.financeReceivableStatusKey(r)===this.receivableStatusFilter)).sort((a,b)=>String(b.settlementMonth).localeCompare(String(a.settlementMonth))||String(a.dueDate||'').localeCompare(String(b.dueDate||'')))},
    financeReceivableTotalPages(){return Math.max(1,Math.ceil(this.financeVisibleReceivables.length/Math.max(1,Number(this.receivablePageSize||10))))},
    receivablePageStart(){const page=Math.min(Math.max(1,Number(this.receivablePage||1)),this.financeReceivableTotalPages);return(page-1)*Math.max(1,Number(this.receivablePageSize||10))},
    receivablePageEnd(){return Math.min(this.financeVisibleReceivables.length,this.receivablePageStart+Math.max(1,Number(this.receivablePageSize||10)))},
    receivableCurrentPage(){return Math.min(Math.max(1,Number(this.receivablePage||1)),this.financeReceivableTotalPages)},
    financeReceivablePagedRows(){return this.financeVisibleReceivables.slice(this.receivablePageStart,this.receivablePageEnd)},
    receivableSelectedClientName(){if(this.receivableClientFilter==='ALL')return'全部客户';const c=this.clients.find(x=>String(x.id)===String(this.receivableClientFilter));return c?c.name:'全部客户'},
    receivableClientOptions(){const q=String(this.receivableClientSearch||'').trim().toLowerCase();return [...this.clients].filter(c=>!q||String(c.name||'').toLowerCase().includes(q)||String(c.product||'').toLowerCase().includes(q)).sort((a,b)=>String(a.name||'').localeCompare(String(b.name||''),'zh-CN'))},
    profitSelectedClientName(){if(this.financeClientFilter==='ALL')return'全部客户';const c=this.clients.find(x=>String(x.id)===String(this.financeClientFilter));return c?c.name:'全部客户'},
    profitClientOptions(){const q=String(this.profitClientSearch||'').trim().toLowerCase();return [...this.clients].filter(c=>!q||String(c.name||'').toLowerCase().includes(q)||String(c.product||'').toLowerCase().includes(q)||String(c.project||'').toLowerCase().includes(q)).sort((a,b)=>String(a.name||'').localeCompare(String(b.name||''),'zh-CN'))},
    financeProfitTotalPages(){return Math.max(1,Math.ceil(this.financeRows.length/Math.max(1,Number(this.profitPageSize||10))))},
    profitPageStart(){const page=Math.min(Math.max(1,Number(this.profitPage||1)),this.financeProfitTotalPages);return(page-1)*Math.max(1,Number(this.profitPageSize||10))},
    profitPageEnd(){return Math.min(this.financeRows.length,this.profitPageStart+Math.max(1,Number(this.profitPageSize||10)))},
    profitCurrentPage(){return Math.min(Math.max(1,Number(this.profitPage||1)),this.financeProfitTotalPages)},
    financeProfitPagedRows(){return this.financeRows.slice(this.profitPageStart,this.profitPageEnd)},
    financeSummaryReceivables(){return [...this.financeReceivables].filter(r=>this.financeSettlementMonthMatch(r.settlementMonth)&&(this.financeClientFilter==='ALL'||String(r.clientId)===String(this.financeClientFilter)))},
    financeReceivableTotals(){const out={expected:{},paid:{},unpaid:{}};this.financeSummaryReceivables.forEach(r=>{const cur=r.currency||'USD',amount=Number(r.amount||0),paid=Math.min(amount,this.financeReceivablePaid(r));out.paid[cur]=(out.paid[cur]||0)+paid});const snap=this.financeActiveSnapshotScope;if(snap?.receivableGroups)out.expected={...snap.receivableGroups};else this.financeSummaryReceivables.forEach(r=>{const cur=r.currency||'USD';out.expected[cur]=(out.expected[cur]||0)+Number(r.amount||0)});new Set([...Object.keys(out.expected),...Object.keys(out.paid)]).forEach(cur=>out.unpaid[cur]=Math.max(0,Number(out.expected[cur]||0)-Number(out.paid[cur]||0)));return out},
    financeCashReceivedGroups(){const groups={},months=new Set(this.financePeriodMonths());this.financeReceivables.filter(r=>this.financeClientFilter==='ALL'||String(r.clientId)===String(this.financeClientFilter)).forEach(r=>(r.payments||[]).forEach(pay=>{if(!months.has(String(pay.date||'').slice(0,7)))return;const cur=r.currency||'USD';groups[cur]=(groups[cur]||0)+Number(pay.amount||0)}));return groups},
    financeReceivableExpectedText(){return this.spendGroupsText(this.financeReceivableTotals.expected)},
    financeReceivablePaidText(){return this.spendGroupsText(this.financeReceivableTotals.paid)},
    financeReceivableUnpaidText(){return this.spendGroupsText(this.financeReceivableTotals.unpaid)},
    financeVisibleCosts(){return [...this.financeCosts].filter(c=>{if(!this.financeDateMatch(c.date))return false;if(this.financeClientFilter==='ALL')return true;const scope=c.scope||(c.clientId?'CLIENT':'COMPANY');if(scope==='CLIENT')return String(c.clientId)===String(this.financeClientFilter);if(scope==='ALLOCATE_SERVICE'||scope==='ALLOCATE_SPEND'){const client=this.clients.find(x=>String(x.id)===String(this.financeClientFilter));return Math.abs(this.financeCostAllocatedAmountForClient(c,client))>0.000001}return false}).sort((a,b)=>String(b.date||'').localeCompare(String(a.date||'')))},
    financeCostGroups(){const snap=this.financeActiveSnapshotScope;if(snap?.costGroups)return{...snap.costGroups};const g={};if(this.financeClientFilter==='ALL'){this.financeVisibleCosts.forEach(c=>{const cur=c.currency||'USD';g[cur]=(g[cur]||0)+Number(c.amount||0)})}else{const client=this.clients.find(c=>String(c.id)===String(this.financeClientFilter));if(client)this.mergeSpendGroups(g,this.financeClientCostGroups(client))}return g},
    financeDirectClientCostGroups(){const snap=this.financeActiveSnapshotScope;if(snap?.directClientCostGroups)return{...snap.directClientCostGroups};const g={};this.financeCosts.filter(c=>this.financeDateMatch(c.date)&&(c.scope||(c.clientId?'CLIENT':'COMPANY'))==='CLIENT'&&(this.financeClientFilter==='ALL'||String(c.clientId)===String(this.financeClientFilter))).forEach(c=>{const cur=c.currency||'USD';g[cur]=(g[cur]||0)+Number(c.amount||0)});return g},
    financeCompanyProjectCostGroups(){const snap=this.financeActivePeriodSnapshot;if(snap?.company?.companyProjectCostGroups)return{...snap.company.companyProjectCostGroups};const g={};this.financeCosts.filter(c=>this.financeDateMatch(c.date)&&(c.scope||(c.clientId?'CLIENT':'COMPANY'))==='COMPANY_PROJECT').forEach(c=>{const cur=c.currency||'USD';g[cur]=(g[cur]||0)+Number(c.amount||0)});return g},
    financeCompanyPublicCostGroups(){const snap=this.financeActivePeriodSnapshot;if(snap?.company?.companyPublicCostGroups)return{...snap.company.companyPublicCostGroups};const g={};this.financeCosts.filter(c=>{const scope=c.scope||(c.clientId?'CLIENT':'COMPANY');return this.financeDateMatch(c.date)&&['COMPANY','ALLOCATE_SERVICE','ALLOCATE_SPEND'].includes(scope)}).forEach(c=>{const cur=c.currency||'USD';g[cur]=(g[cur]||0)+Number(c.amount||0)});return g},
    financeCompanyNonClientCostGroups(){const g={};this.mergeSpendGroups(g,this.financeCompanyProjectCostGroups);this.mergeSpendGroups(g,this.financeCompanyPublicCostGroups);return g},
    financeUnallocatedCompanyCostGroups(){const snap=this.financeActivePeriodSnapshot;if(snap?.company?.unallocatedCompanyCostGroups)return{...snap.company.unallocatedCompanyCostGroups};const g={};this.financeCosts.filter(c=>{const scope=c.scope||(c.clientId?'CLIENT':'COMPANY');return this.financeDateMatch(c.date)&&['COMPANY','ALLOCATE_SERVICE','ALLOCATE_SPEND'].includes(scope)}).forEach(c=>{const cur=c.currency||'USD',unallocated=this.financeCostUnallocatedAmount(c);if(Math.abs(unallocated)>0.000001)g[cur]=(g[cur]||0)+unallocated});return g},
    financeDirectClientCostText(){return this.spendGroupsText(this.financeDirectClientCostGroups)},
    financeCompanyPublicCostText(){return this.spendGroupsText(this.financeCompanyPublicCostGroups)},
    financePublicCostDisplayGroups(){return this.financeClientFilter==='ALL'?this.financeCompanyNonClientCostGroups:this.subtractSpendGroups(this.financeCostGroups,this.financeDirectClientCostGroups)},
    financeUnallocatedCompanyCostText(){return this.spendGroupsText(this.financeUnallocatedCompanyCostGroups)},
    financeUnallocatedCompanyCostNonZero(){return Object.values(this.financeUnallocatedCompanyCostGroups).some(v=>Math.abs(Number(v||0))>0.005)},
    financeCostText(){return this.spendGroupsText(this.financeCostGroups)},
    financeTotalAdSpendGroups(){const snap=this.financeActiveSnapshotScope;if(snap?.spendGroups)return{...snap.spendGroups};return this.financeAdSpendGroups(this.financeClientFilter==='ALL'?null:this.financeClientFilter,this.financePeriodMonths(),'ALL')},
    financeAttributedSpendGroups(){const snap=this.financeActiveSnapshotScope;if(snap?.attributedSpendGroups)return{...snap.attributedSpendGroups};return this.financeAdSpendGroups(this.financeClientFilter==='ALL'?null:this.financeClientFilter,this.financePeriodMonths(),'ATTRIBUTED')},
    financeUnassignedSpendGroups(){const snap=this.financeActiveSnapshotScope;if(snap?.unassignedSpendGroups)return{...snap.unassignedSpendGroups};return this.financeAdSpendGroups(this.financeClientFilter==='ALL'?null:this.financeClientFilter,this.financePeriodMonths(),'UNASSIGNED')},
    financeNoRebateSpendGroups(){const snap=this.financeActiveSnapshotScope;if(snap?.noRebateSpendGroups)return{...snap.noRebateSpendGroups};return this.financeAdSpendGroups(this.financeClientFilter==='ALL'?null:this.financeClientFilter,this.financePeriodMonths(),'NO_REBATE')},
    financeAttributedSpendText(){return this.spendGroupsText(this.financeAttributedSpendGroups)},
    financeUnassignedSpendText(){return this.spendGroupsText(this.financeUnassignedSpendGroups)},
    financeNoRebateSpendText(){return this.spendGroupsText(this.financeNoRebateSpendGroups)},
    financeConfirmedActualRebateGroups(){const snap=this.financeActiveSnapshotScope;if(snap?.actualRebateGroups)return{...snap.actualRebateGroups};const groups={};if(this.financeClientFilter!=='ALL'){const client=this.clients.find(c=>String(c.id)===String(this.financeClientFilter));if(client)return this.financeActualRebateGroups(client);return groups}this.financeReconciliations.filter(r=>r.status!=='VOID'&&this.financeSettlementMonthMatch(r.settlementMonth)).forEach(r=>{const cur=r.currency||'USD';groups[cur]=(groups[cur]||0)+Number(r.actualRebate||0)});return groups},
    financeExpectedNetProfitGroups(){const snap=this.financeActiveSnapshotScope;if(snap?.expectedNetProfitGroups)return{...snap.expectedNetProfitGroups};const income={};this.mergeSpendGroups(income,this.financeReceivableTotals.expected);this.mergeSpendGroups(income,this.financeTotals.expected);return this.subtractSpendGroups(income,this.financeCostGroups)},
    financeActualNetProfitGroups(){const snap=this.financeActiveSnapshotScope;if(snap?.actualNetProfitGroups)return{...snap.actualNetProfitGroups};const income={};this.mergeSpendGroups(income,this.financeReceivableTotals.expected);this.mergeSpendGroups(income,this.financeConfirmedActualRebateGroups);return this.subtractSpendGroups(income,this.financeCostGroups)},
    financeExpectedNetProfitText(){return this.spendGroupsText(this.financeExpectedNetProfitGroups)},
    financeActualNetProfitText(){return this.spendGroupsText(this.financeActualNetProfitGroups)},
    financeProfitConfirmation(){if(this.financeActivePeriodSnapshot)return{pendingReconciliations:0,unassignedSpendGroups:{},unassignedSpendTotal:0,allLocked:true,complete:true};retur