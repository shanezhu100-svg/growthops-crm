tive.length,due:active.filter(l=>l.nextFollowUp&&l.nextFollowUp<=today).length,qualified:active.filter(l=>['QUALIFIED','PROPOSAL'].includes(l.stage)).length,won:this.leads.filter(l=>l.convertedClientId||l.stage==='WON').length}},
    filteredOpeningDeals(){const q=this.openingSearch.trim().toLowerCase();return this.openingDeals.filter(d=>{const hay=[this.openingClientName(d),this.openingProviderName(d),this.openingContactName(d),d.region,d.accountType,d.businessId,d.adAccountIds,d.notes].filter(Boolean).join(' ').toLowerCase();return(!q||hay.includes(q))&&(this.openingProviderFilter==='ALL'||String(d.providerId||'')===String(this.openingProviderFilter))&&(this.openingPlatformFilter==='ALL'||d.platform===this.openingPlatformFilter)&&(this.openingStatusFilter==='ALL'||d.status===this.openingStatusFilter)}).sort((a,b)=>String(b.submitDate||'').localeCompare(String(a.submitDate||'')))},
    openingSelectedDeals(){return this.openingProviderFilter==='ALL'?this.openingDeals:this.openingDeals.filter(d=>String(d.providerId||'')===String(this.openingProviderFilter))},
    openingStats(){const deals=this.openingSelectedDeals;const clients=new Set(deals.map(d=>String(d.clientId||d.externalClientName||d.id)));return{total:deals.length,clients:clients.size,processing:deals.filter(d=>['PREPARE','SUBMITTED','REVIEWING'].includes(d.status)).length,opened:deals.filter(d=>d.status==='OPENED').length,rejected:deals.filter(d=>d.status==='REJECTED').length}},
    openingAvailableYears(){const years=new Set();const now=new Date().getFullYear();for(let y=now-5;y<=now+1;y++)years.add(y);this.clients.forEach(c=>[...(c.fbAccounts||[]),...(c.tkAccounts||[])].forEach(a=>(a.adDataRecords||[]).forEach(r=>{const y=Number(String(r.date||'').slice(0,4));if(y)years.add(y)})));return[...years].sort((a,b)=>b-a)},
    openingMonthLabel(){const [y,m]=String(this.openingMonthKey||'').split('-');return y&&m?`${y}年${Number(m)}月`:'未选择月份'},
    openingQuarterLabel(){return`${Number(this.openingQuarterYear)||new Date().getFullYear()}年第${Number(this.openingQuarter)||1}季度`},
    openingYearLabel(){return`${Number(this.openingYear)||new Date().getFullYear()}年`},
    openingSpendPeriodLabel(){if(this.openingSpendPeriod==='MONTH')return this.openingMonthLabel;if(this.openingSpendPeriod==='QUARTER')return this.openingQuarterLabel;return this.openingYearLabel},
    openingSelectedProviderName(){if(this.openingProviderFilter==='ALL')return'全部代理商';return this.openingProviders.find(p=>String(p.id)===String(this.openingProviderFilter))?.name||'全部代理商'},
    openingTotalSpendText(){return this.spendGroupsText(this.openingDealsSpendGroupsUnique(this.openingSelectedDeals))},
    openingTotalRebateText(){return this.spendGroupsText(this.openingProvidersRebateGroups(this.openingSpendPeriod,this.openingProviderFilter))},
    openingProviderSummaryRows(){const providers=this.openingProviderFilter==='ALL'?this.openingProviders:this.openingProviders.filter(p=>String(p.id)===String(this.openingProviderFilter));return providers.map(provider=>{const deals=this.openingDeals.filter(d=>String(d.providerId||'')===String(provider.id));const clients=new Set(deals.map(d=>String(d.clientId||d.externalClientName||d.id)));const current=this.openingDealsFinancialsForPeriod(deals,this.openingSpendPeriod),total=this.openingDealsFinancialsForPeriod(deals,'ALL'),month=this.openingDealsFinancialsForPeriod(deals,'MONTH'),quarter=this.openingDealsFinancialsForPeriod(deals,'QUARTER'),year=this.openingDealsFinancialsForPeriod(deals,'YEAR');const contactRows=(provider.contacts||[]).map(contact=>{const contactDeals=deals.filter(d=>String(d.contactId||'')===String(contact.id)||(!d.contactId&&String(d.contactName||'').trim()===String(contact.name||'').trim()));const fin=this.openingDealsFinancialsForPeriod(contactDeals,this.openingSpendPeriod);return{contact,dealCount:contactDeals.length,spendText:this.spendGroupsText(fin.spendGroups),rebateText:this.spendGroupsText(fin.rebateGroups)}});return{provider,dealCount:deals.length,clientCount:clients.size,contactRows,spendText:this.spendGroupsText(current.spendGroups),rebateText:this.spendGroupsText(current.rebateGroups),totalSpendText:this.spendGroupsText(total.spendGroups),totalRebateText:this.spendGroupsText(total.rebateGroups),monthSpendText:this.spendGroupsText(month.spendGroups),monthRebateText:this.spendGroupsText(month.rebateGroups),quarterSpendText:this.spendGroupsText(quarter.spendGroups),quarterRebateText:this.spendGroupsText(quarter.rebateGroups),yearSpendText:this.spendGroupsText(year.spendGroups),yearRebateText:this.spendGroupsText(year.rebateGroups)}}).sort((a,b)=>b.clientCount-a.clientCount||String(a.provider.name).localeCompare(String(b.provider.name),'zh-CN'))},
    selectedToolClient(){if(this.selectedToolClientId==='ALL')return null;return this.clients.find(c=>String(c.id)===String(this.selectedToolClientId))||null},
    selectedToolClientAccounts(){const c=this.selectedToolClient;if(!c)return[];return[...(c.fbAccounts||[]).map((a,idx)=>({key:`FB:${a.id}`,platform:'FB',account:a,label:`Facebook · ${a.accountName||`账号 ${idx+1}`} · ${a.adAccountId||'未录入广告账号 ID'}`})),...(c.tkAccounts||[]).map((a,idx)=>({key:`TK:${a.id}`,platform:'TK',account:a,label:`TikTok · ${a.accountName||`账号 ${idx+1}`} · ${a.adAccountId||'未录入广告账号 ID'}`}))]},
    selectedToolClientName(){if(this.selectedToolClientId==='ALL')return'全部客户';return this.selectedToolClient?.name||'未找到客户'},
    selectedToolAccountName(){if(this.selectedToolClientId==='ALL')return'全部账号';if(this.selectedToolAccountKey==='ALL')return'全部账号';return this.selectedToolClientAccounts.find(item=>item.key===this.selectedToolAccountKey)?.label||'未找到账号'},
    toolBindingAccounts(){const c=this.clients.find(c=>String(c.id)===String(this.toolBindingClientId));if(!c)return[];return[...(c.fbAccounts||[]).map((a,idx)=>({key:`FB:${a.id}`,platform:'FB',account:a,label:`Facebook · ${a.accountName||`账号 ${idx+1}`} · ${a.adAccountId||'未录入广告账号 ID'}`})),...(c.tkAccounts||[]).map((a,idx)=>({key:`TK:${a.id}`,platform:'TK',account:a,label:`TikTok · ${a.accountName||`账号 ${idx+1}`} · ${a.adAccountId||'未录入广告账号 ID'}`}))]},
    toolScopeTools(){if(this.selectedToolClientId==='ALL')return this.mediaTools;return this.mediaTools.filter(t=>(t.bindings||[]).some(b=>String(b.clientId)===String(this.selectedToolClientId)&&(this.selectedToolAccountKey==='ALL'||b.accountKey==='ALL'||String(b.accountKey)===String(this.selectedToolAccountKey))))},
    filteredMediaTools(){const q=this.toolSearch.trim().toLowerCase();return this.toolScopeTools.filter(t=>{const bindingText=this.toolBindingDisplay(t).flatMap(b=>[b.clientName,b.accountLabel]).join(' ');const hay=[t.name,t.loginAccount,t.purpose,t.owner,t.notes,bindingText].filter(Boolean).join(' ').toLowerCase();return(!q||hay.includes(q))&&(this.toolCategoryFilter==='ALL'||t.category===this.toolCategoryFilter)}).sort((a,b)=>String(a.name||'').localeCompare(String(b.name||''),'zh-CN'))},
    toolStats(){const scope=this.toolScopeTools;const bindings=scope.reduce((n,t)=>{const list=t.bindings||[];if(this.selectedToolClientId==='ALL')return n+list.length;return n+list.filter(b=>String(b.clientId)===String(this.selectedToolClientId)&&(this.selectedToolAccountKey==='ALL'||b.accountKey==='ALL'||String(b.accountKey)===String(this.selectedToolAccountKey))).length},0);return{total:scope.length,active:scope.filter(t=>t.status==='ACTIVE').length,bindings,categories:new Set(scope.map(t=>t.category).filter(Boolean)).size}},
    completedSopCount(){return this.selectedSopSteps.filter(step=>!!this.sopChecked[step.id]).length},
    fbAssetClients(){return this.clients.filter(c=>c.platform.includes('FB'))},
    tkAssetClients(){return this.clients.filter(c=>c.platform.includes('TK'))},
    fbAccountTotal(){return this.clients.reduce((n,c)=>n+(c.fbAccounts||[]).length,0)},
    tkAccountTotal(){return this.clients.reduce((n,c)=>n+(c.tkAccounts||[]).length,0)},
    financeAvailableYears(){const set=new Set([new Date().getFullYear()]);this.clients.forEach(c=>[c.startDate,c.endDate].forEach(d=>{const y=Number(String(d||'').slice(0,4));if(y)set.add(y)}));this.financeReconciliations.forEach(r=>{const y=Number(String(r.settlementMonth||'').slice(0,4));if(y)set.add(y)});this.clients.forEach(c=>[...(c.fbAccounts||[]),...(c.tkAccounts||[])].forEach(a=>(a.adDataRecords||[]).forEach(r=>{const y=Number(String(r.date||'').slice(0,4));if(y)set.add(y)})));const current=new Date().getFullYear();for(let y=current-2;y<=current+2;y++)set.add(y);return [...set].sort((a,b)=>b-a)},
    financePeriodLabel(){if(this.financePeriod==='MONTH'){const [y,m]=String(this.financeMonthKey||'').split('-');return `${y||'—'}年${Number(m||0)||'—'}月`}if(this.financePeriod==='QUARTER')return `${this.financeQuarterYear}年第${this.financeQuarter}季度`;return `${this.financeYear}年`},
    financeRows(){const snap=this.financeActivePeriodSnapshot;if(snap?.clients){let rows=Object.entries(snap.clients).map(([id,row])=>this.financeSnapshotClientRow(id,row));if(this.financeClientFilter!=='ALL')rows=rows.filter(r=>String(r.client.id)===String(this.financeClientFilter));return rows.filter(r=>this.financeClientFilter!=='ALL'||r.receivableCount||Object.values(r.spendGroups||{}).some(v=>Math.abs(Number(v||0))>0.005)||Object.values(r.actualRebateGroups||{}).some(v=>Math.abs(Number(v||0))>0.005)||Object.values(r.costGroups||{}).some(v=>Math.abs(Number(v||0))>0.005))}let clients=[...this.clients];if(this.financeClientFilter!=='ALL')clients=clients.filter(c=>String(c.id)===String(this.financeClientFilter));const rows=clients.map(client=>this.financeClientRow(client)).filter(Boolean);if(this.financeClientFilter!=='ALL')return rows;return rows.filter(r=>r.receivableCount||Object.values(r.spendGroups||{}).some(v=>Math.abs(Number(v||0))>0.005)||Object.values(r.actualRebateGroups||{}).some(v=>Math.abs(Number(v||0))>0.005)||Object.values(r.costGroups||{}).some(v=>Math.abs(Number(v||0))>0.005))},
    financeTotals(){const out={service:{},spend:{},expected:{},actual:{},expectedProfit:{},actualProfit:{}};this.financeRows.forEach(r=>{this.mergeSpendGroups(out.service,r.receivableGroups);this.mergeSpendGroups(out.expected,r.expectedRebateGroups);this.mergeSpendGroups(out.expectedProfit,r.expectedNetProfitGroups);this.mergeSpendGroups(out.actualProfit,r.actualNetProfitGroups)});out.spend={...this.financeTotalAdSpendGroups};out.actual={...this.financeConfirmedActualRebateGroups};return out},
    financeServiceFeeText(){return this.spendGroupsText(this.financeTotals.service)},
    financeSpendText(){return this.spendGroupsText(this.financeTotalAdSpendGroups)},
    financeExpectedRebateText(){return this.spendGroupsText(this.financeTotals.expected)},
    financeActualRebateText(){return this.spendGroupsText(this.financeConfirmedActualRebateGroups)},
    financeExpectedProfitText(){return this.financeExpectedNetProfitText},
    financeActualProfitText(){return this.financeActualNetProfitText},
    financeVisibleReconciliationHistory(){return [...this.financeReconciliations].filter(r=>this.financeSettlementMonthMatch(r.settlementMonth)&&(this.financeProviderFilter==='ALL'||String(r.providerId)===String(this.financeProviderFilter))).sort((a,b)=>String(b.settlementMonth||'').localeCompare(String(a.settlementMonth||''))||String(b.confirmedDate||'').localeCompare(String(a.confirmedDate||'')))},
    financeRebateChannelOptions(){const options=[];this.openingProviders.forEach(provider=>{(provider.contacts||[]).forEach(contact=>{const linkedDeals=this.openingDeals.filter(d=>d.status==='OPENED'&&String(d.providerId)===String(provider.id)&&String(d.contactId||'')===String(contact.id));options.push({key:`${provider.id}|${contact.id}`,providerId:provider.id,contactId:contact.id,label:`${provider.name} · ${contact.name} · 当前返点 ${Number(this.contactCurrentRebateRate(contact)||0).toFixed(2)}%`,provider,contact,linkedDeals})})});return options},
    financeRebatePolicyText(){const opt=this.financeSelectedRebateOption;if(!opt)return'未选择开户商 / 对接人';return `当前返点 ${Number(this.contactCurrentRebateRate(opt.contact)||0).toFixed(2)}% · ${this.financeRebateLinkedClientCount} 个关联客户`},
    financeRebatePolicyNote(){const opt=this.financeSelectedRebateOption;return opt?.contact?.rebatePolicy||''},
    financeRebateLinkedClientCount(){const opt=this.financeSelectedRebateOption;if(!opt)return 0;return new Set((opt.linkedDeals||[]).map(d=>String(d.clientId||'')).filter(Boolean)).size},
    unboundOpeningDealCount(){return this.openingDeals.filter(d=>this.openingProviderContacts(d).length&&!this.openingContact(d)).length},
    dashboardCards(){const scope=this.activeClients;const usd=scope.filter(c=>c.currency==='USD').reduce((s,c)=>s+Number(c.monthlyFee||0),0);const cny=scope.filter(c=>c.currency==='CNY').reduce((s,c)=>s+Number(c.monthlyFee||0),0);const accounts=scope.reduce((n,c)=>n+(c.fbAccounts||[]).length+(c.tkAccounts||[]).length,0);return[
      {label:'合作客户',value:`${this.activeClients.length} 家`,hint:'当前合作客户（不含归档）',icon:'fa-solid fa-users',iconBg:'bg-indigo-50 text-indigo-600',valueClass:'text-slate-950'},
      {label:'月服务费',value:`$${usd.toLocaleString()} + ¥${cny.toLocaleString()}`,hint:'币种分开统计',icon:'fa-solid fa-wallet',iconBg:'bg-emerald-50 text-emerald-600',valueClass:'text-emerald-600'},
      {label:'运营预警',value:`${this.alertList.length} 项`,hint:'合同 / IP / 应收回款 / 广告余额',icon:'fa-regular fa-bell',iconBg:'bg-amber-50 text-amber-600',valueClass:'text-amber-600'},
      {label:'广告账号',value:`${accounts} 个`,hint:'FB + TikTok',icon:'fa-solid fa-layer-group',iconBg:'bg-blue-50 text-blue-600',valueClass:'text-blue-600'}]},
    reminderTypeOptions(){return (this.reminderTypes||[]).filter(t=>t&&t.key&&t.name)},
    alertList(){const list=[];this.clients.filter(c=>!c.archived).forEach(c=>{this.pushDueAlert(list,c,'CONTRACT',c.endDate,this.alertTypeName('CONTRACT'),this.formatMoney(c.monthlyFee,c.currency),c.product||c.project||'—');(c.networkEnvironments||[]).forEach((env,idx)=>this.pushDueAlert(list,c,'IP',env.ipDueDate,`${this.alertTypeName('IP')} · 环境 ${idx+1}`,env.ipMonthlyFee?`${this.formatMoney(env.ipMonthlyFee,env.ipCurrency)}/月`:'',env.ipEnvironment||env.networkName,env.id));(c.fbAccounts||[]).forEach((account,idx)=>this.pushRechargeAlert(list,c,'FB',account,idx));(c.tkAccounts||[]).forEach((account,idx)=>this.pushRechargeAlert(list,c,'TK',account,idx))});this.financeReceivables.filter(r=>this.financeReceivableUnpaid(r)>0).forEach(r=>{if(!r.dueDate)return;const client=this.clients.find(c=>String(c.id)===String(r.clientId)),party=this.financeReceivableClientName(r),days=this.daysUntil(r.dueDate),stage=this.autoDueReminderStage(r.dueDate);if(stage)list.push({id:`RECEIVABLE-${r.id}`,typeKey:'RECEIVABLE',clientId:client?.id||null,receivableId:r.id,clientName:party,type:this.alertTypeName('RECEIVABLE'),dueDate:r.dueDate,daysLeft:days,cost:`待收 ${this.formatMoney(this.financeReceivableUnpaid(r),r.currency)}`,target:`${this.financeIncomeTypeText(r.incomeType)} · ${r.projectName||r.settlementMonth} · 已收 ${this.formatMoney(this.financeReceivablePaid(r),r.currency)}`,isStandalone:false,...stage})});this.standaloneAlerts.filter(a=>a.typeKey!=='TOOL').forEach(a=>{const d=this.daysUntil(a.dueDate),stage=this.autoDueReminderStage(a.dueDate);if(stage)list.push({...a,...stage,type:this.alertTypeName(a.typeKey),daysLeft:d,isStandalone:true})});return list.filter(a=>a.typeKey==='AD_RECHARGE'||!this.isAlertDismissed(a)).sort((a,b)=>a.daysLeft-b.daysLeft)},
    filteredAlerts(){return this.alertTypeFilter==='ALL'?this.alertList:this.alertList.filter(a=>a.typeKey===this.alertTypeFilter)},
    alertFilters(){const cnt=k=>this.alertList.filter(a=>a.typeKey===k).length