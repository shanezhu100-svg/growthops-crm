.filter(r=>months.includes(String(r.settlementMonth||''))&&(this.openingProviderFilter==='ALL'||String(r.providerId)===String(this.openingProviderFilter))).map(r=>{const provider=this.openingProviders.find(p=>String(p.id)===String(r.providerId)),contact=provider?.contacts?.find(c=>String(c.id)===String(r.contactId)),voided=r.status==='VOID';return{'月份':r.settlementMonth||'','开户商':provider?.name||'已删除开户商','对接人':contact?.name||'已删除对接人','币种':r.currency||'USD','代理商确认广告消耗':voided?0:Number(r.confirmedSpend||0),'实际返点':voided?0:Number(r.actualRebate||0),'撤销前确认消耗':voided?Number(r.confirmedSpend||0):'','撤销前实际返点':voided?Number(r.actualRebate||0):'','确认日期':r.confirmedDate||'','状态':voided?'已撤销':'已确认','备注':r.note||''}});
      this.excelAppendJsonSheet(wb,'返点对账记录',reconRows,[12,18,18,10,18,14,16,16,12,12,30]);
      const filename=`返点统计_${this.excelSafeFilePart(period)}_${this.excelSafeFilePart(providerFilterName)}.xlsx`;XLSX.writeFile(wb,filename,{compression:true});this.logAudit('导出返点 Excel',`${period} · ${providerFilterName}`);this.notify('返点 Excel 已生成并开始下载')
    },
    migrateLegacyActualRebatesToReconciliations(){const legacy=Array.isArray(this.financeActualRebates)?this.financeActualRebates:[];let migrated=0;legacy.forEach(r=>{if(!r?.providerId||!r?.contactId||!r?.settlementMonth)return;const currency=r.currency||'USD',exists=this.financeReconciliations.some(x=>String(x.providerId)===String(r.providerId)&&String(x.contactId)===String(r.contactId)&&String(x.settlementMonth)===String(r.settlementMonth)&&(x.currency||'USD')===currency);if(exists)return;const spend=this.financeSpendForChannelMonth(r.providerId,r.contactId,r.settlementMonth)[currency]||0,expected=this.financeExpectedRebateForChannelMonth(r.providerId,r.contactId,r.settlementMonth)[currency]||0;this.financeReconciliations.push({id:this.accountUid('recon'),providerId:r.providerId,contactId:r.contactId,settlementMonth:r.settlementMonth,currency,confirmedSpend:Number(spend||0),actualRebate:Number(r.amount||0),systemSpend:Number(spend||0),expectedRebate:Number(expected||0),confirmedDate:r.confirmedDate||this.localDateKey(),note:r.note?`历史实际返点迁移：${r.note}`:'历史实际返点记录自动迁移',status:'CONFIRMED',updatedAt:r.updatedAt||new Date().toISOString(),migratedFromLegacy:true});migrated++});if(migrated)this.financeActualRebates=[];return migrated},
    loadData(){try{const storedClients=JSON.parse(localStorage.getItem('growthOpsClients'));this.clients=(storedClients||structuredClone(seedClients)).map(c=>this.normalizeClient(c));this.standaloneAlerts=(JSON.parse(localStorage.getItem('growthOpsAlerts'))||structuredClone(seedAlerts)).filter(a=>a.typeKey!=='TOOL').map(a=>this.normalizeStandaloneAlert(a));this.reminderTypes=this.normalizeReminderTypes(JSON.parse(localStorage.getItem('growthOpsReminderTypes'))||this.defaultReminderTypes());this.dismissedAlerts=JSON.parse(localStorage.getItem('growthOpsDismissedAlerts'))||[];this.leads=JSON.parse(localStorage.getItem('growthOpsLeads'))||structuredClone(seedLeads);this.openingProviders=(JSON.parse(localStorage.getItem('growthOpsOpeningProviders'))||structuredClone(seedOpeningProviders)).map(p=>this.normalizeOpeningProvider(p));this.openingDeals=JSON.parse(localStorage.getItem('growthOpsOpeningDeals'))||structuredClone(seedOpeningDeals);this.migrateOpeningDeals();this.financeActualRebates=this.normalizeFinanceActualRebates(JSON.parse(localStorage.getItem('growthOpsFinanceActualRebates'))||[]);this.financeReceivables=(JSON.parse(localStorage.getItem('growthOpsFinanceReceivables'))||[]).map(r=>this.normalizeReceivable(r));this.financeCosts=(JSON.parse(localStorage.getItem('growthOpsFinanceCosts'))||[]).map(c=>this.normalizeFinanceCost(c));this.financeReconciliations=(JSON.parse(localStorage.getItem('growthOpsFinanceReconciliations'))||[]).map(r=>({...r,status:r.status||'CONFIRMED'}));this.migrateLegacyActualRebatesToReconciliations();this.financeMonthLocks=JSON.parse(localStorage.getItem('growthOpsFinanceMonthLocks'))||{};this.financeMonthSnapshots=JSON.parse(localStorage.getItem('growthOpsFinanceMonthSnapshots'))||{};this.authUsers=JSON.parse(localStorage.getItem('growthOpsAuthUsers'))||structuredClone(seedAuthUsers);this.backupSnapshots=JSON.parse(localStorage.getItem('growthOpsBackups'))||[];this.auditLogs=JSON.parse(localStorage.getItem('growthOpsAuditLogs'))||[];const sessionUserId=localStorage.getItem('growthOpsSessionUser');this.currentUser=this.authUsers.find(u=>u.id===sessionUserId&&u.enabled!==false)||null;this.mediaTools=(JSON.parse(localStorage.getItem('growthOpsMediaTools'))||structuredClone(seedMediaTools)).map(t=>this.normalizeMediaTool(t))}catch(e){this.clients=structuredClone(seedClients).map(c=>this.normalizeClient(c));this.standaloneAlerts=structuredClone(seedAlerts).filter(a=>a.typeKey!=='TOOL');this.reminderTypes=this.defaultReminderTypes();this.dismissedAlerts=[];this.leads=structuredClone(seedLeads);this.openingProviders=structuredClone(seedOpeningProviders).map(p=>this.normalizeOpeningProvider(p));this.openingDeals=structuredClone(seedOpeningDeals);this.migrateOpeningDeals();this.financeActualRebates=[];this.financeReceivables=[];this.financeCosts=[];this.financeReconciliations=[];this.financeMonthLocks={};this.financeMonthSnapshots={};this.authUsers=structuredClone(seedAuthUsers);this.backupSnapshots=[];this.auditLogs=[];this.currentUser=null;this.mediaTools=structuredClone(seedMediaTools).map(t=>this.normalizeMediaTool(t))}},
    persist(){const entries=[['growthOpsClients',this.clients],['growthOpsAlerts',this.standaloneAlerts],['growthOpsReminderTypes',this.reminderTypes],['growthOpsDismissedAlerts',this.dismissedAlerts],['growthOpsLeads',this.leads],['growthOpsOpeningProviders',this.openingProviders],['growthOpsOpeningDeals',this.openingDeals],['growthOpsFinanceActualRebates',this.financeActualRebates],['growthOpsFinanceReceivables',this.financeReceivables],['growthOpsFinanceCosts',this.financeCosts],['growthOpsFinanceReconciliations',this.financeReconciliations],['growthOpsFinanceMonthLocks',this.financeMonthLocks],['growthOpsFinanceMonthSnapshots',this.financeMonthSnapshots],['growthOpsAuthUsers',this.authUsers],['growthOpsBackups',this.backupSnapshots],['growthOpsAuditLogs',this.auditLogs],['growthOpsMediaTools',this.mediaTools]],previous=entries.map(([key])=>[key,localStorage.getItem(key)]);try{entries.forEach(([key,value])=>localStorage.setItem(key,JSON.stringify(value)));this.updateStorageUsage();return true}catch(e){console.error(e);previous.forEach(([key,value])=>{try{if(value===null)localStorage.removeItem(key);else localStorage.setItem(key,value)}catch(rollbackError){console.error(rollbackError)}});this.updateStorageUsage();this.notify('本地存储保存失败，本次写入已回滚。请立即导出备份并清理历史快照。');return false}},
    updateStorageUsage(){let bytes=0;for(let i=0;i<localStorage.length;i++){const k=localStorage.key(i),v=localStorage.getItem(k)||'';bytes+=(String(k).length+String(v).length)*2}this.storageUsageBytes=bytes;return bytes},
    roleLabel(role){return({ADMIN:'管理员',FINANCE:'财务',OPS:'投手 / 运营',SALES:'销售'})[role]||role||'未知'},
    roleScopeText(role){return({ADMIN:'全部页面 / 敏感凭证 / 用户与月结管理',FINANCE:'客户基本资料 / 开户渠道 / 财务 / 提醒 / 备份（无密码权限）',OPS:'客户资产 / 敏感凭证 / 广告 / 数据 / 工具 / SOP',SALES:'潜在客户 / 客户基本资料 / 开户渠道（无密码权限）'})[role]||'自定义'},
    rolePages(role){const common=['dashboard','client-detail'];return{ADMIN:['*'],FINANCE:[...common,'clients','client-form','account-opening','finance','alerts','system'],OPS:[...common,'clients','client-form','assets','ads','analytics','tools','alerts','sop'],SALES:[...common,'leads','clients','client-form','account-opening']}[role]||common},
    canViewPage(page){if(!this.currentUser)return false;const pages=this.rolePages(this.currentUser.role);return pages.includes('*')||pages.includes(page)},
    canViewCredentials(){return['ADMIN','OPS'].includes(this.currentUser?.role)},
    canManageAssets(){return['ADMIN','OPS'].includes(this.currentUser?.role)},
    canManageFinance(){return['ADMIN','FINANCE'].includes(this.currentUser?.role)},
    canManageProviders(){return['ADMIN','FINANCE'].includes(this.currentUser?.role)},
    canArchiveClients(){return['ADMIN','SALES'].includes(this.currentUser?.role)},
    login(){const u=this.authUsers.find(u=>u.enabled!==false&&u.username===this.loginForm.username&&u.password===this.loginForm.password);if(!u){this.notify('账号或密码错误');return}this.currentUser=u;localStorage.setItem('growthOpsSessionUser',u.id);this.logAudit('登录系统',`${u.name} · ${this.roleLabel(u.role)}`);if(!this.canViewPage(this.currentPage))this.currentPage='dashboard'},
    logout(){if(this.currentUser)this.logAudit('退出系统',this.currentUser.name);this.currentUser=null;localStorage.removeItem('growthOpsSessionUser');this.loginForm={username:'',password:''};this.currentPage='dashboard'},
    openUserModal(user=null){if(this.currentUser?.role!=='ADMIN')return;this.userForm=user?JSON.parse(JSON.stringify(user)):{id:null,name:'',username:'',password:'',role:'OPS',enabled:true};this.showUserModal=true},
    saveAuthUser(){if(this.currentUser?.role!=='ADMIN')return;const f={...this.userForm,name:String(this.userForm.name||'').trim(),username:String(this.userForm.username||'').trim(),password:String(this.userForm.password||'')};if(!f.name||!f.username||!f.password){this.notify('请完整填写姓名、登录账号和密码');return}if(!['ADMIN','FINANCE','OPS','SALES'].includes(f.role)){this.notify('请选择有效的用户角色');return}if(this.authUsers.some(u=>String(u.username||'').trim().toLowerCase()===f.username.toLowerCase()&&String(u.id)!==String(f.id||''))){this.notify('登录账号已存在');return}if(f.id&&String(f.id)===String(this.currentUser?.id)&&f.enabled===false){this.notify('当前正在登录的账号不能禁用，请先使用其他管理员账号登录');return}const nextUsers=this.authUsers.map(u=>String(u.id)===String(f.id||'')?{...f}:u);if(!f.id)nextUsers.push({...f,id:'__new__'});if(!nextUsers.some(u=>u.role==='ADMIN'&&u.enabled!==false)){this.notify('系统至少需要保留一个启用状态的管理员账号');return}let saved=null;if(f.id){const i=this.authUsers.findIndex(u=>String(u.id)===String(f.id));if(i>=0){this.authUsers[i]=f;saved=this.authUsers[i]}}else{saved={...f,id:this.accountUid('user')};this.authUsers.push(saved)}if(String(saved?.id)===String(this.currentUser?.id)){this.currentUser=saved;localStorage.setItem('growthOpsSessionUser',saved.id);if(!this.canViewPage(this.currentPage))this.currentPage='dashboard'}this.persist();this.showUserModal=false;this.logAudit('保存用户权限',`${saved?.name||f.name} · ${this.roleLabel(saved?.role||f.role)}`);this.notify('用户权限已保存')},
    canDeleteAuthUser(user){if(!user||this.currentUser?.role!=='ADMIN')return false;if(String(user.id)===String(this.currentUser?.id))return false;if(user.role==='ADMIN'&&user.enabled!==false&&this.authUsers.filter(u=>u.role==='ADMIN'&&u.enabled!==false).length<=1)return false;return true},
    deleteAuthUser(user){if(this.currentUser?.role!=='ADMIN'){this.notify('只有管理员可以删除用户');return}if(String(user.id)===String(this.currentUser?.id)){this.notify('当前正在登录的账号不能删除，请先使用其他管理员账号登录');return}if(user.role==='ADMIN'&&user.enabled!==false&&this.authUsers.filter(u=>u.role==='ADMIN'&&u.enabled!==false).length<=1){this.notify('系统至少需要保留一个启用状态的管理员账号');return}this.askConfirm({title:'删除系统用户',message:`确定删除用户【${user.name}】吗？
删除后该账号将立即失去登录权限。`,confirmText:'确认删除'},()=>{this.authUsers=this.authUsers.filter(u=>String(u.id)!==String(user.id));this.persist();this.logAudit('删除系统用户',`${user.name} · ${user.username}`);this.notify(`用户【${user.name}】已删除`)})},
    deleteBackupSnapshot(snap){if(this.currentUser?.role!=='ADMIN'){this.notify('只有管理员可以删除数据快照');return}if(!snap?.id)return;this.askConfirm({title:'删除数据快照',message:`确定删除【${snap.name}】吗？
删除后无法通过该快照恢复历史数据。`,confirmText:'删除快照'},()=>{this.backupSnapshots=this.backupSnapshots.filter(s=>String(s.id)!==String(snap.id));localStorage.setItem('growthOpsBackups',JSON.stringify(this.backupSnapshots));this.updateStorageUsage();this.logAudit('删除数据快照',snap.name);this.notify('数据快照已删除')})},
    logAudit(action,detail=''){this.auditLogs.unshift({id:this.accountUid('log'),at:new Date().toISOString(),user:this.currentUser?.name||'系统',action,detail});this.auditLogs=this.auditLogs.slice(0,200);localStorage.setItem('growthOpsAuditLogs',JSON.stringify(this.auditLogs))},
    collectSopProgress(){const out={};for(let i=0;i<localStorage.length;i++){const key=localStorage.key(i);if(key&&key.startsWith('growthOpsSop-'))out[key]=localStorage.getItem(key)||'{}'}return out},
    restoreSopProgress(progress){const keys=[];for(let i=0;i<localStorage.length;i++){const key=localStorage.key(i);if(key&&key.startsWith('growthOpsSop-'))keys.push(key)}keys.forEach(key=>localStorage.removeItem(key));Object.entries(progress||{}).forEach(([key,value])=>{if(String(key).startsWith('growthOpsSop-'))localStorage.setItem(key,typeof value==='string'?value:JSON.stringify(value))})},
    collectBackupPayload(){return{version:'growth-ops-2026.08-predeploy-v1',exportedAt:new Date().toISOString(),clients:this.clients,standaloneAlerts:this.standaloneAlerts,reminderTypes:this.reminderTypes,dismissedAlerts:this.dismissedAlerts,leads:this.leads,openingProviders:this.openingProviders,openingDeals:this.openingDeals,financeActualRebates:this.financeActualRebates,financeReceivables:this.financeReceivables,financeCosts:this.financeCosts,financeReconciliations:this.financeReconciliations,financeMonthLocks:this.financeMonthLocks,financeMonthSnapshots:this.financeMonthSnapshots,sopProgress:this.collectSopProgress(),mediaTools:this.mediaTools,authUsers:this.authUsers,auditLogs:this.auditLogs}},
    backupSnapshotLocalDate(snap){if(snap?.backupDate)return String(snap.backupDate);const d=new Date(snap?.createdAt||'');if(Number.isNaN(d.getTime()))return'';return`${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`},
    createBackupSnapshot(notifyUser=false){const payload=this.collectBackupPayload(),backupDate=this.localDateKey(),snap={id:this.accountUid('backup'),name:`数据快照 ${backupDate} ${new Date().toLocaleTimeString('zh-CN',{hour:'2-digit',minute:'2-digit'})}`,backupDate,createdAt:new Date().toISOString(),payload};this.backupSnapshots.unshift(snap);this.backupSnapshots=this.backupSnapshots.slice(0,5);localStorage.setItem('growthOpsBackups',JSON.stringify(this.backupSnapshots));if(notifyUser){this.logAudit('创建数据快照',snap.name);this.notify('已创建全量数据快照')}return snap},
    ensureDailyBackup(){const today=this.localDateKey();if(!this.backupSnapshots.some(s=>this.backupSnapshotLocalDate(s)===today))this.createBackupSnapshot(false)},
    formatBackupTime(value){if(!value)return'—';try{return new Intl.DateTimeFormat('zh-CN',{year:'numeric',month:'2-digit',day:'2-digit',hour:'2-digit',minute:'2-digit'}).format(new Date(value))}catch(e){return value}},
    downloadFullBackup(){const payload=this.collectBackupPayload(),blob=new Blob([JSON.stringify(payload,null,2)],{type:'application/json'}),url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download=`growth-ops-backup-${this.localDateKey()}.json`;