document.body.appendChild(a);a.click();a.remove();URL.revokeObjectURL(url);this.logAudit('导出全量备份',a.download);this.notify('全量备份已导出')},
    applyBackupPayload(p){if(!p||!Array.isArray(p.clients))throw new Error('无效备份');const incomingUsers=Array.isArray(p.authUsers)&&p.authUsers.length?p.authUsers:null;if(incomingUsers&&!incomingUsers.some(u=>u?.role==='ADMIN'&&u.enabled!==false))throw new Error('备份中没有启用状态的管理员账号，已阻止恢复');const sessionId=String(this.currentUser?.id||localStorage.getItem('growthOpsSessionUser')||'');this.clients=p.clients.map(c=>this.normalizeClient(c));this.migrateLegacyAccountSpendRecords();this.standaloneAlerts=(p.standaloneAlerts||[]).map(a=>this.normalizeStandaloneAlert(a));this.reminderTypes=this.normalizeReminderTypes(p.reminderTypes||this.defaultReminderTypes());this.dismissedAlerts=p.dismissedAlerts||[];this.leads=p.leads||[];this.openingProviders=(p.openingProviders||[]).map(x=>this.normalizeOpeningProvider(x));this.openingDeals=p.openingDeals||[];this.migrateOpeningDeals();this.financeActualRebates=this.normalizeFinanceActualRebates(p.financeActualRebates||[]);this.financeReceivables=(p.financeReceivables||[]).map(r=>this.normalizeReceivable(r));this.financeCosts=(p.financeCosts||[]).map(c=>this.normalizeFinanceCost(c));this.financeReconciliations=(p.financeReconciliations||[]).map(r=>({...r,status:r.status||'CONFIRMED'}));this.migrateLegacyActualRebatesToReconciliations();this.financeMonthLocks=p.financeMonthLocks||{};this.financeMonthSnapshots=p.financeMonthSnapshots||{};this.restoreSopProgress(p.sopProgress||{});this.mediaTools=(p.mediaTools||[]).map(t=>this.normalizeMediaTool(t));if(incomingUsers)this.authUsers=incomingUsers.map(u=>({...u}));if(Array.isArray(p.auditLogs))this.auditLogs=p.auditLogs;const restoredSession=this.authUsers.find(u=>String(u.id)===sessionId&&u.enabled!==false)||null;this.currentUser=restoredSession;if(restoredSession)localStorage.setItem('growthOpsSessionUser',restoredSession.id);else localStorage.removeItem('growthOpsSessionUser');this.ensureReceivableLinkedCosts();this.ensureFinanceSnapshotsForLocks();this.persist();this.syncAnalyticsAccountSelection();this.syncAdsAccountSelection();this.syncSopAccountSelection(true);if(!this.currentUser)this.currentPage='dashboard'},
    restoreBackupSnapshot(snap){if(this.currentUser?.role!=='ADMIN'){this.notify('只有管理员可以恢复数据快照');return}if(!snap?.payload)return;this.askConfirm({title:'恢复数据快照',message:`确定恢复【${snap.name}】吗？恢复前系统会先自动保存当前数据快照。`,confirmText:'确认恢复',tone:'warning'},()=>{this.createBackupSnapshot(false);this.applyBackupPayload(snap.payload);this.logAudit('恢复数据快照',snap.name);this.notify('数据快照已恢复')})},
    importFullBackup(event){if(this.currentUser?.role!=='ADMIN'){this.notify('只有管理员可以导入全量备份');if(event?.target)event.target.value='';return}const file=event.target.files?.[0];event.target.value='';if(!file)return;const reader=new FileReader();reader.onload=()=>{try{const p=JSON.parse(reader.result);this.askConfirm({title:'导入全量备份',message:`导入【${file.name}】将覆盖当前业务数据，系统会先自动保存当前快照。是否继续？`,confirmText:'确认导入',tone:'warning'},()=>{this.createBackupSnapshot(false);this.applyBackupPayload(p);this.logAudit('导入全量备份',file.name);this.notify('备份导入完成')})}catch(e){this.notify('备份文件无法识别')}};reader.readAsText(file)},
    defaultReceivableForm(){const month=this.financeMonthKey||this.localDateKey().slice(0,7);return{id:null,ownerType:'CLIENT',clientId:'',payerName:'',settlementMonth:month,incomeType:'OTHER',projectName:'',currency:'USD',amount:'',directCost:0,directCostDate:`${month}-01`,costVendor:'',collectionMode:'RECEIVABLE',receivedDate:this.localDateKey(),paymentMethod:'银行转账',paymentAccount:'',dueDate:'',invoiceStatus:'PENDING',invoiceNo:'',note:'',payments:[],billSource:'MANUAL'}},
    normalizeReceivable(r){const x=JSON.parse(JSON.stringify(r||{}));x.ownerType=['CLIENT','COMPANY'].includes(x.ownerType)?x.ownerType:(x.clientId?'CLIENT':'COMPANY');if(x.ownerType==='COMPANY')x.clientId='';x.payerName=x.payerName||x.sourceName||'';x.incomeType=['SERVICE_FEE','SHOOTING_SERVICE','NETWORK_RECHARGE','ACCOUNT_SALE','OPENING_SERVICE','OTHER'].includes(x.incomeType)?x.incomeType:'SERVICE_FEE';if(x.ownerType==='COMPANY'&&x.incomeType==='SERVICE_FEE')x.incomeType='OTHER';x.projectName=x.projectName||x.itemName||(x.incomeType==='SERVICE_FEE'?'投放服务费':'');x.projectName=String(x.projectName||'').replace(/代投服务费/g,'投放服务费');x.directCost=Math.max(0,Number(x.directCost||0));x.directCostDate=x.directCostDate||(`${String(x.settlementMonth||this.localDateKey().slice(0,7)).slice(0,7)}-01`);x.costVendor=x.costVendor||'';x.billSource=x.billSource||(String(x.note||'').includes('系统自动出账')?'AUTO_SERVICE_FEE':'MANUAL');x.payments=Array.isArray(x.payments)?x.payments:[];if(!x.payments.length&&Number(x.paidAmount||0)>0)x.payments.push({id:this.accountUid('pay-legacy'),date:x.paidDate||x.dueDate||this.localDateKey(),amount:Number(x.paidAmount||0),method:x.paymentMethod||'',account:'',note:'旧版已收金额迁移'});x.payments=x.payments.map(p=>({id:p.id||this.accountUid('pay'),date:p.date||this.localDateKey(),amount:Number(p.amount||0),method:p.method||'',account:p.account||'',note:p.note||'',createdAt:p.createdAt||''}));x.paidAmount=x.payments.reduce((s,p)=>s+Number(p.amount||0),0);x.collectionMode=Number(x.amount||0)>0&&x.paidAmount>=Number(x.amount||0)-0.0001?'PAID':'RECEIVABLE';x.receivedDate=x.receivedDate||x.payments[0]?.date||this.localDateKey();x.paymentMethod=x.paymentMethod||x.payments[0]?.method||'银行转账';x.paymentAccount=x.paymentAccount||x.payments[0]?.account||'';return x},
    financeIncomeTypeText(v){return({SERVICE_FEE:'投放服务费',SHOOTING_SERVICE:'拍摄服务费',NETWORK_RECHARGE:'网络 / IP / 节点代充',ACCOUNT_SALE:'账号销售',OPENING_SERVICE:'开户服务费',OTHER:'其他收入'})[v]||'其他收入'},
    financeIncomeTypePlaceholder(v){return({SERVICE_FEE:'例如：8月投放服务费',SHOOTING_SERVICE:'例如：产品短视频拍摄 / 素材拍摄服务',NETWORK_RECHARGE:'例如：US 静态住宅 IP 代充',ACCOUNT_SALE:'例如：FB 企业广告账号 × 1',OPENING_SERVICE:'例如：Facebook 开户服务',OTHER:'例如：建站服务 / 素材服务'})[v]||'请输入项目内容'},
    financeIncomeCostCategory(v){return({SHOOTING_SERVICE:'CREATIVE',NETWORK_RECHARGE:'IP',ACCOUNT_SALE:'ACCOUNT_PURCHASE',OPENING_SERVICE:'OPENING',OTHER:'OTHER'})[v]||'OTHER'},
    financeReceivableMargin(r){return Number(r?.amount||0)-Number(r?.directCost||0)},
    financeReceivableMarginRate(r){const amount=Number(r?.amount||0);if(amount<=0)return'—';return `${((this.financeReceivableMargin(r)/amount)*100).toFixed(2)}%`},
    financeReceivableIncomeBreakdownText(rows){const counts={};(rows||[]).forEach(r=>{const type=r.incomeType||'SERVICE_FEE';counts[type]=(counts[type]||0)+1});return Object.entries(counts).map(([type,count])=>`${this.financeIncomeTypeText(type)} ${count}`).join(' · ')||'—'},
    syncReceivableCostDate(){const month=String(this.receivableForm.settlementMonth||'');if(/^\d{4}-\d{2}$/.test(month)&&(!this.receivableForm.directCostDate||String(this.receivableForm.directCostDate).slice(0,7)!==month))this.receivableForm.directCostDate=`${month}-01`},
    syncReceivableOwnerType(){if(this.receivableForm.ownerType==='COMPANY'){this.receivableForm.clientId='';if(this.receivableForm.incomeType==='SERVICE_FEE')this.receivableForm.incomeType='OTHER'}else this.receivableForm.payerName='';this.syncReceivableIncomeType()},
    syncReceivableIncomeType(){if(this.receivableForm.incomeType==='SERVICE_FEE'){if(this.receivableForm.ownerType==='COMPANY')this.receivableForm.incomeType='OTHER';this.receivableForm.directCost=0;this.receivableForm.costVendor=''}if(!this.receivableForm.projectName||['投放服务费','拍摄服务费','网络 / IP / 节点代充','账号销售','开户服务费','其他收入'].includes(this.receivableForm.projectName))this.receivableForm.projectName=this.financeIncomeTypeText(this.receivableForm.incomeType);this.syncReceivableCostDate()},
    receivableLinkedCost(r){return this.financeCosts.find(c=>c.sourceType==='RECEIVABLE_ITEM'&&String(c.sourceId)===String(r?.id))||null},
    syncReceivableLinkedCost(r){if(!r?.id)return 0;const existing=this.receivableLinkedCost(r),needs=r.incomeType!=='SERVICE_FEE'&&Number(r.directCost||0)>0;if(!needs){if(existing&&!this.isMonthLocked(String(existing.date||'').slice(0,7))){this.financeCosts=this.financeCosts.filter(c=>String(c.id)!==String(existing.id));return 1}return 0}const costMonth=String(r.directCostDate||`${r.settlementMonth}-01`).slice(0,7);if(this.isMonthLocked(costMonth))return 0;const isCompany=(r.ownerType||'CLIENT')==='COMPANY',payload=this.normalizeFinanceCost({id:existing?.id||this.accountUid('cost-income'),date:r.directCostDate||`${r.settlementMonth}-01`,category:this.financeIncomeCostCategory(r.incomeType),scope:isCompany?'COMPANY_PROJECT':'CLIENT',clientId:isCompany?'':String(r.clientId),currency:r.currency||'USD',amount:Number(r.directCost||0),vendor:r.costVendor||'',note:`收入项目联动成本 · ${isCompany?'公司独立项目':'客户专属'} · ${this.financeIncomeTypeText(r.incomeType)} · ${r.projectName||this.financeIncomeTypeText(r.incomeType)}`,sourceType:'RECEIVABLE_ITEM',sourceId:String(r.id),autoGenerated:true});if(existing)Object.assign(existing,payload);else this.financeCosts.unshift(payload);return 1},
    ensureReceivableLinkedCosts(){let changed=0;this.financeReceivables.forEach(r=>changed+=this.syncReceivableLinkedCost(r));return changed},

    financeReceivableClientName(r){if((r?.ownerType||'CLIENT')==='COMPANY')return String(r?.payerName||'').trim()||'公司收入 · 不关联客户';return this.clients.find(c=>String(c.id)===String(r?.clientId))?.name||'客户已归档 / 删除'},
    financeReceivablePaid(r){return Array.isArray(r?.payments)?r.payments.reduce((s,p)=>s+Number(p.amount||0),0):Number(r?.paidAmount||0)},
    financeReceivableUnpaid(r){return Math.max(0,Number(r.amount||0)-this.financeReceivablePaid(r))},
    financeReceivableStatusText(r){const unpaid=this.financeReceivableUnpaid(r),paid=this.financeReceivablePaid(r);if(unpaid<=0)return'已收款';if(r.dueDate&&r.dueDate<this.localDateKey())return paid>0?'部分逾期':'已逾期';if(paid>0)return'部分收款';return'待收款'},
    financeReceivableStatusStyle(r){const s=this.financeReceivableStatusText(r);return s==='已收款'?'bg-emerald-50 text-emerald-700':s.includes('逾期')?'bg-rose-50 text-rose-600':s==='部分收款'?'bg-blue-50 text-blue-700':'bg-amber-50 text-amber-700'},
    financeReceivableStatusKey(r){const unpaid=this.financeReceivableUnpaid(r);if(unpaid<=0)return'PAID';if(r.dueDate&&r.dueDate<this.localDateKey())return'OVERDUE';return this.financeReceivablePaid(r)>0?'PARTIAL':'PENDING'},
    financeInvoiceStatusText(v){return({NONE:'无需开票',PENDING:'待开票',ISSUED:'已开票'})[v]||'待开票'},
    selectReceivableClient(id){this.receivableClientFilter=String(id);this.receivablePage=1;this.receivableClientSearch='';this.showReceivableClientPicker=false},
    openReceivableModal(r=null){this.receivableForm=r?this.normalizeReceivable(r):this.defaultReceivableForm();if(!r){const preferred=this.receivableClientFilter!=='ALL'?this.receivableClientFilter:this.financeClientFilter;if(preferred!=='ALL'){const c=this.clients.find(c=>String(c.id)===String(preferred));if(c){this.receivableForm.ownerType='CLIENT';this.receivableForm.clientId=String(c.id);this.receivableForm.currency=c.currency||'USD'}}}this.syncReceivableCostDate();this.showReceivableModal=true},
    selectProfitClient(id){this.financeClientFilter=String(id);this.showProfitClientPicker=false;this.profitClientSearch='';this.profitPage=1},
    applyProfitDateFilter(){if(this.profitDateFilter){this.financePeriod='MONTH';this.financeMonthKey=String(this.profitDateFilter).slice(0,7)}this.profitPage=1},
    saveReceivable(){let f=this.normalizeReceivable({...this.receivableForm,ownerType:this.receivableForm.ownerType==='COMPANY'?'COMPANY':'CLIENT',clientId:this.receivableForm.ownerType==='COMPANY'?'':String(this.receivableForm.clientId||''),payerName:String(this.receivableForm.payerName||'').trim(),amount:Number(this.receivableForm.amount||0),directCost:Number(this.receivableForm.directCost||0)});if(!f.settlementMonth||f.amount<=0){this.notify('请完整填写收入项目和有效收入金额');return}if(f.ownerType==='CLIENT'&&!f.clientId){this.notify('关联客户收入必须选择客户');return}if(f.ownerType==='COMPANY'&&f.incomeType==='SERVICE_FEE'){this.notify('投放服务费必须关联客户；公司独立收入请选择其他收入项目');return}if(!this.assertMonthUnlocked(f.settlementMonth,'保存收入项目'))return;const old=f.id?this.financeReceivables.find(r=>String(r.id)===String(f.id)):null;if(old&&String(old.settlementMonth)!==String(f.settlementMonth)&&!this.assertMonthUnlocked(old.settlementMonth,'调整收入项目结算月份'))return;if(f.incomeType==='SERVICE_FEE')f.directCost=0;if(f.directCost>0){if(!f.directCostDate)f.directCostDate=`${f.settlementMonth}-01`;if(String(f.directCostDate).slice(0,7)!==String(f.settlementMonth)){this.notify('为保证月度利润口径一致，项目直接成本发生日必须与结算月份一致');return}if(!this.assertMonthUnlocked(String(f.directCostDate).slice(0,7),'保存项目直接成本'))return}if(this.financeReceivablePaid(f)>f.amount+0.0001){this.notify('收入金额不能小于已经登记的回款总额');return}const isEdit=!!f.id;if(f.incomeType==='SERVICE_FEE'){const dup=this.financeReceivables.find(r=>String(r.id)!==String(f.id||'')&&String(r.clientId)===String(f.clientId)&&String(r.settlementMonth)===String(f.settlementMonth)&&(r.currency||'USD')===(f.currency||'USD')&&(r.incomeType||'SERVICE_FEE')==='SERVICE_FEE');if(dup){this.notify('该客户本月同币种已有“投放服务费”账单，请直接编辑现有账单，避免重复确认服务费收入');return}}if(!isEdit&&this.receivableForm.collectionMode==='PAID'){const receivedDate=this.receivableForm.receivedDate||this.localDateKey();if(!this.assertMonthUnlocked(String(receivedDate).slice(0,7),'登记该到账日期的已收款'))return;f.dueDate='';f.payments=[{id:this.accountUid('pay'),date:receivedDate,amount:Number(f.amount||0),method:this.receivableForm.paymentMethod||'',account:this.receivableForm.paymentAccount||'',note:'新增收入时直接登记已收',createdAt:new Date().toISOString()}];f.paidAmount=Number(f.amount||0);f.collectionMode='PAID'}if(f.id){const i=this.financeReceivables.findIndex(r=>String(r.id)===String(f.id));if(i>=0)this.financeReceivables[i]=f}else{f={...f,id:this.accountUid('ar'),billSource:'MANUAL',createdAt:new Date().toISOString()};this.financeReceivables.unshift(f)}this.syncReceivableLinkedCost(f);this.persist();this.showReceivableModal=false;const costLabel=f.ownerType==='COMPANY'?'公司项目成本':'客户专属成本';this.logAudit(isEdit?'修改收入项目':'新增收入项目',`${this.financeReceivableClientName(f)} · ${f.settlementMonth} · ${this.financeIncomeTypeText(f.incomeType)} · 收入 ${this.formatMoney(f.amount,f.currency)}${Number(f.directCost||0)>0?` · 直接成本 ${this.formatMoney(f.directCost,f.currency)} · 差价 ${this.formatMoney(this.financeReceivableMargin(f),f.currency)}`:''}`);this.notify(Number(f.directCost||0)>0?`收入项目已保存，${costLabel}已自动同步，净利润已更新`:(!isEdit&&this.receivableForm.collectionMode==='PAID'?'收入项目和已收款流水已一次保存':'收入项目已保存'))},
    openPaymentModal(r){const target=this.financeRecei