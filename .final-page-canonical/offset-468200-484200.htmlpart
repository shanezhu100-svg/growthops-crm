vables.find(x=>x.id===r?.id)||r;if(!target)return;this.paymentTargetReceivable=target;this.paymentForm={date:this.localDateKey(),amount:'',method:'银行转账',account:'',note:''};this.showPaymentModal=true},
    saveReceivablePayment(){const r=this.paymentTargetReceivable;if(!r)return;const amount=Number(this.paymentForm.amount||0),payDate=this.paymentForm.date||this.localDateKey();if(amount<=0){this.notify('请输入有效回款金额');return}if(!this.assertMonthUnlocked(String(payDate).slice(0,7),'登记该到账日期的回款'))return;const unpaid=this.financeReceivableUnpaid(r);if(amount>unpaid+0.0001){this.notify(`本次回款不能超过未收金额 ${this.formatMoney(unpaid,r.currency)}`);return}r.payments=Array.isArray(r.payments)?r.payments:[];r.payments.unshift({id:this.accountUid('pay'),date:payDate,amount,method:this.paymentForm.method||'',account:this.paymentForm.account||'',note:this.paymentForm.note||'',createdAt:new Date().toISOString()});r.paidAmount=this.financeReceivablePaid(r);this.persist();this.logAudit('新增回款流水',`${this.financeReceivableClientName(r)} · ${r.settlementMonth} · ${this.formatMoney(amount,r.currency)} · ${this.paymentForm.method||'未设置方式'}`);this.showPaymentModal=false;this.paymentTargetReceivable=null;this.notify('回款流水已保存，已收 / 未收金额已自动更新')},
    deleteReceivablePayment(r,pay){const target=this.financeReceivables.find(x=>x.id===r?.id)||r;if(!target||!pay)return;if(!this.assertMonthUnlocked(String(pay.date||'').slice(0,7),'删除该到账月份的回款'))return;this.askConfirm({title:'删除回款流水',message:`确定删除 ${pay.date} 的回款 ${this.formatMoney(pay.amount,target.currency)} 吗？删除后已收与未收金额会自动重新计算。`,confirmText:'确认删除'},()=>{target.payments=(target.payments||[]).filter(p=>p.id!==pay.id);target.paidAmount=this.financeReceivablePaid(target);if(this.receivableForm?.id===target.id)this.receivableForm=this.normalizeReceivable(target);this.persist();this.logAudit('删除回款流水',`${this.financeReceivableClientName(target)} · ${pay.date} · ${this.formatMoney(pay.amount,target.currency)}`);this.notify('回款流水已删除')})},
    deleteReceivable(r){if(!this.assertMonthUnlocked(r.settlementMonth,'删除收入项目'))return;if(this.financeReceivablePaid(r)>0){this.notify('该收入项目已有回款流水，不能直接删除。请保留记录或先删除回款流水。');return}const linked=this.receivableLinkedCost(r);if(linked&&this.isMonthLocked(String(linked.date||'').slice(0,7))){this.notify('关联项目成本所在月份已月结，不能删除该收入项目');return}this.askConfirm({title:'删除收入项目',message:`确定删除【${this.financeReceivableClientName(r)} · ${this.financeIncomeTypeText(r.incomeType)} · ${r.projectName||r.settlementMonth}】吗？关联的项目直接成本会同步删除。`,confirmText:'确认删除'},()=>{this.financeReceivables=this.financeReceivables.filter(x=>String(x.id)!==String(r.id));this.financeCosts=this.financeCosts.filter(c=>!(c.sourceType==='RECEIVABLE_ITEM'&&String(c.sourceId)===String(r.id)));this.persist();this.logAudit('删除收入项目',`${this.financeReceivableClientName(r)} · ${r.settlementMonth} · ${this.financeIncomeTypeText(r.incomeType)}`);this.notify('收入项目及关联成本已删除，净利润已重新计算')})},
    monthDueDate(month,day=25){const [y,m]=String(month).split('-').map(Number);if(!y||!m)return'';const last=new Date(y,m,0).getDate();return `${y}-${String(m).padStart(2,'0')}-${String(Math.min(Math.max(1,Number(day)||25),last)).padStart(2,'0')}`},
    monthSequence(startMonth,endMonth){const out=[];if(!/^\d{4}-\d{2}$/.test(String(startMonth||''))||!/^\d{4}-\d{2}$/.test(String(endMonth||''))||startMonth>endMonth)return out;let [y,m]=startMonth.split('-').map(Number);const [ey,em]=endMonth.split('-').map(Number);while(y<ey||(y===ey&&m<=em)){out.push(`${y}-${String(m).padStart(2,'0')}`);m++;if(m>12){m=1;y++}if(out.length>240)break}return out},
    clientAutoReceivableMonths(client,throughMonth=this.localDateKey().slice(0,7)){if(!client||client.archived||(client.billingMode||'FULL_MONTH')==='MANUAL'||Number(client.monthlyFee||0)<=0)return[];const start=String(client.startDate||throughMonth).slice(0,7);let end=throughMonth;if(client.endDate){const contractEnd=String(client.endDate).slice(0,7);if(contractEnd&&contractEnd<end)end=contractEnd}return this.monthSequence(start,end)},
    createReceivableForClientMonth(client,month,{allowFuture=false}={}){if(!client||client.archived||!month||(client.billingMode||'FULL_MONTH')==='MANUAL'||Number(client.monthlyFee||0)<=0||this.isMonthLocked(month))return 0;const current=this.localDateKey().slice(0,7);if(!allowFuture&&month>current)return 0;if(client.startDate&&month<String(client.startDate).slice(0,7))return 0;if(client.endDate&&month>String(client.endDate).slice(0,7))return 0;const currency=client.currency||'USD';if(this.financeReceivables.some(r=>String(r.clientId)===String(client.id)&&r.settlementMonth===month&&(r.currency||'USD')===currency&&(r.incomeType||'SERVICE_FEE')==='SERVICE_FEE'))return 0;const amount=this.financeServiceFeeForClientMonth(client,month);if(amount<=0)return 0;this.financeReceivables.push(this.normalizeReceivable({id:this.accountUid('ar'),ownerType:'CLIENT',clientId:String(client.id),payerName:'',settlementMonth:month,incomeType:'SERVICE_FEE',projectName:`${month} 投放服务费`,currency,amount,directCost:0,directCostDate:`${month}-01`,dueDate:this.monthDueDate(month,client.renewalAlertDay),invoiceStatus:'PENDING',invoiceNo:'',note:(client.billingMode||'FULL_MONTH')==='PRORATE'?'系统自动出账 · 按实际服务天数折算':'系统自动出账 · 整月服务费',payments:[],billSource:'AUTO_SERVICE_FEE',createdAt:new Date().toISOString()}));return 1},
    ensureClientFirstReceivable(client){if(!client||(client.billingMode||'FULL_MONTH')==='MANUAL')return 0;const firstMonth=String(client.startDate||this.localDateKey()).slice(0,7);return this.createReceivableForClientMonth(client,firstMonth,{allowFuture:true})},
    ensureAutomaticReceivables({clientId=null,silent=true}={}){const current=this.localDateKey().slice(0,7);let added=0;this.clients.filter(c=>!c.archived&&(!clientId||String(c.id)===String(clientId))).forEach(c=>{this.clientAutoReceivableMonths(c,current).forEach(month=>{added+=this.createReceivableForClientMonth(c,month)})});if(added){this.persist();this.logAudit('自动补齐应收账单',`截至 ${current} · 新增 ${added} 条`);if(!silent)this.notify(`已自动补齐 ${added} 条缺失应收账单`)}return added},
    financeReceivablesForClient(client){if(!client)return[];return this.financeReceivables.filter(r=>String(r.clientId)===String(client.id)&&this.financeSettlementMonthMatch(r.settlementMonth))},
    financeReceivableGroupsForClient(client){const g={};this.financeReceivablesForClient(client).forEach(r=>{const cur=r.currency||'USD';g[cur]=(g[cur]||0)+Number(r.amount||0)});return g},
    financePaidGroupsForClient(client){const g={};this.financeReceivablesForClient(client).forEach(r=>{const cur=r.currency||'USD';g[cur]=(g[cur]||0)+Math.min(Number(r.amount||0),this.financeReceivablePaid(r))});return g},
    generateReceivablesForPeriod(){const months=this.financePeriodMonths();if(months.some(m=>this.isMonthLocked(m))){this.notify('当前统计周期包含已月结月份，不能补生成账单');return}let added=0;months.forEach(month=>{this.clients.filter(c=>!c.archived).forEach(c=>{if(this.financeClientFilter!=='ALL'&&String(c.id)!==String(this.financeClientFilter))return;added+=this.createReceivableForClientMonth(c,month,{allowFuture:true})})});this.persist();this.logAudit('补生成应收账单',`${this.financePeriodLabel} · 新增 ${added} 条`);this.notify(added?`已补生成 ${added} 条应收账单`:'当前周期账单已完整，无需补生成')},
    syncOpeningFeeCost(deal,{silent=false}={}){if(!deal?.id)return 0;const existing=this.financeCosts.find(c=>c.sourceType==='OPENING_DEAL'&&String(c.sourceId)===String(deal.id));const should=deal.status==='OPENED'&&deal.clientId&&Number(deal.fee||0)>0;if(!should){if(existing&&!this.isMonthLocked(String(existing.date||'').slice(0,7)))this.financeCosts=this.financeCosts.filter(c=>String(c.id)!==String(existing.id));return 0}const date=deal.effectiveStartDate||deal.expectedDate||deal.submitDate||this.localDateKey(),month=String(date).slice(0,7);if(this.isMonthLocked(month)){if(!silent)this.notify(`开户费对应 ${month} 已月结，未自动改动历史成本`);return 0}const provider=this.openingProvider(deal);const payload=this.normalizeFinanceCost({id:existing?.id||this.accountUid('cost-opening'),date,category:'OPENING',scope:'CLIENT',clientId:String(deal.clientId),currency:deal.currency||'USD',amount:Number(deal.fee||0),vendor:provider?.name||deal.partnerName||'开户商',note:`开户渠道自动成本 · ${deal.platform==='TK'?'TikTok':'Facebook'} · ${deal.accountType||'广告账户'}`,sourceType:'OPENING_DEAL',sourceId:String(deal.id),autoGenerated:true});if(existing)Object.assign(existing,payload);else this.financeCosts.unshift(payload);return 1},
    ensureAutomaticAssetCosts({clientId=null,month=null,silent=true}={}){const targetMonth=month||this.localDateKey().slice(0,7);if(!targetMonth||this.isMonthLocked(targetMonth))return 0;let changed=0;const scopedClients=this.clients.filter(c=>!c.archived&&(!clientId||String(c.id)===String(clientId))),valid=new Set();scopedClients.forEach(client=>{if(!this.clientContractOverlapsMonth(client,targetMonth))return;(client.networkEnvironments||[]).forEach(env=>{const sourceId=`${client.id}:${env.id}:${targetMonth}`;if(env.autoCost===false||Number(env.ipMonthlyFee||0)<=0)return;valid.add(sourceId);const day=Number(String(env.ipDueDate||'').slice(8,10))||1,existing=this.financeCosts.find(c=>c.sourceType==='IP_ENV_MONTH'&&String(c.sourceId)===sourceId),payload=this.normalizeFinanceCost({id:existing?.id||this.accountUid('cost-ip'),date:this.monthDueDate(targetMonth,day),category:'IP',scope:'CLIENT',clientId:String(client.id),currency:env.ipCurrency||'USD',amount:Number(env.ipMonthlyFee||0),vendor:env.networkName||env.ipEnvironment||'IP / 网络',note:`系统自动生成 · ${env.networkName||env.ipEnvironment||'网络环境'} 月费`,sourceType:'IP_ENV_MONTH',sourceId,autoGenerated:true});if(existing){const before=JSON.stringify(existing);Object.assign(existing,payload);if(JSON.stringify(existing)!==before)changed++}else{this.financeCosts.unshift(payload);changed++}})});const scopedIds=new Set(scopedClients.map(c=>String(c.id)));const beforeLen=this.financeCosts.length;this.financeCosts=this.financeCosts.filter(cost=>{if(cost.sourceType!=='IP_ENV_MONTH'||String(cost.date||'').slice(0,7)!==targetMonth)return true;const sourceClient=String(cost.sourceId||'').split(':')[0];if(clientId&&sourceClient!==String(clientId))return true;if(!clientId&&!scopedIds.has(sourceClient))return true;return valid.has(String(cost.sourceId))});changed+=beforeLen-this.financeCosts.length;if(changed&&!silent){this.persist();this.notify(`已同步 ${changed} 条 IP / 网络月度成本`)}return changed},
    ensureAutomaticOpeningFeeCosts(){let changed=0;this.openingDeals.forEach(deal=>{if(deal.status==='OPENED'&&deal.clientId&&Number(deal.fee||0)>0)changed+=this.syncOpeningFeeCost(deal,{silent:true})});return changed},
    getFinanceMonthCheck(month){if(!month)return{missingBills:0,pendingReconciliations:0,unmatchedChannels:0,unassignedSpendTotal:0,unassignedSpendText:'$0',unallocatedTotal:0,unallocatedText:'$0',issues:[]};const eligible=this.clients.filter(c=>!c.archived&&(c.billingMode||'FULL_MONTH')!=='MANUAL'&&Number(c.monthlyFee||0)>0&&this.clientContractOverlapsMonth(c,month));const missingBills=eligible.filter(c=>!this.financeReceivables.some(r=>String(r.clientId)===String(c.id)&&String(r.settlementMonth)===String(month)&&(r.currency||'USD')===(c.currency||'USD')&&(r.incomeType||'SERVICE_FEE')==='SERVICE_FEE')).length;const channelPairs=[];this.financeRebateChannelOptions.forEach(opt=>{const spend=this.financeSpendForChannelMonth(opt.providerId,opt.contactId,month);Object.entries(spend).forEach(([currency,amount])=>{if(Number(amount||0)>0)channelPairs.push({opt,currency,amount:Number(amount||0)})})});const pendingReconciliations=channelPairs.filter(x=>!this.financeReconciliations.some(r=>r.status!=='VOID'&&String(r.providerId)===String(x.opt.providerId)&&String(r.contactId||'')===String(x.opt.contactId||'')&&String(r.settlementMonth)===String(month)&&(r.currency||'USD')===x.currency)).length;const unmatchedChannels=this.openingDeals.filter(d=>d.status==='OPENED'&&this.openingDealOverlapsMonth(d,month)&&d.clientId&&this.openingDealUnmatchedIds(d).length).length;const unassignedSpend=this.financeUnassignedSpendGroupsForMonth(month),unassignedSpendTotal=Object.values(unassignedSpend).reduce((a,b)=>a+Math.abs(Number(b||0)),0);const unallocated={};this.financeReconciliations.filter(r=>r.status!=='VOID'&&String(r.settlementMonth)===String(month)).forEach(r=>{const total=Number(r.actualRebate||0),allocated=this.clients.reduce((sum,c)=>sum+this.financeActualRebateClientShare(r,c),0),diff=Math.max(0,total-allocated);if(diff>0.005)unallocated[r.currency||'USD']=(unallocated[r.currency||'USD']||0)+diff});const unallocatedTotal=Object.values(unallocated).reduce((a,b)=>a+Math.abs(Number(b||0)),0),issues=[];if(missingBills)issues.push(`缺少 ${missingBills} 个客户应收账单`);if(pendingReconciliations)issues.push(`还有 ${pendingReconciliations} 个渠道 / 币种待返点对账`);if(unmatchedChannels)issues.push(`有 ${unmatchedChannels} 条已开户渠道账号映射异常`);if(unassignedSpendTotal>0.01)issues.push(`存在应有返点但未归属渠道的广告消耗 ${this.spendGroupsText(unassignedSpend)}`);if(unallocatedTotal>0.01)issues.push(`存在未归集实际返点 ${this.spendGroupsText(unallocated)}`);return{missingBills,pendingReconciliations,unmatchedChannels,unassignedSpendTotal,unassignedSpendText:this.spendGroupsText(unassignedSpend),unallocatedTotal,unallocatedText:this.spendGroupsText(unallocated),issues}},
    financeGroupAdd(target,source){Object.entries(source||{}).forEach(([cur,val])=>target[cur]=(target[cur]||0)+Number(val||0));return target},
    financeReceivableGroupsForMonth(month,clientId=null){const g={};this.financeReceivables.filter(r=>String(r.settlementMonth)===String(month)&&(clientId===null||clientId===undefined||String(r.clientId)===String(clientId))).forEach(r=>{const cur=r.currency||'USD';g[cur]=(g[cur]||0)+Number(r.amount||0)});return g},
    financeDirectClientCostGroupsForMonth(month,clientId=null){const g={};this.financeCosts.filter(c=>String(c.date||'').slice(0,7)===String(month)&&(c.scope||(c.clientId?'CLIENT':'COMPANY'))==='CLIENT'&&(clientId===null||clientId===undefined||String(c.clientId)===String(clientId))).forEach(c=>{const cur=c.currency||'USD';g[cur]=(g[cur]||0)+Number(c.amount||0)});return g},
    financeClientCostGroupsForMonth(client,month){const g={};this.financeCosts.filter(c=>String(c.date||'').slice(0,7)===String(month)).forEach(cost=>{const amount=this.financeCostAllocatedAmountForClient(cost,client);if(Math.abs(amount)>0.000001){const cur=cost.currency||'USD';g[cur]=(g[cur]||0)+amount}});return g},
    financeExpectedRebateGroupsForClientMonth(client,month){const g={};if(!client)return g;[['FB',client.fbAccounts||[]],['TK',client.tkAccounts||[]]].forEach(([platform,accounts])=>accounts.forEach(account=>(account.adDataRecords||[]).filter(r=>String(r.date||'').slice(0,7)===String(month)).forEach(r=>{if(this.accountRebateMode(account)!=='CHANNEL')return;const owner=this.openingDealOwnerForRecord(client.id,platform,account,r.date);if(!owner)return;const cur=r.currency||account.adSpendCurrency||'USD',amount=Number(r.spend||0),rate=Number(this.openingDealRebateRate(owner,r.date)||0);g[cur]=(g[cur]||0)+amount*rate/100}))