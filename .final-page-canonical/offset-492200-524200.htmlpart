    syncLegacyAccountFields(c){const fb=(c.fbAccounts||[])[0]||{};const tk=(c.tkAccounts||[])[0]||{};c.fbBmId=fb.bmId||'';c.fbAdAccountId=fb.adAccountId||'';c.fbLoginAccount=fb.loginAccount||'';c.fbLoginPassword=fb.loginPassword||'';c.tkBcId=tk.bcId||'';c.tkAdAccountId=tk.adAccountId||'';c.tkLoginAccount=tk.loginAccount||'';c.tkLoginPassword=tk.loginPassword||'';return c},
    syncLegacyNetworkFields(c){const env=(c.networkEnvironments||[])[0]||{};c.networkName=env.networkName||'';c.ipEnvironment=env.ipEnvironment||'';c.ipDueDate=env.ipDueDate||'';c.ipCurrency=env.ipCurrency||'USD';c.ipMonthlyFee=env.ipMonthlyFee??'';return c},
    cleanPlatformAccounts(c){const hasFb=a=>[a.accountName,a.bmId,a.adAccountId,a.loginAccount,a.loginPassword].some(v=>String(v??'').trim());const hasTk=a=>[a.accountName,a.bcId,a.adAccountId,a.loginAccount,a.loginPassword].some(v=>String(v??'').trim());c.fbAccounts=(c.fbAccounts||[]).filter(hasFb);c.tkAccounts=(c.tkAccounts||[]).filter(hasTk);return this.syncLegacyAccountFields(c)},
    cleanNetworkEnvironments(c){const hasEnv=e=>[e.networkName,e.ipEnvironment,e.ipDueDat