ct){this.reconciliationForm.channelKey='';this.reconciliationForm.id=null;this.reconciliationForm.confirmedSpend='';this.reconciliationForm.actualRebate='';return}this.reconciliationForm.providerId=String(provider.id);this.reconciliationForm.contactId=String(contact.id);this.reconciliationForm.channelKey=`${provider.id}|${contact.id}`;const existing=this.financeReconciliations.find(r=>String(r.providerId)===String(provider.id)&&String(r.contactId)===String(contact.id)&&r.settlementMonth===this.reconciliationForm.settlementMonth&&(r.currency||'USD')===(this.reconciliationForm.currency||'USD'));if(existing){const keep={providerId:this.reconciliationForm.providerId,contactId:this.reconciliationForm.contactId,channelKey:this.reconciliationForm.channelKey,settlementMonth:this.reconciliationForm.settlementMonth,currency:this.reconciliationForm.currency};this.reconciliationForm={...this.reconciliationForm,...JSON.parse(JSON.stringify(existing)),...keep}}else{this.reconciliationForm.id=null;this.reconciliationForm.confirmedSpend=this.reconciliationSystemSpend;this.reconciliationForm.actualRebate=this.reconciliationExpectedRebate}},
    saveReconciliation(){const f=this.reconciliationForm,o=this.reconciliationSelectedOption;if(!o||!f.settlementMonth){this.notify('请选择开户商、对接人和结算月份');return}if(!this.assertMonthUnlocked(f.settlementMonth,'确认返点对账'))return;const confirmedSpend=Number(f.confirmedSpend),actualRebate=Number(f.actualRebate);if(!Number.isFinite(confirmedSpend)||!Number.isFinite(actualRebate)||confirmedSpend<0||actualRebate<0){this.notify('请输入有效的确认消耗和返点');return}const payload={id:f.id||this.accountUid('recon'),providerId:o.providerId,contactId:o.contactId,settlementMonth:f.settlementMonth,currency:f.currency||'USD',confirmedSpend,actualRebate,systemSpend:this.reconciliationSystemSpend,expectedRebate:this.reconciliationExpectedRebate,confirmedDate:f.confirmedDate||this.localDateKey(),note:f.note||'',status:'CONFIRMED',updatedAt:new Date().toISOString()};const idx=this.financeReconciliations.findIndex(r=>String(r.providerId)===String(payload.providerId)&&String(r.contactId)===String(payload.contactId)&&r.settlementMonth===payload.settlementMonth&&(r.currency||'USD')===payload.currency);if(idx>=0){payload.id=this.financeReconciliations[idx].id;this.financeReconciliations[idx]=payload}else this.financeReconciliations.unshift(payload);this.financeActualRebates=this.financeActualRebates.filter(r=>!(String(r.providerId)===String(payload.providerId)&&String(r.contactId)===String(payload.contactId)&&String(r.settlementMonth)===String(payload.settlementMonth)&&(r.currency||'USD')===payload.currency));this.persist();this.showReconciliationModal=false;this.logAudit('代理商返点对账',`${o.provider.name} / ${o.contact.name} · ${payload.settlementMonth} · 消耗 ${this.formatMoney(confirmedSpend,payload.currency)} · 返点 ${this.formatMoney(actualRebate,payload.currency)}`);this.notify('代理商对账已确认，实际返点归集和净利润已自动更新')},
    voidReconciliation(row){const rec=row?.record;if(!rec||rec.status==='VOID')return;if(!this.assertMonthUnlocked(rec.settlementMonth,'撤销返点对账'))return;this.askConfirm({title:'撤销返点对账',message:`确定撤销 ${row.providerName} / ${row.contactName} · ${rec.settlementMonth} 的返点对账吗？实际返点将从财务利润中移除。`,confirmText:'确认撤销',tone:'warning'},()=>{rec.status='VOID';rec.voidedAt=new Date().toISOString();rec.voidedBy=this.currentUser?.name||'';this.financeActualRebates=this.financeActualRebates.filter(r=>!(String(r.providerId)===String(rec.providerId)&&String(r.contactId)===String(rec.contactId)&&r.settlementMonth===rec.settlementMonth&&(r.currency||'USD')===(rec.currency||'USD')));this.persist();this.logAudit('撤销代理商返点对账',`${row.providerName} / ${row.contactName} · ${rec.settlementMonth}`);this.notify('返点对账已撤销，实际返点与利润已重新计算')})},
    navigateTo(page){if(this.currentPage==='client-form'&&page!=='client-form'&&this.formDirty){this.askConfirm({title:'离开客户编辑',message:'客户资料还有未保存修改，离开后本次修改不会保存。确定离开吗？',confirmText:'确认离开',tone:'warning'},()=>{this.formDirty=false;this.navigateTo(page)});return}if(!this.canViewPage(page)){this.notify('当前角色没有访问该页面的权限');return}if(page==='assets'&&!this.clients.some(c=>c.id===this.selectedAssetsClientId))this.selectedAssetsClientId=this.clients[0]?.id||null;if(page==='analytics'){if(!this.clients.some(c=>c.id===this.selectedAnalyticsClientId))this.selectedAnalyticsClientId=this.clients[0]?.id||null;this.syncAnalyticsAccountSelection()}if(page==='ads'){if(!this.clients.some(c=>c.id===this.selectedAdsClientId))this.selectedAdsClientId=this.clients[0]?.id||null;this.syncAdsAccountSelection()}if(page==='finance'){this.ensureAutomaticReceivables({silent:true});(this.financePeriodMonths()||[]).forEach(month=>this.ensureAutomaticAssetCosts({month,silent:true}));this.persist()}this.currentPage=page;window.location.hash=page;window.scrollTo({top:0,behavior:'smooth'});if(page==='sop')this.syncSopAccountSelection()},
    openClientDetail(id){this.selectedClientId=id;this.credentialsVisible=false;this.resetAssetPager('detail');this.navigateTo('client-detail')},
    defaultAssetPagerScope(){return{FB:0,TK:0,GOOGLE:0,INSTAGRAM:0}},
    resetAssetPager(scope){this.assetPager=this.assetPager||{};this.assetPager[scope]={...this.defaultAssetPagerScope()}},
    clampedAssetPagerIndex(scope,key,total){const max=Math.max(0,Number(total||0)-1),cur=Number((((this.assetPager||{})[scope]||{})[key])||0);return Math.min(Math.max(0,Number.isFinite(cur)?cur:0),max)},
    changeAssetPager(scope,key,delta,total){this.assetPager=this.assetPager||{};if(!this.assetPager[scope])this.assetPager[scope]={...this.defaultAssetPagerScope()};const max=Math.max(0,Number(total||0)-1),next=this.clampedAssetPagerIndex(scope,key,total)+Number(delta||0);this.assetPager[scope][key]=Math.min(Math.max(0,next),max)},
    setAssetPagerIndex(scope,key,index,total){this.assetPager=this.assetPager||{};if(!this.assetPager[scope])this.assetPager[scope]={...this.defaultAssetPagerScope()};const max=Math.max(0,Number(total||0)-1),next=Number(index||0);this.assetPager[scope][key]=Math.min(Math.max(0,Number.isFinite(next)?next:0),max)},
    getPagedItem(list,scope,key){const arr=Array.isArray(list)?list:[];if(!arr.length)return null;return arr[this.clampedAssetPagerIndex(scope,key,arr.length)]||arr[0]||null},
    accountUid(prefix){return `${prefix}-${Date.now()}-${Math.random().toString(36).slice(2,8)}`},
    emptyFbAccount(){return{id:this.accountUid('fb'),accountName:'',bmId:'',adAccountId:'',rebateMode:'CHANNEL',adSpendCurrency:'USD',adSpend:'',nextRechargeDate:'',nextRechargeCurrency:'USD',nextRechargeAmount:'',rechargeHistory:[],loginAccount:'',loginPassword:''}},
    emptyTkAccount(){return{id:this.accountUid('tk'),accountName:'',bcId:'',adAccountId:'',rebateMode:'CHANNEL',adSpendCurrency:'USD',adSpend:'',nextRechargeDate:'',nextRechargeCurrency:'USD',nextRechargeAmount:'',rechargeHistory:[],loginAccount:'',loginPassword:''}},
    defaultExternalAssetForm(type='GOOGLE'){return type==='GOOGLE'?{id:null,accountName:'',customerId:'',mccId:'',username:'',profileId:'',loginAccount:'',loginPassword:'',note:''}:{id:null,accountName:'',customerId:'',mccId:'',username:'',profileId:'',loginAccount:'',loginPassword:'',note:''}},
    openExternalAssetModal(type,account=null){if(!this.canManageAssets()){this.notify('当前角色没有维护账号资产的权限');return}if(!this.selectedAssetsClient){this.notify('请先选择客户');return}this.externalAssetType=type==='INSTAGRAM'?'INSTAGRAM':'GOOGLE';this.externalAssetForm=account?{...this.defaultExternalAssetForm(this.externalAssetType),...JSON.parse(JSON.stringify(account))}:this.defaultExternalAssetForm(this.externalAssetType);this.showExternalAssetModal=true},
    saveExternalAsset(){if(!this.canManageAssets()){this.notify('当前角色没有维护账号资产的权限');return}const client=this.clients.find(c=>String(c.id)===String(this.selectedAssetsClientId));if(!client){this.notify('当前客户不存在');return}const type=this.externalAssetType==='INSTAGRAM'?'INSTAGRAM':'GOOGLE',key=type==='GOOGLE'?'googleAccounts':'instagramAccounts',label=type==='GOOGLE'?'Google':'Instagram';const f={...this.defaultExternalAssetForm(type),...JSON.parse(JSON.stringify(this.externalAssetForm)),accountName:String(this.externalAssetForm.accountName||'').trim(),loginAccount:String(this.externalAssetForm.loginAccount||'').trim(),note:String(this.externalAssetForm.note||'').trim()};if(!f.accountName){this.notify('请填写账号名称');return}client[key]=Array.isArray(client[key])?client[key]:[];const isEdit=!!f.id;if(isEdit){const i=client[key].findIndex(a=>String(a.id)===String(f.id));if(i>=0)client[key][i]=f;else client[key].unshift({...f,id:this.accountUid(type==='GOOGLE'?'google':'ig')})}else client[key].unshift({...f,id:this.accountUid(type==='GOOGLE'?'google':'ig')});this.persist();this.showExternalAssetModal=false;this.logAudit(isEdit?`修改 ${label} 账号`:`新增 ${label} 账号`,`${client.name} · ${f.accountName}`);this.notify(`${label} 账号已保存`)},
    deleteExternalAsset(type,account){if(!this.canManageAssets()){this.notify('当前角色没有维护账号资产的权限');return}const client=this.clients.find(c=>String(c.id)===String(this.selectedAssetsClientId));if(!client||!account)return;const isGoogle=type==='GOOGLE',key=isGoogle?'googleAccounts':'instagramAccounts',label=isGoogle?'Google':'Instagram';this.askConfirm({title:`删除 ${label} 账号`,message:`确定删除【${account.accountName||label+' 账号'}】吗？\n该操作只删除当前客户的这条 ${label} 账号资产，不影响 Facebook / TikTok 及其他客户资料。`,confirmText:'确认删除'},()=>{client[key]=(client[key]||[]).filter(a=>String(a.id)!==String(account.id));this.persist();this.logAudit(`删除 ${label} 账号`,`${client.name} · ${account.accountName||''}`);this.notify(`${label} 账号已删除`)})},
    emptyNetworkEnvironment(){return{id:this.accountUid('net'),networkName:'',ipEnvironment:'',ipDueDate:'',ipCurrency:'USD',ipMonthlyFee:'',autoCost:true}},
    migrateLegacyAccountSpendRecords(){let migrated=0;this.clients.forEach(client=>{[['FB',client.fbAccounts||[]],['TK',client.tkAccounts||[]]].forEach(([platform,accounts])=>accounts.forEach(account=>{account.adDataRecords=Array.isArray(account.adDataRecords)?account.adDataRecords:[];if(account.adDataRecords.length||Number(account.adSpend||0)<=0)return;const currency=account.adSpendCurrency||'USD',date=this.localDateKey();account.adDataRecords.push({id:this.accountUid('data-legacy'),date,campaignId:'',campaignName:'',planName:'旧版累计消耗迁移',adSetId:'',adSetName:'',adId:'',adName:'',currency,spend:Number(account.adSpend||0),impressions:0,reach:0,clicks:0,leads:0,conversions:0,revenue:0,video3sRate:null,video25Rate:null,video50Rate:null,video75Rate:null,video95Rate:null,videoCompleteRate:null,note:`系统迁移：旧版${platform}累计消耗无日期，已归入 ${date}；如需精确历史月份，请编辑该条广告数据日期。`,createdAt:new Date().toISOString(),updatedAt:new Date().toISOString(),legacySpendMigration:true});migrated++}))});if(migrated)this.logAudit('迁移旧版广告消耗',`${migrated} 个广告账户旧版累计消耗已转换为统一广告数据记录`);return migrated},
    normalizeAdDataRecords(records){
      const normalized=(Array.isArray(records)?records:[]).map(r=>({
        id:r.id||this.accountUid('data'),date:r.date||this.localDateKey(),campaignId:r.campaignId||'',campaignName:r.campaignName||'',planName:r.planName||'',adSetId:r.adSetId||'',adSetName:r.adSetName||'',adId:r.adId||'',adName:r.adName||'',currency:r.currency||'USD',spend:Number(r.spend||0),impressions:Number(r.impressions||0),reach:Number(r.reach||0),clicks:Number(r.clicks||0),leads:Number(r.leads||0),conversions:Number(r.conversions||0),revenue:Number(r.revenue||0),video3sRate:this.optionalNumber(r.video3sRate),video25Rate:this.optionalNumber(r.video25Rate),video50Rate:this.optionalNumber(r.video50Rate),video75Rate:this.optionalNumber(r.video75Rate),video95Rate:this.optionalNumber(r.video95Rate),videoCompleteRate:this.optionalNumber(r.videoCompleteRate),note:r.note||'',createdAt:r.createdAt||'',updatedAt:r.updatedAt||r.createdAt||''
      }));
      const unique=new Map();
      normalized.forEach(record=>{
        const key=[record.date||'',record.campaignId||'',record.adSetId||'',record.adId||''].join('|');
        const previous=unique.get(key);
        if(!previous){unique.set(key,record);return}
        const prevTime=String(previous.updatedAt||previous.createdAt||'');
        const nextTime=String(record.updatedAt||record.createdAt||'');
        if(nextTime>prevTime)unique.set(key,record);
      });
      return [...unique.values()];
    },
