eAutomaticReceivables({silent:true});this.ensureAutomaticAssetCosts({month:monthKey,silent:true});const check=this.runFinanceMonthCheck(monthKey,false);if(check.issues.length){this.notify(`月结检查未通过：${check.issues.join('；')}`);return}this.askConfirm({title:'完成财务月结',message:`${monthKey} 月结检查已通过。确定完成月结吗？系统会冻结该月收入、广告消耗、返点、成本与利润口径；以后仍可按实际到账日期登记跨月回款。`,confirmText:'确认月结',tone:'warning'},()=>{const snapshot=this.buildFinanceMonthSnapshot(monthKey);this.financeMonthSnapshots[monthKey]=snapshot;this.financeMonthLocks[monthKey]={lockedAt:new Date().toISOString(),lockedBy:this.currentUser?.name||'',snapshotAt:snapshot.createdAt};this.persist();this.logAudit('完成财务月结',`${monthKey} · 已生成冻结快照`);this.notify(`${monthKey} 已完成月结，历史利润口径已冻结`)})}},
    openReconciliationModal(row=null){this.reconciliationForm=this.defaultReconciliationForm();if(row){const rec=row.record;this.reconciliationForm={...this.reconciliationForm,...(rec?JSON.parse(JSON.stringify(rec)):{}),providerId:String(row.providerId||''),contactId:String(row.contactId||''),channelKey:`${row.providerId}|${row.contactId}`,settlementMonth:row.month,currency:row.currency,confirmedSpend:rec?.confirmedSpend??row.systemSpend,actualRebate:rec?.actualRebate??row.expectedRebate};this.syncReconciliationForm()}this.showReconciliationModal=true},
    openReconciliationHistoryEntry(entry){if(!entry)return;const currency=entry.currency||'USD',spendGroups=this.financeSpendForChannelMonth(entry.providerId,entry.contactId,entry.settlementMonth),expectedGroups=this.financeExpectedRebateForChannelMonth(entry.providerId,entry.contactId,entry.settlementMonth);this.openReconciliationModal({record:entry,providerId:entry.providerId,contactId:entry.contactId,month:entry.settlementMonth,currency,systemSpend:Number(entry.systemSpend??spendGroups[currency]??0),expectedRebate:Number(entry.expectedRebate??expectedGroups[currency]??0)})},
    syncReconciliationChannel(){const option=this.financeRebateChannelOptions.find(o=>String(o.key)===String(this.reconciliationForm.channelKey||''));this.reconciliationForm.providerId=option?String(option.providerId):'';this.reconciliationForm.contactId=option?String(option.contactId):'';this.syncReconciliationForm()},
    syncReconciliationProvider(){this.reconciliationForm.contactId='';this.reconciliationForm.channelKey='';this.reconciliationForm.id=null;this.reconciliationForm.confirmedSpend='';this.reconciliationForm.actualRebate=''},
    syncReconciliationContact(){this.reconciliationForm.channelKey=this.reconciliationForm.providerId&&this.reconciliationForm.contactId?`${this.reconciliationForm.providerId}|${this.reconciliationForm.contactId}`:'';this.syncReconciliationForm()},
    syncReconciliationForm(){const provider=this.openingProviders.find(p=>String(p.id)===String(this.reconciliationForm.providerId||''));const contact=provider?.contacts?.find(c=>String(c.id)===String(this.reconciliationForm.contactId||''));if(!provider||!contact){this.reconciliationForm.channelKey='';this.reconciliationForm.id=null;this.reconciliationForm.confirmedSpend='';this.reconciliationForm.actualRebate='';return}this.reconciliationForm.providerId=String(provider.id);this.reconciliationForm.contactId=String(contact.id);this.reconciliationForm.channelKey=`${provider.id}|${contact.id}`;const existing=this.financeReconciliations.find(r=>String(r.providerId)===String(provider.id)&&String(r.contactId)===String(contact.id)&&r.settlementMonth===this.reconciliationForm.settlementMonth&&(r.currency||'USD')===(this.reconciliationForm.currency||'USD'));if(existing){const keep={providerId:this.reconciliationForm.providerId,contactId:this.reconciliationForm.contactId,channelKey:this.reconciliationForm.channelKey,settlementMonth:this.reconciliationForm.settlementMonth,currency:this.reconciliationForm.currency};this.reconciliationForm={...this.reconciliationForm,...JSON.parse(JSON.stringify(existing)),...keep}}else{this.reconciliationForm.id=null;this.reconciliationForm.confirmedSpend=this.reconciliationSystemSpend;this.reconciliationForm.actualRebate=this.reconciliationExpectedRebate}},
    saveReconciliation(){const f=this.reconciliationForm,o=this.reconciliationSelectedOption;if(!o||!f.settlementMonth){this.notify('请选择开户商、对接人和结算月份');return}if(!this.assertMonthUnlocked(f.settlementMonth,'确认返点对账'))return;const confirmedSpend=Number(f.confirmedSpend),actualRebate=Number(f.actualRebate);if(!Number.isFinite(confirmedSpend)||!Number.isFinite(actualRebate)||confirmedSpend<0||actualRebate<0){this.notify('请输入有效的确认消耗和返点');return}const payload={id:f.id||this.accountUid('recon'),providerId:o.providerId,contactId:o.contactId,settlementMonth:f.settlementMonth,currency:f.currency||'USD',confirmedSpend,actualRebate,systemSpend:this.reconciliationSystemSpend,expectedRebate:this.reconciliationExpectedRebate,confirmedDate:f.confirmedDate||this.localDateKey(),note:f.note||'',status:'CONFIRMED',updatedAt:new Date().toISOString()};const idx=this.financeReconciliations.findIndex(r=>String(r.providerId)===String(payload.providerId)&&String(r.contactId)===String(payload.contactId)&&r.settlementMonth===payload.settlementMonth&&(r.currency||'USD')===payload.currency);if(idx>=0){payload.id=this.financeReconciliations[idx].id;this.financeReconciliations[idx]=payload}else this.financeReconciliations.unshift(payload);this.financeActualRebates=this.financeActualRebates.filter(r=>!(String(r.providerId)===String(payload.providerId)&&String(r.contactId)===String(payload.contactId)&&String(r.settlementMonth)===String(payload.settlementMonth)&&(r.currency||'USD')===payload.currency));this.persist();this.showReconciliationModal=false;this.logAudit('代理商返点对账',`${o.provider.name} / ${o.contact.name} · ${payload.settlementMonth} · 消耗 ${this.formatMoney(confirmedSpend,payload.currency)} · 返点 ${this.formatMoney(actualRebate,payload.currency)}`);this.notify('代理商对账已确认，实际返点归集和净利润已自动更新')},
    voidReconciliation(row){const rec=row?.record;if(!rec||rec.status==='VOID')return;if(!this.assertMonthUnlocked(rec.settlementMonth,'撤销返点对账'))return;this.askConfirm({title:'撤销返点对账',message:`确定撤销 ${row.providerName} / ${row.contactName} · ${rec.settlementMonth} 的返点对账吗？实际返点将从财务利润中移除。`,confirmText:'确认撤销',tone:'warning'},()=>{rec.status='VOID';rec.voidedAt=new Date().toISOString();rec.voidedBy=this.currentUser?.name||'';this.financeActualRebates=this.financeActualRebates.filter(r=>!(String(r.providerId)===String(rec.providerId)&&String(r.contactId)===String(rec.contactId)&&r.settlementMonth===rec.settlementMonth&&(r.currency||'USD')===(rec.currency||'USD')));this.persist();this.logAudit('撤销代理商返点对账',`${row.providerName} / ${row.contactName} · ${rec.settlementMonth}`);this.notify('返点对账已撤销，实际返点与利润已重新计算')})},
    navigateTo(page){if(this.currentPage==='client-form'&&page!=='client-form'&&this.formDirty){this.askConfirm({title:'离开客户编辑',message:'客户资料还有未保存修改，离开后本次修改不会保存。确定离开吗？',confirmText:'确认离开',tone:'warning'},()=>{this.formDirty=false;this.navigateTo(page)});return}if(!this.canViewPage(page)){this.notify('当前角色没有访问该页面的权限');return}if(page==='assets'&&!this.clients.some(c=>c.id===this.selectedAssetsClientId))this.selectedAssetsClientId=this.clients[0]?.id||null;if(page==='analytics'){if(!this.clients.some(c=>c.id===this.selectedAnalyticsClientId))this.selectedAnalyticsClientId=this.clients[0]?.id||null;this.syncAnalyticsAccountSelection()}if(page==='ads'){if(!this.clients.some(c=>c.id===this.selectedAdsCli