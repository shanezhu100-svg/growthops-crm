key]=Array.isArray(client[key])?client[key]:[];const isEdit=!!f.id;if(isEdit){const i=client[key].findIndex(a=>String(a.id)===String(f.id));if(i>=0)client[key][i]=f;else client[key].unshift({...f,id:this.accountUid(type==='GOOGLE'?'google':'ig')})}else client[key].unshift({...f,id:this.accountUid(type==='GOOGLE'?'google':'ig')});this.persist();this.showExternalAssetModal=false;this.logAudit(isEdit?`修改 ${label} 账号`:`新增 ${label} 账号`,`${client.name} · ${f.accountName}`);this.notify(`${label} 账号已保存`)},
    deleteExternalAsset(type,account){if(!this.canManageAssets()){this.notify('当前角色没有维护账号资产的权限');return}const client=this.clients.find(c=>String(c.id)===String(this.selectedAssetsClientId));if(!client||!account)return;const isGoogle=type==='GOOGLE',key=isGoogle?'googleAccounts':'instagramAccounts',label=isGoogle?'Google':'Instagram';this.askConfirm({title:`删除 ${label} 账号`,message:`确定删除【${account.accountName||label+' 账号'}】吗？\n该操作只删除当前客户的这条 ${label} 账号资产，不影响 Facebook / TikTok 及其他客户资料。`,confirmText:'确认删除'},()=>{client[key]=(client[key]||[]).filter(a=>String(a.id)!==String(account.id));this.persist();this.logAudit(`删除 ${label} 账号`,`${client.name} · ${account.accountName||''}`);this.notify(`${label} 账号已删除`)})},
    emptyNetworkEnvironment(){return{id:this.accountUid('net'),networkName:'',ipEnvironment:'',ipDueDate:'',ipCurrency:'USD',ipMonthlyFee:'',autoCost:true}},
    migrateLegacyAccountSpendRecords(){let migrated=0;this.clients.forEach(client=>{[['FB',client.fbAccounts||[]],['TK',client.tkAccounts||[]]].forEach(([platform,accounts])=>accounts.forEach(account=>{account.adDataRecords=Array.isArray(account.adDataRecords)?account.adDataRecords:[];if(account.adDataRecords.length||Number(account.adSpend||0)<=0)return;const currency=account.adSpendCurrency||'USD',date=this.localDateKey();account.adDataRecords.push({id:this.accountUid('data-legacy'),date,campaignId:'',campaignName:'',planName:'旧版累计消耗迁移',adSetId:'',adSetName:'',adId:'',adName:'',currency,spend:Number(account.adSpend||0),impressions:0,reach:0,clicks:0,leads:0,conversions:0,revenue:0,video3sRate:null,video25Rate:null,video50Rate:null,video75Rate:null,video95Rate:null,videoCompleteRate:null,note:`系统迁移：旧版${platform}累计消耗无日期，已归入 ${date}；如需精确历史月份，请编辑该条广告数据日期。`,createdAt:new Date().toISOString(),updatedAt:new Date().toISOString(),legacySpendMigration:true});migrated++}))});if(migrated)this.logAudit('迁移旧版广告消耗',`${migrated} 个广告账户旧版累计消耗已转换为统一广告数据记录`);return migrated},
    normalizeAdDataRecords(records){
      const normalized=(Array.isArray(records)?records:[]).map(r=>({
        id:r.id||this.accountUid('data'),date:r.date||this.localDateKey(),campaignId:r.campaignId||'',campaignName:r.campaignName||'',planName:r.planName||'',adSetId:r.adSetId||'',adSetName:r.adSetName||'',adId:r.adId||'',adName:r.adName||'',currency:r.currency||'USD',spend:Number(r.spend||0),impressions:Number(r.impressions||0),reach:Number(r.reach||0),clicks:Number(r.clicks||0),leads:Number(r.leads||0),conversions:Number(r.conversions||0),revenue:Number(r.revenue||0),video3sRate:this.optionalNumber(r.video3sRate),video25Rate:this.optionalNumber(r.video25Rate),video50Rate:this.optionalNumber(r.video50Rate),video75Rate:this.optionalNumber(r.video75Rate),video95Rate:this.optionalNumber(r.video95Rate),videoCompleteRate:this.optionalNumber(r.videoCompleteRate),note:r.note||'',createdAt:r.createdAt||'',updatedAt:r.updatedAt||r.createdAt||''
      }));
      const unique=new Map();
      normalized.forEach(record=>{
        const key=[record.date||'',record.campaignId||'',record.adSetId||'',record.adId||''].join('|');
        const previous=unique.get(key);
        if(!previous){unique.set(key,record);