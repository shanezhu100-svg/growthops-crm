e,e.ipMonthlyFee].some(v=>String(v??'').trim());c.networkEnvironments=(c.networkEnvironments||[]).filter(hasEnv);return this.syncLegacyNetworkFields(c)},
    addPlatformAccount(platform){if(platform==='FB'){this.form.fbAccounts=this.form.fbAccounts||[];this.form.fbAccounts.push(this.emptyFbAccount())}else{this.form.tkAccounts=this.form.tkAccounts||[];this.form.tkAccounts.push(this.emptyTkAccount())}},
    removePlatformAccount(platform,index){const key=platform==='FB'?'fbAccounts':'tkAccounts';const list=this.form[key]||[];const account=list[index];if(!account)return;const displayName=account.accountName||`${platform==='FB'?'Facebook':'TikTok'} 账号 ${index+1}`;if(this.form.id){const adRecords=(account.adDataRecords||[]).length,campaigns=(this.form.adCampaigns||[]).filter(c=>String(c.accountId)===String(account.id)).length,tools=this.mediaTools.filter(t=>(t.bindings||[]).some(b=>String(b.clientId)===String(this.form.id)&&String(b.accountKey)===`${platform}:${account.id}`)).length,openings=this.openingDeals.filter(d=>String(d.clientId)===String(this.form.id)&&String(d.platform)===platform&&String(d.adAccountIds||'').split(/[,，\s]+/).filter(Boolean).includes(String(account.adAccountId||''))).length;if(adRecords+campaigns+tools+openings>0){this.notify(`删除受保护：【${displayName}】仍关联 ${adRecords} 条广告数据、${campaigns} 个广告方案、${openings} 条开户记录、${tools} 个工具绑定。请先迁移或解除关联后再删除。`);return}}const removeNow=()=>{list.splice(index,1);this.formDirty=true;this.notify(`账号【${displayName}】已从当前编辑资料中移除，保存客户后生效`)};const values=platform==='FB'?[account.accountName,account.bmId,account.adAccountId,account.loginAccount,account.loginPassword]:[account.accountName,account.bcId,account.adAccountId,account.loginAccount,account.loginPassword];if(values.some(v=>String(v||'').trim()))this.askConfirm({title:'删除账号资产',message:`确定删除【${displayName}】这组账号资料吗？保存客户后生效。`,confirmText:'确认删除'},removeNow);else removeNow()},
    addNetworkEnvironment(){this.form.networkEnvironments=this.form.networkEnvironments||[];this.form.networkEnvironments.push(this.emptyNetworkEnvironment())},
    removeNetworkEnvironment(index){const list=this.form.networkEnvironments||[];const env=list[index];if(!env)return;const removeNow=()=>{list.splice(index,1);this.formDirty=true;this.notify('网络环境已从当前编辑资料中移除，保存客户后生效')};const values=[env.networkName,env.ipEnvironment,env.ipDueDate,env.ipMonthlyFee];if(values.some(v=>String(v??'').trim()))this.askConfirm({title:'删除网络环境',message:`确定删除【${env.networkName||env.ipEnvironment||'当前网络环境'}】及其到期节点资料吗？保存客户后生效。`,confirmText:'确认删除'},removeNow);else removeNow()},
    accountEntityText(c,platform){const list=platform==='FB'?(c.fbAccounts||[]):(c.tkAccounts||[]);if(!list.length)return platform==='FB'?'BM 未录入':'BC 未录入';const values=list.map((a,idx)=>{const name=a.accountName||`${platform==='FB'?'FB':'TK'}账号${idx+1}`;const id=platform==='FB'?(a.bmId||a.adAccountId||'未录入'):(a.bcId||a.adAccountId||'未录入');return `${name}: ${id}`});return values.join(' · ')},
    maskAccount(value){const s=String(value||'');if(!s)return'';if(s.includes('@')){const [name,domain]=s.split('@');const head=name.slice(0,Math.min(2,name.length));return `${head}${name.length>2?'***':''}@${domain}`}if(s.length<=4)return'****';return `${s.slice(0,2)}****${s.slice(-2)}`},
    defaultForm(){return{id:null,sourceLeadId:null,archived:false,archivedAt:'',name:'',product:'',platform:'FB+TK',project:'',currency:'USD',monthlyFee:'',billingMode:'FULL_MONTH',startDate:'',endDate:'',renewalAlertDay:25,status:'ACTIVE',fbAccounts:[this.emptyFbAccount()],tkAccounts:[this.emptyTkAccount()],googleAccounts:[],instagramAccounts:[],networkEnvironments:[this.emptyNetworkEnvironment()],fbBmId:'',fbAdAccountId:'',fbLoginAccount:'',fbLoginPassword:'',tkBcId:'',tkAdAccountId:'',tkLoginAccount:'',tkLoginPassword:'',networkName:'',ipEnvironment:'',ipDueDate:'',ipCurrency:'USD',ipMonthlyFee:'',sopSteps:['检查节点与登录环境','检查广告账户状态和昨日消耗','记录关键数据并同步客户'],riskRules:'保持固定登录环境，任何异常操作先暂停并复核。',renewalHistory:[],adCampaigns:[],fbData:null,tkData:null}},
    openClientForm(client=null){if(client?.archived){this.notify('归档客户需先恢复后才能编辑');return}this.suppressDirtyWatch=true;this.form=client?this.normalizeClient(client):this.defaultForm();if(client)this.selectedClientId=client.id;this.formDirty=false;this.$nextTick(()=>{this.suppressDirtyWatch=false;this.formDirty=false});this.navigateTo('client-form')},
    saveClient(){this.cleanPlatformAccounts(this.form);this.cleanNetworkEnvironments(this.form);if(this.form.id){const i=this.clients.findIndex(c=>c.id===this.form.id),before=i>-1?JSON.parse(JSON.stringify(this.clients[i])):null;if(i>-1)this.clients[i]=this.normalizeClient(this.form);this.selectedClientId=this.form.id;const added=this.ensureAutomaticReceivables({clientId:this.form.id,silent:true}),assetCosts=this.ensureAutomaticAssetCosts({clientId:this.form.id,month:this.localDateKey().slice(0,7),silent:true});this.persist();this.logAudit('修改客户资料',`${this.form.name} · ${this.auditDiff(before,this.clients[i],['name','project','monthlyFee','currency','billingMode','startDate','endDate','status'])}${added?` · 自动补账 ${added} 条`:''}`);this.formDirty=false;this.notify(added||assetCosts?`客户资料已保存${added?`，自动补齐 ${added} 条缺失账单`:''}${assetCosts?`，同步 ${assetCosts} 条 IP / 网络成本`:''}`:'客户资料已保存；历史已生成账单金额保持不变');this.navigateTo('client-detail')}else{const n=this.normalizeClient({...this.defaultForm(),...JSON.parse(JSON.stringify(this.form)),id:Date.now()});this.clients.unshift(n);this.selectedClientId=n.id;this.selectedAssetsClientId=n.id;this.selectedSopClientId=n.id;this.selectedAnalyticsClientId=n.id;this.selectedAdsClientId=n.id;const firstBill=this.ensureClientFirstReceivable(n),catchup=this.ensureAutomaticReceivables({clientId:n.id,silent:true}),assetCosts=this.ensureAutomaticAssetCosts({clientId:n.id,month:this.localDateKey().slice(0,7),silent:true});if(n.sourceLeadId){const lead=this.leads.find(l=>String(l.id)===String(n.sourceLeadId));if(lead){lead.stage='WON';lead.convertedClientId=n.id;lead.convertedAt=new Date().toISOString();lead.nextFollowUp=''}}this.persist();this.logAudit('新增客户',`${n.name} · ${this.formatMoney(n.monthlyFee,n.currency)}/月 · ${n.billingMode==='MANUAL'?'待手工出账':`自动生成账单 ${firstBill+catchup} 条${assetCosts?` · 自动成本 ${assetCosts} 条`:''}`}`);this.formDirty=false;this.notify(n.billingMode==='MANUAL'?`新客户已创建；当前为手工计费，请在应收/回款中建立账单${assetCosts?`；已同步 ${assetCosts} 条 IP / 网络成本`:''}`:`新客户已创建，并自动生成应收账单${firstBill+catchup?` ${firstBill+catchup} 条`:''}${assetCosts?`；已同步 ${assetCosts} 条 IP / 网络成本`:''}`);this.navigateTo('client-detail')}},
    clientRelationSummary(client){const id=String(client?.id||''),accounts=[...(client?.fbAccounts||[]),...(client?.tkAccounts||[])],adRecords=accounts.reduce((n,a)=>n+(a.adDataRecords||[]).length,0),campaigns=(client?.adCampaigns||[]).length,openings=this.openingDeals.filter(d=>String(d.clientId)===id).length,receivables=this.financeReceivables.filter(r=>String(r.clientId)===id).length,costs=this.financeCosts.filter(c=>String(c.clientId||'')===id).length,tools=this.mediaTools.filter(t=>(t.bindings||[]).some(b=>String(b.clientId)===id)).length;return{adRecords,campaigns,openings,receivables,costs,tools,total:adRecords+campaigns+openings+receivables+costs+tools}},
    archiveClient(client){if(!client||client.archived)return;if(!this.canArchiveClients()){this.notify('当前角色没有归档客户的权限');return}this.askConfirm({title:'归档客户',message:`确定归档客户【${client.name}】吗？

归档后历史广告、开户、财务和回款数据都会保留，但客户不再参与当前运营预警。`,confirmText:'确认归档',tone:'warning'},()=>{client.archived=true;client.archivedAt=new Date().toISOString();client.status='PAUSED';this.persist();this.logAudit('归档客户',client.name);this.notify(`客户【${client.name}】已归档`)})},
    deleteClient(client){if(!client)return;if(this.currentUser?.role!=='ADMIN'){this.notify('只有管理员可以永久删除客户');return}if(!client.archived){this.notify('请先归档客户，再执行永久删除');return}const clientId=String(client.id),hasPaymentHistory=this.financeReceivables.some(r=>String(r.clientId)===clientId&&(r.payments||[]).length>0),hasLockedHistory=Object.values(this.financeMonthSnapshots||{}).some(s=>!!s?.clients?.[clientId]);if(hasPaymentHistory||hasLockedHistory){this.notify('该客户存在已回款或已月结财务历史。为保证账务与审计记录完整，不能永久删除；请保持归档状态。');return}const rel=this.clientRelationSummary(client);const detail=`广告数据 ${rel.adRecords} 条、广告方案 ${rel.campaigns} 个、开户记录 ${rel.openings} 条、应收账单 ${rel.receivables} 条、成本 ${rel.costs} 条、工具绑定 ${rel.tools} 个`;const message=rel.total?`【${client.name}】存在关联业务数据：
${detail}

继续删除会同时移除该客户主档、客户内广告方案/广告数据、开户记录、应收账单、客户专属成本，并解除投放工具绑定。该操作不可恢复。`:`确定永久删除客户【${client.name}】吗？该操作不可恢复。`;this.askConfirm({title:rel.total?'删除客户及关联数据':'删除客户',message,confirmText:'确认永久删除'},()=>{const id=String(client.id);this.openingDeals=this.openingDeals.filter(d=>String(d.clientId)!==id);this.financeReceivables=this.financeReceivables.filter(r=>String(r.clientId)!==id);this.financeCosts=this.financeCosts.filter(c=>String(c.clientId||'')!==id);this.standaloneAlerts=this.standaloneAlerts.filter(a=>String(a.clientId||'')!==id);this.dismissedAlerts=this.dismissedAlerts.filter(a=>String(a.clientId||'')!==id);this.mediaTools=this.mediaTools.map(t=>({...t,bindings:(t.bindings||[]).filter(b=>String(b.clientId)!==id)}));this.clients=this.clients.filter(c=>String(c.id)!==id);const first=this.clients.find(c=>!c.archived)||this.clients[0]||null;['selectedClientId','selectedAssetsClientId','selectedSopClientId','selectedAnalyticsClientId','selectedAdsClientId'].forEach(k=>{if(String(this[k])===id)this[k]=first?.id||null});this.persist();this.syncAnalyticsAccountSelection();this.syncAdsAccountSelection();this.syncSopAccountSelection(true);this.logAudit('永久删除客户',`${client.name} · ${detail}`);this.notify(`客户【${client.name}】及关联数据已删除`)})},
    restoreClient(client){if(!client?.archived)return;if(!this.canArchiveClients()){this.notify('当前角色没有恢复客户的权限');return}this.askConfirm({title:'恢复归档客户',message:`确定恢复客户【${client.name}】吗？`,confirmText:'确认恢复',tone:'warning'},()=>{client.archived=false;client.archivedAt='';client.status='ACTIVE';this.persist();this.logAudit('恢复归档客户',client.name);this.notify('客户已恢复到当前合作客户')})},
    auditDiff(before,after,fields=[]){if(!before||!after)return'新建记录';const labels={name:'名称',project:'项目',monthlyFee:'月服务费',currency:'币种',startDate:'合同开始',endDate:'合同到期',status:'状态',billingMode:'计费方式'};const changes=[];fields.forEach(k=>{const a=before?.[k]??'',b=after?.[k]??'';if(String(a)!==String(b))changes.push(`${labels[k]||k}: ${a||'—'} → ${b||'—'}`)});return changes.length?changes.join('；'):'资料更新'},
    aggregateAccountsMetrics(accounts){const records=(accounts||[]).flatMap(a=>a.adDataRecords||[]);const groups=this.spendGroups(accounts||[]);const impressions=records.reduce((s,r)=>s+Number(r.impressions||0),0),clicks=records.reduce((s,r)=>s+Number(r.clicks||0),0),leads=records.reduce((s,r)=>s+Number(r.leads||0),0),conversions=records.reduce((s,r)=>s+Number(r.conversions||0),0);const revenueGroups=records.reduce((acc,r)=>{const currency=r.currency||'USD';acc[currency]=(acc[currency]||0)+Number(r.revenue||0);return acc},{});const currencies=Object.keys(groups).filter(k=>Number(groups[k]||0)>0);let cpmText='—',cpcText='—',cpaText='—',roasText='—';if(currencies.length===1){const cur=currencies[0],spend=Number(groups[cur]||0),revenue=Number(revenueGroups[cur]||0);if(impressions>0)cpmText=this.formatMoney(spend/impressions*1000,cur);if(clicks>0)cpcText=this.formatMoney(spend/clicks,cur);if(conversions>0)cpaText=this.formatMoney(spend/conversions,cur);if(spend>0)roasText=(revenue/spend).toFixed(2)}return{records:records.length,spendText:this.spendGroupsText(groups),impressions,clicks,leads,conversions,cpmText,ctrText:impressions>0?`${(clicks/impressions*100).toFixed(2)}%`:'—',cpcText,cvrText:clicks>0?`${(conversions/clicks*100).toFixed(2)}%`:'—',cpaText,roasText}},
    selectAnalyticsClient(id){this.selectedAnalyticsClientId=Number(id);this.syncAnalyticsAccountSelection()},
    selectAdsClient(id){this.selectedAdsClientId=Number(id);this.syncAdsAccountSelection()},
    syncAnalyticsAccountSelection(){const c=this.selectedAnalyticsClient;if(!c){this.selectedAnalyticsFbAccountId=null;this.selectedAnalyticsTkAccountId=null;return}const fb=c.fbAccounts||[],tk=c.tkAccounts||[];if(!fb.some(a=>String(a.id)===String(this.selectedAnalyticsFbAccountId)))this.selectedAnalyticsFbAccountId=fb[0]?.id||null;if(!tk.some(a=>String(a.id)===String(this.selectedAnalyticsTkAccountId)))this.selectedAnalyticsTkAccountId=tk[0]?.id||null},
    analyticsMetricsForAccount(account,platform){if(!account)return null;const records=account.adDataRecords||[];if(records.length){const s=this.accountDataSummary(account);return{leads:s.leads,cpl:s.cplText,impressions:s.impressions.toLocaleString(),cpm:s.cpmText,ctr:s.ctrText,cpc:s.cpcText,cvr:s.cvrText,cpa:s.cpaText,roas:s.roasText}}const c=this.selectedAnalyticsClient;const accounts=platform==='FB'?(c?.fbAccounts||[]):(c?.tkAccounts||[]);const fallback=platform==='FB'?c?.fbData:c?.tkData;if(!(accounts.length===1&&fallback))return null;return{...fallback,cpm:fallback.cpm??'',cpc:fallback.cpc??'',cvr:fallback.cvr??'',cpa:fallback.cpa??''}},
    syncAdsAccountSelection(){const c=this.selectedAdsClient;if(!c){this.selectedAdsAccountId=null;return}const fb=c.fbAccounts||[],tk=c.tkAccounts||[];if(this.selectedAdsPlatform==='FB'&&!fb.length&&tk.length)this.selectedAdsPlatform='TK';if(this.selectedAdsPlatform==='TK'&&!tk.length&&fb.length)this.selectedAdsPlatform='FB';const accounts=this.selectedAdsPlatform==='FB'?fb:tk;if(!accounts.some(a=>a.id===this.selectedAdsAccountId))this.selectedAdsAccountId=accounts[0]?.id||null},
    emptyAdCampaign(){return{id:this.accountUid('campaign'),platform:this.selectedAdsPlatform,accountId:this.selectedAdsAccount?.id||'',name:'',objective:'TRAFFIC',planName:'',planNotes:'',createdAt:this.localDateKey(),isSaved:false,savedAt:'',updatedAt:'',adSets:[]}},
    emptyAdSet(){return{id:this.accountUid('adset'),name:'',deliveryMethod:'AUTO',country:'',ageMin:18,ageMax:65,gender:'ALL',interests:'',budgetCurrency:'USD',budget:'',spendCurrency:'USD',spend:'',ads:[]}},
    emptyCreative(){return{id:this.accountUid('ad'),name:'',format:'PHOTO',primaryText:'',headline:'',description:'',callToAction:'LEARN_MORE'}},
    addAdCampaign(){const c=this.selectedAdsClient,a=this.selectedAdsAccount;if(!c||!a){this.notify('请先选择广告账户');return}c.adCampaigns=Array.isArray(c.adCampaigns)?c.adCampaigns:[];c.adCampaigns.push(this.emptyAdCampai