gn());this.persist();this.notify('已添加广告系列')},
    removeAdCampaign(campaign){const c=this.selectedAdsClient;if(!c||!campaign)return;const adSetCount=(campaign.adSets||[]).length,adCount=(campaign.adSets||[]).reduce((n,s)=>n+(s.ads||[]).length,0);this.askConfirm({title:'删除广告系列',message:`确定删除【${campaign.name||campaign.planName||'未命名广告系列'}】吗？
将同时删除其中 ${adSetCount} 个广告组、${adCount} 个广告设置。`,confirmText:'确认删除'},()=>{c.adCampaigns=(c.adCampaigns||[]).filter(x=>String(x.id)!==String(campaign.id));this.persist();this.logAudit('删除广告系列',`${c.name} · ${campaign.name||campaign.planName||'未命名'}`);this.notify('广告系列已删除')})},
    addAdSet(campaign){if(!campaign)return;campaign.adSets=Array.isArray(campaign.adSets)?campaign.adSets:[];campaign.adSets.push(this.emptyAdSet());this.persist();this.notify('已添加广告组')},
    removeAdSet(campaign,adset){if(!campaign||!adset)return;this.askConfirm({title:'删除广告组',message:`确定删除广告组【${adset.name||'未命名广告组'}】吗？
其中 ${(adset.ads||[]).length} 个广告也会一并删除。`,confirmText:'确认删除'},()=>{campaign.adSets=(campaign.adSets||[]).filter(x=>String(x.id)!==String(adset.id));this.persist();this.logAudit('删除广告组',adset.name||'未命名广告组');this.notify('广告组已删除')})},
    addCreative(adset){if(!adset)return;adset.ads=Array.isArray(adset.ads)?adset.ads:[];adset.ads.push(this.emptyCreative());this.persist();this.notify('已添加广告')},
    removeCreative(adset,ad){if(!adset||!ad)return;this.askConfirm({title:'删除广告',message:`确定删除广告【${ad.name||'未命名广告'}】吗？`,confirmText:'确认删除'},()=>{adset.ads=(adset.ads||[]).filter(x=>String(x.id)!==String(ad.id));this.persist();this.logAudit('删除广告',ad.name||'未命名广告');this.notify('广告已删除')})},
    saveAdsPlan(campaign){if(!campaign)return;if(!String(campaign.planName||'').trim()&&!String(campaign.name||'').trim()){this.notify('请至少填写方案名称或广告系列名称');return}campaign.adSets=(campaign.adSets||[]).map(adset=>({...adset,ageMin:Number(adset.ageMin||18),ageMax:Number(adset.ageMax||65),budget:adset.budget===''?'':Number(adset.budget||0)}));campaign.isSaved=true;campaign.savedAt=campaign.savedAt||this.localDateKey();campaign.updatedAt=this.localDateKey();this.persist();this.logAudit('保存广告方案',`${this.selectedAdsClient?.name||''} · ${campaign.planName||campaign.name||'未命名方案'}`);this.notify('广告方案已保存，并加入方案列表')},
    editAdCampaign(campaign){if(!campaign)return;campaign.isSaved=false;this.persist();this.notify('已打开方案编辑器')},
    openAdsPlanDetail(campaign){if(!campaign)return;this.selectedPlanDetail=JSON.parse(JSON.stringify(campaign));this.showAdsPlanDetailModal=true},
    objectiveLabel(v){return ({TRAFFIC:'流量',ENGAGEMENT:'互动',LEADS:'潜在客户'})[v]||'流量'},
    deliveryMethodLabel(v){return v==='MANUAL'?'手动定向':'自动投放'},
    genderLabel(v){return ({MALE:'男性',FEMALE:'女性',ALL:'不限'})[v]||'不限'},
    creativeFormatLabel(v){return v==='VIDEO'?'视频':'照片'},
    callToActionLabel(v){return ({LEARN_MORE:'了解更多',CONTACT_US:'联系我们',GET_QUOTE:'获取报价',SIGN_UP:'注册',APPLY_NOW:'立即申请',SHOP_NOW:'立即购买',DOWNLOAD:'下载'})[v]||v||'了解更多'},
    campaignAdCount(campaign){return (campaign?.adSets||[]).reduce((n,a)=>n+(a.ads||[]).length,0)},
    campaignBudgetText(campaign){const groups={};(campaign?.adSets||[]).forEach(a=>{const currency=a.budgetCurrency||'USD';groups[currency]=(groups[currency]||0)+Number(a.budget||0)});return this.spendGroupsText(groups)},
    campaignDataRecords(campaign){if(!campaign||!this.selectedAdsAccount)return[];return (this.selectedAdsAccount.adDataRecords||[]).filter(r=>r.campaignId===campaign.id)},
    campaignDataRecordCount(campaign){return this.campaignDataRecords(campaign).length},
    campaignDataSpendText(campaign){const groups={};this.campaignDataRecords(campaign).forEach(r=>{const currency=r.currency||'USD';groups[currency]=(groups[currency]||0)+Number(r.spend||0)});return Object.keys(groups).length?this.spendGroupsText(groups):'—'},
    adSetDataSpendText(campaign,adset){if(!campaign||!adset||!this.selectedAdsAccount)return'—';const groups={};(this.selectedAdsAccount.adDataRecords||[]).filter(r=>r.campaignId===campaign.id&&r.adSetId===adset.id).forEach(r=>{const currency=r.currency||'USD';groups[currency]=(groups[currency]||0)+Number(r.spend||0)});return Object.keys(groups).length?this.spendGroupsText(groups):'—'},
    adSetDetailSpendText(campaign,adset){if(!campaign||!adset||!this.selectedAdsAccount)return'—';return this.adSetDataSpendText(campaign,adset)},
    openAdDataModal(campaign=null){const account=this.selectedAdsAccount;if(!account){this.notify('请先选择广告账户');return}if(!this.savedAdsCampaignsForAccount.length){this.notify('请先保存至少一个广告方案');return}this.editingAdDataRecordId=null;const target=campaign&&campaign.id?this.savedAdsCampaignsForAccount.find(c=>c.id===campaign.id):this.savedAdsCampaignsForAccount[0];this.adDataForm={date:this.localDateKey(),campaignId:target?.id||'',adSetId:'',adId:'',currency:account.adSpendCurrency||'USD',spend:'',impressions:'',reach:'',clicks:'',leads:'',conversions:'',revenue:'',video3sRate:'',video25Rate:'',video50Rate:'',video75Rate:'',video95Rate:'',videoCompleteRate:'',note:''};this.syncAdDataSelections();this.showAdDataModal=true},
    openAdDataFromAnalytics(platform,account){const client=this.selectedAnalyticsClient;if(!client||!account)return;this.selectedAdsClientId=client.id;this.selectedAdsPlatform=platform;this.selectedAdsAccountId=account.id;if(!this.savedAdsCampaignsForAccount.length){this.notify('该广告账户还没有已保存广告方案，请先到广告管理保存方案');this.navigateTo('ads');return}this.openAdDataModal()},
    editAdDataRecord(record){if(!record)return;this.editingAdDataRecordId=record.id;this.adDataForm={date:record.date||this.localDateKey(),campaignId:record.campaignId||'',adSetId:record.adSetId||'',adId:record.adId||'',currency:record.currency||this.selectedAdsAccount?.adSpendCurrency||'USD',spend:Number(record.spend||0),impressions:Number(record.impressions||0),reach:record.reach??'',clicks:Number(record.clicks||0),leads:Number(record.leads||0),conversions:Number(record.conversions||0),revenue:Number(record.revenue||0),video3sRate:record.video3sRate??'',video25Rate:record.video25Rate??'',video50Rate:record.video50Rate??'',video75Rate:record.video75Rate??'',video95Rate:record.video95Rate??'',videoCompleteRate:record.videoCompleteRate??'',note:record.note||''};this.syncAdDataSelections();this.showAdDataModal=true},
    syncAdDataSelections(){const campaign=this.savedAdsCampaignsForAccount.find(c=>c.id===this.adDataForm.campaignId);const sets=campaign?.adSets||[];if(!sets.some(a=>a.id===this.adDataForm.adSetId))this.adDataForm.adSetId='';this.syncAdDataAdSelection()},
    syncAdDataAdSelection(){const set=this.adDataAdSets.find(a=>a.id===this.adDataForm.adSetId);const ads=set?.ads||[];if(!ads.some(a=>a.id===this.adDataForm.adId))this.adDataForm.adId=''},
    adDataIdentity(record){return [record?.date||'',record?.campaignId||'',record?.adSetId||'',record?.adId||''].join('|')},
    optionalNumber(value){if(value===''||value===null||value===undefined)return null;const n=Number(value);return Number.isFinite(n)?n:null},
    normalizePercent(value){const n=this.optionalNumber(value);return n===null?null:Math.min(100,Math.max(0,n))},
    percentText(value){const n=this.optionalNumber(value);return n===null?'—':`${n.toFixed(2).replace(/\.00$/,'')}%`},
    adRecordMetrics(record){const spend=Number(record?.spend||0),impressions=Number(record?.impressions||0),reach=Number(record?.reach||0),clicks=Number(record?.clicks||0),conversions=Number(record?.conversions||0),revenue=Number(record?.revenue||0),currency=record?.currency||'USD';return{cpmText:impressions>0?this.formatMoney(spend/impressions*1000,currency):'—',reachText:reach>0?reach.toLocaleString():'—',frequencyText:reach>0?(impressions/reach).toFixed(2):'—',ctrText:impressions>0?`${(clicks/impressions*100).toFixed(2)}%`:'—',cpcText:clicks>0?this.formatMoney(spend/clicks,currency):'—',cvrText:clicks>0?`${(conversions/clicks*100).toFixed(2)}%`:'—',cpaText:conversions>0?this.formatMoney(spend/conversions,currency):'—',roasText:spend>0?(revenue/spend).toFixed(2):'—'}},
    adDataDraftMetrics(){return this.adRecordMetrics(this.adDataForm)},
    saveAdDataRecord(){const client=this.selectedAdsClient,account=this.selectedAdsAccount;if(!client||!account)return;if(!this.assertMonthUnlocked(String(this.adDataForm.date||this.localDateKey()).slice(0,7),'保存广告数据'))return;const campaign=this.savedAdsCampaignsForAccount.find(c=>c.id===this.adDataForm.campaignId);if(!campaign){this.notify('请选择有效的广告方案');return}account.adDataRecords=Array.isArray(account.adDataRecords)?account.adDataRecords:[];const existingCurrencies=[...new Set(account.adDataRecords.filter(r=>r.id!==this.editingAdDataRecordId).map(r=>r.currency).filter(Boolean))];if(existingCurrencies.length&&!existingCurrencies.includes(this.adDataForm.currency)){this.notify(`该广告账户已有 ${existingCurrencies.join('/')} 数据，请保持同一结算币种`);return}const adset=(campaign.adSets||[]).find(a=>a.id===this.adDataForm.adSetId);const ad=(adset?.ads||[]).find(a=>a.id===this.adDataForm.adId);const now=new Date().toISOString();const isFB=this.selectedAdsPlatform==='FB';const payload={date:this.adDataForm.date||this.localDateKey(),campaignId:campaign.id,campaignName:campaign.name||'',planName:campaign.planName||'',adSetId:adset?.id||'',adSetName:adset?.name||'',adId:ad?.id||'',adName:ad?.name||'',currency:this.adDataForm.currency||account.adSpendCurrency||'USD',spend:Number(this.adDataForm.spend||0),impressions:Number(this.adDataForm.impressions||0),reach:isFB?Number(this.adDataForm.reach||0):0,clicks:Number(this.adDataForm.clicks||0),leads:Number(this.adDataForm.leads||0),conversions:Number(this.adDataForm.conversions||0),revenue:Number(this.adDataForm.revenue||0),video3sRate:isFB?this.normalizePercent(this.adDataForm.video3sRate):null,video25Rate:isFB?this.normalizePercent(this.adDataForm.video25Rate):null,video50Rate:isFB?this.normalizePercent(this.adDataForm.video50Rate):null,video75Rate:isFB?this.normalizePercent(this.adDataForm.video75Rate):null,video95Rate:isFB?this.normalizePercent(this.adDataForm.video95Rate):null,videoCompleteRate:isFB?this.normalizePercent(this.adDataForm.videoCompleteRate):null,note:this.adDataForm.note||'',updatedAt:now};let targetIndex=-1;if(this.editingAdDataRecordId)targetIndex=account.adDataRecords.findIndex(r=>r.id===this.editingAdDataRecordId);if(targetIndex<0){const identity=this.adDataIdentity(payload);targetIndex=account.adDataRecords.findIndex(r=>this.adDataIdentity(r)===identity)}const isUpdate=targetIndex>=0;if(isUpdate){const previous=account.adDataRecords[targetIndex];account.adDataRecords[targetIndex]={...previous,...payload,id:previous.id,createdAt:previous.createdAt||now}}else{account.adDataRecords.unshift({...payload,id:this.accountUid('data'),createdAt:now})}campaign.updatedAt=this.localDateKey();this.syncAccountAnalyticsFromRecords(account);this.syncClientPlatformAnalytics(client,this.selectedAdsPlatform);this.persist();this.showAdDataModal=false;this.editingAdDataRecordId=null;this.logAudit(isUpdate?'修改广告数据':'新增广告数据',`${client.name} · ${account.accountName||account.adAccountId} · ${payload.date} · ${this.formatMoney(payload.spend,payload.currency)}`);this.notify(isUpdate?'广告数据已更新，全部分析指标已同步刷新':'广告数据已保存一次，投放分析与 Facebook 深度指标已同步更新')},
    deleteAdDataRecord(record){const client=this.selectedAdsClient,account=this.selectedAdsAccount;if(!client||!account||!record)return;if(!this.assertMonthUnlocked(String(record.date||'').slice(0,7),'删除广告数据'))return;this.askConfirm({title:'删除广告数据记录',message:`确定删除 ${record.date} 的这条广告数据吗？
消耗：${this.formatMoney(record.spend,record.currency)}。删除后投放分析、账户消耗和余额会自动重新计算。`,confirmText:'确认删除'},()=>{account.adDataRecords=(account.adDataRecords||[]).filter(r=>String(r.id)!==String(record.id));if(this.editingAdDataRecordId===record.id)this.editingAdDataRecordId=null;this.syncAccountAnalyticsFromRecords(account);this.syncClientPlatformAnalytics(client,this.selectedAdsPlatform);this.persist();this.logAudit('删除广告数据',`${client.name} · ${account.accountName||account.adAccountId} · ${record.date} · ${this.formatMoney(record.spend,record.currency)}`);this.notify('广告数据记录已删除，分析数据已重新计算')})},
    accountDataDates(account){return [...new Set((account?.adDataRecords||[]).map(r=>r.date).filter(Boolean))].sort((a,b)=>String(b).localeCompare(String(a)))},
    accountDataSpendGroups(account,dateFilter='ALL'){const allRecords=account?.adDataRecords||[];const records=dateFilter&&dateFilter!=='ALL'?allRecords.filter(r=>r.date===dateFilter):allRecords;return records.reduce((acc,r)=>{const currency=r.currency||account?.adSpendCurrency||'USD';acc[currency]=(acc[currency]||0)+Number(r.spend||0);return acc},{})},
    accountSpendText(account){return this.spendGroupsText(this.accountDataSpendGroups(account))},
    accountDataSummary(account,dateFilter='ALL'){const allRecords=account?.adDataRecords||[];const records=dateFilter&&dateFilter!=='ALL'?allRecords.filter(r=>r.date===dateFilter):allRecords;const groups=this.accountDataSpendGroups(account,dateFilter);const impressions=records.reduce((s,r)=>s+Number(r.impressions||0),0),reach=records.reduce((s,r)=>s+Number(r.reach||0),0),clicks=records.reduce((s,r)=>s+Number(r.clicks||0),0),leads=records.reduce((s,r)=>s+Number(r.leads||0),0),conversions=records.reduce((s,r)=>s+Number(r.conversions||0),0);const revenueGroups=records.reduce((acc,r)=>{const currency=r.currency||'USD';acc[currency]=(acc[currency]||0)+Number(r.revenue||0);return acc},{});const currencies=Object.keys(groups).filter(k=>Number(groups[k]||0)>0||records.some(r=>(r.currency||'USD')===k));let cplText='—',cpmText='—',cpcText='—',cpaText='—',roasText='—';if(currencies.length===1){const cur=currencies[0],spend=Number(groups[cur]||0),revenue=Number(revenueGroups[cur]||0);if(leads>0)cplText=this.formatMoney(spend/leads,cur);if(impressions>0)cpmText=this.formatMoney(spend/impressions*1000,cur);if(clicks>0)cpcText=this.formatMoney(spend/clicks,cur);if(conversions>0)cpaText=this.formatMoney(spend/conversions,cur);if(spend>0)roasText=(revenue/spend).toFixed(2)}const weightedRate=(key)=>{let weighted=0,weight=0,sum=0,count=0;records.forEach(r=>{const v=this.optionalNumber(r[key]);if(v===null)return;const w=Number(r.impressions||0);sum+=v;count++;if(w>0){weighted+=v*w;weight+=w}});if(weight>0)return weighted/weight;if(count>0)return sum/count;return null};const rateText=(key)=>{const v=weightedRate(key);return v===null?'—':`${v.toFixed(2)}%`};return{records:records.length,spendText:this.spendGroupsText(groups),impressions,reach,reachText:reach>0?reach.toLocaleString():'—',clicks,leads,conversions,revenueText:Object.keys(revenueGroups).length?this.spendGroupsText(revenueGroups):'—',cpmText,frequencyText:reach>0?(impressions/reach).toFixed(2):'—',ctrText:impressions>0?`${(clicks/impressions*100).toFixed(2)}%`:'—',cpcText,cplText,cvrText:clicks>0?`${(conversions/clicks*100).toFixed(2)}%`:'—',cpaText,roasText,video3sRateText:rateText('video3sRate'),video25RateText:rateText('video25Rate'),video50RateText:rateText('video50Rate'),video75RateText:rateText('v