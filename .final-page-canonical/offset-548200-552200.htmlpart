Number(record?.clicks||0),conversions=Number(record?.conversions||0),revenue=Number(record?.revenue||0),currency=record?.currency||'USD';return{cpmText:impressions>0?this.formatMoney(spend/impressions*1000,currency):'—',reachText:reach>0?reach.toLocaleString():'—',frequencyText:reach>0?(impressions/reach).toFixed(2):'—',ctrText:impressions>0?`${(clicks/impressions*100).toFixed(2)}%`:'—',cpcText:clicks>0?this.formatMoney(spend/clicks,currency):'—',cvrText:clicks>0?`${(conversions/clicks*100).toFixed(2)}%`:'—',cpaText:conversions>0?this.formatMoney(spend/conversions,currency):'—',roasText:spend>0?(revenue/spend).toFixed(2):'—'}},
    adDataDraftMetrics(){return this.adRecordMetrics(this.adDataForm)},
    saveAdDataRecord(){const client=this.selectedAdsClient,account=this.selectedAdsAccount;if(!client||!account)return;if(!this.assertMonthUnlocked(String(this.adDataForm.date||this.localDateKey()).slice(0,7),'保存广告数据'))return;const campaign=this.savedAdsCampaignsForAccount.find(c=>c.id===this.adDataForm.campaignId);if(!campaign){this.notify('请选择有效的广告方案');return}account.adDataRecords=Array.isArray(account.adDataRecords)?account.adDataRecords:[];const existingCurrencies=[...new Set(account.adDataRecords.filter(r=>r.id!==this.editingAdDataRecordId).map(r=>r.currency).filter(Boolean))];if(existingCurrencies.length&&!existingCurrencies.includes(this.adDataForm.currency)){this.notify(`该广告账户已有 ${existingCurrencies.join('/')} 数据，请保持同一结算币种`);return}const adset=(campaign.adSets||[]).find(a=>a.id===this.adDataForm.adSetId);const ad=(adset?.ads||[]).find(a=>a.id===this.adDataForm.adId);const now=new Date().toISOString();const isFB=this.selectedAdsPlatform==='FB';const payload={date:this.adDataForm.date||this.localDateKey(),campaignId:campaign.id,campaignName:campaign.name||'',planName:campaign.planName||'',adSetId:adset?.id||'',adSetName:adset?.name||'',adId:ad?.id||'',adName:ad?.name||'',currency:this.adDataForm.currency||account.adSpendCurrency||'USD',spend:Number(this.adDataForm.spend||0),impressions:Number(this.adDataForm.impressions||0),reach:isFB?Number(this.adDataForm.reach||0):0,clicks:Number(this.adDataForm.clicks||0),leads:Number(this.adDataForm.leads||0),conversions:Number(this.adDataForm.conversions||0),revenue:Number(this.adDataForm.revenue||0),video3sRate:isFB?this.normalizePercent(this.adDataForm.video3sRate):null,video25Rate:isFB?this.normalizePercent(this.adDataForm.video25Rate):null,video50Rate:isFB?this.normalizePercent(this.adDataForm.video50Rate):null,video75Rate:isFB?this.normalizePercent(this.adDataForm.video75Rate):null,video95Rate:isFB?this.normalizePercent(this.adDataForm.video95Rate):null,videoCompleteRate:isFB?this.normalizePercent(this.adDataForm.videoCompleteRate):null,note:this.adDataForm.note||'',updatedAt:now};let targetIndex=-1;if(this.editingAdDataRecordId)targetIndex=account.adDataRecords.findIndex(r=>r.id===this.editingAdDataRecordId);if(targetIndex<0){const identity=this.adDataIdentity(payload);targetIndex=account.adDataRecords.findIndex(r=>this.adDataIdentity(r)===identity)}const isUpdate=targetIndex>=0;if(isUpdate){const previous=account.adDataRecords[targetIndex];account.adDataRecords[targetIndex]={...previous,...payload,id:previous.id,createdAt:previous.createdAt||now}}else{account.adDataRecords.unshift({...payload,id:this.accountUid('data'),createdAt:now})}campaign.updatedAt=this.localDateKey();this.syncAccountAnalyticsFromRecords(account);this.syncClientPlatformAnalytics(client,this.selectedAdsPlatform);this.persist();this.showAdDataModal=false;this.editingAdDataRecordId=null;this.logAudit(isUpdate?'修改广告数据':'新增广告数据',`${client.name} · ${account.accountName||account.adAccountId} · ${payload.date} · ${this.formatMoney(payload.spend,payload.currency)}`);this.notify(isUpdate?'广告数据已更新，全部分析指标已同步刷新':'广告数据已保存一次，投放分析与 Facebook 深度