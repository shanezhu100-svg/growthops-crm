ideo75Rate'),video95RateText:rateText('video95Rate'),videoCompleteRateText:rateText('videoCompleteRate')}},
    syncAccountAnalyticsFromRecords(account){const records=account?.adDataRecords||[];if(!records.length){account.adSpend=0;return}const currency=records[0].currency||account.adSpendCurrency||'USD';account.adSpendCurrency=currency;account.adSpend=records.filter(r=>(r.currency||'USD')===currency).reduce((s,r)=>s+Number(r.spend||0),0)},
    syncClientPlatformAnalytics(client,platform){if(!client)return;const accounts=platform==='FB'?(client.fbAccounts||[]):(client.tkAccounts||[]);const records=accounts.flatMap(a=>a.adDataRecords||[]);const key=platform==='FB'?'fbData':'tkData';if(!records.length){if(client[key]?._source==='AD_RECORDS')client[key]=null;return}const impressions=records.reduce((s,r)=>s+Number(r.impressions||0),0),clicks=records.reduce((s,r)=>s+Number(r.clicks||0),0),leads=records.reduce((s,r)=>s+Number(r.leads||0),0);const currencies=[...new Set(records.map(r=>r.currency||'USD'))];const spend=records.reduce((s,r)=>s+Number(r.spend||0),0),revenue=records.reduce((s,r)=>s+Number(r.revenue||0),0);const sameCurrency=currencies.length===1;client[key]={_source:'AD_RECORDS',spend,impressions:impressions.toLocaleString(),ctr:impressions>0?Number((clicks/impressions*100).toFixed(2)):0,leads,cpl:sameCurrency&&leads>0?Number((spend/leads).toFixed(2)):0,roas:sameCurrency&&spend>0?Number((revenue/spend).toFixed(2)):0};if(platform==='FB'){const reach=records.reduce((s,r)=>s+Number(r.reach||0),0),conversions=records.reduce((s,r)=>s+Number(r.conversions||0),0);client[key].reach=reach;client[key].frequency=reach>0?Number((impressions/reach).toFixed(2)):0;client[key].cpm=sameCurrency&&impressions>0?Number((spend/impressions*1000).toFixed(2)):0;client[key].cpc=sameCurrency&&clicks>0?Number((spend/clicks).toFixed(2)):0;client[key].cvr=clicks>0?Number((conversions/clicks*100).toFixed(2)):0;client[key].cpa=sameCurrency&&conversions>0?Number((spend/conversions).toFixed(2)):0}},
    campaignSpendText(campaign){const groups={};(campaign?.adSets||[]).forEach(adset=>{const currency=adset.spendCurrency||'USD';groups[currency]=(groups[currency]||0)+Number(adset.spend||0)});return this.spendGroupsText(groups)},
    latestRechargeDate(account){const r=(account?.rechargeHistory||[])[0];return r?.date||'暂无记录'},
    daysUntil(dateStr){if(!dateStr)return 9999;const now=new Date();const today=new Date(now.getFullYear(),now.getMonth(),now.getDate());const d=new Date(dateStr+'T00:00:00');return Math.ceil((d-today)/86400000)},
    autoDueReminderStage(date){if(!date)return null;const days=this.daysUntil(date);if(days>7||days<-30)return null;let index=1,daysBefore=7;if(days<=3){index=2;daysBefore=3}if(days<=1){index=3;daysBefore=1}return{reminderIndex:index,reminderTotal:3,reminderDaysBefore:daysBefore,reminderDate:this.addDays(date,-daysBefore)}},
    pushDueAlert(list,c,typeKey,date,type,cost,target,networkId=null){if(!date)return;const days=this.daysUntil(date),stage=this.autoDueReminderStage(date);if(stage)list.push({id:`${typeKey}-${c.id}${networkId?`-${networkId}`:''}`,typeKey,clientId:c.id,networkId,clientName:c.name,type,dueDate:date,daysLeft:days,cost,target,isStandalone:false,...stage})},
    hasUsdBalanceData(account){return !!(account?.rechargeHistory||[]).some(r=>(r.currency||'USD')==='USD')},
    accountRechargeUsd(account){return (account?.rechargeHistory||[]).filter(r=>(r.currency||'USD')==='USD').reduce((sum,r)=>sum+Number(r.amount||0),0)},
    accountSpendUsd(account){return Number(this.accountDataSpendGroups(account)?.USD||0)},
    accountBalanceUsd(account){return this.accountRechargeUsd(account)-this.accountSpendUsd(account)},
    accountBalanceText(account){return this.hasUsdBalanceData(account)?this.formatMoney(this.accountBalanceUsd(account),'USD'):'未建立 USD 余额'},
    isLowBalance(account){return this.hasUsdBalanceData(account)&&this.accountBalanceUsd(account)<=100},
    isCriticalBalance(account){return this.hasUsdBalanceData(account)&&this.accountBalanceUsd(account)<=30},
    rechargeAlertStage(account){if(!this.hasUsdBalanceData(account))return null;const balance=this.accountBalanceUsd(account);if(balance<=30)return'CRITICAL';if(balance<=100)return'LOW';return null},
    pushRechargeAlert(list,c,platform,account,idx){const balanceStage=this.rechargeAlertStage(account);if(!balanceStage)return;const platformName=platform==='FB'?'Facebook':'TikTok';const accountName=account.accountName||`${platformName} 账号 ${idx+1}`;const balance=this.accountBalanceUsd(account);list.push({id:`AD_RECHARGE-${c.id}-${account.id}`,typeKey:'AD_RECHARGE',balanceStage,alertThreshold:balanceStage==='CRITICAL'?30:100,clientId:c.id,accountId:account.id,platform,clientName:c.name,type:`${balanceStage==='CRITICAL'?'广告费二次紧急提醒':'广告费余额提醒'} · ${platformName}`,dueDate:'余额触发',daysLeft:0,balance,balanceText:this.formatMoney(balance,'USD'),adAccountId:account.adAccountId||'',accountName,cost:`当前余额 ${this.formatMoney(balance,'USD')}`,target:`${accountName}${account.adAccountId?` · ${account.adAccountId}`:''}`,isStandalone:false})},
    findAccount(clientId,platform,accountId){const c=this.clients.find(c=>c.id===clientId);if(!c)return null;return (platform==='FB'?(c.fbAccounts||[]):(c.tkAccounts||[])).find(a=>a.id===accountId)||null},
    saveAdSpend(account){if(!account)return;account.adSpend=Number(account.adSpend||0);account.adSpendCurrency=account.adSpendCurrency||'USD';this.persist();this.notify('广告消耗已保存')},
    saveRechargeReminder(account){if(!account)return;this.persist()},
    openRechargeModal(client,platform,account){if(!client||!account)return;this.rechargeForm={clientId:client.id,platform,accountId:account.id,clientName:client.name,accountName:account.accountName||account.adAccountId||'广告账户',currency:account.adSpendCurrency||'USD',amount:'',date:this.localDateKey(),note:''};this.showRechargeModal=true},
    saveRecharge(){const account=this.findAccount(this.rechargeForm.clientId,this.rechargeForm.platform,this.rechargeForm.accountId);if(!account){this.showRechargeModal=false;return}if(!this.assertMonthUnlocked(String(this.rechargeForm.date||this.localDateKey()).slice(0,7),'登记广告充值'))return;const amount=Number(this.rechargeForm.amount||0);if(amount<=0){this.notify('请输入有效的充值金额');return}account.rechargeHistory=Array.isArray(account.rechargeHistory)?account.rechargeHistory:[];account.rechargeHistory.unshift({id:`recharge-${Date.now()}`,date:this.rechargeForm.date||this.localDateKey(),currency:this.rechargeForm.currency||'USD',amount,note:this.rechargeForm.note||'广告账户充值'});this.persist();this.logAudit('登记广告充值',`${this.rechargeForm.clientName} · ${this.rechargeForm.accountName} · ${this.formatMoney(amount,this.rechargeForm.currency||'USD')}`);this.showRechargeModal=false;this.notify(this.hasUsdBalanceData(account)?`广告充值已登记，当前 USD 余额 ${this.accountBalanceText(account)}`:'广告充值已登记')},
    rechargeGroups(accounts){return (accounts||[]).reduce((acc,a)=>{(a.rechargeHistory||[]).forEach(r=>{const currency=r.currency||'USD';acc[currency]=(acc[currency]||0)+Number(r.amount||0)});return acc},{})},
    accountRechargeText(account){return this.spendGroupsText(this.rechargeGroups([account]))},
    clientRechargeText(c){if(!c)return'—';return this.spendGroupsText(this.rechargeGroups([...(c.fbAccounts||[]),...(c.tkAccounts||[])]))},
    latestRechargeLabel(account){const r=(account.rechargeHistory||[])[0];return r?`${r.date} · ${this.formatMoney(r.amount,r.currency)}`:'暂无记录'},
    spendGroups(accounts){return (accounts||[]).reduce((acc,a)=>{const groups=this.accountDataSpendGroups(a);Object.entries(groups).forEach(([currency,value])=>acc[currency]=(acc[currency]||0)+Number(value||0));return acc},{})},
    spendGroupsText(groups){const parts=[];if(Object.prototype.hasOwnProperty.call(groups,'USD'))parts.push(this.formatMoney(groups.USD,'USD'));if(Object.prototype.hasOwnProperty.call(groups,'CNY'))parts.push(this.formatMoney(groups.CNY,'CNY'));return parts.length?parts.join(' + '):'—'},
    financeMoneyRows(groups){const source=groups&&typeof groups==='object'?groups:{},preferred=['USD','CNY'],extra=Object.keys(source).filter(k=>!preferred.includes(k)).sort(),keys=[...preferred.filter(k=>Object.prototype.hasOwnProperty.call(source,k)),...extra];if(!keys.length)keys.push('USD');return keys.map(currency=>({currency,amount:Number(source[currency]||0),text:this.formatMoney(source[currency]||0,currency)}))},
    financeProfitBreakdownRows(kind='EXPECTED'){const rebate=kind==='ACTUAL'?this.financeConfirmedActualRebateGroups:this.financeTotals.expected,net=kind==='ACTUAL'?this.financeActualNetProfitGroups:this.financeExpectedNetProfitGroups,groups=[this.financeReceivableTotals.expected,rebate,this.financeCostGroups,net],preferred=['USD','CNY'],all=new Set(groups.flatMap(g=>Object.keys(g||{}))),keys=[...preferred.filter(k=>all.has(k)),...[...all].filter(k=>!preferred.includes(k)).sort()];if(!keys.length)keys.push('USD');return keys.map(currency=>({currency,receivable:Number(this.financeReceivableTotals.expected[currency]||0),rebate:Number(rebate[currency]||0),cost:Number(this.financeCostGroups[currency]||0),net:Number(net[currency]||0),receivableText:this.formatMoney(this.financeReceivableTotals.expected[currency]||0,currency),rebateText:this.formatMoney(rebate[currency]||0,currency),costText:this.formatMoney(this.financeCostGroups[currency]||0,currency),netText:this.formatMoney(net[currency]||0,currency)}))},
    financeReconciliationStatusForScope(clientId=null,months=null){const monthList=Array.isArray(months)&&months.length?months:this.financePeriodMonths(),pending=new Set();this.financeRebateChannelOptions.forEach(opt=>{monthList.forEach(month=>{const groups=clientId===null||clientId===undefined?this.financeSpendForChannelMonth(opt.providerId,opt.contactId,month):this.financeClientSpendForChannelMonth(clientId,opt.providerId,opt.contactId,month);Object.entries(groups||{}).forEach(([currency,amount])=>{if(Number(amount||0)<=0)return;const has=this.financeReconciliations.some(r=>r.status!=='VOID'&&String(r.providerId)===String(opt.providerId)&&String(r.contactId||'')===String(opt.contactId||'')&&String(r.settlementMonth)===String(month)&&(r.currency||'USD')===currency);if(!has)pending.add(`${opt.providerId}|${opt.contactId}|${month}|${currency}`)})})});const unassignedSpendGroups=this.financeAdSpendGroups(clientId===null||clientId===undefined?null:clientId,monthList,'UNASSIGNED'),unassignedSpendTotal=Object.values(unassignedSpendGroups).reduce((sum,v)=>sum+Math.abs(Number(v||0)),0),allLocked=monthList.length>0&&monthList.every(month=>this.isMonthLocked(month));return{pendingReconciliations:pending.size,unassignedSpendGroups,unassignedSpendTotal,allLocked,complete:pending.size===0&&unassignedSpendTotal<=0.01}},
    platformSpendText(c,platform){if(!c)return'—';const accounts=platform==='FB'?(c.fbAccounts||[]):(c.tkAccounts||[]);return accounts.length?this.spendGroupsText(this.spendGroups(accounts)):'—'},
    clientSpendText(c){if(!c)return'—';const accounts=[...(c.fbAccounts||[]),...(c.tkAccounts||[])];return accounts.length?this.spendGroupsText(this.spendGroups(accounts)):'—'},
    formatMoney(v,currency){const n=Number(v||0).toLocaleString(undefined,{maximumFractionDigits:2});return currency==='CNY'?`¥${n}`:`$${n}`},
    contractStatusText(c){const d=this.daysUntil(c.endDate);if(d<0)return`已到期 ${Math.abs(d)} 天`;if(d===0)return'今天到期';return`${d} 天后到期`},
    daysLeftLabel(d){if(d<0)return`逾期 ${Math.abs(d)} 天`;if(d===0)return'今天到期';return`${d} 天后`},
    defaultReminderTypes(){return[{key:'IP',name:'静态 IP / 节点',system:true},{key:'CONTRACT',name:'服务合同',system:true},{key:'RECEIVABLE',name:'应收回款',system:true}]},
    normalizeReminderTypes(types){const defaults=this.defaultReminderTypes(),incoming=Array.isArray(types)?types:[],map=new Map();defaults.forEach(t=>map.set(t.key,{...t}));incoming.forEach(t=>{if(!t||!t.key)return;const base=map.get(t.key)||{};let name=String(t.name||base.name||'提醒类型').trim();if(t.key==='RECEIVABLE'&&name==='客户回款')name='应收回款';map.set(t.key,{...base,...t,name,system:!!(base.system||t.system)})});return[...map.values()]},
    canManageReminderTypes(){return['ADMIN','OPS'].includes(this.currentUser?.role)},
    reminderTypeLabel(k){const t=(this.reminderTypes||[]).find(x=>String(x.key)===String(k));if(t?.name)return t.name;if(k==='CONTRACT')return'服务合同';if(k==='IP')return'静态 IP / 节点';return'自定义提醒'},
    alertTypeName(k){if(k==='AD_RECHARGE')return'广告费余额提醒';if(k==='RECEIVABLE')return'应收回款提醒';const name=this.reminderTypeLabel(k);return['CONTRACT','IP'].includes(k)?`${name}到期`:name},
    alertStyle(k){if(k==='CONTRACT')return{bg:'bg-emerald-50',text:'text-emerald-600',icon:'fa-solid fa-file-contract'};if(k==='AD_RECHARGE')return{bg:'bg-amber-50',text:'text-amber-600',icon:'fa-solid fa-coins'};if(k==='IP')return{bg:'bg-indigo-50',text:'text-indigo-600',icon:'fa-solid fa-network-wired'};return{bg:'bg-violet-50',text:'text-violet-600',icon:'fa-regular fa-bell'}},
    reminderTargetLabel(k){if(k==='CONTRACT')return'产品 / 服务';if(k==='IP')return'环境 / 平台';if(k==='RECEIVABLE')return'账单 / 回款说明';return'提醒内容'},
    reminderTargetPlaceholder(k){if(k==='CONTRACT')return'例如：遥控割草机 / 广告代投服务';if(k==='IP')return'例如：AdsPower Profile / 网络环境';return'例如：域名、服务器、证书或其他需要提醒的事项'},
    openReminderTypeManager(){if(!this.canManageReminderTypes()){this.notify('当前角色没有管理提醒类型的权限');return}this.resetReminderTypeForm();this.showReminderTypeManager=true},
    resetReminderTypeForm(){this.reminderTypeForm={key:'',name:''}},
    editReminderType(type){if(!this.canManageReminderTypes())return;this.reminderTypeForm={key:type.key,name:type.name||''}},
    reminderTypeUsageCount(key){return (this.standaloneAlerts||[]).filter(a=>String(a.typeKey)===String(key)).length},
    saveReminderType(){if(!this.canManageReminderTypes()){this.notify('当前角色没有管理提醒类型的权限');return}const name=String(this.reminderTypeForm.name||'').trim();if(!name){this.notify('请输入提醒类型名称');return}const duplicate=(this.reminderTypes||[]).find(t=>t.name===name&&String(t.key)!==String(this.reminderTypeForm.key||''));if(duplicate){this.notify('提醒类型名称已存在');return}if(this.reminderTypeForm.key){const t=this.reminderTypes.find(x=>String(x.key)===String(this.reminderTypeForm.key));if(!t){this.notify('提醒类型不存在');return}const old=t.name;t.name=name;this.persist();this.logAudit('修改提醒类型',`${old} → ${name}`);this.notify('提醒类型已修改')}else{const type={key:`CUSTOM_${Date.now()}`,name,system:false};this.reminderTypes.push(type);this.newAlertForm.typeKey=type.key;this.persist();this.logAudit('新增提醒类型',name);this.notify('提醒类型已添加')}this.resetReminderTypeForm()},
    deleteReminderType(type){if(!this.canManageReminderTypes()){this.notify('当前角色没有管理提醒类型的权限');return}if(type?.system){this.notify('系统提醒类型不能删除，只能修改显示名称');return}const used=this.reminderTypeUsageCount(type?.key);if(used){this.notify(`该类型仍有 ${used} 条独立提醒正在使用，请先删除或更换这些提醒`);return}this.askConfirm({title:'删除提醒类型',message:`确定删除提醒类型【${type?.name||'未命名'}】吗？`,confirmText:'确认删除'},()=>{this.reminderTypes=this.reminderTypes.filter(t=>String(t.key)!==String(type.key));if(String(this.newAlertForm.typeKey)===String(type.key))this.newAlertForm.typeKey='IP';if(String(this.alertTypeFilter)===Strin