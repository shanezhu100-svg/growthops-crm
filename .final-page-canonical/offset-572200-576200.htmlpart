g(type.key))this.alertTypeFilter='ALL';this.persist();this.logAudit('删除提醒类型',type.name||'');this.notify('提醒类型已删除')})},
    addDays(dateStr,n){const d=new Date(dateStr+'T00:00:00');d.setDate(d.getDate()+n);return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`},
    handleAlertComplete(item){if(item.typeKey==='AD_RECHARGE'){const c=this.clients.find(c=>c.id===item.clientId);const account=this.findAccount(item.clientId,item.platform,item.accountId);if(c&&account)this.openRechargeModal(c,item.platform,account);return}if(item.typeKey==='RECEIVABLE'){const r=this.financeReceivables.find(r=>String(r.id)===String(item.receivableId));if(!r){this.notify('应收账单已不存在或已删除');return}this.financePeriod='MONTH';this.financeMonthKey=r.settlementMonth||String(r.dueDate||'').slice(0,7);this.financeClientFilter=r.clientId?String(r.clientId):'ALL';this.navigateTo('finance');this.$nextTick(()=>this.openPaymentModal(r));return}this.openRenewalModal(item)},
    addMonths(dateStr,n){if(!dateStr)return'';const src=new Date(dateStr+'T00:00:00'),day=src.getDate();const d=new Date(src.getFullYear(),src.getMonth()+Number(n||0),1);const last=new Date(d.getFullYear(),d.getMonth()+1,0).getDate();d.setDate(Math.min(day,last));return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`},
    openRenewalModal(item){if(!item||!item.dueDate)return;this.renewalTarget=JSON.parse(JSON.stringify(item));this.renewalForm={mode:'M1',newDueDate:this.addMonths(item.dueDate,1),note:''};this.showRenewalModal=true},
    syncRenewalPreview(){if(!this.renewalTarget)return;const map={M1:1,M3:3,M6:6,M12:12};if(map[this.renewalForm.mode])this.renewalForm.newDueDate=this.addMonths(this.renewalTarget.dueDate,map[this.renewalForm.mode])},
    saveRenewal(){const item=this.renewalTarget;if(!item)return;const newDue=String(this.renewalForm.newDueDate||'');if(!newDue){this.notify('请选择新的到期日期');return}if(newDue<=String(item.dueDate||'')){this.notify('新的到期日期应晚于当前到期日期');return}const note=String(this.renewalForm.note||'').trim();if(item.isStandalone){const a=this.standaloneAlerts.find(a=>String(a.id)===String(item.id));if(a)a.dueDate=newDue}else{const c=this.clients.find(c=>String(c.id)===String(item.clientId));if(!c){this.notify('客户不存在');return}if(item.typeKey==='CONTRACT'){const old=c.endDate;c.endDate=newDue;c.renewalHistory=c.renewalHistory||[];c.renewalHistory.unshift({date:this.localDateKey(),newEndDate:newDue,note:note||`服务合同续费：${old} → ${newDue}`})}else if(item.typeKey==='IP'){const env=(c.networkEnvironments||[]).find(e=>String(e.id)===String(item.networkId));if(env)env.ipDueDate=newDue;else if(c.ipDueDate)c.ipDueDate=newDue;this.syncLegacyNetworkFields(c)}}this.dismissedAlerts=(this.dismissedAlerts||[]).filter(x=>String(x.id)!==String(item.id));let autoBills=0;if(!item.isStandalone&&item.typeKey==='CONTRACT')autoBills=this.ensureAutomaticReceivables({clientId:item.clientId,silent:true});this.persist();this.logAudit('登记续费',`${item.clientName||'独立提醒'} · ${item.type||this.alertTypeName(item.typeKey)} · ${item.dueDate} → ${newDue}${note?' · '+note:''}${autoBills?` · 自动补账 ${autoBills} 条`:''}`);this.showRenewalModal=false;this.renewalTarget=null;this.notify(`续费已保存，新到期日期 ${newDue}${autoBills?`；已自动补齐 ${autoBills} 条应收账单`:''}`)},
    alertDismissKey(item){return `${item?.id||''}|${item?.dueDate||''}|${item?.reminderIndex||0}`},
    isAlertDismissed(item){const key=this.alertDismissKey(item);return !!key&&this.dismissedAlerts.some(x=>String(x.key)===String(key))},
    alertIgnoreFollowupText(item){const idx=Number(item?.reminderIndex||0);if(idx<=1)return'仅忽略当前阶段；进入到期前 3 天和 1 天阶段时会再次提醒。';if(idx===2)return'仅忽略当前阶段；进入到期前 1 �