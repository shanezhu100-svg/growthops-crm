g(type.key))this.alertTypeFilter='ALL';this.persist();this.logAudit('删除提醒类型',type.name||'');this.notify('提醒类型已删除')})},
    addDays(dateStr,n){const d=new Date(dateStr+'T00:00:00');d.setDate(d.getDate()+n);return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`},
    handleAlertComplete(item){if(item.typeKey==='AD_RECHARGE'){const c=this.clients.find(c=>c.id===item.clientId);const account=this.findAccount(item.clientId,item.platform,item.accountId);if(c&&account)this.openRechargeModal(c,item.platform,account);return}if(item.typeKey==='RECEIVABLE'){const r=this.financeReceivables.find(r=>String(r.id)===String(item.receivableId));if(!r){this.notify('应收账单已不存在或已删除');return}this.financePeriod='MONTH';this.financeMonthKey=r.settlementMonth||String(r.dueDate||'').slice(0,7);this.financeClientFilter=r.clientId?String(r.clientId):'ALL';this.navigateTo('finance');this.$nextTick(()=>this.openPaymentModal(r));return}this.openRenewalModal(item)},
    addMonths(dateStr,n){if(!dateStr)return'';const src=new Date(dateStr+'T00:00:00'),day=src.getDate();const d=new Date(src.getFullYear(),src.getMonth()+Number(n||0),1);const last=new Date(d.getFullYear(),d.getMonth()+1,0).getDate();d.setDate(Math.min(day,last));return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`},
    openRenewalModal(item){if(!item||!item.dueDate)return;this.renewalTarget=JSON.parse(JSON.stringify(item));this.renewalForm={mode:'M1',newDueDate:this.addMonths(item.dueDate,1),note:''};this.showRenewalModal=true},
    syncRenewalPreview(){if(!this.renewalTarget)return;const map={M1:1,M3:3,M6:6,M12:12};if(map[this.renewalForm.mode])this.renewalForm.newDueDate=this.addMonths(this.renewalTarget.dueDate,map[this.renewalForm.mode])},
    saveRenewal(){const item=this.renewalTarget;if(!item)return;const newDue=String(this.renewalForm.newDueDate||'');if(!newDue){this.notify('请选择新的到期日期');return}if(newDue<=String(item.dueDate||'')){this.notify('新的到期日期应晚于当前到期日期');return}const note=String(this.renewalForm.note||'').trim();if(item.isStandalone){const a=this.standaloneAlerts.find(a=>String(a.id)===String(item.id));if(a)a.dueDate=newDue}else{const c=this.clients.find(c=>String(c.id)===String(item.clientId));if(!c){this.notify('客户不存在');return}if(item.typeKey==='CONTRACT'){const old=c.endDate;c.endDate=newDue;c.renewalHistory=c.renewalHistory||[];c.renewalHistory.unshift({date:this.localDateKey(),newEndDate:newDue,note:note||`服务合同续费：${old} → ${newDue}`})}else if(item.typeKey==='IP'){const env=(c.networkEnvironments||[]).find(e=>String(e.id)===String(item.networkId));if(env)env.ipDueDate=newDue;else if(c.ipDueDate)c.ipDueDate=newDue;this.syncLegacyNetworkFields(c)}}this.dismissedAlerts=(this.dismissedAlerts||[]).filter(x=>String(x.id)!==String(item.id));let autoBills=0;if(!item.isStandalone&&item.typeKey==='CONTRACT')autoBills=this.ensureAutomaticReceivables({clientId:item.clientId,silent:true});this.persist();this.logAudit('登记续费',`${item.clientName||'独立提醒'} · ${item.type||this.alertTypeName(item.typeKey)} · ${item.dueDate} → ${newDue}${note?' · '+note:''}${autoBills?` · 自动补账 ${autoBills} 条`:''}`);this.showRenewalModal=false;this.renewalTarget=null;this.notify(`续费已保存，新到期日期 ${newDue}${autoBills?`；已自动补齐 ${autoBills} 条应收账单`:''}`)},
    alertDismissKey(item){return `${item?.id||''}|${item?.dueDate||''}|${item?.reminderIndex||0}`},
    isAlertDismissed(item){const key=this.alertDismissKey(item);return !!key&&this.dismissedAlerts.some(x=>String(x.key)===String(key))},
    alertIgnoreFollowupText(item){const idx=Number(item?.reminderIndex||0);if(idx<=1)return'仅忽略当前阶段；进入到期前 3 天和 1 天阶段时会再次提醒。';if(idx===2)return'仅忽略当前阶段；进入到期前 1 天阶段时会再次提醒。';if(item?.typeKey==='RECEIVABLE')return'将忽略当前账单最后阶段提醒；账单完成回款后会自动消失，后续月份的新账单仍会正常提醒。';return'将忽略当前到期周期的最后阶段提醒；如果后续完成续费或修改到期日期，新周期仍会重新提醒。'},
    restoreDismissedAlerts(){const activeKeys=new Set();this.clients.filter(c=>!c.archived).forEach(c=>{const cs=this.autoDueReminderStage(c.endDate);if(c.endDate&&cs)activeKeys.add(`CONTRACT-${c.id}|${c.endDate}|${cs.reminderIndex}`);(c.networkEnvironments||[]).forEach(env=>{const s=this.autoDueReminderStage(env.ipDueDate);if(env.ipDueDate&&s)activeKeys.add(`IP-${c.id}-${env.id}|${env.ipDueDate}|${s.reminderIndex}`)})});this.financeReceivables.filter(r=>this.financeReceivableUnpaid(r)>0&&r.dueDate).forEach(r=>{const stage=this.autoDueReminderStage(r.dueDate);if(stage)activeKeys.add(`RECEIVABLE-${r.id}|${r.dueDate}|${stage.reminderIndex}`)});const count=(this.dismissedAlerts||[]).filter(x=>activeKeys.has(String(x.key))).length;if(!count)return;this.askConfirm({title:'恢复已忽略提醒',message:`将恢复当前阶段的 ${count} 条已忽略提醒，不会修改原始到期日期或应收账单。`,confirmText:'恢复提醒',tone:'warning'},()=>{this.dismissedAlerts=(this.dismissedAlerts||[]).filter(x=>!activeKeys.has(String(x.key)));this.persist();this.logAudit('恢复已忽略提醒',`${count} 条`);this.notify(`已恢复 ${count} 条提醒`)})},
    deleteAlert(item){
      if(!item)return;
      if(item.typeKey==='AD_RECHARGE'){
        this.notify('广告余额提醒由系统自动生成：余额 ≤ $100 首次提醒，≤ $30 二次提醒；充值后余额高于 $100 会自动消失');
        return;
      }
      const clientName=item.clientName||'当前客户';
      const typeName=item.type||this.alertTypeName(item.typeKey)||'到期提醒';
      if(item.isStandalone){
        this.askConfirm({title:'删除独立提醒',message:`确定删除【${clientName}】的【${typeName}】独立提醒吗？

只删除这条独立提醒，不影响客户档案。`,confirmText:'确认删除',tone:'danger'},()=>{this.standaloneAlerts=this.standaloneAlerts.filter(a=>String(a.id)!==String(item.id));this.persist();this.logAudit('删除独立提醒',`${clientName} · ${typeName}`);this.notify('独立提醒已删除')});
        return;
      }
      const followup=this.alertIgnoreFollowupText(item);this.askConfirm({title:'忽略本次到期提醒',message:`确定忽略【${clientName}】的【${typeName}】吗？

不会修改原始到期日期、应收账单或客户资料。${followup}`,confirmText:'确认忽略',tone:'warning'},()=>{const key=this.alertDismissKey(item);if(!this.dismissedAlerts.some(x=>String(x.key)===String(key)))this.dismissedAlerts.unshift({key,id:item.id,dueDate:item.dueDate,typeKey:item.typeKey,clientId:item.clientId,networkId:item.networkId||'',clientName,ignoredAt:new Date().toISOString()});this.persist();this.logAudit('忽略到期提醒',`${clientName} · ${typeName} · ${item.dueDate}`);this.notify(Number(item?.reminderIndex||0)>=3?'当前到期周期提醒已忽略':'当前阶段提醒已忽略，后续阶段仍会再次提醒')});
    },
    normalizeStandaloneAlert(alert){const x={...(alert||{})};delete x.reminderDates;delete x.remindDays;delete x.remindPreset;delete x.customRemindDays;return x},
    standaloneReminderRuleText(alert){return alert?.dueDate?'系统自动提醒：到期前 7 天、3 天、1 天':'请选择到期日期'},
    saveStandaloneAlert(){if(!this.reminderTypeOptions.some(t=>String(t.key)===String(this.newAlertForm.typeKey))){this.notify('请选择有效的提醒类型');return}const dueDate=String(this.newAlertForm.dueDate||'');if(!dueDate){this.notify('请选择到期日期');return}const record={typeKey:this.newAlertForm.typeKey,clientName:this.newAlertForm.clientName,dueDate,cost:this.newAlertForm.cost,target:this.newAlertForm.target,id:'sa-'+Date.now()};this.standaloneAlerts.unshift(record);this.persist();this.logAudit('新增独立提醒',`${record.clientName} · ${record.dueDate} · 自动 7/3/1 天提醒`);this.showAddAlertModal=false;this.newAlertForm={typeKey:'IP',clientName:'',dueDate:'',cost:'',target:''};this.notify('独立提醒已添加 · 系统将在到期前 7 天、3 天、1 天自动提醒')},
    noticeText(item){if(item.typeKey==='AD_RECHARGE'){const account=[item.accountName,item.adAccountId].filter(Boolean).join(' · ')||item.target||'广告账户';return`广告账户：${account}
当前余额：${item.balanceText||this.formatMoney(item.balance||0,'USD')}`;}if(item.typeKey==='RECEIVABLE')return`【回款提醒】${item.clientName} 的 ${item.target||'应收账单'} 到期日为 ${item.dueDate}（${this.daysLeftLabel(item.daysLeft)}）。${item.cost||''}。请及时跟进回款。`;return`【提醒】${item.clientName} 的「${item.type}」计划日期为 ${item.dueDate}（${this.daysLeftLabel(item.daysLeft)}）。${item.cost?`费用：${item.cost}。`:''}${item.target?`${item.typeKey==='CONTRACT'?'产品/服务':'环境/平台'}：${item.target}。`:''}请及时确认是否续费。`},
    async copyText(t){const text=String(t??'');try{if(navigator.clipboard?.writeText){await navigator.clipboard.writeText(text);this.notify('已复制到剪贴板');return}}catch(e){}try{const ta=document.createElement('textarea');ta.value=text;ta.setAttribute('readonly','');ta.style.position='fixed';ta.style.opacity='0';document.body.appendChild(ta);ta.select();const ok=document.execCommand&&document.execCommand('copy');document.body.removeChild(ta);if(ok){this.notify('已复制到剪贴板');return}}catch(e){}this.notify('复制失败，请手动选择文本复制')},
    copyIndividualNotice(item){this.copyText(this.noticeText(item))},
    copyNoticeSummary(){const text=`【客户运营提醒 · ${new Date().toLocaleDateString('zh-CN')}】

`+this.alertList.map((a,i)=>a.typeKey==='AD_RECHARGE'?`${i+1}. ${a.clientName}｜${a.type}｜当前余额 ${a.balanceText}｜${a.balanceStage==='CRITICAL'?'二次提醒 ≤ $30':'首次提醒 ≤ $100'}｜${a.target||''}`:`${i+1}. ${a.clientName}｜${a.type}｜${a.dueDate}｜${this.daysLeftLabel(a.daysLeft)}｜${a.cost||'无费用记录'}`).join('\n');this.copyText(text)},
    defaultLeadForm(){return{id:null,company:'',contact:'',contactInfo:'',source:'网站询盘',platformInterest:'FB+TK',budgetCurrency:'USD',expectedBudget:'',quoteCurrency:'USD',adQuote:'',stage:'NEW',nextFollowUp:'',owner:'',notes:'',createdAt:'',convertedClientId:null,convertedAt:''}},
    openLeadModal(lead=null){this.leadForm=lead?JSON.parse(JSON.stringify(lead)):this.defaultLeadForm();this.showLeadModal=true},
    saveLead(){if(!this.leadForm.company)return;const payload={...this.leadForm,expectedBudget:Number(this.leadForm.expectedBudget||0),adQuote:Number(this.leadForm.adQuote||0),quoteCurrency:this.leadForm.quoteCurrency||this.leadForm.budgetCurrency||'USD'};if(payload.convertedClientId)payload.stage='WON';if(['WON','LOST'].includes(payload.stage))payload.nextFollowUp='';if(payload.id){const i=this.leads.findIndex(l=>l.id===payload.id);if(i>-1)this.leads[i]=payload}else this.leads.unshift({...payload,id:this.accountUid('lead'),createdAt:this.localDateKey()});this.persist();this.showLeadModal=false;this.logAudit(payload.id?'修改潜在客户':'新增潜在客户',`${payload.company} · ${this.leadStageText(payload.stage)}`);if(payload.stage==='WON'&&!payload.convertedClientId){this.leadPoolFilter='WON';this.leadQuickFilter='ALL';this.notify('已标记为成交；请在“已成交”中创建正式客户档案')}else if(payload.stage==='LOST'){this.leadPoolFilter='LOST';this.leadQuickFilter='ALL';this.notify('已移入流失历史')}else{this.leadPoolFilter='ACTIVE';this.leadQuickFilter='ALL';this.notify('潜在客户已保存')}},
    deleteLead(lead){if(!lead)return;this.askConfirm({title:'删除潜在客户',message:`确定删除潜在客户【${lead.company}】吗？
该线索的联系人、报价、跟进阶段和备注都会一并删除。`,confirmText:'确认删除'},()=>{this.leads=this.leads.filter(l=>String(l.id)!==String(lead.id));this.persist();this.logAudit('删除潜在客户',lead.company);this.notify(`潜在客户【${lead.company}】已删除`)})},
    leadStageText(stage){return({NEW:'新线索',CONTACTED:'已联系',QUALIFIED:'已确认需求',PROPOSAL:'报价 / 方案中',WON:'已成交',LOST:'已流失'})[stage]||'新线索'},
    leadStageStyle(stage){return({NEW:'bg-slate-100 text-slate-600',CONTACTED:'bg-blue-50 text-blue-700',QUALIFIED:'bg-cyan-50 text-cyan-700',PROPOSAL:'bg-amber-50 text-amber-700',WON:'bg-emerald-50 text-emerald-700',LOST:'bg-rose-50 text-rose-600'})[stage]||'bg-slate-100 text-slate-600'},
    followupLabel(date){if(!date)return'';const d=this.daysUntil(date);if(d<0)return`已逾期 ${Math.abs(d)} 天`;if(d===0)return'今天跟进';if(d===1)return'明天跟进';return`${d} 天后跟进`},
    leadFollowupClass(lead){if(!lead.nextFollowUp||['WON','LOST'].includes(lead.stage))return'text-slate-600';return this.daysUntil(lead.nextFollowUp)<=0?'text-rose-600':'text-slate-700'},
    convertLeadToClient(lead){if(lead?.convertedClientId){this.openConvertedLeadClient(lead);return}const f=this.defaultForm();f.sourceLeadId=lead.id;f.name=lead.company||'';f.product='广告投放服务';f.platform=lead.platformInterest||'FB+TK';f.project='广告开户 / 投放合作';const hasQuote=Number(lead.adQuote||0)>0;f.currency=hasQuote?(lead.quoteCurrency||lead.budgetCurrency||'USD'):(lead.budgetCurrency||'USD');f.monthlyFee=hasQuote?Number(lead.adQuote||0):Number(lead.expectedBudget||0);f.startDate=this.localDateKey();f.endDate=this.addDays(this.localDateKey(),30);if(f.platform==='FB')f.tkAccounts=[];if(f.platform==='TK')f.fbAccounts=[];this.form=f;this.showLeadModal=false;this.notify('已带入正式客户资料；保存成功后会自动移出当前潜客池、进入成交历史，并自动进入应收管理');this.navigateTo('client-form')},
    openConvertedLeadClient(lead){const client=this.clients.find(c=>String(c.id)===String(lead?.convertedClientId));if(!client){this.notify('关联的正式客户已不存在，请重新确认合作');lead.convertedClientId=null;lead.convertedAt='';this.persist();return}this.selectedClientId=client.id;this.navigateTo('client-detail')},
    defaultOpeningForm(){return{id:null,clientId:null,externalClientName:'',providerId:this.openingProviders[0]?.id||'',contactId:'',platform:'FB',accountType:'企业广告账户',region:'',quantity:1,partnerName:'',contactName:'',contactInfo:'',currency:'USD',fee:'',status:'PREPARE',submitDate:'',expectedDate:'',effectiveStartDate:this.localDateKey(),effectiveEndDate:'',businessId:'',accountScope:'SPECIFIC',adAccountIds:'',notes:''}},
    defaultProviderForm(){return{id:null,name:'',platforms:'FB+TK',region:'',website:'',contacts:[],contactName:'',contactPhone:'',contactWechat:'',contactEmail:'',rebateRate:0,rebatePolicy:'',policy:'',notes:''}},
    openOpeningModal(deal=null){this.openingForm=deal?{...this.defaultOpeningForm(),...JSON.parse(JSON.stringify(deal))}:this.defaultOpeningForm();if(deal&&(deal.effectiveStartDate===undefined||deal.effectiveStartDate===null))this.openingForm.effectiveStartDate=deal.submitDate||'';if(!deal)this.applyProviderToOpeningForm();else{const p=this.openingProvider(this.openingForm);if(p&&this.openingForm.contactId&&!this.openingContact(this.openingForm))this.openingForm.contactId=''}if(!['SPECIFIC','ALL'].includes(this.openingForm.accountScope))this.openingForm.accountScope='SPECIFIC';this.syncOpeningAccountSelection();this.showOpeningModal=true},
    saveOpeningDeal(){if(!this.openingForm.clientId&&!this.openingForm.externalClientName){this.notify('请选择关联客户或填写外部客户名称');return}if(!this.openingForm.providerId){this.notify('请选择开户商渠道');return}const provider=this.openingProvider(this.openingF