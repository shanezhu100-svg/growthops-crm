��【${lead.company}】吗？\n该线索的联系人、报价、跟进阶段和备注都会一并删除。`,confirmText:'确认删除'},()=>{this.leads=this.leads.filter(l=>String(l.id)!==String(lead.id));this.persist();this.logAudit('删除潜在客户',lead.company);this.notify(`潜在客户【${lead.company}】已删除`)})},
    leadStageText(stage){return({NEW:'新线索',CONTACTED:'已联系',QUALIFIED:'已确认需求',PROPOSAL:'报价 / 方案中',WON:'已成交',LOST:'已流失'})[stage]||'新线索'},
    leadStageStyle(stage){return({NEW:'bg-slate-100 text-slate-600',CONTACTED:'bg-blue-50 text-blue-700',QUALIFIED:'bg-cyan-50 text-cyan-700',PROPOSAL:'bg-amber-50 text-amber-700',WON:'bg-emerald-50 text-emerald-700',LOST:'bg-rose-50 text-rose-600'})[stage]||'bg-slate-100 text-slate-600'},
    followupLabel(date){if(!date)return'';const d=this.daysUntil(date);if(d<0)return`已逾期 ${Math.abs(d)} 天`;if(d===0)return'今天跟进';if(d===1)return'明天跟进';return`${d} 天后跟进`},
    leadFollowupClass(lead){if(!lead.nextFollowUp||['WON','LOST'].includes(lead.stage))return'text-slate-600';return this.daysUntil(lead.nextFollowUp)<=0?'text-rose-600':'text-slate-700'},
    convertLeadToClient(lead){if(lead?.convertedClientId){this.openConvertedLeadClient(lead);return}const f=this.defaultForm();f.sourceLeadId=lead.id;f.name=lead.company||'';f.product='广告投放服务';f.platform=lead.platformInterest||'FB+TK';f.project='广告开户 / 投放合作';const hasQuote=Number(lead.adQuote||0)>0;f.currency=hasQuote?(lead.quoteCurrency||lead.budgetCurrency||'USD'):(lead.budgetCurrency||'USD');f.monthlyFee=hasQuote?Number(lead.adQuote||0):Number(lead.expectedBudget||0);f.startDate=this.localDateKey();f.endDate=this.addDays(this.localDateKey(),30);if(f.platform==='FB')f.tkAccounts=[];if(f.platform==='TK')f.fbAccounts=[];this.form=f;this.showLeadModal=false;this.notify('已带入正式客户资料；保存成功后会自动移出当前潜客池、进入成交历�