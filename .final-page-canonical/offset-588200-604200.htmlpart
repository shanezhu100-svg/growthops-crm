orm);const contacts=this.openingProviderContacts(this.openingForm);if(contacts.length&&!this.openingForm.contactId){this.notify('请选择该开户商的具体对接人');return}const contact=this.openingContact(this.openingForm);if(this.openingForm.contactId&&!contact){this.notify('当前对接人已不存在，请重新选择');return}const previous=this.openingForm.id?this.openingDeals.find(d=>String(d.id)===String(this.openingForm.id)):null;let effectiveStartDate=this.openingForm.effectiveStartDate||this.openingForm.submitDate||this.localDateKey();if(this.openingForm.status==='OPENED'&&(!previous||previous.status!=='OPENED')&&(!this.openingForm.effectiveStartDate||!previous||String(this.openingForm.effectiveStartDate)===String(previous.effectiveStartDate||previous.submitDate||'')))effectiveStartDate=this.localDateKey();const effectiveEndDate=this.openingForm.effectiveEndDate||'';if(effectiveEndDate&&effectiveEndDate<effectiveStartDate){this.notify('渠道 / 返点结束日期不能早于生效日期');return}if(this.openingForm.clientId&&this.openingForm.adAccountIds&&this.openingDealUnmatchedIds(this.openingForm).length){this.notify(`广告账户 ID 未匹配：${this.openingDealUnmatchedIds(this.openingForm).join('、')}。请先修正账号 ID，避免消耗和返点归集错误。`);return}const noRebateAccounts=this.openingDealMatchedAccounts(this.openingForm).filter(a=>this.accountRebateMode(a)==='NONE');if(noRebateAccounts.length){this.notify(`以下广告账户已设置为“无返点 / 客户自有账户”，不能绑定返点渠道：${noRebateAccounts.map(a=>a.accountName||a.adAccountId).join('、')}`);return}let payload={...this.openingForm,effectiveStartDate,effectiveEndDate,partnerName:provider?.name||this.openingForm.partnerName||'',contactName:contact?.name||this.openingForm.contactName||'',contactInfo:'',quantity:Number(this.openingForm.quantity||1),fee:Number(this.openingForm.fee||0)};const isEdit=!!payload.id;if(isEdit){const i=this.openingDeals.findIndex(d=>String(d.id)===String(payload.id));if(i>-1)this.openingDeals[i]=payload}else{payload={...payload,id:this.accountUid('opening')};this.openingDeals.unshift(payload)}const costSync=this.syncOpeningFeeCost(payload);this.persist();this.showOpeningModal=false;this.logAudit(isEdit?'修改客户开户渠道':'新增客户开户渠道',`${this.openingClientName(payload)} · ${provider?.name||'未设置'} / ${contact?.name||'未设置'} · ${effectiveStartDate} → ${effectiveEndDate||'持续'}${payload.status==='OPENED'?' · 已进入财务归属':' · 暂不进入财务归属'}`);this.notify(`客户开户渠道已保存${payload.status==='OPENED'?' · 已开户状态开始参与消耗和返点':' · 当前状态不参与财务'}${costSync>0?' · 开户费已自动计入成本':''}`)},
    deleteOpeningDeal(deal){
      if(!deal?.id){this.notify('未找到这条开户渠道记录');return}
      const clientName=this.openingClientName(deal),providerName=this.openingProviderName(deal),contactName=this.openingContactName(deal);
      this.askConfirm({
        title:'删除客户开户渠道记录',
        message:`确定删除【${clientName}】的开户渠道记录吗？

开户商：${providerName}
对接人：${contactName}
平台：${deal.platform==='TK'?'TikTok':'Facebook'}

只删除这条开户关联记录，不会删除客户、开户商或广告账户。`,
        confirmText:'确认删除',tone:'danger'
      },()=>{
        const before=this.openingDeals.length;
        this.openingDeals=this.openingDeals.filter(d=>String(d.id)!==String(deal.id));
        if(this.openingDeals.length===before){this.notify('没有找到可删除的开户渠道记录，请刷新页面后重试');return}
        const linkedCost=this.financeCosts.find(c=>c.sourceType==='OPENING_DEAL'&&String(c.sourceId)===String(deal.id));if(linkedCost&&!this.isMonthLocked(String(linkedCost.date||'').slice(0,7)))this.financeCosts=this.financeCosts.filter(c=>String(c.id)!==String(linkedCost.id));
        this.persist();
        this.logAudit('删除客户开户渠道',`${clientName} · ${providerName} · ${contactName}`);
        this.notify('客户开户渠道记录已删除');
      });
    },
    openProviderModal(provider=null){if(!this.canManageProviders()){this.notify('开户商资料与返点政策仅管理员 / 财务可维护');return}this.providerForm=provider?JSON.parse(JSON.stringify(this.normalizeOpeningProvider(provider))):this.defaultProviderForm();this.showProviderModal=true},
    addProviderContact(){if(!Array.isArray(this.providerForm.contacts))this.providerForm.contacts=[];this.providerForm.contacts.push({id:this.accountUid('contact'),name:'',phone:'',wechat:'',email:'',rebateRate:0,rebatePolicy:'',rebatePolicies:[{id:this.accountUid('policy'),effectiveDate:this.localDateKey(),rebateRate:0,rebatePolicy:''}]})},
    addContactRebatePolicy(contact){if(!contact)return;if(!Array.isArray(contact.rebatePolicies))contact.rebatePolicies=[];contact.rebatePolicies.push({id:this.accountUid('policy'),effectiveDate:this.localDateKey(),rebateRate:this.contactCurrentRebateRate(contact),rebatePolicy:''})},
    removeContactRebatePolicy(contact,index){if(!contact||!Array.isArray(contact.rebatePolicies)||contact.rebatePolicies.length<=1)return;contact.rebatePolicies.splice(index,1)},
    removeProviderContact(index,contact){if(this.providerForm.id&&contact?.id){const used=this.openingDeals.filter(d=>String(d.providerId)===String(this.providerForm.id)&&String(d.contactId||'')===String(contact.id));if(used.length){this.notify(`对接人【${contact.name||'未命名'}】仍关联 ${used.length} 条客户开户记录，请先为这些客户更换对接人`);return}}this.providerForm.contacts.splice(index,1)},
    saveOpeningProvider(){if(!this.canManageProviders()){this.notify('当前角色没有维护开户商资料的权限');return}if(!this.providerForm.name?.trim()){this.notify('请填写开户商名称');return}const contacts=(this.providerForm.contacts||[]).map((c,idx)=>({...c,name:String(c.name||'').trim(),id:c.id||this.accountUid(`contact-${idx+1}`),rebatePolicies:(c.rebatePolicies||[]).map((p,pidx)=>({id:p.id||this.accountUid(`policy-${pidx+1}`),effectiveDate:p.effectiveDate||'',rebateRate:Number(p.rebateRate||0),rebatePolicy:String(p.rebatePolicy||'').trim()}))}));for(const c of contacts){if(!c.name){this.notify('每个对接人都需要填写名称');return}if(!c.rebatePolicies.length){this.notify(`对接人【${c.name}】至少保留一条返点政策`);return}const dates=new Set();for(const p of c.rebatePolicies){if(!p.effectiveDate){this.notify(`对接人【${c.name}】的返点政策需要填写生效日期`);return}if(dates.has(p.effectiveDate)){this.notify(`对接人【${c.name}】同一天只能有一条返点政策`);return}dates.add(p.effectiveDate);if(!Number.isFinite(p.rebateRate)||p.rebateRate<0||p.rebateRate>100){this.notify(`对接人【${c.name}】返点比例请输入 0–100 之间的数字`);return}}}const payload=this.normalizeOpeningProvider({...this.providerForm,name:this.providerForm.name.trim(),contacts});if(payload.id){const i=this.openingProviders.findIndex(p=>String(p.id)===String(payload.id));if(i>-1)this.openingProviders[i]=payload;this.openingDeals.forEach(d=>{if(String(d.providerId)!==String(payload.id))return;d.partnerName=payload.name;const c=payload.contacts.find(x=>String(x.id)===String(d.contactId||''));if(c){d.contactName=c.name;d.contactInfo=''}})}else this.openingProviders.push({...payload,id:this.accountUid('provider')});this.persist();this.showProviderModal=false;this.logAudit(payload.id?'修改开户商资料':'新增开户商',`${payload.name} · ${payload.contacts.length} 位对接人`);this.notify(`开户商资料已保存 · ${payload.contacts.length} 位对接人独立返点`)},
    deleteOpeningProvider(provider){
      if(!this.canManageProviders()){this.notify('当前角色没有删除开户商的权限');return}
      if(!provider?.id){this.notify('未找到开户商资料');return}
      const used=this.openingDeals.filter(d=>String(d.providerId)===String(provider.id));
      if(used.length){this.notify(`删除受保护：该开户商仍关联 ${used.length} 条客户开户记录，请先为这些记录更换开户商后再删除。`);return}
      this.askConfirm({title:'删除开户商',message:`确定删除开户商【${provider.name}】吗？

该开户商当前没有客户开户记录关联。`,confirmText:'确认删除',tone:'danger'},()=>{
        this.openingProviders=this.openingProviders.filter(p=>String(p.id)!==String(provider.id));
        this.persist();this.showProviderModal=false;this.logAudit('删除开户商',provider.name);this.notify('开户商已删除');
      });
    },
    normalizeOpeningProvider(provider){const p={...provider};const legacyRate=Math.max(0,Math.min(100,Number(p.rebateRate||0)||0));let contacts=Array.isArray(p.contacts)?p.contacts.map(c=>({...c})):[];const hasLegacyContact=!!(p.contactName||p.contactPhone||p.contactWechat||p.contactEmail||legacyRate||p.rebatePolicy);if(!contacts.length&&hasLegacyContact)contacts=[{id:`contact-${p.id||'legacy'}-1`,name:p.contactName||'默认对接人',phone:p.contactPhone||'',wechat:p.contactWechat||'',email:p.contactEmail||'',rebateRate:legacyRate,rebatePolicy:p.rebatePolicy||''}];contacts=contacts.map((c,idx)=>{let rate=Number(c.rebateRate||0);if(!Number.isFinite(rate))rate=0;rate=Math.max(0,Math.min(100,rate));let policies=Array.isArray(c.rebatePolicies)?c.rebatePolicies.map((rp,pidx)=>({id:rp.id||`policy-${p.id||'provider'}-${idx+1}-${pidx+1}`,effectiveDate:rp.effectiveDate||'1900-01-01',rebateRate:Math.max(0,Math.min(100,Number(rp.rebateRate??rp.rate??0)||0)),rebatePolicy:rp.rebatePolicy||rp.note||''})):[];if(!policies.length)policies=[{id:`policy-${p.id||'provider'}-${idx+1}-legacy`,effectiveDate:'1900-01-01',rebateRate:rate,rebatePolicy:c.rebatePolicy||''}];policies.sort((a,b)=>String(a.effectiveDate).localeCompare(String(b.effectiveDate)));const latest=policies[policies.length-1];return{id:c.id||`contact-${p.id||'provider'}-${idx+1}`,name:String(c.name||`对接人 ${idx+1}`).trim(),phone:c.phone||c.contactPhone||'',wechat:c.wechat||c.contactWechat||'',email:c.email||c.contactEmail||'',rebateRate:Number(latest?.rebateRate||0),rebatePolicy:latest?.rebatePolicy||'',rebatePolicies:policies}});p.contacts=contacts;const first=contacts[0];p.contactName=first?.name||p.contactName||'';p.contactPhone=first?.phone||p.contactPhone||'';p.contactWechat=first?.wechat||p.contactWechat||'';p.contactEmail=first?.email||p.contactEmail||'';p.rebateRate=first?Number(first.rebateRate||0):legacyRate;p.rebatePolicy=first?.rebatePolicy||p.rebatePolicy||'';if(p.policy===undefined)p.policy='';return p},
    migrateOpeningDeals(){this.openingDeals=this.openingDeals.map(d=>{const copy={...d};if(!copy.providerId&&copy.partnerName){const p=this.openingProviders.find(p=>String(p.name).trim()===String(copy.partnerName).trim());if(p)copy.providerId=p.id}const p=this.openingProviders.find(p=>String(p.id)===String(copy.providerId));if(copy.providerId&&!copy.partnerName)copy.partnerName=p?.name||'';if(copy.contactName===undefined)copy.contactName='';if(copy.contactInfo===undefined)copy.contactInfo='';if(copy.contactId===undefined)copy.contactId='';if(copy.effectiveStartDate===undefined||copy.effectiveStartDate===null)copy.effectiveStartDate=copy.submitDate||'';if(copy.effectiveEndDate===undefined||copy.effectiveEndDate===null)copy.effectiveEndDate='';if(!['SPECIFIC','ALL'].includes(copy.accountScope))copy.accountScope='SPECIFIC';if(p){let c=p.contacts?.find(x=>String(x.id)===String(copy.contactId||''));if(!c&&copy.contactName)c=p.contacts?.find(x=>String(x.name).trim()===String(copy.contactName).trim());if(c){copy.contactId=c.id;copy.contactName=c.name;if(!copy.contactInfo){const info=this.providerContactText(c);copy.contactInfo=info==='未维护联系方式'?'':info}}else if(!copy.contactId){copy.contactName=''}}return copy})},
    openingClientName(deal){return this.clients.find(c=>String(c.id)===String(deal.clientId))?.name||deal.externalClientName||'未命名项目'},
    openingProvider(deal){return this.openingProviders.find(p=>String(p.id)===String(deal?.providerId))||null},
    openingProviderName(deal){return this.openingProvider(deal)?.name||deal?.partnerName||'未选择开户商'},
    openingProviderContacts(dealOrProvider){const p=dealOrProvider?.contacts?dealOrProvider:this.openingProvider(dealOrProvider);return p?.contacts||[]},
    openingContact(deal){const p=this.openingProvider(deal);if(!p)return null;let c=(p.contacts||[]).find(x=>String(x.id)===String(deal?.contactId||''));if(!c&&deal?.contactName)c=(p.contacts||[]).find(x=>String(x.name).trim()===String(deal.contactName).trim());return c||null},
    openingContactName(deal){const c=this.openingContact(deal);if(c)return c.name;const p=this.openingProvider(deal);if(p)return (p.contacts||[]).length?'未绑定对接人':'未设置对接人';return deal?.contactName||'未设置对接人'},
    providerContactText(contactOrProvider){if(!contactOrProvider)return'—';const phone=contactOrProvider.phone||contactOrProvider.contactPhone||'';const wechat=contactOrProvider.wechat||contactOrProvider.contactWechat||'';const email=contactOrProvider.email||contactOrProvider.contactEmail||'';const parts=[];if(phone)parts.push(phone);if(wechat)parts.push(`微信 ${wechat}`);if(email)parts.push(email);return parts.join(' · ')||'未维护联系方式'},
    openingContactInfoText(deal){const c=this.openingContact(deal);const live=c?this.providerContactText(c):'';return live&&live!=='未维护联系方式'?live:(deal?.contactInfo||'未维护联系方式')},
    rebatePolicyForContact(contact,date=null){if(!contact)return null;const target=String(date||this.localDateKey()).slice(0,10);const policies=(Array.isArray(contact.rebatePolicies)?contact.rebatePolicies:[]).map(p=>({...p,rebateRate:Number(p.rebateRate??p.rate??0)||0,effectiveDate:p.effectiveDate||'1900-01-01'})).sort((a,b)=>String(a.effectiveDate).localeCompare(String(b.effectiveDate)));if(!policies.length)return{effectiveDate:'1900-01-01',rebateRate:Number(contact.rebateRate||0),rebatePolicy:contact.rebatePolicy||''};return[...policies].reverse().find(p=>String(p.effectiveDate)<=target)||{effectiveDate:'',rebateRate:0,rebatePolicy:'尚未到首条返点政策生效日期'}},
    contactCurrentRebateRate(contact){return Number(this.rebatePolicyForContact(contact,this.localDateKey())?.rebateRate||0)},
    openingDealRebateRate(deal,date=null){const c=this.openingContact(deal);return Number(this.rebatePolicyForContact(c,date)?.rebateRate||0)},
    openingDealRebatePolicy(deal,date=null){const c=this.openingContact(deal);return this.rebatePolicyForContact(c,date)?.rebatePolicy||''},
    accountRebateMode(account){return account?.rebateMode==='NONE'?'NONE':'CHANNEL'},
    accountRebateModeText(account){return this.accountRebateMode(account)==='NONE'?'无返点 / 客户自有账户':'有渠道返点'},
    providerRateRangeText(provider){const rates=(provider?.contacts||[]).map(c=>this.contactCurrentRebateRate(c));if(!rates.length)return'未设置返点';const min=Math.min(...rates),max=Math.max(...rates);return min===max?`当前返点 ${min.toFixed(2)}%`:`当前返点 ${min.toFixed(2)}%–${max.toFixed(2)}%`},
    applyProviderToOpeningForm(){const p=this.openingProvider(this.openingForm);if(!p)return;this.openingForm.partnerName=p.name;const contacts=p.contacts||[];if(!contacts.some(c=>String(c.id)===String(this.openingForm.contactId||'')))this.openingForm.contactId='';this.applyOpeningContactToForm();if(!this.openingForm.region)this.openingForm.region=p.region||'';if(p.platforms==='FB'||p.platforms==='TK')this.openingForm.platform=p.platforms;this.syncOpeningAccountSelection()},
    applyOpeningContactToForm(){const c=this.openingContact(this.openingForm);if(c){this.openingForm.contactName=c.name;this.openingForm.contactInfo=''}else{this.opening