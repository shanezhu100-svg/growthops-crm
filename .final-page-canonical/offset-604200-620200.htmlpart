Form.contactName='';this.openingForm.contactInfo=''}},
    visibleProviderContactRows(row){const rows=row?.contactRows||[];const selected=this.openingContactSelections?.[row?.provider?.id]||'ALL';return selected==='ALL'?rows:rows.filter(cr=>String(cr.contact?.id)===String(selected))},
    openingStatusText(status){return({PREPARE:'资料准备',SUBMITTED:'已提交',REVIEWING:'审核中',OPENED:'已开户',REJECTED:'异常 / 驳回'})[status]||'资料准备'},
    openingStatusStyle(status){return({PREPARE:'bg-slate-100 text-slate-600',SUBMITTED:'bg-blue-50 text-blue-700',REVIEWING:'bg-amber-50 text-amber-700',OPENED:'bg-emerald-50 text-emerald-700',REJECTED:'bg-rose-50 text-rose-600'})[status]||'bg-slate-100 text-slate-600'},
    openingPeriodMatchFor(date,period='MONTH'){if(period==='ALL')return true;if(!date)return false;const d=new Date(`${date}T00:00:00`);if(Number.isNaN(d.getTime()))return false;const y=d.getFullYear(),m=d.getMonth()+1;if(period==='MONTH'){const [targetY,targetM]=String(this.openingMonthKey||'').split('-').map(Number);return y===targetY&&m===targetM}if(period==='QUARTER')return y===Number(this.openingQuarterYear)&&Math.floor((m-1)/3)+1===Number(this.openingQuarter);if(period==='YEAR')return y===Number(this.openingYear);return false},
    openingPeriodMatch(date){return this.openingPeriodMatchFor(date,this.openingSpendPeriod)},
    openingDealAccountIds(deal){return[...new Set(String(deal?.adAccountIds||'').split(/[\s,，;；]+/).map(s=>s.trim()).filter(Boolean))]},
    openingAccountOptions(deal){const client=this.clients.find(c=>String(c.id)===String(deal?.clientId));if(!client)return[];return(deal?.platform==='TK'?(client.tkAccounts||[]):(client.fbAccounts||[])).map((a,idx)=>({id:String(a.adAccountId||'').trim(),accountId:a.id,name:a.accountName||`${deal?.platform==='TK'?'TikTok':'Facebook'} 账号 ${idx+1}`})).filter(x=>x.id)},
    openingDealMatchedAccounts(deal){const client=this.clients.find(c=>String(c.id)===String(deal?.clientId));if(!client)return[];const accounts=deal?.platform==='TK'?(client.tkAccounts||[]):(client.fbAccounts||[]);if(deal?.accountScope==='ALL')return accounts;const ids=this.openingDealAccountIds(deal);if(!ids.length)return[];return accounts.filter(a=>ids.includes(String(a.adAccountId||'').trim()))},
    openingAccountSelected(deal,id){return this.openingDealAccountIds(deal).includes(String(id||''))},
    toggleOpeningAccount(id,checked){const ids=new Set(this.openingDealAccountIds(this.openingForm));checked?ids.add(String(id)):ids.delete(String(id));this.openingForm.adAccountIds=[...ids].join(', ')},
    syncOpeningAccountSelection(){if(!this.openingForm)return;const valid=new Set(this.openingAccountOptions(this.openingForm).map(x=>x.id));if(this.openingForm.accountScope==='SPECIFIC')this.openingForm.adAccountIds=this.openingDealAccountIds(this.openingForm).filter(id=>valid.has(id)).join(', ')},
    openingDealUnmatchedIds(deal){const ids=this.openingDealAccountIds(deal);if(!ids.length)return[];const matched=new Set(this.openingDealMatchedAccounts(deal).map(a=>String(a.adAccountId||'').trim()));return ids.filter(id=>!matched.has(id))},
    openingDealAccountMatchText(deal){const ids=this.openingDealAccountIds(deal),matched=this.openingDealMatchedAccounts(deal),missing=this.openingDealUnmatchedIds(deal);if(deal?.accountScope==='ALL')return`${matched.length} 个关联广告账户 · 明确选择平台全部账户`;if(!ids.length)return'尚未选择广告账户';if(missing.length)return`ID 未匹配：${missing.join('、')} · 已匹配 ${matched.length}/${ids.length}`;return`${matched.length} 个关联广告账户 · 已明确绑定`},
    openingDealEffectiveStart(deal){return deal?.effectiveStartDate||deal?.submitDate||''},
    openingDealAppliesToDate(deal,date){const d=String(date||'').slice(0,10);if(!d)return false;const start=this.openingDealEffectiveStart(deal),end=deal?.effectiveEndDate||'';return(!start||d>=start)&&(!end||d<=end)},
    openingDealOwnerForRecord(clientId,platform,account,date){if(!account||!date||this.accountRebateMode(account)!=='CHANNEL')return null;return this.openingDeals.filter(d=>d.status==='OPENED'&&String(d.clientId)===String(clientId)&&String(d.platform||'FB')===String(platform||'FB')&&this.openingDealAppliesToDate(d,date)&&this.openingDealMatchedAccounts(d).some(a=>String(a.id||a.adAccountId)===String(account.id||account.adAccountId))).sort((a,b)=>String(this.openingDealEffectiveStart(b)||'0000-00-00').localeCompare(String(this.openingDealEffectiveStart(a)||'0000-00-00'))||String(b.submitDate||'').localeCompare(String(a.submitDate||''))||String(b.id||'').localeCompare(String(a.id||'')))[0]||null},
    openingDealOwnsRecord(deal,account,date){if(!deal||deal.status!=='OPENED'||!account||!date||!this.openingDealAppliesToDate(deal,date))return false;const owner=this.openingDealOwnerForRecord(deal.clientId,deal.platform,account,date);return String(owner?.id||'')===String(deal.id||'')},
    openingDealSpendGroupsForPeriod(deal,period=this.openingSpendPeriod){const groups={};this.openingDealMatchedAccounts(deal).forEach(account=>(account.adDataRecords||[]).filter(r=>this.openingPeriodMatchFor(r.date,period)&&this.openingDealOwnsRecord(deal,account,r.date)).forEach(r=>{const cur=r.currency||account.adSpendCurrency||'USD';groups[cur]=(groups[cur]||0)+Number(r.spend||0)}));return groups},
    openingDealSpendGroups(deal){return this.openingDealSpendGroupsForPeriod(deal,this.openingSpendPeriod)},
    openingDealSpendText(deal){return this.spendGroupsText(this.openingDealSpendGroups(deal))},
    openingDealRebateText(deal){return this.spendGroupsText(this.openingDealsFinancialsForPeriod([deal],this.openingSpendPeriod).rebateGroups)},
    openingDealsFinancialsForPeriod(deals,period=this.openingSpendPeriod){const spendGroups={},rebateGroups={};(deals||[]).forEach(deal=>{this.openingDealMatchedAccounts(deal).forEach(account=>(account.adDataRecords||[]).filter(r=>this.openingPeriodMatchFor(r.date,period)&&this.openingDealOwnsRecord(deal,account,r.date)).forEach(r=>{const cur=r.currency||account.adSpendCurrency||'USD',amount=Number(r.spend||0),rate=this.openingDealRebateRate(deal,r.date);spendGroups[cur]=(spendGroups[cur]||0)+amount;rebateGroups[cur]=(rebateGroups[cur]||0)+amount*Number(rate||0)/100}))});return{spendGroups,rebateGroups}},
    openingDealsSpendGroupsUniqueForPeriod(deals,period=this.openingSpendPeriod){return this.openingDealsFinancialsForPeriod(deals,period).spendGroups},
    openingDealsRebateGroupsUniqueForPeriod(deals,period=this.openingSpendPeriod){return this.openingDealsFinancialsForPeriod(deals,period).rebateGroups},
    openingDealsSpendGroupsUnique(deals){return this.openingDealsSpendGroupsUniqueForPeriod(deals,this.openingSpendPeriod)},
    rebateGroups(groups,rate){const out={};Object.entries(groups||{}).forEach(([cur,value])=>{out[cur]=Number(value||0)*Number(rate||0)/100});return out},
    openingProvidersRebateGroups(period=this.openingSpendPeriod,providerFilter=this.openingProviderFilter){const deals=providerFilter==='ALL'?this.openingDeals:this.openingDeals.filter(d=>String(d.providerId||'')===String(providerFilter));return this.openingDealsRebateGroupsUniqueForPeriod(deals,period)},
    mergeSpendGroups(target,source){Object.entries(source||{}).forEach(([cur,val])=>target[cur]=(target[cur]||0)+Number(val||0));return target},
    financeAdSpendGroups(clientId=null,months=null,mode='ALL'){const groups={},allowed=new Set(Array.isArray(months)?months:this.financePeriodMonths());this.clients.filter(c=>clientId===null||clientId===undefined||String(c.id)===String(clientId)).forEach(client=>{[['FB',client.fbAccounts||[]],['TK',client.tkAccounts||[]]].forEach(([platform,accounts])=>accounts.forEach(account=>(account.adDataRecords||[]).forEach(record=>{const month=String(record.date||'').slice(0,7);if(!allowed.has(month))return;const rebateMode=this.accountRebateMode(account),owner=rebateMode==='CHANNEL'?this.openingDealOwnerForRecord(client.id,platform,account,record.date):null;let include=mode==='ALL';if(mode==='ATTRIBUTED')include=rebateMode==='CHANNEL'&&!!owner;if(mode==='UNASSIGNED')include=rebateMode==='CHANNEL'&&!owner;if(mode==='NO_REBATE')include=rebateMode==='NONE';if(!include)return;const cur=record.currency||account.adSpendCurrency||'USD';groups[cur]=(groups[cur]||0)+Number(record.spend||0)})))});return groups},
    financeClientAdSpendGroups(client,months=null){return this.financeAdSpendGroups(client?.id??null,months||this.financePeriodMonths(),'ALL')},
    financeUnassignedSpendGroupsForMonth(month){return this.financeAdSpendGroups(null,[month],'UNASSIGNED')},
    financeReceivableGroupsForClientMonth(client,month){const g={};this.financeReceivables.filter(r=>String(r.clientId)===String(client?.id)&&String(r.settlementMonth)===String(month)).forEach(r=>{const cur=r.currency||'USD';g[cur]=(g[cur]||0)+Number(r.amount||0)});return g},
    financeServiceFeeReceivableGroupsForClientMonth(client,month){const g={};this.financeReceivables.filter(r=>String(r.clientId)===String(client?.id)&&String(r.settlementMonth)===String(month)&&(r.incomeType||'SERVICE_FEE')==='SERVICE_FEE').forEach(r=>{const cur=r.currency||'USD';g[cur]=(g[cur]||0)+Number(r.amount||0)});return g},
    financePeriodMonths(){if(this.financePeriod==='MONTH')return this.financeMonthKey?[this.financeMonthKey]:[];if(this.financePeriod==='QUARTER'){const start=(Number(this.financeQuarter)-1)*3+1;return[0,1,2].map(i=>`${this.financeQuarterYear}-${String(start+i).padStart(2,'0')}`)}return Array.from({length:12},(_,i)=>`${this.financeYear}-${String(i+1).padStart(2,'0')}`)},
    financeSettlementMonthMatch(month){return this.financePeriodMonths().includes(String(month||''))},
    financeDateMatch(date){return this.financeSettlementMonthMatch(String(date||'').slice(0,7))},
    openingDealOverlapsMonth(deal,month){if(!deal||!month)return false;const [y,m]=String(month).split('-').map(Number);if(!y||!m)return false;const first=`${y}-${String(m).padStart(2,'0')}-01`,last=`${y}-${String(m).padStart(2,'0')}-${String(new Date(y,m,0).getDate()).padStart(2,'0')}`,start=this.openingDealEffectiveStart(deal),end=deal.effectiveEndDate||'';return(!start||start<=last)&&(!end||end>=first)},
    openingDealOverlapsFinancePeriod(deal){return this.financePeriodMonths().some(month=>this.openingDealOverlapsMonth(deal,month))},
    financeProviderActiveMonthsForClient(client){if(this.financeProviderFilter==='ALL')return this.financePeriodMonths();const deals=this.openingDeals.filter(d=>d.status==='OPENED'&&String(d.clientId)===String(client.id)&&String(d.providerId)===String(this.financeProviderFilter));return this.financePeriodMonths().filter(month=>deals.some(d=>this.openingDealOverlapsMonth(d,month)))},
    clientContractOverlapsMonth(client,month){if(!client||!month)return false;const [y,m]=String(month).split('-').map(Number);if(!y||!m)return false;const first=new Date(y,m-1,1),last=new Date(y,m,0,23,59,59),start=client.startDate?new Date(`${client.startDate}T00:00:00`):null,end=client.endDate?new Date(`${client.endDate}T23:59:59`):null;if(start&&last<start)return false;if(end&&first>end)return false;return true},
    financeClientActiveMonths(client){return this.financePeriodMonths().filter(month=>this.clientContractOverlapsMonth(client,month))},
    billingModeText(mode){return mode==='PRORATE'?'按实际服务天数折算':mode==='MANUAL'?'手工账单确认':'整月计费'},
    financeServiceFeeForClientMonth(client,month){if(!client||!month)return 0;const mode=client.billingMode||'FULL_MONTH',monthly=Number(client.monthlyFee||0);if(mode==='MANUAL')return this.financeReceivables.filter(r=>String(r.clientId)===String(client.id)&&r.settlementMonth===month&&(r.currency||'USD')===(client.currency||'USD')).reduce((s,r)=>s+Number(r.amount||0),0);if(!this.clientContractOverlapsMonth(client,month)||monthly<=0)return 0;if(mode!=='PRORATE')return monthly;const [y,m]=month.split('-').map(Number),daysInMonth=new Date(y,m,0).getDate(),first=new Date(y,m-1,1),last=new Date(y,m-1,daysInMonth),contractStart=client.startDate?new Date(`${client.startDate}T00:00:00`):first,contractEnd=client.endDate?new Date(`${client.endDate}T00:00:00`):last,start=contractStart>first?contractStart:first,end=contractEnd<last?contractEnd:last;if(end<start)return 0;const activeDays=Math.floor((end-start)/86400000)+1;return Math.round((monthly*activeDays/daysInMonth)*100)/100},
    financeServiceFeeGroups(client,monthsOverride=null){const groups={};const cur=client.currency||'USD',months=Array.isArray(monthsOverride)?monthsOverride:this.financePeriodMonths();months.forEach(month=>{const amount=this.financeServiceFeeForClientMonth(client,month);if(amount>0)groups[cur]=(groups[cur]||0)+amount});return groups},
    financeDealsForClient(client){return this.openingDeals.filter(d=>d.status==='OPENED'&&String(d.clientId)===String(client.id)&&this.openingDealOverlapsFinancePeriod(d))},
    financeDealsFinancials(deals){const spendGroups={},rebateGroups={};(deals||[]).forEach(deal=>{this.openingDealMatchedAccounts(deal).forEach(account=>(account.adDataRecords||[]).filter(r=>this.financeDateMatch(r.date)&&this.openingDealOwnsRecord(deal,account,r.date)).forEach(r=>{const cur=r.currency||account.adSpendCurrency||'USD',amount=Number(r.spend||0),rate=this.openingDealRebateRate(deal,r.date);spendGroups[cur]=(spendGroups[cur]||0)+amount;rebateGroups[cur]=(rebateGroups[cur]||0)+amount*Number(rate||0)/100}))});return{spendGroups,rebateGroups}},
    financeChannelDeals(providerId,contactId,clientId=null){return this.openingDeals.filter(d=>d.status==='OPENED'&&String(d.providerId)===String(providerId)&&String(d.contactId||'')===String(contactId||'')&&(clientId===null||String(d.clientId)===String(clientId)))},
    financeChannelMonthGroups(providerId,contactId,month,clientId=null,kind='REBATE'){const groups={};this.financeChannelDeals(providerId,contactId,clientId).forEach(deal=>{this.openingDealMatchedAccounts(deal).forEach(account=>(account.adDataRecords||[]).filter(r=>String(r.date||'').slice(0,7)===String(month)&&this.openingDealOwnsRecord(deal,account,r.date)).forEach(r=>{const cur=r.currency||account.adSpendCurrency||'USD',spend=Number(r.spend||0),rate=this.openingDealRebateRate(deal,r.date);groups[cur]=(groups[cur]||0)+(kind==='SPEND'?spend:spend*Number(rate||0)/100)}))});return groups},
    financeExpectedRebateForChannelMonth(providerId,contactId,month){return this.financeChannelMonthGroups(providerId,contactId,month,null,'REBATE')},
    financeClientExpectedRebateForChannelMonth(clientId,providerId,contactId,month){return this.financeChannelMonthGroups(providerId,contactId,month,clientId,'REBATE')},
    financeSpendForChannelMonth(providerId,contactId,month){return this.financeChannelMonthGroups(providerId,contactId,month,null,'SPEND')},
    financeClientSpendForChannelMonth(clientId,providerId,contactId,month){return this.financeChannelMonthGroups(providerId,contactId,month,clientId,'SPEND')},
    financeActualRebateClientShare(entry,client){const cur=entry.currency||'USD',month=entry.settlementMonth,providerId=entry.providerId,contactId=entry.contactId||'';let clientBase=this.financeClientExpectedRebateForChannelMonth(client.id,providerId,contactId,month)[cur]||0,totalBase=this.financeExpectedRebateForChannelMonth(providerId,contactId,month)[cur]||0;if(!(totalBase>0)){clientBase=this.financeClientSpendForChannelMonth(client.id,providerId,contactId,month)[cur]||0;totalBase=this.financeSpendForChannelMonth(providerId,contactId,month)[cur]||0}const totalActual=Number(entry.actualRebate??entry.amount??0);return totalBase>0?totalActual*(clientBase/totalBase):0},
    financeActualRebateGroups(client){const groups={};this.financeReconciliations.filter(r=>r.status!=='VOID'&&this.financeSettlementMonthMatch(r.settlementMonth)).forEach(r=>{const amount=this.financeActualRebateClientShare(r,client);if(amount>0)groups[r.currency||'USD']=(groups[r.currency||'USD']||0)+amount});return groups},
    financePr