veMonths(client).length,receivableRows,receivableCount:receivableRows.length,receivableGroups,paidGroups,serviceFeeGroups,spendGroups:allSpendGroups,expectedRebateGroups:fin.rebateGroups,actualRebateGroups,costGroups,expectedNetProfitGroups,actualNetProfitGroups,channelLabels,actualEntryCount,actualProfitConfirmed,actualProfitLabel,pendingRebateCount:reconciliationStatus.pendingReconciliations}},
    financeDefaultSettlementMonth(){const months=this.financePeriodMonths();const current=`${new Date().getFullYear()}-${String(new Date().getMonth()+1).padStart(2,'0')}`;return months.includes(current)?current:(months[months.length-1]||current)},
    defaultFinanceRebateForm(){return{id:null,channelKey:'',providerId:'',contactId:'',settlementMonth:this.financeDefaultSettlementMonth(),currency:'USD',amount:'',confirmedDate:this.localDateKey(),note:''}},
    normalizeFinanceActualRebates(records){const grouped=new Map();(records||[]).forEach((r,idx)=>{if(!r?.providerId||!r?.settlementMonth)return;let contactId=r.contactId||'';if(!contactId&&r.clientId){const deal=this.openingDeals.find(d=>String(d.clientId)===String(r.clientId)&&String(d.providerId)===String(r.providerId)&&(r.platform?String(d.platform||'')===String(r.platform):true));contactId=deal?.contactId||''}const key=`${String(r.providerId)}|${String(contactId)}|${String(r.settlementMonth)}|${String(r.currency||'USD')}`;const cur=grouped.get(key);if(cur){cur.amount=Number(cur.amount||0)+Number(r.amount||0);cur.note=[cur.note,r.note].filter(Boolean).join('；');if(String(r.confirmedDate||'')>String(cur.confirmedDate||''))cur.confirmedDate=r.confirmedDate;if(String(r.updatedAt||'')>String(cur.updatedAt||''))cur.updatedAt=r.updatedAt}else grouped.set(key,{id:r.id||`rebate-migrated-${idx}`,providerId:r.providerId,contactId,settlementMonth:r.settlementMonth,currency:r.currency||'USD',amount:Number(r.amount||0),confirmedDate:r.confirmedDate||'',note:r.note||'',updatedAt:r.updatedAt||''})});return [...grouped.values()]},
    financeEntryProviderName(entry){return this.openingProviders.find(p=>String(p.id)===String(entry.providerId))?.name||'未知开户商'},
    financeEntryContactName(entry){const p=this.openingProviders.find(p=>String(p.id)===String(entry.providerId));return (p?.contacts||[]).find(c=>String(c.id)===String(entry.contactId||''))?.name||'未设置对接人'},
    financeEntryLinkedClientCount(entry){return new Set(this.financeChannelDeals(entry.providerId,entry.contactId||'').map(d=>String(d.clientId||'')).filter(Boolean)).size},
    normalizeMediaTool(tool){const raw={...(tool||{})};let bindings=Array.isArray(raw.bindings)?raw.bindings.map(b=>({clientId:b.clientId,accountKey:b.accountKey||'ALL'})):[];if(!bindings.length)bindings=(raw.clientIds||[]).map(clientId=>({clientId,accountKey:'ALL'}));const seen=new Set();bindings=bindings.filter(b=>{if(b.clientId===undefined||b.clientId===null||b.clientId==='')return false;const key=`${String(b.clientId)}|${String(b.accountKey||'ALL')}`;if(seen.has(key))return false;seen.add(key);return true});raw.bindings=bindings;raw.clientIds=[...new Set(bindings.map(b=>b.clientId))];raw.loginPassword=raw.loginPassword||'';return raw},
    defaultToolForm(){return{id:null,name:'',category:'BROWSER',url:'',loginAccount:'',loginPassword:'',purpose:'',bindings:[],clientIds:[],owner:'',status:'ACTIVE',seats:1,notes:''}},
    openToolModal(tool=null){this.toolForm=tool?this.normalizeMediaTool(JSON.parse(JSON.stringify(tool))):this.defaultToolForm();this.toolBindingClientId=this.selectedToolClientId!=='ALL'?String(this.selectedToolClientId):'';this.toolBindingAccountKey=(this.toolBindingClientId&&this.selectedToolAccountKey!=='ALL')?this.selectedToolAccountKey:'ALL';this.showToolModal=true},
    addToolBinding(){if(!this.toolBindingClientId){this.notify('请先选择客户');return}const client=this.clients.find(c=>String(c.id)===String(this.toolBindingClientId));if(!client){this.notify('未找到所选客户');return}const clientId=client.id,accountKey=this.toolBindingAccountKey||'ALL';this.toolForm.bindings=this.toolForm.bindings||[];if(this.toolForm.bindings.some(b=>String(b.clientId)===String(clientId)&&String(b.accountKey||'ALL')===String(accountKey))){this.notify('这个客户账号已经绑定');return}this.toolForm.bindings.push({clientId,accountKey});this.toolForm.clientIds=[...new Set(this.toolForm.bindings.map(b=>b.clientId))];this.notify(accountKey==='ALL'?'已绑定该客户全部账号':'已绑定所选客户账号')},
    removeToolBinding(index){this.toolForm.bindings=this.toolForm.bindings||[];this.toolForm.bindings.splice(index,1);this.toolForm.clientIds=[...new Set(this.toolForm.bindings.map(b=>b.clientId))]},
    saveMediaTool(){if(!this.toolForm.name)return;if(!(this.toolForm.bindings||[]).length){this.notify('请至少绑定一个客户或客户账号');return}const payload=this.normalizeMediaTool({...this.toolForm,loginPassword:this.toolForm.loginPassword||'',seats:Number(this.toolForm.seats||1)});if(payload.id){const i=this.mediaTools.findIndex(t=>t.id===payload.id);if(i>-1)this.mediaTools[i]=payload}else this.mediaTools.unshift({...payload,id:this.accountUid('tool')});this.persist();this.showToolModal=false;this.logAudit(payload.id?'修改投放工具':'新增投放工具',`${payload.name} · ${(payload.bindings||[]).length} 个绑定范围`);this.notify('投放工具已保存')},
    deleteMediaTool(tool){if(!tool)return;const bindingCount=(tool.bindings||[]).length;this.askConfirm({title:'删除投放工具',message:`确定删除投放工具【${tool.name}】吗？\n该工具当前绑定 ${bindingCount} 个客户/账号范围，删除后这些绑定会同步移除。`,confirmText:'确认删除'},()=>{this.mediaTools=this.mediaTools.filter(t=>String(t.id)!==String(tool.id));delete this.toolPasswordVisible[tool.id];this.persist();this.logAudit('删除投放工具',`${tool.name} · ${bindingCount} 个绑定`);this.notify(`投放工具【${tool.name}】已删除`)})},
    toolAccountOptionsForClient(clientId){const c=this.clients.find(c=>String(c.id)===String(clientId));if(!c)return[];return[...(c.fbAccounts||[]).map((a,idx)=>({key:`FB:${a.id}`,platform:'FB',account:a,label:`Facebook · ${a.accountName||`账号 ${idx+1}`} · ${a.adAccountId||'未录入广告账号 ID'}`})),...(c.tkAccounts||[]).map((a,idx)=>({key:`TK:${a.id}`,platform:'TK',account:a,label:`TikTok · ${a.accountName||`账号 ${idx+1}`} · ${a.adAccountId||'未录入广告账号 ID'}`}))]},
    toolBindingDisplay(tool){return(tool.bindings||[]).map(b=>{const client=this.clients.find(c=>String(c.id)===String(b.clientId));const key=b.accountKey||'ALL';if(key==='ALL')return{...b,clientName:client?.name||'未知客户',accountLabel:'该客户全部账号',platform:'ALL'};const item=this.toolAccountOptionsForClient(b.clientId).find(x=>x.key===key);return{...b,clientName:client?.name||'未知客户',accountLabel:item?.label||'账号已删除 / 未找到',platform:item?.platform||String(key).split(':')[0]||'FB'}})},
    toggleToolPassword(id){this.toolPasswordVisible={...this.toolPasswordVisible,[id]:!this.toolPasswordVisible[id]}},
    toolCategoryText(category){return({BROWSER:'指纹浏览器',CREATIVE:'素材 / 创意',LANDING:'落地页 / 建站',ANALYTICS:'数据分析',CRM:'CRM / 线索',SPY:'广告情报',OTHER:'其他工具'})[category]||'其他工具'},
    toolCategoryIcon(category){return({BROWSER:'fa-solid fa-fingerprint',CREATIVE:'fa-solid fa-wand-magic-sparkles',LANDING:'fa-solid fa-window-maximize',ANALYTICS:'fa-solid fa-chart-line',CRM:'fa-solid fa-address-book',SPY:'fa-solid fa-binoculars',OTHER:'fa-solid fa-toolbox'})[category]||'fa-solid fa-toolbox'},
    toolClientNames(tool){return[...new Set((tool.bindings||[]).map(b=>this.clients.find(c=>String(c.id)===String(b.clientId))?.name).filter(Boolean))]},
    safeToolUrl(url){try{const u=new URL(url);return['http:','https:'].includes(u.protocol)?u.href:'#'}catch(e){return'#'}},
    localDateKey(date=new Date()){const d=date instanceof Date?date:new Date(date);return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`},
    syncSopAccountSelection(clientChanged=false){const client=this.selectedSopClient;if(!client){this.selectedSopAccountKey='';this.sopChecked={};this.sopExpandedTasks={};return}const accounts=this.selectedSopAccounts;if(clientChanged){this.selectedSopAccountKey='';this.sopChecked={};this.sopExpandedTasks={}}if(!accounts.length){this.selectedSopAccountKey='';this.sopChecked={};return}if(this.selectedSopAccountKey&&!accounts.some(item=>item.key===this.selectedSopAccountKey))this.selectedSopAccountKey='';if(!this.selectedSopAccountKey&&accounts.length===1)this.selectedSopAccountKey=accounts[0].key;if(!this.selectedSopAccountKey){this.sopChecked={};return}this.ensureSelectedSopConfig();this.ensureSopDailyTasks();this.loadSopProgress()},
    onSopAccountChange(){if(!this.selectedSopClient||!this.selectedSopAccount){this.selectedSopAccountKey='';this.sopChecked={};this.sopExpandedTasks={};return}this.sopExpandedTasks={};this.ensureSelectedSopConfig();this.ensureSopDailyTasks();this.loadSopProgress()},
    ensureSelectedSopConfig(){const c=this.selectedSopClient,item=this.selectedSopAccount;if(!c||!item)return null;c.sopAccountConfigs=c.sopAccountConfigs&&typeof c.sopAccountConfigs==='object'?c.sopAccountConfigs:{};if(!c.sopAccountConfigs[item.key]){const legacy=(Array.isArray(c.sopSteps)?c.sopSteps:[]).map(step=>typeof step==='string'?step:(step?.text||'')).filter(Boolean);c.sopAccountConfigs[item.key]={dailyPlan:'',notes:'',steps:legacy.map(text=>({id:this.accountUid('sop'),text,plan:'',note:''})),dailyTasks:{}}}const cfg=c.sopAccountConfigs[item.key];cfg.dailyTasks=cfg.dailyTasks&&typeof cfg.dailyTasks==='object'?cfg.dailyTasks:{};cfg.steps=Array.isArray(cfg.steps)?cfg.steps:[];return cfg},
    ensureSopDailyTasks(date=this.selectedSopDate){const cfg=this.ensureSelectedSopConfig();if(!cfg||!date)return[];if(!Array.isArray(cfg.dailyTasks[date])){const template=(cfg.steps||[]).filter(step=>step.text||step.plan||step.note);cfg.dailyTasks[date]=template.map(step=>({id:this.accountUid('sop'),text:step.text||'',plan:step.plan||'',note:step.note||''}));this.persist()}return cfg.dailyTasks[date]},
    sopProgressKey(){if(!this.selectedSopClient||!this.selectedSopAccountKey||!this.selectedSopDate)return'';return`growthOpsSop-${this.selectedSopClient.id}-${this.selectedSopAccountKey}-${this.selectedSopDate}`},
    loadSopProgress(){if(!this.selectedSopClient||!this.selectedSopAccountKey){this.sopChecked={};return}this.ensureSopDailyTasks();const key=this.sopProgressKey();try{const saved=JSON.parse(localStorage.getItem(key));if(saved&&typeof saved==='object'){this.sopChecked=saved;return}const legacy=JSON.parse(localStorage.getItem(`sop-${this.selectedSopClient.id}-${this.selectedSopDate}`))||{};const migrated={};this.selectedSopSteps.forEach((step,idx)=>{if(legacy[idx])migrated[step.id]=true});this.sopChecked=migrated}catch(e){this.sopChecked={}}},
    saveSopProgress(){const key=this.sopProgressKey();if(!key)return;localStorage.setItem(key,JSON.stringify(this.sopChecked))},
    onSopDateChange(){if(!this.selectedSopDate)this.selectedSopDate=this.localDateKey();this.ensureSopDailyTasks();this.loadSopProgress()},
    setSopDateToday(){this.selectedSopDate=this.localDateKey();this.onSopDateChange()},
    resetSopProgress(){if(!this.selectedSopAccount)return;this.sopChecked={};this.saveSopProgress();this.notify(`已重置 ${this.sopSelectedDateBadge} 的完成状态`)},
    toggleSopTask(taskId){if(!taskId)return;this.sopExpandedTasks[taskId]=!this.sopExpandedTasks[taskId]},
    openSopTaskModal(step=null){if(!this.selectedSopClient||!this.selectedSopAccount){this.notify('请先选择客户和客户账号');return}if(step&&step.id){this.sopTaskForm={id:step.id,originalDate:this.selectedSopDate||this.localDateKey(),date:this.selectedSopDate||this.localDateKey(),text:String(step.text||''),plan:String(step.plan||''),note:String(step.note||'')}}else{this.sopTaskForm={id:null,originalDate:'',date:this.selectedSopDate||this.localDateKey(),text:'',plan:'',note:''}}this.showSopTaskModal=true},
    saveSopTask(){if(!this.selectedSopClient||!this.selectedSopAccount){this.notify('当前没有可记录任务的客户账号');return}const cfg=this.ensureSelectedSopConfig();if(!cfg){this.notify('任务保存失败，请重新选择客户账号');return}const date=this.sopTaskForm.date||this.selectedSopDate||this.localDateKey();const text=String(this.sopTaskForm.text||'').trim();if(!text){this.notify('请填写操作步骤');return}const plan=String(this.sopTaskForm.plan||'').trim(),note=String(this.sopTaskForm.note||'').trim();let taskId=this.sopTaskForm.id||this.accountUid('sop');if(this.sopTaskForm.id){const originalDate=this.sopTaskForm.originalDate||this.selectedSopDate||date;const originalTasks=this.ensureSopDailyTasks(originalDate);const originalIndex=originalTasks.findIndex(step=>step.id===this.sopTaskForm.id);if(originalIndex!==-1)originalTasks.splice(originalIndex,1);cfg.dailyTasks[originalDate]=(originalTasks||[]).map(step=>({id:step.id||this.accountUid('sop'),text:String(step.text||''),plan:String(step.plan||''),note:String(step.note||'')}));if(originalDate!==date){delete this.sopChecked[taskId];try{const oldKey=`growthOpsSop-${this.selectedSopClient.id}-${this.selectedSopAccountKey}-${originalDate}`;const oldProgress=JSON.parse(localStorage.getItem(oldKey)||'{}');delete oldProgress[taskId];localStorage.setItem(oldKey,JSON.stringify(oldProgress))}catch(e){}}}const targetTasks=this.ensureSopDailyTasks(date);targetTasks.push({id:taskId,text,plan,note});cfg.dailyTasks[date]=targetTasks.map(step=>({id:step.id||this.accountUid('sop'),text:String(step.text||''),plan:String(step.plan||''),note:String(step.note||'')}));const today=this.localDateKey();if(date===today||this.sopTaskForm.originalDate===today){const todayTasks=this.ensureSopDailyTasks(today);cfg.steps=todayTasks.filter(step=>step.text||step.plan||step.note).map(step=>({id:this.accountUid('sop'),text:String(step.text||'').trim(),plan:String(step.plan||'').trim(),note:String(step.note||'').trim()}))}this.persist();this.selectedSopDate=date;this.loadSopProgress();this.sopExpandedTasks[taskId]=true;this.showSopTaskModal=false;const action=this.sopTaskForm.id?'修改 SOP 任务':'新增 SOP 任务';this.logAudit(action,`${this.selectedSopClient.name} · ${this.selectedSopAccount.account.accountName||this.selectedSopAccount.account.adAccountId||'未命名账号'} · ${date} · ${text}`);this.notify(this.sopTaskForm.id?'任务已修改并更新到执行 Checklist':'任务已保存，并已显示在执行 Checklist')},
    addSopStep(){this.openSopTaskModal()},
    removeSopStep(index){const cfg=this.ensureSelectedSopConfig(),tasks=this.ensureSopDailyTasks();if(!cfg||!tasks?.[index])return;const step=tasks[index],date=this.selectedSopDate,clientName=this.selectedSopClient?.name||'当前客户',accountName=this.selectedSopAccount?.account?.accountName||this.selectedSopAccount?.account?.adAccountId||'当前账号';this.askConfirm({title:'删除 SOP 任务',message:`确定删除 ${this.sopSelectedDateBadge} 的任务【${step.text||index+1}】吗？删除后不会影响其他日期的任务。`,confirmText:'确认删除',tone:'danger'},()=>{delete this.sopChecked[step.id];delete this.sopExpandedTasks[step.id];tasks.splice(index,1);this.saveSopProgress();this.saveSopDailyTasks();this.logAudit('删除 SOP 任务',`${clientName} · ${accountName} · ${date} · ${step.text||''}`);this.notify('任务已删除')})},
    saveSopDailyTasks(){const cfg=this.ensureSelectedSopConfig();if(!cfg||!this.selectedSopDate)return;const tasks=this.ensureSopDailyTasks();cfg.dailyTasks[this.selectedSopDate]=(tasks||[]).map(step=>({id:step.id||this.accountUid('sop'),text:String(step.text||''),plan:String(step.plan||''),note:String(step.note||'')}));if(this.selectedSopDate===this.localDateKey())cfg.steps=cfg.dailyTasks[this.selectedSopDate].filter(step=>step.text||step.plan||step.note).map(step=>({id:this.accountUid('sop'),text:step.text.trim(),plan:step.plan.trim(),note:step.note.trim()}));this.persist()},
    saveSopSettings(){const cfg=this.ensureSelectedSopConfig();if(!cfg)return;cfg.dailyPlan=String(cfg.dailyPlan||'').trim();cfg.notes=String(cfg.notes||'').trim();this.persist();this.logAudit('保存 SOP 计划',`${this.selectedSopClient?.name||''} · ${this.selectedSopAccount?.account?.accountName||''}`);this.notify('当前账号执行计划与备注已保存')},
    askConfirm({title='确认操作',message='',confirmText='确认删除',tone='danger'}={},action=null){this.confirmDialog={show:true,title,message,confirmText,tone};this.confirmAction=typeof action==='function'?action:null},
    cancelConfirmDialog(){this.confirmDialog={show:false,title:'',message:'',confirmText:'确认删除',tone:'danger'};this.confirmAction=null},
    runConfirmDialog(){const action=this.confirmAction;this.confirmDialog.show=false;this.confirmAction=null;if(typeof action==='function'){try{action()}catch(e){console.error(e);this.notify('操作执行失败，请刷新页面后重试')}}},
    notify(msg){this.toastMessage=String(msg||'');clearTimeout(this._toastTimer);this._toastTimer=setTimeout(()=>this.toastMessage='',4500)},
    resetDemoData(){if(this.currentUser?.role!=='ADMIN'){this.notify('只有管理员可以恢复演示数据');return}this.askConfirm({title:'恢复初始演示数据',message:'当前浏览器中已修改的业务数据会被演示数据覆盖。建议先导出备份。确定继续吗？',confirmText:'确认恢复',tone:'warning'},()=>{this.clients=structuredClone(seedClients).map(c=>this.normalizeClient(c));this.standaloneAlerts=structuredClone(seedAlerts).map(a=>this.normalizeStandaloneAlert(a));this.reminderTypes=this.defaultReminderTypes();this.dismissedAlerts=[];this.leads=structuredClone(seedLeads);this.openingProviders=structuredClone(seedOpeningProviders).map(p=>this.normalizeOpeningProvider(p));this.openingDeals=structuredClone(seedOpeningDeals);this.financeActualRebates=[];this.financeReceivables=[];this.financeCosts=[];this.financeReconciliations=[];this.financeMonthLocks={};this.financeMonthSnapshots={};this.authUsers=structuredClone(seedAuthUsers);this.backupSnapshots=[];this.auditLogs=[];this.mediaTools=structuredClone(seedMediaTools).map(t=>this.normalizeMediaTool(t));this.migrateLegacyAccountSpendRecords();const sessionId=String(this.currentUser?.id||'');this.currentUser=this.authUsers.find(u=>String(u.id)===sessionId&&u.enabled!==false)||null;if(this.currentUser)localStorage.setItem('growthOpsSessionUser',this.currentUser.id);else localStorage.removeItem('growthOpsSessionUser');this.persist();this.selectedClientId=1;this.selectedAssetsClientId=1;this.selectedSopClientId=null;this.selectedSopAccountKey='';this.selectedSopDate=this.localDateKey();this.selectedAnalyticsClientId=1;this.selectedAnalyticsFbAccountId=null;this.selectedAnalyticsTkAccountId=null;this.selectedAdsClientId=1;this.selectedAdsPlatform='FB';this.selectedAdsAccountId=null;this.syncAnalyticsAccountSelection();this.syncAdsAccountSelection();this.syncSopAccountSelection(true);this.notify('已恢复演示数据');this.navigateTo('dashboard')})}
  },
  mounted(){this.loadData();this.migrateLegacyAccountSpendRecords();this.ensureAutomaticReceivables({silent:true});this.ensureAutomaticAssetCosts({month:this.localDateKey().slice(0,7),silent:true});this.ensureAutomaticOpeningFeeCosts();this.ensureReceivableLinkedCosts();this.ensureFinanceSnapshotsForLocks();this.persist();this.updateStorageUsage();this.form=this.defaultForm();this.leadForm=this.defaultLeadForm();this.openingForm=this.defaultOpeningForm();this.providerForm=this.defaultProviderForm();this.toolForm=this.defaultToolForm();this.receivableForm=this.defaultReceivableForm();this.costForm=this.defaultCostForm();this.reconciliationForm=this.defaultReconciliationForm();this.userForm={id:null,name:'',username:'',password:'',role:'OPS',enabled:true};this.ensureDailyBackup();this.updateStorageUsage();this.syncAnalyticsAccountSelection();this.syncAdsAccountSelection();this.syncSopAccountSelection();const hash=window.location.hash.slice(1);const allowed=['dashboard','leads','clients','account-opening','alerts','assets','sop','ads','analytics','finance','tools','system','client-detail','client-form'];if(allowed.includes(hash)&&this.canViewPage(hash))this.currentPage=hash;window.addEventListener('hashchange',()=>{const h=window.location.hash.slice(1);if(allowed.includes(h)&&this.canViewPage(h)){this.currentPage=h;if(h==='analytics')this.syncAnalyticsAccountSelection();if(h==='ads')this.syncAdsAccountSelection();if(h==='sop')this.syncSopAccountSelection()}});window.addEventListener('beforeunload',(e)=>{if(this.formDirty){e.preventDefault();e.returnValue=''}});if(this.currentPage==='sop')this.syncSopAccountSelection()}
}).mount('#app');
</script>
</body>
</html>
