me(entry){const p=this.openingProviders.find(p=>String(p.id)===String(entry.providerId));return (p?.contacts||[]).find(c=>String(c.id)===String(entry.contactId||''))?.name||'未设置对接人'},
    financeEntryLinkedClientCount(entry){return new Set(this.financeChannelDeals(entry.providerId,entry.contactId||'').map(d=>String(d.clientId||'')).filter(Boolean)).size},
    normalizeMediaTool(tool){const raw={...(tool||{})};let bindings=Array.isArray(raw.bindings)?raw.bindings.map(b=>({clientId:b.clientId,accountKey:b.accountKey||'ALL'})):[];if(!bindings.length)bindings=(raw.clientIds||[]).map(clientId=>({clientId,accountKey:'ALL'}));const seen=new Set();bindings=bindings.filter(b=>{if(b.clientId===undefined||b.clientId===null||b.clientId==='')return false;const key=`${String(b.clientId)}|${String(b.accountKey||'ALL')}`;if(seen.has(key))return false;seen.add(key);return true});raw.bindings=bindings;raw.clientIds=[...new Set(bindings.map(b=>b.clientId))];raw.loginPassword=raw.loginPassword||'';return raw},
    defaultToolForm(){return{id:null,name:'',category:'BROWSER',url:'',loginAccount:'',loginPassword:'',purpose:'',bindings:[],clientIds:[],owner:'',status:'ACTIVE',seats:1,notes:''}},
    openToolModal(tool=null){this.toolForm=tool?this.normalizeMediaTool(JSON.parse(JSON.stringify(tool))):this.defaultToolForm();this.toolBindingClientId=this.selectedToolClientId!=='ALL'?String(this.selectedToolClientId):'';this.toolBindingAccountKey=(this.toolBindingClientId&&this.selectedToolAccountKey!=='ALL')?this.selectedToolAccountKey:'ALL';this.showToolModal=true},
    addToolBinding(){if(!this.toolBindingClientId){this.notify('请先选择客户');return}const client=this.clients.find(c=>String(c.id)===String(this.toolBindingClientId));if(!client){this.notify('未找到所选客户');return}const clientId=client.id,accountKey=this.toolBindingAccountKey||'ALL';this.toolForm.bindings=this.toolForm.bindings||[];if(this.toolForm.bindings.some(b=>String(b.clientId)===String(clientId