)&&String(b.accountKey||'ALL')===String(accountKey))){this.notify('这个客户账号已经绑定');return}this.toolForm.bindings.push({clientId,accountKey});this.toolForm.clientIds=[...new Set(this.toolForm.bindings.map(b=>b.clientId))];this.notify(accountKey==='ALL'?'已绑定该客户全部账号':'已绑定所选客户账号')},
