AccountSelection(clientChanged=false){const client=this.selectedSopClient;if(!client){this.selectedSopAccountKey='';this.sopChecked={};this.sopExpandedTasks={};return}const accounts=this.selectedSopAccounts;if(clientChanged){this.selectedSopAccountKey='';this.sopChecked={};this.sopExpandedTasks={}}if(!accounts.length){this.selectedSopAccountKey='';this.sopChecked={};return}if(this.selectedSopAccountKey&&!accounts.some(item=>item.key===this.selectedSopAccountKey))this.selectedSopAccountKey='';if(!this.selectedSopAccountKey&&accounts.length===1)this.selectedSopAccountKey=accounts[0].key;if(!this.selectedSopAccountKey){this.sopChecked={};return}this.ensureSelectedSopConfig();this.ensureSopDailyTasks();this.loadSopProgress()},
    onSopAccountChange(){if(!this.selectedSopClient||!this.selectedSopAccount){this.selectedSopAccountKey='';this.sopChecked={};this.sopExpandedTasks={};return}this.sopExpandedTasks={};this.ensureSelectedSopConfig();this.ensureSopDailyTasks();this.loadSopProgress()},