<span class="mt-0.5 w-8 h-8 rounded-lg flex items-center justify-center shrink-0" :class="globalSearchResultIconClass(result)"><i :class="globalSearchResultIcon(result)"></i></span>
                      <span class="min-w-0 flex-1"><span class="block text-xs font-extrabold truncate">{{ result.title }}</span><span class="block text-[10px] text-slate-400 mt-0.5 truncate">{{ result.subtitle }}</span><span v-if="result.matchLabel" class="inline-flex mt-1 px-1.5 py-0.5 rounded-md bg-slate-100 text-[9px] font-bold text-slate-500">{{ result.matchLabel }} · {{ result.matchValue }}</span></span>
                      <i class="fa-solid fa-arrow-right text-[9px] text-slate-300 mt-2"></i>
                    </button>
                  </div>
                  <div v-else class="px-4 py-8 text-center text-xs text-slate-400">没有找到匹配的客户或账号资产</div>
                </div>
              </div>

              <div class="hidden 2xl:flex items-center gap-1.5 shrink-0">
                <span class="h-7 px-2.5 rounded-lg bg-slate-50 border border-slate-100 text-[9px] font-bold text-slate-500 flex items-center">客户</span>
                <span class="h-7 px-2.5 rounded-lg bg-blue-50 border border-blue-100 text-[9px] font-bold text-blue-600 flex items-center">FB / TK</span>
                <span class="h-7 px-2.5 rounded-lg bg-red-50 border border-red-100 text-[9px] font-bold text-red-500 flex items-center">Google</span>
                <span class="h-7 px-2.5 rounded-lg bg-fuchsia-50 border border-fuchsia-100 text-[9px] font-bold text-fuchsia-600 flex items-center">Instagram</span>
              </div>
            </div>
          </div>

          <div v-if="selectedAssetsClient" class="space-y-5">
            <div class="bg-white border border-slate-200 rounded-2xl soft-shadow p-4 flex flex-col md:flex-row md:items-center justify-between gap-4">
              <div class="flex items-center gap-3 min-w-0">
                <div class="w-11 h-11 shrink-0 rounded-2xl bg-indigo-50 text-indigo-600 flex items-center justify-center"><i class="fa-solid fa-building"></i></div>
                <div class="min-w-0"><div class="font-extrabold text-sm truncate">{{ selectedAssetsClient.name }}</div><div class="text-[11px] text-slate-400 mt-1 truncate">{{ selectedAssetsClient.product }} · {{ selectedAssetsClient.project }}</div></div>
              </div>
              <div class="flex items-center gap-2 flex-wrap">
                <platform-badges :platform="selectedAssetsClient.platform"></platform-badges>
                <span class="text-[10px] font-bold px-2.5 py-1.5 rounded-full bg-blue-50 text-blue-700">FB {{ (selectedAssetsClient.fbAccounts || []).length }} 个</span>
                <span class="text-[10px] font-bold px-2.5 py-1.5 rounded-full bg-slate-100 text-slate-700">TK {{ (selectedAssetsClient.tkAccounts || []).length }} 个</span>
                <span class="text-[10px] font-bold px-2.5 py-1.5 rounded-full bg-red-50 text-red-600">Google {{ (selectedAssetsClient.googleAccounts || []).length }} 个</span>
                <span class="text-[10px] font-bold px-2.5 py-1.5 rounded-full bg-fuchsia-50 text-fuchsia-700">INS {{ (selectedAssetsClient.instagramAccounts || []).length }} 个</span>
                <button v-if="canViewCredentials()" @click="credentialsVisible=!credentialsVisible" class="h-8 px-3 rounded-lg border border-slate-200 text-[11px] font-bold text-indigo-600 hover:bg-indigo-50">
                  <i :class="credentialsVisible?'fa-regular fa-eye-slash':'fa-regular fa-eye'" class="mr-1"></i>{{ credentialsVisible?'隐藏登录资料':'查看登录资料' }}
                </button>
              </div>
            </div>

            <div class="grid grid-cols-1 xl:grid-cols-2 gap-5">
              <div class="bg-white border border-slate-200 rounded-2xl soft-shadow overflow-hidden">
                <div class="p-5 border-b border-slate-100 flex items-center justify-between gap-3 flex-wrap">
                  <div class="font-extrabold text-sm flex items-center gap-2"><i class="fa-brands fa-facebook text-blue-600"></i>Facebook 资产</div>
                  <div class="flex items-center gap-2 flex-wrap justify-end"><span class="text-[10px] font-bold bg-blue-50 text-blue-700 px-2 py-1 rounded-full">{{ (selectedAssetsClient.fbAccounts || []).length }} 个账号</span><div v-if="(selectedAssetsClient.fbAccounts || []).length>1" class="inline-flex items-center gap-1.5"><select :value="clampedAssetPagerIndex('assets','FB',(selectedAssetsClient.fbAccounts||[]).length)" @change="setAssetPagerIndex('assets','FB',$event.target.value,(selectedAssetsClient.fbAccounts||[]).length)" class="h-7 max-w-[150px] rounded-lg border border-blue-100 bg-white px-2 text-[10px] font-bold text-blue-700 outline-none focus:ring-2 focus:ring-blue-100" title="直接选择 Facebook 账号"><option v-for="(a,i) in (selectedAssetsClient.fbAccounts||[])" :key="a.id || i" :value="i">{{ a.accountName || `Facebook 账号 ${i+1}` }}</option></select><button type="button" @click="changeAssetPager('assets','FB',-1,(selectedAssetsClient.fbAccounts||[]).length)" class="w-7 h-7 rounded-lg border border-blue-100 bg-white text-blue-700 disabled:opacity-40" :disabled="clampedAssetPagerIndex('assets','FB',(selectedAssetsClient.fbAccounts||[]).length)===0"><i class="fa-solid fa-chevron-left text-[10px]"></i></button><span class="text-[10px] font-bold text-blue-700 min-w-[52px] text-center">{{ clampedAssetPagerIndex('assets','FB',(selectedAssetsClient.fbAccounts||[]).length)+1 }} / {{ (selectedAssetsClient.fbAccounts || []).length }}</span><button type="button" @click="changeAssetPager('assets','FB',1,(selectedAssetsClient.fbAccounts||[]).length)" class="w-7 h-7 rounded-lg border border-blue-100 bg-white text-blue-700 disabled:opacity-40" :disabled="clampedAssetPagerIndex('assets','FB',(selectedAssetsClient.fbAccounts||[]).length)>=(selectedAssetsClient.fbAccounts||[]).length-1"><i class="fa-solid fa-chevron-right text-[10px]"></i></button></div></div>
                </div>
                <div v-if="selectedAssetsClient.fbAccounts && selectedAssetsClient.fbAccounts.length" class="p-4 space-y-3">
                  <template v-for="(account,idx) in [getPagedItem(selectedAssetsClient.fbAccounts,'assets','FB')]" :key="account?.id || 'assets-fb'">
                  <div v-if="account" class="rounded-2xl border border-blue-100 bg-blue-50/30 p-4">
                    <div class="flex items-center justify-between mb-3"><div><div class="text-xs font-extrabold text-blue-900">{{ account.accountName || `Facebook 账号 ${clampedAssetPagerIndex('assets','FB',(selectedAssetsClient.fbAccounts||[]).length)+1}` }}</div><div class="text-[10px] text-slate-400 mt-0.5">Facebook 账号 {{ clampedAssetPagerIndex('assets','FB',(selectedAssetsClient.fbAccounts||[]).length)+1 }}</div></div><span class="text-[10px] font-bold text-blue-600 bg-white border border-blue-100 px-2 py-1 rounded-full">FB</span></div>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                      <div class="rounded-xl bg-white border border-slate-100 p-3 sm:col-span-2"><div class="text-[10px] text-slate-400">账号名称</div><div class="text-xs font-extrabold text-slate-900 mt-1 break-all">{{ account.accountName || `Facebook 账号 ${clampedAssetPagerIndex('assets','FB',(selectedAssetsClient.fbAccounts||[]).length)+1}` }}</div></div>
                      <div class="rounded-xl bg-white border border-slate-100 p-3"><div class="text-[10px] text-slate-400">BM ID</div><div class="font-mono text-xs font-bold mt-1 break-all select-all">{{ account.bmId || '未录入' }}</div></div>
                      <div class="rounded-xl bg-white border border-slate-100 p-3"><div class="text-[10px] text-slate-400">广告账号 ID</div><div class="font-mono text-xs font-bold mt-1 break-all select-all">{{ account.adAccountId || '未录入' }}</div></div>
                      <div class="rounded-xl bg-white border border-slate-100 p-3"><div class="text-[10px] text-slate-400">登录账号</div><div class="font-mono text-xs mt-1 break-all select-all">{{ credentialsVisible ? (account.loginAccount || '未录入') : (account.loginAccount ? maskAccount(account.loginAccount) : '未录入') }}</div></div>
                      <div class="rounded-xl bg-white border border-slate-100 p-3"><div class="text-[10px] text-slate-400">密码 / 2FA</div><div class="font-mono text-xs font-bold mt-1 break-all select-all">{{ credentialsVisible ? (account.loginPassword || '未录入') : (account.loginPassword ? '••••••••••••' : '未录入') }}</div></div>
                    </div>
                  </div>
                  </template>
                </div>
                <div v-else class="py-14 px-5 text-center text-xs text-slate-400"><i class="fa-brands fa-facebook text-3xl text-slate-200 block mb-3"></i>当前客户暂无 Facebook 账号资产</div>
              </div>

              <div class="bg-white border border-slate-200 rounded-2xl soft-shadow overflow-hidden">
                <div class="p-5 border-b border-slate-100 flex items-center justify-between gap-3 flex-wrap">
                  <div class="font-extrabold text-sm flex items-center gap-2"><i class="fa-brands fa-tiktok"></i>TikTok 资产</div>
                  <div class="flex items-center gap-2 flex-wrap justify-end"><span class="text-[10px] font-bold bg-slate-100 text-slate-700 px-2 py-1 rounded-full">{{ (selectedAssetsClient.tkAccounts || []).length }} 个账号</span><div v-if="(selectedAssetsClient.tkAccounts || []).length>1" class="inline-flex items-center gap-1.5"><select :value="clampedAssetPagerIndex('assets','TK',(selectedAssetsClient.tkAccounts||[]).length)" @change="setAssetPagerIndex('assets','TK',$event.target.value,(selectedAssetsClient.tkAccounts||[]).length)" class="h-7 max-w-[150px] rounded-lg border border-slate-200 bg-white px-2 text-[10px] font-bold text-slate-700 outline-none