/div>
                    <div v-if="account.note" class="mt-3 rounded-xl bg-white/80 border border-slate-100 p-3 text-[10px] text-slate-500 leading-relaxed">{{ account.note }}</div>
                  </div>
                  </template>
                </div>
                <div v-else class="py-14 px-5 text-center text-xs text-slate-400"><i class="fa-brands fa-google text-3xl text-slate-200 block mb-3"></i><div>当前客户暂无 Google 账号资产</div><button v-if="canManageAssets()" type="button" @click="openExternalAssetModal('GOOGLE')" class="mt-3 h-9 px-4 rounded-xl bg-red-50 text-red-600 font-bold">+ 添加 Google 账号</button></div>
              </div>

              <div class="bg-white border border-slate-200 rounded-2xl soft-shadow overflow-hidden">
                <div class="p-5 border-b border-slate-100 flex items-center justify-between gap-3">
                  <div><div class="font-extrabold text-sm flex items-center gap-2"><i class="fa-brands fa-instagram text-fuchsia-600"></i>Instagram 资产</div><div class="text-[10px] text-slate-400 mt-1">Instagram 用户名 / ID / 登录资料统一归档</div></div>
                  <div class="flex items-center gap-2 flex-wrap justify-end"><span class="text-[10px] font-bold bg-fuchsia-50 text-fuchsia-700 px-2 py-1 rounded-full">{{ (selectedAssetsClient.instagramAccounts || []).length }} 个账号</span><div v-if="(selectedAssetsClient.instagramAccounts || []).length>1" class="inline-flex items-center gap-1.5"><select :value="clampedAssetPagerIndex('assets','INSTAGRAM',(selectedAssetsClient.instagramAccounts||[]).length)" @change="setAssetPagerIndex('assets','INSTAGRAM',$event.target.value,(selectedAssetsClient.instagramAccounts||[]).length)" class="h-7 max-w-[150px] rounded-lg border border-fuchsia-100 bg-white px-2 text-[10px] font-bold text-fuchsia-700 outline-none focus:ring-2 focus:ring-fuchsia-100" title="直接选择 Instagram 账号"><option v-for="(a,i) in (selectedAssetsClient.instagramAccounts||[])" :key="a.id || i" :value="i">{{ a.accountName || `Instagram 账号 ${i+1}` }}</option></select><button type="button" @click="changeAssetPager('assets','INSTAGRAM',-1,(selectedAssetsClient.instagramAccounts||[]).length)" class="w-7 h-7 rounded-lg border border-fuchsia-100 bg-white text-fuchsia-700 disabled:opacity-40" :disabled="clampedAssetPagerIndex('assets','INSTAGRAM',(selectedAssetsClient.instagramAccounts||[]).length)===0"><i class="fa-solid fa-chevron-left text-[10px]"></i></button><span class="text-[10px] font-bold text-fuchsia-700 min-w-[52px] text-center">{{ clampedAssetPagerIndex('assets','INSTAGRAM',(selectedAssetsClient.instagramAccounts||[]).length)+1 }} / {{ (selectedAssetsClient.instagramAccounts || []).length }}</span><button type="button" @click="changeAssetPager('assets','INSTAGRAM',1,(selectedAssetsClient.instagramAccounts||[]).length)" class="w-7 h-7 rounded-lg border border-fuchsia-100 bg-white text-fuchsia-700 disabled:opacity-40" :disabled="clampedAssetPagerIndex('assets','INSTAGRAM',(selectedAssetsClient.instagramAccounts||[]).length)>=(selectedAssetsClient.instagramAccounts||[]).length-1"><i class="fa-solid fa-chevron-right text-[10px]"></i></button></div><button v-if="canManageAssets()" type="button" @click="openExternalAssetModal('INSTAGRAM')" class="h-8 px-3 rounded-lg bg-fuchsia-50 text-fuchsia-700 text-[10px] font-extrabold hover:bg-fuchsia-100"><i class="fa-solid fa-plus mr-1"></i>添加 INS</button></div>
                </div>
                <div v-if="selectedAssetsClient.instagramAccounts && selectedAssetsClient.instagramAccounts.length" class="p-4 space-y-3">
                  <template v-for="(account,idx) in [getPagedItem(selectedAssetsClient.instagramAccounts,'assets','INSTAGRAM')]" :key="account?.id || 'assets-instagram'">
                  <div v-if="account" class="rounded-2xl border border-fuchsia-100 bg-fuchsia-50/20 p-4">
                    <div class="flex items-start justify-between gap-3 mb-3"><div><div class="text-xs font-extrabold text-slate-900">{{ account.accountName || `Instagram 账号 ${clampedAssetPagerIndex('assets','INSTAGRAM',(selectedAssetsClient.instagramAccounts||[]).length)+1}` }}</div><div class="text-[10px] text-slate-400 mt-0.5">Instagram 账号 {{ clampedAssetPagerIndex('assets','INSTAGRAM',(selectedAssetsClient.instagramAccounts||[]).length)+1 }}</div></div><div v-if="canManageAssets()" class="flex gap-1"><button type="button" @click="openExternalAssetModal('INSTAGRAM',account)" class="w-8 h-8 rounded-lg text-indigo-600 hover:bg-white" title="编辑 Instagram 账号"><i class="fa-solid fa-pen"></i></button><button type="button" @click="deleteExternalAsset('INSTAGRAM',account)" class="w-8 h-8 rounded-lg text-rose-500 hover:bg-white" title="删除 Instagram 账号"><i class="fa-regular fa-trash-can"></i></button></div></div>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                      <div class="rounded-xl bg-white border border-slate-100 p-3 sm:col-span-2"><div class="text-[10px] text-slate-400">账号名称</div><div class="text-xs font-extrabold mt-1 break-all">{{ account.accountName || `Instagram 账号 ${clampedAssetPagerIndex('assets','INSTAGRAM',(selectedAssetsClient.instagramAccounts||[]).length)+1}` }}</div></div>
                      <div class="rounded-xl bg-white border border-slate-100 p-3"><div class="text-[10px] text-slate-400">Instagram 用户名</div><div class="font-mono text-xs font-bold mt-1 break-all select-all">{{ account.username || '未录入' }}</div></div>
                      <div class="rounded-xl bg-white border border-slate-100 p-3"><div class="text-[10px] text-slate-400">Instagram ID</div><div class="font-mono text-xs font-bold mt-1 break-all select-all">{{ account.profileId || '未录入' }}</div></div>
                      <div class="rounded-xl bg-white border border-slate-100 p-3"><div class="text-[10px] text-slate-400">登录邮箱 / 手机号</div><div class="font-mono text-xs mt-1 break-all select-all">{{ credentialsVisible ? (account.loginAccount || '未录入') : (account.loginAccount ? maskAccount(account.loginAccount) : '未录入') }}</div></div>
                      <div class="rounded-xl bg-white border border-slate-100 p-3"><div class="text-[10px] text-slate-400">&#23494;&#30721; / 2FA</div><div class="font-mono text-xs font-bold mt-1 break-all select-all">{{ credentialsVisible ? (account['login'+'Password'] || '未录入') : (account['login'+'Password'] ? '••••••••••••' : '未录入') }}</div></div>
                    </div>
                    <div v-if="account.note" class="mt-3 rounded-xl bg-white/80 border border-slate-100 p-3 text-[10px] text-slate-500 leading-relaxed">{{ account.note }}</div>
                  </div>
                  </template>
                </div>
                <div v-else class="py-14 px-5 text-center text-xs text-slate-400"><i class="fa-brands fa-instagram text-3xl text-slate-200 block mb-3"></i><div>当前客户暂无 Instagram 账号资产</div><button v-if="canManageAssets()" type="button" @click="openExternalAssetModal('INSTAGRAM')" class="mt-3 h-9 px-4 rounded-xl bg-fuchsia-50 text-fuchsia-700 font-bold">+ 添加 Instagram 账号</button></div>
              </div>
            </div>

            <div class="flex justify-end">
              <button @click="openClientForm(selectedAssetsClient)" class="h-10 px-4 rounded-xl bg-slate-950 text-white text-xs font-bold hover:bg-slate-800 transition"><i class="fa-solid fa-pen-to-square mr-1.5"></i>编辑当前客户账号资产</button>
            </div>
          </div>
          <div v-else class="bg-white border border-slate-200 rounded-2xl py-16 text-center text-xs text-slate-400">暂无客户资料</div>
        </section>

        <!-- SOP -->
        <section v-else-if="currentPage==='sop'" key="sop" class="space-y-5">
          <div class="flex flex-col xl:flex-row xl:items-end justify-between gap-4">
            <div>
              <h2 class="text-2xl font-extrabold tracking-tight">每日 SOP 管理</h2>
              <p class="text-xs text-slate-500 mt-1">按客户和具体 FB / TikTok 账号管理每日任务；直接在 Checklist 中添加、删除和修改任务，并可切换日期查看历史或安排未来任务。</p>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 w-full xl:w-auto">
              <label class="block"><span class="block text-[10px] font-bold text-slate-400 mb-1.5">更换客户</span><select v-model.number="selectedSopClientId" @change="syncSopAccountSelection(true)" class="h-10 min-w-[230px] w-full rounded-xl border border-slate-200 bg-white px-3 text-xs font-bold"><option :value="null">请选择客户</option><option v-for="c in activeClients" :value="c.id" :key="c.id">{{ c.name }}</option></select></label>
              <label class="block"><span class="block text-[10px] font-bold text-slate-400 mb-1.5">更换客户账号</span><select v-model="selectedSopAccountKey" @change="onSopAccountChange" class="h-10 min-w-[260px] w-full rounded-xl border border-slate-200 bg-white px-3 text-xs font-bold disabled:bg-slate-50 disabled:text-slate-400 disabled:cursor-not-allowed" :disabled="!selectedSopClient || !selectedSopAccounts.length"><option value="">{{ !selectedSopClient ? '请先选择客户' : (selectedSopAccounts.length ? '请选择客户账号' : '暂无账号资产') }}</option><option v-for="item in selectedSopAccounts" :key="item.key" :value="item.key">{{ item.platformName }} · {{ item.account.accountName || item.account.adAccountId || '未命名账号' }}</option></select></label>
            </div>
          </div>

          <div v-if="selectedSopClient && selectedSopAccount" class="space-y-5">
            <div class="bg-white border border-slate-200 rounded-2xl soft-shadow p-5 flex flex-col lg:flex-row lg:items-center justify-between gap-4">
              <div class="flex items-start gap-3">
                <div class="w-10 h-10 rounded-xl flex items-center justify-center" :class="selectedSopAccount.platform==='FB'?'bg-blue-50 text-blue-600':'bg-slate-950 text-white'"><i :class="selectedSopAccount.platform==='FB'?'fa-brands fa-facebook':'fa-brands fa-tiktok'"></i></div>
                <div><div class="text-[10px] font-bold uppercase tracking-wider text-slate-400">当前执行客户 / 账号</div><div class="font-extrabold text-sm mt-0.5">{{ selectedSopClient.name }} · {{ selectedSopAccount.account.accountName || '未命名账号' }}</div><div class="text-[11px] text-slate-500 mt-1">{{ selectedSopAccount.platformName }} · 广告账号 {{ selectedSopAccount.account.adAccountId || '未录入' }} · {{ selectedSopAccount.platform==='FB' ? 'BM ' + (selectedSopAccount.account.bmId || '未录入') : 'BC ' + (selectedSopAccount.account.bcId || '未录入') }}</div></div>
              </div>
              <div class="flex flex-wrap items-center gap-2"><span class="px-3 py-1.5 rounded-full bg-emerald-50 text-emerald-700 text-[11px] font-bold border border-emerald-100">{{ sopSelectedDateBadge }} · {{ completedSopCount }} / {{ selectedSopSteps.length }} 已完成</span><button @click="openClientDetail(selectedSopClient.id)" class="h-9 px-3 rounded-xl border border-slate-200 text-xs font-bold hover:bg-slate-50">查看客户资产</button></div>
            </div>

            <div class="grid grid-cols-1 xl:grid-cols-3 gap-5">
              <div class="xl:col-span-2 bg-white border border-slate-200 rounded-2xl soft-shadow overflow-hidden">
                <div class="p-5 border-b border-slate-100 space-y-4">
                  <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-4">
                    <div>
                      <h3 class="font-extrabold text-sm">{{ sopChecklistTitle }}</h3>
                      <p class="text-[11px] text-slate-400 mt-1">任务和完成状态按“客户 + 账号 + 日期”独立保存，通过日期选择器查看历史或安排未来任务。</p>
                    </div>
                    <button @click="openSopTaskModal" class="h-10 px-4 rounded-xl bg-indigo-600 text-white text-xs font-extrabold hover:bg-indigo-500 shadow-sm shadow-indigo-200 flex items-center justify-center gap-2 shrink-0">
                      <span class="w-5 h-5 rounded-lg bg-white/15 flex items-center justify-center"><i class="fa-solid fa-plus text-[10px]"></i></span>
                      <span>添加任务</span>
                    </button>
                  </div>
                  <div class="rounded-xl border border-slate-200 bg-slate-50/80 p-3 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                    <div class="flex flex-wrap items-center gap-2">
                      <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">任务日期</span>
                      <input type="date" v-model="selectedSopDate" @change="onSopDateChange" class="h-9 rounded-xl border border-slate-200 bg-white px-3 text-xs font-bold text-slate-700">
                      <button @click="setSopDateToday" class="h-9 px-3 rounded-xl border border-indigo-200 bg-indigo-50 text-indigo-700 text-xs font-bold hover:bg-indigo-100">今天</button>
                    </div>
                    <button @click="resetSopProgress" class="h-9 px-3 rounded-xl bg-white text-rose-600 border border-rose-200 text-xs font-bold hover:bg-rose-50"><i class="fa-solid fa-rotate-left mr-1.5"></i>重置完成状态</button>
                  </div>
                </div>
                <div class="p-5 space-y-3">
                  <div v-for="(step,idx) in selectedSopSteps" :key="step.id" class="rounded-2xl border overflow-hidden transition" :class="sopChecked[step.id]?'bg-emerald-50/50 border-emerald-200':'bg-white border-slate-200'">
                    <div class="p-3.5 sm:p-4 flex items-center gap-3">
                      <input type="checkbox" v-model="sopChecked[step.id]" @change="saveSopProgress" class="w-4 h-4 accent-emerald-600 shrink-0">
                      <button type="button" @click="toggleSopTask(step.id)" class="flex-1 min-w-0 text-left group">
                        <div class="flex items-center gap-2 min-w-0">
                          <span class="w-6 h-6 rounded-lg bg-slate-100 text-slate-500 flex items-center justify-center text-[10px] font-black shrink-0">{{ idx+1 }}</span>
                          <span class="truncate text-xs sm:text-sm font-extrabold" :class="sopChecked[step.id]?'text-emerald-700 line-through':'text-slate-800'">{{ step.text || '未命名任务' }}</span>
                          <span v-if="step.plan" class="hidden md:inline-flex px-2 py-1 rounded-lg bg-indigo-50 text-indigo-600 text-[9px] font-bold shrink-0"><i class="fa-regular fa-clock mr-1"></i>{{ step.plan }}</span>
                        </div>
                      </button>
                      <div class="flex items-center gap-1 shrink-0">
                        <button type="button" @click="openSopTaskModal(step)" class="w-8 h-8 rounded-lg text-indigo-600 hover:bg-indigo-50 transition" title="修改任务"><i class="fa-solid fa-pen text-[11px]"></i></button>
                        <button type="button" @click="removeSopStep(idx)" class="w-8 h-8 rounded-lg text-rose-500 hover:bg-rose-50 transition" title="删除任务"><i class="fa-regular fa-trash-can text-[11px]"></i></button>
                        <button type="button" @click="toggleSopTask(step.id)" class="w-8 h-8 rounded-lg text-slate-400 hover:bg-slate-50 transition" :title="sopExpandedTasks[step.id]?'收起详情':'展开详情'"><i class="fa-solid fa-chevron-down text-[10px] transition-transform duration-200" :class="sopExpandedTasks[step.id]?'rotate-180':''"></i></button>
                      </div>
                    </div>
                    <div v-if="sopExpandedTasks[step.id]" class="px-4 pb-4 pt-0">
                      <div class="ml-7 sm:ml-9 rounded-xl border border-slate-100 bg-slate-50/80 p-3 grid grid-cols-1 md:grid-cols-2 gap-3">
                        <div><div class="text-[9px] uppercase tracking-wider font-bold text-slate-400">计划</div><div class="text-xs font-semibold text-slate-700 mt-1.5 whitespace-pre-wrap">{{ step.plan || '未设置计划' }}</div></div>
                        <div><div class="text-[9px] uppercase tracking-wider font-bold text-slate-400">备注</div><div class="text-xs text-slate-600 mt-1.5 whitespace-pre-wrap">{{ step.note || '暂无备注' }}</div></div>
                      </div>
                    </div>
                  </div>
                  <div v-if="!selectedSopSteps.length" class="py-12 text-center text-xs text-slate-400"><i class="fa-solid fa-calendar-plus text-3xl text-slate-200 block mb-3"></i>{{ sopSelectedDateBadge }} 暂无任务，点击右上角「添加任务」开始安排。</div>
                </div>
              </div>

              <div class="space-y-5">
                <div class="bg-white border border-slate-200 rounded-2xl p-5 soft-shadow space-y-4">
                  <div><div class="font-extrabold text-sm">计划与账号备注</div><p class="text-[11px] text-slate-400 mt-1">长期执行计划和账号注意事项，只属于当前选择的客户账号。</p></div>
                  <label class="block"><span class="block text-[11px] font-bold text-slate-600 mb-1.5">执行计划</span><textarea v-model="selectedSopConfig.dailyPlan" rows="4" placeholder="例如：工作日 09:00 检查账户；18:00 同步日报" class="w-full rounded-xl border border-slate-200 p-3 text-xs focus:outline-none focus:ring-2 focus:ring-indigo-100"></textarea></label>
                  <label class="block"><span class="block text-[11px] font-bold text-slate-600 mb-1.5">账号备注</span><textarea v-model="selectedSopConfig.notes" rows="4" placeholder="记录账号特殊要求、客户要求、操作禁忌等" class="w-full rounded-xl border border-slate-200 p-3 text-xs focus:outline-none focus:ring-2 focus:ring-indigo-100"></textarea></label>
                  <button @click="saveSopSettings" class="w-full h-10 rounded-xl bg-slate-950 text-white text-xs font-bold hover:bg-slate-800"><i class="fa-solid fa-floppy-disk mr-1.5"></i>保存计划与备注</button>
                </div>
                <div class="bg-amber-50 border border-amber-200 rounded-2xl p-5"><div class="font-extrabold text-xs text-amber-900"><i class="fa-solid fa-triangle-exclamation mr-1.5"></i>客户风控规则</div><p class="text-xs text-amber-800 leading-relaxed mt-3">{{ selectedSopClient.riskRules || '暂无风控规则' }}</p></div>
              </div>
            </div>
          </div>
          <div v-else-if="selectedSopClient && selectedSopAccounts.length" class="bg-white border border-slate-200 rounded-2xl py-16 text-center text-xs text-slate-400"><i class="fa-solid fa-arrow-up-right-dots text-3xl text-slate-200 block mb-3"></i><div class="font-bold text-slate-600">请选择执行账号</div><div class="mt-1">{{ selectedSopClient.name }} 有 {{ selectedSopAccounts.length }} 个 FB / TikTok 账号，请在右上角明确选择本次执行账号。</div><button type="button" @click="openClientDetail(selectedSopClient.id)" class="mt-4 h-9 px-4 rounded-xl border border-slate-200 bg-white text-xs font-bold text-slate-600 hover:bg-slate-50">查看 {{ selectedSopClient.name }} 资产</button></div>
          <div v-else-if="selectedSopClient" class="bg-white border border-slate-200 rounded-2xl py-16 text-center text-xs text-slate-400"><i class="fa-solid fa-user-lock text-3xl text-slate-200 block mb-3"></i><div class="font-bold text-slate-600">当前客户暂无可执行账号</div><div class="mt-1">请先到客户资料中添加 Facebook / TikTok 账号资产。</div><button type="button" @click="openClientDetail(selectedSopClient.id)" class="mt-4 h-9 px-4 rounded-xl border border-slate-200 bg-white text-xs font-bold text-slate-600 hover:bg-slate-50">查看 {{ selectedSopClien