最近充值日期</div><div class="text-xl font-black text-amber-700 mt-2">{{ latestRechargeDate(selectedAdsAccount) }}</div><div class="text-[10px] text-slate-400 mt-1">登记充值时自动写入日期</div></div>
            </div>

            <div v-if="selectedAdsAccount && selectedAdsAccount.rechargeHistory && selectedAdsAccount.rechargeHistory.length" class="bg-white border border-slate-200 rounded-2xl soft-shadow overflow-hidden">
              <div class="p-4 border-b border-slate-100"><div class="font-extrabold text-sm">广告费充值记录</div><div class="text-[10px] text-slate-400 mt-1">充值日期会在每次登记时自动记录，可在充值窗口修改当天日期。</div></div>
              <div class="overflow-x-auto"><table class="w-full text-xs"><thead class="bg-slate-50 text-slate-400"><tr><th class="text-left px-4 py-3">日期</th><th class="text-left px-4 py-3">金额</th><th class="text-left px-4 py-3">备注</th></tr></thead><tbody class="divide-y divide-slate-100"><tr v-for="record in selectedAdsAccount.rechargeHistory.slice(0,8)" :key="record.id"><td class="px-4 py-3 font-mono font-bold">{{ record.date }}</td><td class="px-4 py-3 font-extrabold text-emerald-600">{{ formatMoney(record.amount,record.currency) }}</td><td class="px-4 py-3 text-slate-500">{{ record.note || '广告账户充值' }}</td></tr></tbody></table></div>
            </div>

            <!-- Saved Ads Plan List -->
            <div v-if="selectedAdsAccount" class="bg-white border border-slate-200 rounded-2xl soft-shadow overflow-hidden">
              <div class="p-5 border-b border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                <div><h3 class="font-extrabold text-sm">已保存广告方案</h3><p class="text-[11px] text-slate-400 mt-1">方案保存后会变成列表记录；点击「详情」查看完整广告设置方案。</p></div>
                <button @click="addAdCampaign" class="h-9 px-3.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-bold"><i class="fa-solid fa-plus mr-1.5"></i>新建广告方案</button>
              </div>
              <div v-if="savedAdsCampaignsForAccount.length" class="overflow-x-auto scrollbar">
                <table class="w-full min-w-[1080px] text-xs">
                  <thead class="bg-slate-50 text-slate-500"><tr><th class="p-3.5 text-left">方案名称</th><th class="p-3.5 text-left">广告系列</th><th class="p-3.5 text-left">目标</th><th class="p-3.5 text-left">广告组 / 广告</th><th class="p-3.5 text-left">方案预算</th><th class="p-3.5 text-left">数据消耗</th><th class="p-3.5 text-left">数据记录</th><th class="p-3.5 text-left">更新时间</th><th class="p-3.5 text-left">操作</th></tr></thead>
                  <tbody class="divide-y divide-slate-100">
                    <tr v-for="campaign in savedAdsCampaignsForAccount" :key="campaign.id" class="hover:bg-slate-50/70">
                      <td class="p-3.5"><div class="font-extrabold text-slate-900">{{ campaign.planName || '未命名方案' }}</div><div class="text-[10px] text-slate-400 mt-1">{{ selectedAdsPlatform==='FB'?'Facebook':'TikTok' }} · {{ selectedAdsAccount.accountName }}</div></td>
                      <td class="p-3.5 font-bold">{{ campaign.name || '未命名广告系列' }}</td>
                      <td class="p-3.5"><span class="inline-flex px-2 py-1 rounded-lg bg-indigo-50 text-indigo-700 text-[10px] font-extrabold">{{ objectiveLabel(campaign.objective) }}</span></td>
                      <td class="p-3.5"><div class="font-bold">{{ (campaign.adSets||[]).length }} 个广告组</div><div class="text-[10px] text-slate-400 mt-1">{{ campaignAdCount(campaign) }} 个广告</div></td>
                      <td class="p-3.5 font-extrabold text-violet-600">{{ campaignBudgetText(campaign) }}</td>
                      <td class="p-3.5 font-extrabold text-amber-600">{{ campaignDataSpendText(campaign) }}</td>
                      <td class="p-3.5"><span class="inline-flex px-2 py-1 rounded-full bg-cyan-50 text-cyan-700 font-extrabold text-[10px]">{{ campaignDataRecordCount(campaign) }} 条</span></td>
                      <td class="p-3.5 font-mono text-[11px] text-slate-500">{{ campaign.updatedAt || campaign.savedAt || campaign.createdAt || '—' }}</td>
                      <td class="p-3.5"><div class="flex justify-end gap-1.5"><button @click="openAdsPlanDetail(campaign)" class="h-8 px-2.5 rounded-lg bg-slate-100 text-slate-700 font-bold text-[11px]"><i class="fa-regular fa-eye mr-1"></i>详情</button><button @click="openAdDataModal(campaign)" class="h-8 px-2.5 rounded-lg bg-cyan-600 text-white font-bold text-[11px]"><i class="fa-solid fa-chart-line mr-1"></i>加数据</button><button @click="editAdCampaign(campaign)" class="h-8 px-2.5 rounded-lg bg-indigo-50 text-indigo-700 font-bold text-[11px]"><i class="fa-regular fa-pen-to-square"></i></button><button @click="removeAdCampaign(campaign)" class="h-8 px-2.5 rounded-lg bg-rose-50 text-rose-600 font-bold text-[11px]"><i class="fa-regular fa-trash-can"></i></button></div></td>
                    </tr>
                  </tbody>
                </table>
              </div>
              <div v-else class="py-12 text-center"><i class="fa-solid fa-table-list text-3xl text-slate-200"></i><div class="text-sm font-extrabold text-slate-600 mt-3">还没有已保存的广告方案</div><div class="text-xs text-slate-400 mt-1">点击「新建广告方案」设置完成后保存，方案会自动出现在这里。</div></div>
            </div>

            <!-- Draft / Edit Ads Plan -->
            <div v-if="selectedAdsAccount && draftAdsCampaignsForAccount.length" class="space-y-5">
              <div v-for="(campaign,campaignIndex) in draftAdsCampaignsForAccount" :key="campaign.id" class="bg-white border border-indigo-200 rounded-2xl soft-shadow overflow-hidden">
                <div class="p-5 border-b border-indigo-100 bg-indigo-50/30">
                  <div class="flex flex-col lg:flex-row lg:items-start justify-between gap-4">
                    <div><div class="text-[10px] text-indigo-500 font-bold">AD PLAN EDITOR · 广告方案编辑</div><div class="font-extrabold text-base mt-1">{{ campaign.planName || campaign.name || '新广告方案' }}</div><div class="text-[10px] text-slate-400 mt-1">设置完成后点击保存，当前编辑器会收起并生成一条方案列表。</div></div>
                    <div class="flex gap-2"><button @click="saveAdsPlan(campaign)" class="h-9 px-4 rounded-xl bg-slate-950 text-white text-xs font-bold"><i class="fa-solid fa-floppy-disk mr-1.5"></i>保存广告方案</button><button type="button" @click="removeAdCampaign(campaign)" class="h-9 px-3 rounded-xl bg-white text-rose-600 border border-rose-100 text-xs font-bold"><i class="fa-regular fa-trash-can mr-1"></i>删除</button></div>
                  </div>
                  <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-3 mt-4">
                    <form-field label="广告系列名称"><input v-model.trim="campaign.name" class="field" placeholder="例如：8月美国潜客测试" /></form-field>
                    <form-field label="广告系列目标"><select v-model="campaign.objective" class="field"><option value="TRAFFIC">流量</option><option value="ENGAGEMENT">互动</option><option value="LEADS">潜在客户</option></select></form-field>
                    <form-field label="方案名称"><input v-model.trim="campaign.planName" class="field" placeholder="例如：美国 B2B 第一轮测试" /></form-field>
                    <div class="rounded-xl bg-white border border-indigo-100 px-3 py-2"><div class="text-[10px] text-slate-400">方案预算</div><div class="text-sm font-extrabold text-violet-600 mt-1">{{ campaignBudgetText(campaign) }}</div></div>
                  </div>
                  <div class="mt-3"><div class="text-[11px] font-semibold text-slate-500 mb-1.5">广告设置方案 / 测试思路 / 优化备注</div><textarea v-model.trim="campaign.planNotes" rows="3" class="w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-xs outline-none focus:ring-2 focus:ring-indigo-100" placeholder="记录预算分配、受众测试逻辑、素材方向、转化路径或后续优化计划"></textarea></div>
                </div>

                <div class="p-4 sm:p-5 space-y-4">
                  <div class="flex items-center justify-between"><div class="text-xs font-extrabold text-slate-800"><i class="fa-solid fa-layer-group text-violet-500 mr-1.5"></i>广告组 Ad Set</div><button @click="addAdSet(campaign)" class="h-8 px-3 rounded-lg bg-violet-600 text-white text-[11px] font-bold"><i class="fa-solid fa-plus mr-1"></i>添加广告组</button></div>
                  <div v-if="campaign.adSets && campaign.adSets.length" class="space-y-4">
                    <div v-for="(adset,adsetIndex) in campaign.adSets" :key="adset.id" class="rounded-2xl bg-white border border-slate-200 p-4">
                      <div class="flex flex-col md:flex-row md:items-center justify-between gap-3"><div><div class="text-[10px] font-bold text-violet-500">AD SET {{ adsetIndex+1 }}</div><div class="text-xs font-extrabold mt-1">{{ adset.name || `广告组 ${adsetIndex+1}` }}</div></div><div class="flex items-center gap-2"><span class="text-[10px] font-bold bg-cyan-50 text-cyan-700 px-2 py-1 rounded-full">实际消耗 {{ adSetDataSpendText(campaign,adset) }}</span><button @click="removeAdSet(campaign,adset)" class="h-8 px-2.5 rounded-lg text-rose-500 bg-rose-50 text-[11px] font-bold"><i class="fa-regular fa-trash-can"></i></button></div></div>
                      <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-3 mt-4">
                        <form-field label="广告组名称"><input v-model.trim="adset.name" class="field" placeholder="例如：US 25-54 工业兴趣" /></form-field>
                        <form-field label="投放方式"><select v-model="adset.deliveryMethod" class="field"><option value="AUTO">自动投放</option><option value="MANUAL">手动定向</option></select></form-field>
                        <form-field label="国家 / 地区"><input v-model.trim="adset.country" class="field" placeholder="例如：美国 / 加拿大" /></form-field>
                        <form-field label="性别"><select v-model="adset.gender" class="field"><option value="ALL">不限</option><option value="MALE">男性</option><option value="FEMALE">女性</option></select></form-field>
                        <form-field label="最低年龄"><input v-model.number="adset.ageMin" type="number" min="13" max="65" class="field" /></form-field>
                        <form-field label="最高年龄"><input v-model.number="adset.ageMax" type="number" min="13" max="65" class="field" /></form-field>
                        <div class="md:col-span-2"><form-field label="兴趣受众"><input v-model.trim="adset.interests" class="field" placeholder="例如：Construction、Heavy Equipment、Landscaping" /></form-field></div>
                        <form-field label="广告组预算"><div class="money-input-group"><select v-model="adset.budgetCurrency" class="field money-currency"><option value="USD">USD</option><option value="CNY">CNY</option></select><input v-model.number="adset.budget" type="number" min="0" step="0.01" class="field money-amount" placeholder="预算" /></div></form-field>
                        <div><div class="text-[11px] font-semibold text-slate-500 mb-1.5">广告组实际消耗</div><div class="h-10 rounded-xl border border-cyan-100 bg-cyan-50/50 px-3 flex items-center justify-between"><span class="text-[10px] text-cyan-700 font-bold">由广告数据自动汇总</span><span class="text-xs font-black text-slate-900">{{ adSetDataSpendText(campaign,adset) }}</span></div></div>
                      </div>

                      <div class="mt-5 pt-4 border-t border-slate-100">
                        <div class="flex items-center justify-between"><div class="text-xs font-extrabold"><i class="fa-solid fa-rectangle-ad text-cyan-500 mr-1.5"></i>广告 Ad</div><button @click="addCreative(adset)" class="h-8 px-3 rounded-lg bg-cyan-600 text-white text-[11px] font-bold"><i class="fa-solid fa-plus mr-1"></i>添加广告</button></div>
                        <div v-if="adset.ads && adset.ads.length" class="grid grid-cols-1 xl:grid-cols-2 gap-3 mt-3">
                          <div v-for="(ad,adIndex) in adset.ads" :key="ad.id" class="rounded-xl border border-cyan-100 bg-cyan-50/20 p-4">
                            <div class="flex items-center justify-between gap-3"><div><div class="text-[10px] font-bold text-cyan-600">AD {{ adIndex+1 }}</div><div class="text-xs font-extrabold mt-1">{{ ad.name || `广告 ${adIndex+1}` }}</div></div><button @click="removeCreative(adset,ad)" class="w-8 h-8 rounded-lg bg-rose-50 text-rose-500"><i class="fa-regular fa-trash-can"></i></button></div>
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mt-3">
                              <form-field label="广告名称"><input v-model.trim="ad.name" class="field" placeholder="例如：割草机视频 A" /></form-field>
                              <form-field label="投放素材"><select v-model="ad.format" class="field"><option value="PHOTO">照片</option><option value="VIDEO">视频</option></select></form-field>
                              <div class="sm:col-span-2"><div class="text-[11px] font-semibold text-slate-500 mb-1.5">广告文案</div><textarea v-model.trim="ad.primaryText" rows="3" class="w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-xs outline-none focus:ring-2 focus:ring-cyan-100" placeholder="记录 Primary Text / 主文案"></textarea></div>
                              <form-field label="标题"><input v-model.trim="ad.headline" class="field" placeholder="广告标题" /></form-field>
                              <form-field label="行动号召"><select v-model="ad.callToAction" class="field"><option value="LEARN_MORE">了解更多</option><option value="CONTACT_US">联系我们</option><option value="GET_QUOTE">获取报价</option><option value="SIGN_UP">注册</option><option value="APPLY_NOW">立即申请</option><option value="SHOP_NOW">立即购买</option><option value="DOWNLOAD">下载</option></select></form-field>
                              <div class="sm:col-span-2"><form-field label="描述"><input v-model.trim="ad.description" class="field" placeholder="广告描述 / 补充卖点" /></form-field></div>
                            </div>
                          </div>
                        </div>
                        <div v-else class="mt-3 rounded-xl border border-dashed border-cyan-200 py-6 text-center text-[11px] text-slate-400">暂无广告素材，点击「添加广告」记录照片 / 视频、文案和 CTA。</div>
                      </div>
                    </div>
                  </div>
                  <div v-else class="rounded-xl border border-dashed border-violet-200 py-8 text-center text-[11px] text-slate-400">暂无广告组，点击「添加广告组」记录国家、年龄、性别、兴趣受众、预算和消耗。</div>
                </div>
              </div>
            </div>

            <!-- Ad Data Records -->
            <div v-if="selectedAdsAccount" class="bg-white border border-slate-200 rounded-2xl soft-shadow overflow-hidden">
              <div class="p-5 border-b border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                <div><h3 class="font-extrabold text-sm">广告数据记录</h3><p class="text-[11px] text-slate-400 mt-1">统一数据源：同一日期 + 方案 + 广告组 + 广告只保留一条记录；再次保存会更新原记录，并自动同步到「投放数据分析」。</p></div>
                <div class="flex items-center gap-2"><span class="hidden sm:inline-flex text-[10px] font-bold text-emerald-700 bg-emerald-50 border border-emerald-100 px-2.5 py-1.5 rounded-full"><i class="fa-solid fa-link mr-1"></i>一处录入 · 双页面同步</span><button @click="openAdDataModal()" :disabled="!savedAdsCampaignsForAccount.length" class="h-9 px-3.5 rounded-xl bg-cyan-600 disabled:bg-slate-300 text-white text-xs font-bold"><i class="fa-solid fa-plus mr-1.5"></i>录入/更新广告数据</button></div>
              </div>
              <div v-if="accountAdDataRecords.length">
                <div class="grid grid-cols-2 md:grid-cols-4 xl:grid-cols-8 gap-2 p-4 bg-cyan-50/30 border-b border-cyan-100">
                  <div class="rounded-xl bg-white border border-cyan-100 p-3"><div class="text-[10px] text-slate-400">累计消耗</div><div class="font-extrabold text-xs mt-1">{{ accountDataSummary(selectedAdsAccount).spendText }}</div></div>
                  <div class="rounded-xl bg-white border border-cyan-100 p-3"><div class="text-[10px] text-slate-400">曝光</div><div class="font-extrabold text-xs mt-1">{{ accountDataSummary(selectedAdsAccount).impressions.toLocaleString() }}</div></div>
                  <div class="rounded-xl bg-white border border-cyan-100 p-3"><div class="text-[10px] text-slate-400">点击</div><div class="font-extrabold text-xs mt-1">{{ accountDataSummary(selectedAdsAccount).clicks.toLocaleString() }}</div></div>
                  <div class="rounded-xl bg-white border border-cyan-100 p-3"><div class="text-[10px] text-slate-400">潜在客户</div><div class="font-extrabold text-xs mt-1">{{ accountDataSummary(selectedAdsAccount).leads.toLocaleString() }}</div></div>
                  <div class="rounded-xl bg-white border border-cyan-100 p-3"><div class="text-[10px] text-slate-400">转化</div><div class="font-extrabold text-xs mt-1">{{ accountDataSummary(selectedAdsAccount).conversions.toLocaleString() }}</div></div>
                  <div class="rounded-xl bg-white border border-cyan-100 p-3"><div class="text-[10px] text-slate-400">CTR</div><div class="font-extrabold text-xs mt-1">{{ accountDataSummary(selectedAdsAccount).ctrText }}</div></div>
                  <div class="rounded-xl bg-white border border-cyan-100 p-3"><div class="text-[10px] text-slate-400">CPL</div><div class="font-extrabold text-xs mt-1">{{ accountDataSummary(selectedAdsAccount).cplText }}</div></div>
                  <div class="rounded-xl bg-white border border-cyan-100 p-3"><div class="text-[10px] text-slate-400">ROAS</div><div class="font-extrabold text-xs mt-1">{{ accountDataSummary(selectedAdsAccount).roasText }}</div></div>
                </div>
                <div class="px-4 py-2 text-[10px] text-slate-400 border-t border-cyan-100">同一日期 + 广告方案 + 广告组 + 广告只保留一条最新记录；Facebook 效率指标与视频指标直接保留在每条数据记录中查看。</div><div class="overflow-x-auto scrollbar"><table class="w-full min-w-[1320px] text-xs"><thead class="bg-slate-50 text-slate-500"><tr><th class="p-3.5 text-left">日期</th><th class="p-3.5 text-left">广告方案</th><th class="p-3.5 text-left">广告组 / 广告</th><th class="p-3.5 text-left">消耗</th><th class="p-3.5 text-left">曝光</th><th class="p-3.5 text-left">点击</th><th class="p-3.5 text-left">潜客</th><th class="p-3.5 text-left">转化</th><th class="p-3.5 text-left">收入</th><th v-if="selectedAdsPlatform==='FB'" class="p-3.5 text-left min-w-[210px]">FB 效率指标</th><th v-if="selectedAdsPlatform==='FB'" class="p-3.5 text-left min-w-[230px]">视频指标</th><th class="p-3.5 text-left">备注</th><th class="p-3.5 text-left">操作</th></tr></thead><tbody class="divide-y divide-slate-100"><tr v-for="record in accountAdDataRecords" :key="record.id" class="hover:bg-slate-50"><td class="p-3.5 font-mono font-bold">{{ record.date }}</td><td class="p-3.5"><div class="font-bold">{{ record.planName || record.campaignName || '—' }}</div><div v-if="record.campaignName &