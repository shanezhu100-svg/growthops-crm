"openingProviders.length" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-3 p-4">
              <div v-for="row in openingProviderSummaryRows" :key="row.provider.id" class="rounded-2xl border border-slate-200 p-4 hover:border-blue-200 transition">
                <div class="flex items-start justify-between gap-3">
                  <div>
                    <div class="flex items-center gap-2 flex-wrap">
                      <div class="font-black text-base">{{ row.provider.name }}</div>
                      <span class="px-2 py-1 rounded-full bg-blue-50 text-blue-700 text-[9px] font-extrabold">{{ (row.provider.contacts||[]).length }} 位对接人</span>
                      <span v-if="(row.provider.contacts||[]).length" class="px-2 py-1 rounded-full bg-violet-50 text-violet-700 text-[9px] font-extrabold">{{ providerRateRangeText(row.provider) }}</span>
                    </div>
                    <div class="text-[10px] text-slate-400 mt-1">{{ row.provider.platforms || 'FB + TK' }} <span v-if="row.provider.region">· {{ row.provider.region }}</span></div>
                  </div>
                  <div class="flex gap-1"><button type="button" @click="openingProviderFilter=row.provider.id" class="w-8 h-8 rounded-lg bg-slate-50 text-slate-500" title="筛选该开户商"><i class="fa-solid fa-filter"></i></button><button v-if="canManageProviders()" type="button" @click="openProviderModal(row.provider)" class="w-8 h-8 rounded-lg bg-blue-50 text-blue-600" title="编辑开户商"><i class="fa-solid fa-pen"></i></button></div>
                </div>
                <div class="grid grid-cols-2 gap-2 mt-4"><div class="rounded-xl bg-slate-50 p-3"><div class="text-[9px] text-slate-400">开户客户</div><div class="font-extrabold mt-1">{{ row.clientCount }} 个</div></div><div class="rounded-xl bg-amber-50 p-3"><div class="text-[9px] text-amber-600">{{ openingSpendPeriodLabel }}消耗</div><div class="font-extrabold text-amber-700 mt-1">{{ row.spendText }}</div><div class="text-[9px] text-violet-600 mt-1">返点 {{ row.rebateText }}</div></div></div>
                <div class="mt-3 rounded-xl border border-violet-100 overflow-hidden">
                  <div class="px-3 py-2 bg-violet-50/60 text-[10px] font-extrabold text-violet-700 flex items-center justify-between"><span>消耗 / 返点自动核算</span><span>按对接人政策</span></div>
                  <div class="grid grid-cols-2 divide-x divide-y divide-slate-100 text-[10px]"><div class="p-2.5"><div class="text-slate-400">累计总消耗</div><div class="font-extrabold text-slate-800 mt-1">{{ row.totalSpendText }}</div><div class="text-violet-600 mt-1">返点 {{ row.totalRebateText }}</div></div><div class="p-2.5"><div class="text-slate-400">{{ openingMonthLabel }}消耗</div><div class="font-extrabold text-slate-800 mt-1">{{ row.monthSpendText }}</div><div class="text-violet-600 mt-1">返点 {{ row.monthRebateText }}</div></div><div class="p-2.5"><div class="text-slate-400">{{ openingQuarterLabel }}消耗</div><div class="font-extrabold text-slate-800 mt-1">{{ row.quarterSpendText }}</div><div class="text-violet-600 mt-1">返点 {{ row.quarterRebateText }}</div></div><div class="p-2.5"><div class="text-slate-400">{{ openingYearLabel }}消耗</div><div class="font-extrabold text-slate-800 mt-1">{{ row.yearSpendText }}</div><div class="text-violet-600 mt-1">返点 {{ row.yearRebateText }}</div></div></div>
                </div>
                <div class="mt-3 rounded-xl border border-slate-100 overflow-hidden">
                  <div class="px-3 py-2 bg-slate-50 text-[10px] font-extrabold text-slate-600 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                    <span>对接人与独立返点</span>
                    <div class="flex items-center gap-2">
                      <div class="relative">
                        <i class="fa-solid fa-user-check absolute left-2.5 top-1/2 -translate-y-1/2 text-violet-500 pointer-events-none"></i>
                        <select :value="openingContactSelections[row.provider.id] || 'ALL'" @change="openingContactSelections[row.provider.id]=$event.target.value" class="h-7 max-w-[190px] rounded-lg border border-violet-200 bg-white pl-7 pr-7 text-[9px] font-extrabold text-violet-700 outline-none focus:ring-2 focus:ring-violet-100" title="选择对接人查看">
                          <option value="ALL">选择对接人 · 全部</option>
                          <option v-for="cr in row.contactRows" :key="cr.contact.id" :value="cr.contact.id">{{ cr.contact.name }} · 当前 {{ Number(contactCurrentRebateRate(cr.contact)||0).toFixed(2) }}%</option>
                        </select>
                      </div>
                    </div>
                  </div>
                  <div v-if="visibleProviderContactRows(row).length" class="provider-contact-list divide-y divide-slate-100" :class="{'is-all':(openingContactSelections[row.provider.id] || 'ALL')==='ALL'}">
                    <div v-for="cr in visibleProviderContactRows(row)" :key="cr.contact.id" class="provider-contact-row p-3 text-[10px]">
                      <div class="flex items-center justify-between gap-2"><div class="font-extrabold text-slate-800">{{ cr.contact.name }}</div><span class="px-2 py-0.5 rounded-full bg-violet-50 text-violet-700 font-extrabold">当前 {{ Number(contactCurrentRebateRate(cr.contact)||0).toFixed(2) }}%</span></div>
                      <div class="text-slate-400 mt-1 break-all">{{ providerContactText(cr.contact) }}</div>
                      <div class="grid grid-cols-2 gap-2 mt-2"><div class="rounded-lg bg-amber-50 px-2 py-1.5"><span class="text-amber-600">消耗</span><div class="font-bold text-amber-700 mt-0.5">{{ cr.spendText }}</div></div><div class="rounded-lg bg-violet-50 px-2 py-1.5"><span class="text-violet-600">返点</span><div class="font-bold text-violet-700 mt-0.5">{{ cr.rebateText }}</div></div></div>
                      <div v-if="rebatePolicyForContact(cr.contact,localDateKey())?.rebatePolicy" class="text-violet-600 mt-2 line-clamp-2">当前政策：{{ rebatePolicyForContact(cr.contact,localDateKey())?.rebatePolicy }}</div>
                    </div>
                  </div>
                  <div v-else class="p-3 text-[10px] text-amber-600 bg-amber-50/50">尚未维护对接人。编辑开户商后可为不同对接人设置独立返点。</div>
                </div>
                <div v-if="row.provider.policy" class="mt-3 pt-3 border-t border-slate-100 text-[10px] text-slate-500 line-clamp-2">开户政策：{{ row.provider.policy }}</div>
              </div>
            </div>
          </div>

          <div class="bg-white border border-slate-200 rounded-2xl soft-shadow overflow-hidden">
            <div class="p-4 border-b border-slate-100 flex flex-col xl:flex-row xl:items-center justify-between gap-3"><div><div class="font-extrabold text-sm">客户开户渠道记录</div><div class="text-[10px] text-slate-400 mt-1">直接查看客户开户渠道、对接人和返点政策；只有“已开户”状态才进入广告消耗与返点财务归属，开户费用会自动进入客户成本。</div></div><div class="flex flex-col sm:flex-row gap-2"><input v-model.trim="openingSearch" class="h-9 w-full sm:w-60 rounded-xl border border-slate-200 px-3 text-xs outline-none" placeholder="搜索客户 / 开户商 / 账号 ID" /><select v-model="openingProviderFilter" class="h-9 rounded-xl border border-slate-200 px-3 text-xs font-semibold"><option value="ALL">全部开户商</option><option v-for="p in openingProviders" :key="p.id" :value="p.id">{{ p.name }}</option></select><select v-model="openingPlatformFilter" class="h-9 rounded-xl border border-slate-200 px-3 text-xs font-semibold"><option value="ALL">全部平台</option><option value="FB">Facebook</option><option value="TK">TikTok</option></select><select v-model="openingStatusFilter" class="h-9 rounded-xl border border-slate-200 px-3 text-xs font-semibold"><option value="ALL">全部状态</option><option value="PREPARE">资料准备</option><option value="SUBMITTED">已提交</option><option value="REVIEWING">审核中</option><option value="OPENED">已开户</option><option value="REJECTED">异常 / 驳回</option></select></div></div>
            <div v-if="filteredOpeningDeals.length" class="overflow-x-auto scrollbar"><table class="w-full min-w-[1580px] text-left text-xs"><thead class="bg-slate-50 text-slate-400"><tr><th class="p-4">客户 / 平台</th><th class="p-4">开户商 / 对接人</th><th class="p-4">开户类型 / 地区</th><th class="p-4">开户费用</th><th class="p-4">{{ openingSpendPeriodLabel }}广告消耗</th><th class="p-4">{{ openingSpendPeriodLabel }}返点</th><th class="p-4">提交 / 预计完成</th><th class="p-4">状态</th><th class="p-4">BM/BC / 广告账户</th><th class="p-4 text-right">操作</th></tr></thead><tbody class="divide-y divide-slate-100"><tr v-for="deal in filteredOpeningDeals" :key="deal.id" class="hover:bg-slate-50/70"><td class="p-4"><div class="font-extrabold">{{ openingClientName(deal) }}</div><div class="mt-1"><span class="inline-flex px-2 py-1 rounded-lg text-[10px] font-extrabold" :class="deal.platform==='FB'?'bg-blue-50 text-blue-700':'bg-slate-950 text-white'"><i :class="deal.platform==='FB'?'fa-brands fa-facebook':'fa-brands fa-tiktok'" class="mr-1"></i>{{ deal.platform==='FB'?'Facebook':'TikTok' }}</span></div></td><td class="p-4"><div class="font-extrabold text-blue-700">{{ openingProviderName(deal) }}</div><div class="text-[10px] text-slate-500 mt-1">对接人：{{ openingContactName(deal) }}</div></td><td class="p-4"><div class="font-bold">{{ deal.accountType || '标准广告账户' }}</div><div class="text-[10px] text-slate-400 mt-1">{{ deal.region || openingProvider(deal)?.region || '—' }} · {{ deal.quantity || 1 }} 个账户</div></td><td class="p-4 font-extrabold text-emerald-600">{{ Number(deal.fee||0)>0 ? formatMoney(deal.fee,deal.cur