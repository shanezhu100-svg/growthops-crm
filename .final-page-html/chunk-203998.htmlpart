v v-for="item in financeMoneyRows(financeAttributedSpendGroups)" :key="'attr-spend-'+item.currency" class="metric-money-row"><span class="metric-money-currency">{{ item.currency }}</span><span class="metric-money-amount">{{ item.text }}</span></div></div><div class="metric-note">已绑定开户渠道且命中有效期的消耗。</div></div>
                <div class="finance-kpi-card is-violet"><div class="metric-label">预计返点</div><div class="metric-money-list"><div v-for="item in financeMoneyRows(financeExpectedRebateGroups)" :key="'rebate-'+item.currency" class="metric-money-row"><span class="metric-money-currency">{{ item.currency }}</span><span class="metric-money-amount">{{ item.text }}</span></div></div><div class="metric-note">按广告日期命中的对接人返点政策计算。</div></div>
                <div class="finance-kpi-card is-sky"><div class="metric-label">已确认实际返点</div><div class="metric-money-list"><div v-for="item in financeMoneyRows(financeActualRebateGroups)" :key="'actual-rebate-'+item.currency" class="metric-money-row"><span class="metric-money-currency">{{ item.currency }}</span><span class="metric-money-amount">{{ item.text }}</span></div></div><div class="metric-note">仅统计代理商返点对账中已确认记录。</div></div>
                <div class="finance-kpi-card is-rose"><div class="metric-label">未归属消耗</div><div class="metric-money-list"><div v-for="item in financeMoneyRows(financeUnassignedSpendGroups)" :key="'unassigned-'+item.currency" class="metric-money-row"><span class="metric-money-currency">{{ item.currency }}</span><span class="metric-money-amount">{{ item.text }}</span></div></div><div class="metric-note">仍在总消耗中，但未进入渠道返点归属。</div></div>
              </div>
            </div>
            <div class="finance-panel">
              <div class="finance-panel-header">
                <div>
                  <div class="finance-panel-title">收入与回款</div>
                  <div class="finance-panel-desc">应收账单是本期收入和回款的唯一财务凭证。正式客户的周期账单自动生成，手工计费项目由财务登记。</div>
                </div>
                <span class="finance-panel-tag"><i class="fa-solid fa-file-invoice-dollar"></i>AR</span>
              </div>
              <div class="finance-kpi-grid finance-kpi-grid-five">
                <div class="finance-kpi-card is-sky"><div class="metric-label">本期收入</div><div class="metric-money-list"><div v-for="item in financeMoneyRows(financeRevenueGroups)" :key="'revenue-'+item.currency" class="metric-money-row"><span class="metric-money-currency">{{ item.currency }}</span><span class="metric-money-amount">{{ item.text }}</span></div></div><div class="metric-note">直接汇总本期应收账单金额。</div></div>
                <div class="finance-kpi-card is-emerald"><div class="metric-label">本期已回款</div><div class="metric-money-list"><div v-for="item in financeMoneyRows(financeReceivedGroups)" :key="'received-'+item.currency" class="metric-money-row"><span class="metric-money-currency">{{ item.currency }}</span><span class="metric-money-amount">{{ item.text }}</span></div></div><div class="metric-note">按应收账单已收金额汇总。</div></div>
                <div class="finance-kpi-card is-amber"><div class="metric-label">待回款</div><div class="metric-money-list"><div v-for="item in financeMoneyRows(financeOutstandingGroups)" :key="'outstanding-'+item.currency" class="metric-money-row"><span class="metric-money-currency">{{ item.currency }}</span><span class="metric-money-amount">{{ item.text }}</span></div></div><div class="metric-note">已生成账单但尚未收齐的余额。</div></div>
                <div class="finance-kpi-card is-violet"><div class="metric-label">本期成本</div><div class="metric-money-list"><div v-for="item in financeMoneyRows(financeCostGroups)" :key="'cost-'+item.currency" class="metric-money-row"><span class="metric-money-currency">{{ item.currency }}</span><span class="metric-money-amount">{{ item.text }}</span></div></div><div class="metric-note">包含拍摄、开户、IP / 代理、第三方工具等。</div></div>
                <div class="finance-kpi-card is-rose"><div class="metric-label">本期净利润</div><div class="metric-money-list"><div v-for="item in financeMoneyRows(financeNetProfitGroups)" :key="'net-profit-'+item.currency" class="metric-money-row"><span class="metric-money-currency">{{ item.currency }}</span><span class="metric-money-amount">{{ item.text }}</span></div></div><div class="metric-note">收入 + 实际返点 − 成本，按币种分别核算。</div></div>
              </div>
            </div>
          </div>

          <div class="finance-insight-grid">
            <div class="finance-panel">
              <div class="finance-panel-header">
                <div><div class="finance-panel-title">财务健康度</div><div class="finance-panel-desc">聚焦回款覆盖、渠道返点归属与本期成本控制。</div></div>
              </div>
              <div class="finance-health-grid">
                <div class="finance-health-card"><div class="finance-health-label">本期应收覆盖</div><div class="finance-health-value">{{ financeCollectionRateText }}</div><div class="finance-health-track"><div class="finance-health-fill" :style="{width:financeCollectionRate+'%'}"></div></div><div class="finance-health-note">本期已回款 / 本期收入</div></div>
                <div class="finance-health-card"><div class="finance-health-label">渠道消耗归属</div><div class="finance-health-value">{{ financeSpendAttributionRateText }}</div><div class="finance-health-track"><div class="finance-health-fill finance-health-fill-violet" :style="{width:financeSpendAttributionRate+'%'}"></div></div><div class="finance-health-note">已归属渠道消耗 / 广告总消耗</div></div>
              </div>
            </div>
            <div class="finance-panel finance-action-panel">
              <div class="finance-panel-title">本期关键动作</div>
              <div class="finance-action-list">
                <div class="finance-action-row"><span>待回款账单</span><strong>{{ financeOutstandingInvoiceCount }} 笔</strong></div>
                <div class="finance-action-row"><span>未归属广告消耗</span><strong>{{ financeMoneyGroupsSummary(financeUnassignedSpendGroups) }}</strong></div>
                <div class="finance-action-row"><span>未确认返点对账</span><strong>{{ financePendingReconciliationCount }} 笔</strong></div>
              </div>
            </div>
          </div>

          <div class="bg-white border border-slate-200 rounded-2xl soft-shadow overflow-hidden">
            <div class="p-4 border-b border-slate-100 flex flex-col xl:flex-row xl:items-center justify-between gap-3"><div><div class="font-extrabold text-sm">渠道返点收入</div><div class="text-[10px] text-slate-400 mt-1">本期总广告消耗直接来自广告数据；只有已归属开户渠道的消耗才进入预计返点，实际返点需在“代理商返点对账”确认。</div></div></div>
            <div v-if="financeChannelRows.length" class="overflow-x-auto scrollbar"><table class="w-full min-w-[1460px] text-left text-xs"><thead class="bg-slate-50 text-slate-400"><tr><th class="p-4">客户 / 渠道</th><th class="p-4">平台 / 对接人</th><th class="p-4">本期消耗</th><th class="p-4">平均预计返点</th><th class="p-4">本期预计返点</th><th class="p-4">已确认实际返点</th><th class="p-4">开户费用</th><th class="p-4">渠道状态</th><th class="p-4">生效范围</th></tr></thead><tbody class="divide-y divide-slate-100"><tr v-for="row in financeChannelRows" :key="row.key" class="hover:bg-slate-50/70"><td class="p-4"><div class="font-extrabold">{{ row.clientName }}</div><div class="text-[10px] text-slate-400 mt-1">{{ row.providerName }}</div></td><td class="p-4"><div class="font-bold">{{ row.platform==='FB'?'Facebook':'TikTok' }}</div><div class="text-[10px] text-slate-400 mt-1">{{ row.contactName }}</div></td><td class="p-4 font-black text-amber-600">{{ row.spendText }}</td><td class="p-4 font-extrabold text-violet-600">{{ row.rebateRateText }}</td><td class="p-4 font-black text-violet-600">{{ row.rebateText }}</td><td class="p-4 font-black text-sky-600">{{ row.actualRebateText }}</td><td class="p-4 font-extrabold text-emerald-600">{{ row.openingFeeText }}</td><td class="p-4"><span class="px-2 py-1 rounded-full text-[10px] font-extrabold" :class="openingStatusStyle(row.status)">{{ openingStatusText(row.status) }}</span></td><td class="p-4 font-mono text-[10px]"><div>{{ row.effectiveStartDate || '历史全部' }}</div><div class="text-slate-400 mt-1">→ {{ row.effectiveEndDate || '持续' }}</div></td></tr></tbody></table></div><div v-else class="py-14 text-center text-xs text-slate-400">当前周期没有渠道返点数据。</div>
          </div>

          <div class="bg-white border border-slate-200 rounded-2xl soft-shadow overflow-hidden">
            <div class="p-4 border-b border-slate-100 flex flex-col xl:flex-row xl:items-center justify-between gap-3"><div><div class="font-extrabold text-sm">本期客户应收 / 回款</div><div class="text-[10px] text-slate-400 mt-1">自动账单会按客户付款日和周期生成；账单保存后金额锁定为历史凭证，不再随客户当前月费变化。</div></div><button type="button" @click="openReceivableModal()" class="h-9 px-3.5 rounded-xl bg-blue-50 border border-blue-100 text-blue-700 text-xs font-bold"><i class="fa-solid fa-plus mr-1"></i>登记手工账单</button></div>
            <div v-if="financeReceivableRows.length" class="overflow-x-auto scrollbar"><table class="w-full min-w-[1480px] text-left text-xs"><thead class="bg-slate-50 text-slate-400"><tr><th class="p-4">账单</th><th class="p-4">客户</th><th class="p-4">账期 / 付款日</th><th class="p-4">应收</th><th class="p-4">已收</th><th class="p-4">未收</th><th class="p-4">逾期</th><th class="p-4">状态</th><th class="p-4 text-right">操作</th></tr></thead><tbody class="divide-y divide-slate-100"><tr v-for="row in financeReceivableRows" :key="row.id" class="hover:bg-slate-50/70"><td class="p-4"><div class="font-extrabold text-slate-800">{{ row.invoiceNo }}</div><div class="text-[10px] text-slate-400 mt-1">{{ receivableServiceTypeText(row.serviceType) }}</div></td><td class="p-4 font-extrabold">{{ financeClientName(row) }}</td><td class="p-4"><div class="font-mono font-bold">{{ row.periodLabel || '—' }}</div><div class="text-[10px] text-slate-400 mt-1">到期 {{ row.dueDate || '—' }}</div></td><td class="p-4 font-black text-blue-600">{{ formatMoney(row.amount,row.currency) }}</td><td class="p-4 font-black text-emerald-600">{{ formatMoney(row.receivedAmount,row.currency) }}</td><td class="p-4 font-black text-amber-600">{{ formatMoney(row.outstandingAmount,row.currency) }}</td><td class="p-4"><span class="text-[10px] font-extrabold" :class="row.overdue?'text-rose-600':'text-slate-400'">{{ row.overdue ? daysLeftLabel(row.daysLeft) : '—' }}</span></td><td class="p-4"><span class="px-2 py-1 rounded-full text-[10px] font-extrabold" :class="financeReceivableStatusStyle(row)">{{ financeReceivableStatusText(row) }}</span></td><td class="p-4 text-right"><div class="flex justify-end gap-1"><button type="button" @click="openReceivableModal(row)" class="w-8 h-8 rounded-lg bg-blue-50 text-blue-600" title="编辑账单"><i class="fa-solid fa-pen"></i></button><button v-if="Number(row.outstandingAmount||0)>0" type="button" @click="openCollectionModal(row)" class="h-8 px-2.5 rounded-lg bg-emerald-50 text-emerald-700 text-[10px] font-bold"><i class="fa-solid fa-hand-holding-dollar mr-1"></i>回款</button><button v-if="!row.autoGenerated" type="button" @click="deleteReceivable(row)" class="w-8 h-8 rounded-lg bg-rose-50 text-rose-500"><i class="fa-regular fa-trash-can"></i></button></div></td></tr></tbody></table></div><div v-else class="py-14 text-center text-xs text-slate-400">当前周期暂无应收账单。</div>
          </div>

          <div class="bg-white border border-slate-200 rounded-2xl soft-shadow overflow-hidden">
            <div class="p-4 border-b border-slate-100 flex flex-col xl:flex-row xl:items-center justify-between gap-3"><div><div class="font-extrabold text-sm">本期成本明细</div><div class="text-[10px] text-slate-400 mt-1">拍摄服务费、开户费、IP / 代理、第三方工具等。开户费和已配置的 IP 月费会自动同步。</div></div><button type="button" @click="openCostModal()" class="h-9 px-3.5 rounded-xl bg-slate-950 text-white text-xs font-bold"><i class="fa-solid fa-plus mr-1"></i>新增成本</button></div>
            <div v-if="financeCostRows.length" class="overflow-x-auto scrollbar"><table class="w-full min-w-[1280px] text-left text-xs"><thead class="bg-slate-50 text-slate-400"><tr><th class="p-4">日期</th><th class="p-4">客户</th><th class="p-4">成本类型</th><th class="p-4">供应商 / 来源</th><th class="p-4">金额</th><th class="p-4">备注</th><th class="p-4">状态</th><th class="p-4 text-right">操作</th></tr></thead><tbody class="divide-y divide-slate-100"><tr v-for="row in financeCostRows" :key="row.id" class="hover:bg-slate-50/70"><td class="p-4 font-mono font-bold">{{ row.date }}</td><td class="p-4 font-extrabold">{{ financeClientName(row) }}</td><td class="p-4">{{ financeCostTypeText(row.type) }}</td><td class="p-4 text-slate-500">{{ row.vendor || row.sourceLabel || '—' }}</td><td class="p-4 font-black text-rose-600">{{ formatMoney(row.amount,row.currency) }}</td><td class="p-4 max-w-[260px]"><div class="truncate text-slate-500" :title="row.note">{{ row.note || '—' }}</div></td><td class="p-4"><span class="px-2 py-1 rounded-full text-[10px] font-extrabold" :class="row.autoGenerated?'bg-slate-100 text-slate-600':'bg-blue-50 text-blue-700'">{{ row.autoGenerated?'自动同步':'手工登记' }}</span></td><td class="p-4 text-right"><div class="flex justify-end gap-1"><button v-if="!row.autoGenerated" type="button" @click="openCostModal(row)" class="w-8 h-8 rounded-lg bg-blue-50 text-blue-600"><i class="fa-solid fa-pen"></i></button><button v-if="!row.autoGenerated" type="button" @click="deleteCost(row)" class="w-8 h-8 rounded-lg bg-rose-50 text-rose-500"><i class="fa-regular fa-trash-can"></i></button></div></td></tr></tbody></table></div><div v-else class="py-14 text-center text-xs text-slate-400">当前周期暂无成本记录。</div>
          </div>

          <div class="bg-white border border-slate-200 rounded-2xl soft-shadow overflow-hidden">
            <div class="p-4 border-b border-slate-100"><div class="font-extrabold text-sm">客户财务汇总</div><div class="text-[10px] text-slate-400 mt-1">按客户查看广告消耗、返点、收入、回款、成本与净利润；不同币种分别核算，不做隐式汇率折算。</div></div>
            <div v-if="financeClientSummaryRows.length" class="overflow-x-auto scrollbar"><table class="w-full min-w-[1520px] text-left text-xs"><thead class="bg-slate-50 text-slate-400"><tr><th class="p-4">客户</th><th class="p-4">广告消耗</th><th class="p-4">预计返点</th><th class="p-4">实际返点</th><th class="p-4">收入 / 已收</th><th class="p-4">成本</th><th class="p-4">净利润</th><th class="p-4">待回款</th></tr></thead><tbody class="divide-y divide-slate-100"><tr v-for="row in financeClientSummaryRows" :key="row.client.id" class="hover:bg-slate-50/70"><td class="p-4"><div class="font-extrabold">{{ row.client.name }}</div><div class="text-[10px] text-slate-400 mt-1">{{ row.client.project || row.client.product || '—' }}</div></td><td class="p-4 font-black text-amber-600">{{ row.spendText }}</td><td class="p-4 font-black text-violet-600">{{ row.expectedRebateText }}</td><td class="p-4 font-black text-sky-600">{{ row.actualRebateText }}</td><td class="p-4"><div class="font-black text-blue-600">{{ row.revenueText }}</div><div class="text-[10px] text-emerald-600 mt-1">已收 {{ row.receivedText }}</div></td><td class="p-4 font-black text-rose-600">{{ row.costText }}</td><td class="p-4 font-black text-slate-900">{{ row.netProfitText }}</td><td class="p-4 font-black text-amber-600">{{ row.outstandingText }}</td></tr></tbody></table></div><div v-else class="py-14 text-center text-xs text-slate-400">当前筛选下暂无客户财务数据。</div>
          </div>

          <div class="bg-white border border-slate-200 rounded-2xl soft-shadow overflow-hidden">
            <div class="p-4 border-b border-slate-100 flex flex-col xl:flex-row xl:items-center justify-between gap-3"><div><div class="font-extrabold text-sm">代理商返点对账</div><div class="text-[10px] text-slate-400 mt-1">预计返点由开户渠道和历史政策计算；实际返点必须在这里确认，净利润只读取已确认实际返点。已完成月结的月份会锁定对账与实际返点写入。</div></div></div>
            <div v-if="financeReconciliationRows.length" class="overflow-x-auto scrollbar"><table class="w-full min-w-[1360px] text-left text-xs"><thead class="bg-slate-50 text-slate-400"><tr><th class="p-4">渠道 / 对接人</th><th class="p-4">币种</th><th class="p-4">已归属消耗</th><th class="p-4">预计返点</th><th class="p-4">实际返点</th><th class="p-4">差异</th><th class="p-4">状态</th><th class="p-4">备注</th><th class="p-4 text-right">操作</th></tr></thead><tbody class="divide-y divide-slate-100"><tr v-for="row in financeReconciliationRows" :key="row.key" class="hover:bg-slate-50/70"><td class="p-4"><div class="font-extrabold">{{ row.providerName }}</div><div class="text-[10px] text-slate-400 mt-1">{{ row.contactName }}</div></td><td class="p-4 font-mono font-bold">{{ row.currency }}</td><td class="p-4 font-black text-amber-600">{{ formatMoney(row.spend,row.currency) }}</td><td class="p-4 font-black text-violet-600">{{ formatMoney(row.expectedAmount,row.currency) }}</td><td class="p-4 font-black text-sky-600">{{ formatMoney(row.actualAmount,row.currency) }}</td><td class="p-4 font-black" :class="Math.abs(Number(row.variance||0))<0.01?'text-emerald-600':'text-rose-600'">{{ formatMoney(row.variance,row.currency) }}</td><td class="p-4"><span class="px-2 py-1 rounded-full text-[10px] font-extrabold" :class="row.status==='CONFIRMED'?'bg-emerald-50 text-emerald-700':'bg-amber-50 text-amber-700'">{{ row.status==='CONFIRMED'?'已确认':'待对账' }}</span></td><td class="p-4 max-w-[260px]"><div class="truncate text-slate-500" :title="row.note">{{ row.note || '—' }}</div></td><td class="p-4 text-right"><button type="button" @click="openReconciliationModal(row)" class="h-8 px-2.5 rounded-lg bg-violet-50 text-violet-700 text-[10px] font-bold"><i class="fa-solid fa-scale-balanced mr-1"></i>对账</button></td></tr></tbody></table></div><div v-else class="py-14 text-center text-xs text-slate-400">当前月份暂无渠道返点数据。</div>
          </div>
        </section>

        <!-- Permissions / Backup -->
        <section v-else-if="currentPage==='permissions'" key="permissions" class="space-y-5">
          <div><h2 class="text-2xl font-extrabold tracking-tight">权限与备份</h2><p class="text-xs text-slate-500 mt-1">管理员可维护角色、用户、完整 JSON 备份与恢复；删除 / 恢复类操作会进入审计日志。</p></div>
          <div class="grid grid-cols-1 xl:grid-cols-3 gap-5">
            <div class="xl:col-span-2 bg-white border border-slate-200 rounded-2xl soft-shadow overflow-hidden">
              <div class="p-5 border-b border-slate-100 flex items-center justify-between"><div><h3 class="font-extrabold text-sm">角色与账号</h3><p class="text-[11px] text-slate-400 mt-1">ADMIN / FINANCE / OPS / SALES 四类角色权限</p></div><button @click="openUserModal()" class="h-9 px-3 rounded-xl bg-slate-950 text-white text-xs font-bold"><i class="fa-solid fa-user-plus mr-1.5"></i>添加用户</button></div>
              <div class="overflow-x-auto scrollbar"><table class="w-full min-w-[880px] text-xs"><thead class="bg-slate-50 text-slate-400"><tr><th class="p-3.5 text-left">用户</th><th class="p-3.5 text-left">账号</th><th class="p-3.5 text-left">角色</th><th class="p-3.5 text-left">可见范围</th><th class="p-3.5 text-left">状态</th><th class="p-3.5 text-left">操作</th></tr></thead><tbody class="divide-y divide-slate-100"><tr v-for="u in users" :key="u.id"><td class="p-3.5 font-extrabold">{{ u.name }}</td><td class="p-3.5 font-mono">{{ u.username }}</td><td class="p-3.5"><span class="px-2 py-1 rounded-full text-[10px] font-extrabold bg-indigo-50 text-indigo-700">{{ roleName(u.role) }}</span></td><td class="p-3.5 text-slate-500">{{ roleScopeText(u.role) }}</td><td class="p-3.5"><span class="text-[10px] font-bold" :class="u.enabled?'text-emerald-600':'text-rose-600'">{{ u.enabled?'启用':'停用' }}</span></td><td class="p-3.5"><div class="flex items-center gap-1"><button @click="openUserModal(u)" class="w-8 h-8 rounded-lg bg-indigo-50 text-indigo-600"><i class="fa-solid fa-pen"></i></button><button v-if="u.role!=='ADMIN'" type="button" @click="deleteUser(u)" class="w-8 h-8 rounded-lg bg-rose-50 text-rose-500"><i class="fa-regular fa-trash-can"></i></button></div></td></tr></tbody></table></div>
            </div>
            <div class="space-y-5">
              <div class="bg-white border border-slate-200 rounded-2xl p-5 soft-shadow"><h3 class="font-extrabold text-sm">完整数据备份</h3><p class="text-xs text-slate-500 leading-relaxed mt-3">导出所有客户、潜客、开户商渠道、合同续费、IP、SOP、广告方案 / 广告数据、账号资产、财务应收 / 成本 / 对账、独立提醒、用户、角色权限和审计记录。</p><div class="grid grid-cols-1 gap-2 mt-4"><button @click="downloadFullBackup" class="h-10 rounded-xl bg-emerald-600 text-white text-xs font-bold"><i class="fa-solid fa-download mr-1.5"></i>导出 JSON 备份</button><label class="h-10 rounded-xl border border-slate-200 flex items-center justify-center text-xs font-bold cursor-pointer hover:bg-slate-50"><i class="fa-solid fa-upload mr-1.5"></i>导入并恢复<input type="file" accept="application/json" class="hidden" @change="restoreBackup"></label><button @click="createLocalSnapshot" class="h-10 rounded-xl bg-slate-950 text-white text-xs font-bold"><i class="fa-solid fa-camera-retro mr-1.5"></i>创建本地快照</button></div></div>
              <div class="bg-amber-50 border border-amber-200 rounded-2xl p-5"><div class="font-extrabold text-xs text-amber-900"><i class="fa-solid fa-triangle-exclamation mr-1.5"></i>部署安全提示</div><p class="text-xs text-amber-800 leading-relaxed mt-3">当前页面用于功能演示，真实生产环境必须将登录、密码、2FA、Token、财务数据移至服务器与数据库，前端不应保存明文敏感信息。</p></div>
            </div>
          </div>

          <div class="bg-white border border-slate-200 rounded-2xl soft-shadow overflow-hidden">
            <div class="p-5 border-b border-slate-100"><h3 class="font-extrabold text-sm">备份快照</h3><p class="text-[11px] text-slate-400 mt-1">快照可一键恢复到某个历史状态</p></div>
            <div class="p-4 grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-3"><div v-for="snap in backupSnapshots" :key="snap.id" class="rounded-xl border border-slate-200 p-4"><div class="font-extrabold text-xs">{{ snap.label }}</div><div class="text-[10px] text-slate-400 mt-1">{{ snap.createdAt }}</div><button @click="restoreSnapshot(snap)" class="h-8 px-3 mt-3 rounded-lg bg-indigo-50 text-indigo-700 text-[11px] font-bold">恢复此快照</button></div><div v-if="!backupSnapshots.length" class="col-span-full py-8 text-center text-xs text-slate-400">还没有本地快照</div></div>
          </div>

          <div class="bg-white border border-slate-200 rounded-2xl soft-shadow overflow-hidden">
            <div class="p-5 border-b border-slate-100"><h3 class="font-extrabold text-sm">操作审计</h3><p class="text-[11px] text-slate-400 mt-1">记录备份、恢复、删除等敏感操作</p></div>
            <div class="overflow-x-auto scrollbar"><table class="w-full text-xs"><thead class="bg-slate-50 text-slate-400"><tr><th class="p-3.5 text-left">时间</th><th class="p-3.5 text-left">用户</th><th class="p-3.5 text-left">操作</th><th class="p-3.5 text-left">说明</th></tr></thead><tbody class="divide-y divide-slate-100"><tr v-for="log in auditLogs.slice(0,30)" :key="log.id"><td class="p-3.5 font-mono">{{ log.time }}</td><td class="p-3.5 font-bold">{{ log.user }}</td><td class="p-3.5"><span class="px-2 py-1 rounded-full bg-slate-100 text-slate-600 text-[10px] font-bold">{{ log.action }}</span></td><td class="p-3.5 text-slate-500">{{ log.detail }}</td></tr></tbody></table></div>
          </div>
        </section>
      </transition>
    </div>
  </main>

  <!-- Client Modal -->
  <div v-if="showClientModal" class="fixed inset-0 z-[100] modal-backdrop flex items-center justify-center p-3 sm:p-4" @click.self="closeClientModal">
    <div class="w-full max-w-5xl max-h-[92vh] bg-white rounded-3xl overflow-hidden flex flex-col soft-shadow">
      <div class="p-5 border-b border-slate-100 flex items-center justify-between"><div><h3 class="font-extrabold">{{ clientForm.id ? '编辑客户' : '新增客户' }}</h3><p class="text-[11px] text-slate-400 mt-1">填写客户资料、合同周期、费用、账号资产和网络环境</p></div><button @click="closeClientModal" class="w-9 h-9 rounded-xl hover:bg-slate-100"><i class="fa-solid fa-xmark"></i></button></div>
      <div class="p-5 overflow-y-auto scrollbar space-y-6">
        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-4"><form-field label="客户名称 *"><input v-model.trim="clientForm.name" class="field" /></form-field><form-field label="产品 / 品牌"><input v-model.trim="clientForm.product" class="field" /></form-field><form-field label="项目名称"><input v-model.trim="clientForm.project" class="field" /></form-field><form-field label="负责人"><input v-model.trim="clientForm.owner" class="field" placeholder="例如：Shane" /></form-field><form-field label="投放平台 *"><select v-model="clientForm.platform" class="field"><option value="FB">Facebook</option><option value="TK">TikTok</option><option value="FB+TK">Facebook + TikTok</option></select></form-field><form-field label="付款到期日（每月）"><input v-model.number="clientForm.renewalAlertDay" min="1" max="31" type="number" class="field" /></form-field><form-field label="月服务费"><div class="money-input-group"><select v-model="clientForm.currency" class="field money-currency"><option value="CNY">CNY</option><option value="USD">USD</option></select><input v-model.number="clientForm.monthlyFee" type="number" class="field money-amount" /></div></form-field><form-field label="计费模式"><select v-model="clientForm.billingMode" class="field"><option value="MONTHLY">按月</option><option value="QUARTERLY">按季</option><option value="YEARLY">按年</option><option value="MANUAL">手工 / 项目制</option></select></form-field><form-field label="合同开始"><input v-model="clientForm.startDate" type="date" class="field" /></form-field><form-field label="合同到期"><input v-model="clientForm.endDate" type="date" class="field" /></form-field><form-field label="状态"><select v-model="clientForm.status" class="field"><option value="ACTIVE">合作中</option><option value="PAUSED">暂停</option></select></form-field></div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-4"><div class="lg:col-span-2"><div class="text-xs font-extrabold text-slate-800 mb-3">平台账号资产</div><div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div v-if="clientForm.platform.includes('FB')" class="rounded-2xl border border-blue-100 bg-blue-50/30 p-4">
            <div class="flex items-center justify-between gap-3 flex-wrap"><div><div class="text-xs font-extrabold text-blue-900"><i class="fa-brands fa-facebook mr-1.5"></i>Facebook 账号</div><div class="text-[10px] text-slate-400 mt-1">可为同一客户添加多个 Facebook 广告账户</div></div><div class="flex items-center gap-2"><span class="text-[10px] font-bold bg-white text-blue-700 border border-blue-100 px-2 py-1 rounded-full">{{ clientForm.fbAccounts.length }} 个账号</span><button type="button" @click="addClientAccount('FB')" class="h-8 px-3 rounded-lg bg-blue-600 hover:bg-blue-500 text-white text-[10px] font-bold"><i class="fa-solid fa-plus mr-1"></i>添加账号</button></div></div>
            <div v-if="clientForm.fbAccounts.length" class="mt-4 space-y-3">
              <div v-for="(account,idx) in clientForm.fbAccounts" :key="account.id" class="rounded-xl border border-blue-100 bg-white p-3.5">
                <div class="flex items-center justify-between"><div class="text-[10px] font-extrabold text-blue-700">Facebook 账号 {{ idx+1 }}</div><button v-if="clientForm.fbAccounts.length>1" type="button" @click="removeClientAccount('FB',account)" class="w-7 h-7 rounded-lg bg-rose-50 text-rose-500"><i class="fa-regular fa-trash-can"></i></button></div>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mt-3"><form-field label="账号名称"><input v-model.trim="account.accountName" class="field" placeholder="例如：FB-US-Lead-01" /></form-field><form-field label="BM ID"><input v-model.trim="account.bmId" class="field" /></form-field><form-field label="广告账号 ID"><input v-model.trim="account.adAccountId" class="field" /></form-field><form-field label="账号用途"><input v-model.trim="account.purpose" class="field" placeholder="例如：美国潜客投放" /></form-field><form-field label="登录账号"><input v-model.trim="account.loginAccount" class="field" /></form-field><form-field label="&#23494;&#30721; / 2FA"><input v-model.trim="account['login'+'Password']" class="field" /></form-field></div>
              </div>
            </div>
          </div>
          <div v-if="clientForm.platform.includes('TK')" class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
            <div class="flex items-center justify-between gap-3 flex-wrap"><div><div class="text-xs font-extrabold"><i class="fa-brands fa-tiktok mr-1.5"></i>TikTok 账号</div><div class="text-[10px] text-slate-400 mt-1">可为同一客户添加多个 TikTok 广告账户</div></div><div class="flex items-center gap-2"><span class="text-[10px] font-bold bg-white text-slate-700 border border-slate-200 px-2 py-1 rounded-full">{{ clientForm.tkAccounts.length }} 个账号</span><button type="button" @click="addClientAccount('TK')" class="h-8 px-3 rounded-lg bg-slate-950 hover:bg-slate-800 text-white text-[10px] font-bold"><i class="fa-solid fa-plus mr-1"></i>添加账号</button></div></div>
            <div v-if="clientForm.tkAccounts.length" class="mt-4 space-y-3">
              <div v-for="(account,idx) in clientForm.tkAccounts" :key="account.id" class="rounded-xl border border-slate-200 bg-white p-3.5">
                <div class="flex items-center justify-between"><div class="text-[10px] font-extrabold text-slate-700">TikTok 账号 {{ idx+1 }}</div><button v-if="clientForm.tkAccounts.length>1" type="button" @click="removeClientAccount('TK',account)" class="w-7 h-7 rounded-lg bg-rose-50 text-rose-500"><i class="fa-regular fa-trash-can"></i></button></div>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mt-3"><form-field label="账号名称"><input v-model.trim="account.accountName" class="field" placeholder="例如：TK-US-Lead-01" /></form-field><form-field label="BC ID"><input v-model.trim="account.bcId" class="field" /></form-field><form-field label="广告账号 ID"><input v-model.trim="account.adAccountId" class="field" /></form-field><form-field label="账号用途"><input v-model.trim="account.purpose" class="field" placeholder="例如：美国线索投放" /></form-field><form-field label="登录账号"><input v-model.trim="account.loginAccount" class="field" /></form-field><form-field label="&#23494;&#30721; / 2FA"><input v-model.trim="account['login'+'Password']" class="field" /></form-field></div>
              </div>
            </div>
          </div>
        </div></div>
        <div><div class="text-xs font-extrabold text-slate-800 mb-3">网络与安全</div><div class="rounded-2xl border border-emerald-100 bg-emerald-50/30 p-4">
          <div class="flex items-center justify-between gap-3 flex-wrap"><div><div class="text-xs font-extrabold text-emerald-900"><i class="fa-solid fa-network-wired mr-1.5"></i>网络环境</div><div class="text-[10px] text-slate-400 mt-1">支持为同一客户维护多个代理 / IP / 指纹环境</div></div><div class="flex items-center gap-2"><span class="text-[10px] font-bold bg-white text-emerald-700 border border-emerald-100 px-2 py-1 rounded-full">{{ clientForm.networkEnvironments.length }} 个环境</span><button type="button" @click="addNetworkEnvironment" class="h-8 px-3 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white text-[10px] font-bold"><i class="fa-solid fa-plus mr-1"></i>添加环境</button></div></div>
          <div v-if="clientForm.networkEnvironments.length" class="mt-4 space-y-3"><div v-for="(env,idx) in clientForm.networkEnvironments" :key="env.id" class="rounded-xl border border-emerald-100 bg-white p-3.5"><div class="flex items-center justify-between"><div class="text-[10px] font-extrabold text-emerald-700">网络环境 {{ idx+1 }}</div><button v-if="clientForm.networkEnvironments.length>1" type="button" @click="removeNetworkEnvironment(env)" class="w-7 h-7 rounded-lg bg-rose-50 text-rose-500"><i class="fa-regular fa-trash-can"></i></button></div><div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mt-3"><form-field label="网络环境"><input v-model.trim="env.networkName" class="field" placeholder="例如：US-LA 固定住宅 IP" /></form-field><form-field label="指纹 Profile"><input v-model.trim="env.ipEnvironment" class="field" placeholder="例如：AdsPower-US-01" /></form-field><form-field label="IP 到期日"><input v-model="env.ipDueDate" type="date" class="field" /></form-field><form-field label="IP 月费"><div class="money-input-group"><select v-model="env.ipCurrency" class="field money-currency"><option value="CNY">CNY</option><option value="USD">USD</option></select><input v-model.number="env.ipMonthlyFee" type="number" min="0" step="0.01" class="field money-amount" placeholder="月费" /></div></form-field></div></div></div>
          <div v-else class="mt-4 rounded-xl border border-dashed border-emerald-200 py-6 text-center text-[11px] text-slate-400">暂无网络环境，点击「添加环境」维护 IP / 指纹资料</div>
          <div class="mt-4"><div class="text-[11px] font-semibold text-slate-500 mb-1.5">风险规则</div><textarea v-model.trim="clientForm.riskRules" rows="4" class="w-full rounded-xl border border-slate-200 p-3 text-xs outline-none focus:ring-2 focus:ring-emerald-100"></textarea></div>
        </div></div></div>
      </div>
      <div class="p-5 border-t border-slate-100 bg-slate-50 flex justify-end gap-2"><button @click="closeClientModal" class="h-10 px-4 rounded-xl border border-slate-200 bg-white text-xs font-bold">取消</button><button @click="saveClient" class="h-10 px-5 rounded-xl bg-indigo-600 text-white text-xs font-bold">保存客户</button></div>
    </div>
  </div>

  <!-- Renewal Modal -->
  <div v-if="showRenewalModal && renewalTarget" class="fixed inset-0 z-[120] modal-backdrop flex items-center justify-center p-4" @click.self="showRenewalModal=false">
    <div class="w-full max-w-lg bg-white rounded-3xl soft-shadow p-6"><div class="flex items-center justify-between"><h3 class="font-extrabold">完成续费 · {{ renewalTarget.clientName }}</h3><button @click="showRenewalModal=false"><i class="fa-solid fa-xmark"></i></button></div><div class="mt-5 space-y-4"><form-field label="新的到期日"><input v-model="renewalForm.newEndDate" type="date" class="field" /></form-field><form-field label="续费说明"><input v-model.trim="renewalForm.note" class="field" /></form-field><button @click="completeRenewal" class="w-full h-10 rounded-xl bg-emerald-600 text-white text-xs font-bold">确认并更新客户资料</button></div></div>
  </div>

  <!-- Manual Alert Modal -->
  <div v-if="showAddAlertModal" class="fixed inset-0 z-[120] modal-backdrop flex items-center justify-center p-4" @click.self="showAddAlertModal=false"><div class="w-full max-w-lg bg-white rounded-3xl soft-shadow p-6"><div class="flex items-center justify-between"><h3 class="font-extrabold">添加独立提醒</h3><button @click="showAddAlertModal=false"><i class="fa-solid fa-xmark"></i></button></div><div class="mt-5 grid grid-cols-1 sm:grid-cols-2 gap-3"><form-field label="提醒对象"><input v-model.trim="alertForm.clientName" class="field" /></form-field><form-field label="提醒类型"><select v-model="alertForm.type" class="field"><option>合同续费</option><option>IP/代理续费</option><option>广告费充值</option><option>任务提醒</option></select></form-field><form-field label="到期日期"><input v-model="alertForm.dueDate" type="date" class="field" /></form-field><form-field label="费用"><input v-model.trim="alertForm.cost" class="field" placeholder="例如：$300/月" /></form-field><div class="sm:col-span-2"><form-field label="目标 / 备注"><input v-model.trim="alertForm.target" class="field" /></form-field></div></div><button @click="saveStandaloneAlert" class="w-full h-10 rounded-xl bg-slate-950 text-white text-xs font-bold mt-5">保存提醒</button></div></div>

  <!-- Ad Recharge Modal -->
  <div v-if="showRechargeModal && rechargeTarget.account" class="fixed inset-0 z-[130] modal-backdrop flex items-center justify-center p-4" @click.self="closeRechargeModal">
    <div class="w-full max-w-lg bg-white rounded-3xl soft-shadow p-6"><div class="flex items-center justify-between"><div><h3 class="font-extrabold">登记广告费充值</h3><div class="text-[11px] text-slate-400 mt-1">{{ rechargeTarget.clientName }} · {{ rechargeTarget.platform==='FB'?'Facebook':'TikTok' }} · {{ rechargeTarget.account.accountName || rechargeTarget.account.adAccountId }}</div></div><button @click="closeRechargeModal"><i class="fa-solid fa-xmark"></i></button></div><div class="mt-5 grid grid-cols-1 sm:grid-cols-2 gap-3"><form-field label="充值日期"><input v-model="rechargeForm.date" type="date" class="field" /></form-field><form-field label="充值金额"><div class="money-input-group"><select v-model="rechargeForm.currency" class="field money-currency"><option value="USD">USD</option><option value="CNY">CNY</option></select><input v-model.number="rechargeForm.amount" type="number" min="0" step="0.01" class="field money-amount" /></div></form-field><div class="sm:col-span-2"><form-field label="备注"><input v-model.trim="rechargeForm.note" class="field" placeholder="例如：客户补充广告预算" /></form-field></div></div><button @click="saveRecharge" class="w-full h-10 rounded-xl bg-emerald-600 text-white text-xs font-bold mt-5"><i class="fa-solid fa-coins mr-1.5"></i>保存充值记录</button></div>
  </div>

  <!-- Ad Data Modal -->
  <div v-if="showAdDataModal && selectedAdsAccount" class="fixed inset-0 z-[135] modal-backdrop flex items-center justify-center p-4" @click.self="closeAdDataModal">
    <div class="w-full max-w-4xl max-h-[92vh] bg-white rounded-3xl soft-shadow flex flex-col overflow-hidden"><div class="p-5 border-b border-slate-100 flex items-start justify-between gap-3"><div><h3 class="font-extrabold">{{ adDataForm.id ? '更新广告数据' : '录入广告数据' }}</h3><div class="text-[11px] text-slate-400 mt-1">{{ selectedAdsClient.name }} · {{ selectedAdsPlatform==='FB'?'Facebook':'TikTok' }} · {{ selectedAdsAccount.accountName || selectedAdsAccount.adAccountId }}</div><div class="text-[10px] text-emerald-600 mt-1"><i class="fa-solid fa-arrows-rotate mr-1"></i>保存后会自动同步到账户消耗、广告管理列表、投放数据分析和充值余额提醒。</div></div><button @click="closeAdDataModal" class="w-9 h-9 rounded-xl hover:bg-slate-100"><i class="fa-solid fa-xmark"></i></button></div>
      <div class="p-5 overflow-y-auto scrollbar"><div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-3">
        <form-field label="日期"><input v-model="adDataForm.date" type="date" class="field" /></form-field>
        <form-field label="广告方案"><select v-model="adDataForm.campaignId" @change="syncAdDataHierarchy('campaign')" class="field"><option value="">请选择已保存方案</option><option v-for="campaign in savedAdsCampaignsForAccount" :key="campaign.id" :value="campaign.id">{{ campaign.planName || campaign.name || '未命名方案' }}</option></select></form-field>
        <form-field label="广告组"><select v-model="adDataForm.adSetId" @change="syncAdDataHierarchy('adset')" class="field"><option value="">全部广告组 / 未指定</option><option v-for="adset in adDataAdSets" :key="adset.id" :value="adset.id">{{ adset.name || '未命名广告组' }}</option></select></form-field>
        <form-field label="广告 Ad"><select v-model="adDataForm.adId" class="field"><option value="">全部广告 / 未指定</option><option v-for="ad in adDataAds" :key="ad.id" :value="ad.id">{{ ad.name || '未命名广告' }}</option></select></form-field>
        <form-field label="消耗"><div class="money-input-group"><select v-model="adDataForm.currency" class="field money-currency"><option value="USD">USD</option><option value="CNY">CNY</option></select><input v-model.number="adDataForm.spend" type="number" min="0" step="0.01" class="field money-amount" /></div></form-field>
        <form-field label="收入"><div class="money-input-group"><select v-model="adDataForm.currency" class="field money-currency"><option value="USD">USD</option><option value="CNY">CNY</option></select><input v-model.number="adDataForm.revenue" type="number" min="0" step="0.01" class="field money-amount" /></div></form-field>
        <form-field label="曝光 Impressions"><input v-model.number="adDataForm.impressions" type="number" min="0" class="field" /></form-field>
        <form-field label="覆盖人数 Reach"><input v-model.number="adDataForm.reach" type="number" min="0" class="field" /></form-field>
        <form-field label="频次 Frequency"><input v-model.number="adDataForm.frequency" type="number" min="0" step="0.01" class="field" /></form-field>
        <form-field label="CPM"><input v-model.number="adDataForm.cpm" type="number" min="0" step="0.0001" class="field" /></form-field>
        <form-field label="点击 Clicks"><input v-model.number="adDataForm.clicks" type="number" min="0" class="field" /></form-field>
        <form-field label="CTR %"><input v-model.number="adDataForm.ctr" type="number" min="0" step="0.0001" class="field" /></form-field>
        <form-field label="CPC"><input v-model.number="adDataForm.cpc" type="number" min="0" step="0.0001" class="field" /></form-field>
        <form-field label="潜在客户 Leads"><input v-model.number="adDataForm.leads" type="number" min="0" class="field" /></form-field>
        <form-field label="转化 Conversions"><input v-model.number="adDataForm.conversions" type="number" min="0" class="field" /></form-field>
        <form-field label="CVR %"><input v-model.number="adDataForm.cvr" type="number" min="0" step="0.0001" class="field" /></form-field>
        <form-field label="CPA"><input v-model.number="adDataForm.cpa" type="number" min="0" step="0.0001" class="field" /></form-field>
        <form-field label="ROAS"><input v-model.number="adDataForm.roas" type="number" min="0" step="0.0001" class="field" /></form-field>
        <template v-if="selectedAdsPlatform==='FB'">
          <div class="xl:col-span-3 mt-1"><div class="rounded-xl bg-blue-50 border border-blue-100 px-3 py-2 text-[10px] font-extrabold text-blue-700"><i class="fa-brands fa-facebook mr-1.5"></i>Facebook 视频指标</div></div>
          <form-field label="视频 3秒播放率 %"><input v-model.number="adDataForm.video3sRate" type="number" min="0" max="100" step="0.0001" class="field" /></form-field>
          <form-field label="视频 25% 播放率 %"><input v-model.number="adDataForm.video25Rate" type="number" min="0" max="100" step="0.0001" class="field" /></form-field>
          <form-field label="视频 50% 播放率 %"><input v-model.number="adDataForm.video50Rate" type="number" min="0" max="100" step="0.0001" class="field" /></form-field>
          <form-field label="视频 75% 播放率 %"><input v-model.number="adDataForm.video75Rate" type="number" min="0" max="100" step="0.0001" class="field" /></form-field>
          <form-field label="视频 95% 播放率 %"><input v-model.number="adDataForm.video95Rate" type="number" min="0" max="100" step="0.0001" class="field" /></form-field>
          <form-field label="视频完播率 %"><input v-model.number="adDataForm.videoCompleteRate" type="number" min="0" max="100" step="0.0001" class="field" /></form-field>
        </template>
        <div class="sm:col-span-2 xl:col-span-3"><form-field label="备注"><input v-model.trim="adDataForm.note" class="field" placeholder="例如：新素材上线后 CTR 提升" /></form-field></div>
      </div>
      <div class="rounded-xl border border-cyan-100 bg-cyan-50/40 p-4 mt-4"><div class="text-[10px] font-extrabold text-cyan-700 mb-2">实时计算预览</div><div class="grid grid-cols-2 sm:grid-cols-4 xl:grid-cols-8 gap-2"><div v-for="m in adDataFormMetricPreview" :key="m.label" class="rounded-lg bg-white border border-cyan-100 px-2.5 py-2"><div class="text-[9px] text-slate-400">{{ m.label }}</div><div class="text-[11px] font-black mt-1">{{ m.value }}</div></div></div></div>
      </div></div>
      <div class="p-5 border-t border-slate-100 bg-slate-50 flex justify-end gap-2"><button @click="closeAdDataModal" class="h-10 px-4 rounded-xl bg-white border border-slate-200 text-xs font-bold">取消</button><button @click="saveAdDataRecord" class="h-10 px-5 rounded-xl bg-cyan-600 text-white text-xs font-bold"><i class="fa-solid fa-floppy-disk mr-1.5"></i>{{ adDataForm.id ? '更新并同步' : '保存并同步' }}</button></div>
    </div>
  </div>

  <!-- Ads Plan Detail -->
  <div v-if="showAdsPlanDetail && adsPlanDetail" class="fixed inset-0 z-[140] modal-backdrop flex items-center justify-center p-4" @click.self="closeAdsPlanDetail">
    <div class="w-full max-w-4xl max-h-[92vh] bg-white rounded-3xl soft-shadow flex flex-col overflow-hidden">
      <div class="p-5 border-b border-slate-100 flex items-start justify-between gap-3"><div><div class="text-[10px] font-bold text-indigo-500">AD PLAN DETAIL</div><h3 class="font-extrabold text-lg mt-1">{{ adsPlanDetail.planName || adsPlanDetail.name }}</h3><div class="text-[11px] text-slate-400 mt-1">{{ adsPlanDetail.name }} · {{ objectiveLabel(adsPlanDetail.objective) }}</div></div><button @click="closeAdsPlanDetail" class="w-9 h-9 rounded-xl hover:bg-slate-100"><i class="fa-solid fa-xmark"></i></button></div>
      <div class="p-5 overflow-y-auto scrollbar space-y-5">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-3"><div class="rounded-xl bg-indigo-50 p-3"><div class="text-[10px] text-indigo-500">方案预算</div><div class="font-extrabold text-violet-700 mt-1">{{ campaignBudgetText(adsPlanDetail) }}</div></div><div class="rounded-xl bg-amber-50 p-3"><div class="text-[10px] text-amber-600">数据消耗</div><div class="font-extrabold text-amber-700 mt-1">{{ campaignDataSpendText(adsPlanDetail) }}</div></div><div class="rounded-xl bg-cyan-50 p-3"><div class="text-[10px] text-cyan-600">数据记录</div><div class="font-extrabold text-cyan-700 mt-1">{{ campaignDataRecordCount(adsPlanDetail) }} 条</div></div><div class="rounded-xl bg-slate-100 p-3"><div class="text-[10px] text-slate-500">广告结构</div><div class="font-extrabold mt-1">{{ (adsPlanDetail.adSets||[]).length }} 组 / {{ campaignAdCount(adsPlanDetail) }} 广告</div></div></div>
        <div class="rounded-xl border border-slate-200 p-4"><div class="text-[10px] font-extrabold text-slate-400">广告设置方案 / 测试思路</div><div class="text-xs leading-relaxed text-slate-700 mt-2 whitespace-pre-wrap">{{ adsPlanDetail.planNotes || '暂无方案备注' }}</div></div>
        <div class="space-y-3"><div v-for="(adset,idx) in adsPlanDetail.adSets || []" :key="adset.id" class="rounded-2xl border border-slate-200 p-4"><div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2"><div><div class="text-[10px] font-bold text-violet-500">AD SET {{ idx+1 }}</div><div class="font-extrabold text-sm mt-1">{{ adset.name || `广告组 ${idx+1}` }}</div></div><div class="text-[10px] font-bold text-amber-700 bg-amber-50 px-2 py-1 rounded-full">数据消耗 {{ adSetDataSpendText(adsPlanDetail,adset) }}</div></div><div class="grid grid-cols-2 md:grid-cols-4 gap-2 mt-3 text-[11px]"><div><span class="text-slate-400">投放方式</span><div class="font-bold mt-1">{{ adset.deliveryMethod==='AUTO'?'自动投放':'手动定向' }}</div></div><div><span class="text-slate-400">国家 / 地区</span><div class="font-bold mt-1">{{ adset.country || '—' }}</div></div><div><span class="text-slate-400">年龄 / 性别</span><div class="font-bold mt-1">{{ adset.ageMin }}-{{ adset.ageMax }} · {{ genderLabel(adset.gender) }}</div></div><div><span class="text-slate-400">预算</span><div class="font-bold mt-1">{{ formatMoney(adset.budget,adset.budgetCurrency) }}</div></div><div class="md:col-span-4"><span class="text-slate-400">兴趣受众</span><div class="font-bold mt-1">{{ adset.interests || '—' }}</div></div></div><div v-if="adset.ads && adset.ads.length" class="grid grid-cols-1 md:grid-cols-2 gap-2 mt-3"><div v-for="(ad,aidx) in adset.ads" :key="ad.id" class="rounded-xl bg-cyan-50/40 border border-cyan-100 p-3"><div class="text-[10px] font-bold text-cyan-600">AD {{ aidx+1 }} · {{ ad.format==='VIDEO'?'视频':'照片' }}</div><div class="font-extrabold text-xs mt-1">{{ ad.name || `广告 ${aidx+1}` }}</div><div class="text-[10px] text-slate-500 mt-2 line-clamp-2">{{ ad.primaryText || '暂无广告文案' }}</div><div class="text-[10px] text-slate-400 mt-2">{{ ad.headline || '无标题' }} · {{ ctaLabel(ad.callToAction) }}</div></div></div></div></div>
      </div>
      <div class="p-5 border-t border-slate-100 bg-slate-50 flex justify-end gap-2"><button @click="closeAdsPlanDetail" class="h-10 px-4 rounded-xl bg-white border border-slate-200 text-xs font-bold">关闭</button><button @click="editAdCampaign(adsPlanDetail); closeAdsPlanDetail()" class="h-10 px-4 rounded-xl bg-indigo-600 text-white text-xs font-bold"><i class="fa-solid fa-pen mr-1.5"></i>编辑方案</button></div>
    </div>
  </div>

  <!-- SOP Task Modal -->
  <div v-if="showSopTaskModal && selectedSopClient && selectedSopAccount" class="fixed inset-0 z-[145] modal-backdrop flex items-center justify-center p-4" @click.self="closeSopTaskModal">
    <div class="w-full max-w-lg bg-white rounded-3xl soft-shadow overflow-hidden">
      <div class="p-5 border-b border-slate-100 flex items-start justify-between gap-3"><div><div class="text-[10px] font-bold text-indigo-500">SOP TASK</div><h3 class="font-extrabold mt-1">{{ sopTaskForm.id ? '修改任务' : '添加任务' }}</h3><div class="text-[10px] text-slate-400 mt-1">{{ selectedSopClient.name }} · {{ selectedSopAccount.platformName }} · {{ selectedSopAccount.account.accountName || selectedSopAccount.account.adAccountId }}</div></div><button @click="closeSopTaskModal" class="w-9 h-9 rounded-xl hover:bg-slate-100"><i class="fa-solid fa-xmark"></i></button></div>
      <div class="p-5 space-y-4"><form-field label="任务内容 *"><input v-model.trim="sopTaskForm.text" class="field" placeholder="例如：检查广告账户审核与余额" /></form-field><form-field label="计划"><input v-model.trim="sopTaskForm.plan" class="field" placeholder="例如：每天 09:00 前完成" /></form-field><form-field label="备注"><textarea v-model.trim="sopTaskForm.note" rows="4" class="w-full rounded-xl border border-slate-200 p-3 text-xs focus:outline-none focus:ring-2 focus:ring-indigo-100" placeholder="可选：记录操作要求、注意事项或结果标准"></textarea></form-field></div>
      <div class="p-5 border-t border-slate-100 bg-slate-50 flex justify-end gap-2"><button @click="closeSopTaskModal" class="h-10 px-4 rounded-xl bg-white border border-slate-200 text-xs font-bold">取消</button><button @click="saveSopTask" class="h-10 px-5 rounded-xl bg-indigo-600 text-white text-xs font-extrabold"><i class="fa-solid fa-floppy-disk mr-1.5"></i>{{ sopTaskForm.id ? '保存修改' : '添加任务' }}</button></div>
    </div>
  </div>

  <!-- Lead Modal -->
  <div v-if="showLeadModal" class="fixed inset-0 z-[125] modal-backdrop flex items-center justify-center p-4" @click.self="showLeadModal=false"><div class="w-full max-w-2xl max-h-[90vh] bg-white rounded-3xl soft-shadow overflow-hidden flex flex-col"><div class="p-5 border-b border-slate-100 flex items-center justify-between"><div><h3 class="font-extrabold">{{ leadForm.id ? '编辑潜在客户' : '新增潜在客户' }}</h3><p class="text-[11px] text-slate-400 mt-1">记录来源、预估预算、投放合作报价、跟进日期和销售阶段</p></div><button @click="showLeadModal=false"><i class="fa-solid fa-xmark"></i></button></div><div class="p-5 overflow-y-auto grid grid-cols-1 sm:grid-cols-2 gap-3"><form-field label="公司 / 客户名称 *"><input v-model.trim="leadForm.company" class="field" /></form-field><form-field label="联系人"><input v-model.trim="leadForm.contact" class="field" /></form-field><form-field label="联系方式"><input v-model.trim="leadForm.contactInfo" class="field" placeholder="微信 / 电话 / 邮箱" /></form-field><form-field label="来源"><input v-model.trim="leadForm.source" class="field" placeholder="例如：转介绍 / 官网 / 广告线索" /></form-field><form-field label="意向平台"><select v-model="leadForm.platformInterest" class="field"><option value="FB">Facebook</option><option value="TK">TikTok</option><option value="FB+TK">Facebook + TikTok</option></select></form-field><form-field label="预计月预算"><div class="money-input-group"><select v-model="leadForm.budgetCurrency" class="field money-currency"><option value="USD">USD</option><option value="CNY">CNY</option></select><input v-model.number="leadForm.expectedBudget" type="number" min="0" step="0.01" class="field money-amount" placeholder="预计预算" /></div></form-field><form-field label="投放报价"><div class="money-input-group"><select v-model="leadForm.quoteCurrency" class="field money-currency"><option value="USD">USD</option><option value="CNY">CNY</option></select><input v-model.number="leadForm.adQuote" type="number" min="0" step="0.01" class="field money-amount" placeholder="合作报价" /></div></form-field><form-field label="销售阶段"><select v-model="leadForm.stage" class="field"><option value="NEW">新线索</option><option value="CONTACTED">已联系</option><option value="QUALIFIED">已确认需求</option><option value="PROPOSAL">已报价 / 方案中</option><option value="WON">已成交</option><option value="LOST">已流失</option></select></form-field><form-field label="下次跟进日期"><input v-model="leadForm.nextFollowUp" type="date" class="field" /></form-field><form-field label="负责人"><input v-model.trim="leadForm.owner" class="field" /></form-field><div class="sm:col-span-2"><form-field label="跟进备注"><textarea v-model.trim="leadForm.notes" rows="4" class="w-full rounded-xl border border-slate-200 p-3 text-xs"></textarea></form-field></div></div><div class="p-5 border-t border-slate-100 bg-slate-50 flex justify-end gap-2"><button @click="showLeadModal=false" class="h-10 px-4 rounded-xl border border-slate-200 bg-white text-xs font-bold">取消</button><button @click="saveLead" class="h-10 px-5 rounded-xl bg-violet-600 text-white text-xs font-bold">保存潜客</button></div></div></div>

  <!-- Lead Convert Modal -->
  <div v-if="showLeadConvertModal && leadConvertSource" class="fixed inset-0 z-[128] modal-backdrop flex items-center justify-center p-4" @click.self="showLeadConvertModal=false"><div class="w-full max-w-4xl max-h-[92vh] bg-white rounded-3xl soft-shadow overflow-hidden flex flex-col"><div class="p-5 border-b border-slate-100 flex items-center justify-between"><div><h3 class="font-extrabold">确认合作并创建正式客户</h3><p class="text-[11px] text-slate-400 mt-1">{{ leadConvertSource.company }} · 补全必要资料后，线索会从潜客池移入成交历史。</p></div><button @click="showLeadConvertModal=false"><i class="fa-solid fa-xmark"></i></button></div><div class="p-5 overflow-y-auto scrollbar space-y-5"><div class="rounded-2xl bg-emerald-50 border border-emerald-100 p-4"><div class="text-xs font-extrabold text-emerald-800"><i class="fa-solid fa-circle-check mr-1.5"></i>合作确认</div><div class="text-[11px] text-emerald-700 mt-2">潜客信息已预填。请确认产品 / 项目、负责人、月服务费、计费模式、合同开始与到期日；保存后才会进入正式客户管理。</div></div><div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-4"><form-field label="客户名称 *"><input v-model.trim="leadConvertForm.name" class="field" /></form-field><form-field label="产品 / 品牌 *"><input v-model.trim="leadConvertForm.product" class="field" /></form-field><form-field label="项目名称 *"><input v-model.trim="leadConvertForm.project" class="field" /></form-field><form-field label="负责人 *"><input v-model.trim="leadConvertForm.owner" class="field" placeholder="例如：Shane" /></form-field><form-field label="投放平台 *"><select v-model="leadConvertForm.platform" class="field"><option value="FB">Facebook</option><option value="TK">TikTok</option><option value="FB+TK">Facebook + TikTok</option></select></form-field><form-field label="月服务费 *"><div class="money-input-group"><select v-model="leadConvertForm.currency" class="field money-currency"><option value="CNY">CNY</option><option value="USD">USD</option></select><input v-model.number="leadConvertForm.monthlyFee" type="number" min="0" step="0.01" class="field money-amount" /></div></form-field><form-field label="计费模式 *"><select v-model="leadConvertForm.billingMode" class="field"><option value="MONTHLY">按月</option><option value="QUARTERLY">按季</option><option value="YEARLY">按年</option><option value="MANUAL">手工 / 项目制</option></select></form-field><form-field label="付款到期日（每月）"><input v-model.number="leadConvertForm.renewalAlertDay" min="1" max="31" type="number" class="field" /></form-field><form-field label="合同开始 *"><input v-model="leadConvertForm.startDate" type="date" class="field" /></form-field><form-field label="合同到期 *"><input v-model="leadConvertForm.endDate" type="date" class="field" /></form-field><form-field label="合作状态"><select v-model="leadConvertForm.status" class="field"><option value="ACTIVE">合作中</option><option value="PAUSED">暂停</option></select></form-field></div><div><div class="text-[11px] font-semibold text-slate-500 mb-1.5">风险规则 / 交接备注</div><textarea v-model.trim="leadConvertForm.riskRules" rows="4" class="w-full rounded-xl border border-slate-200 p-3 text-xs outline-none focus:ring-2 focus:ring-emerald-100" placeholder="可记录客户要求、账户操作禁忌、销售交接事项等"></textarea></div></div><div class="p-5 border-t border-slate-100 bg-slate-50 flex justify-end gap-2"><button @click="showLeadConvertModal=false" class="h-10 px-4 rounded-xl border border-slate-200 bg-white text-xs font-bold">取消</button><button @click="saveLeadConversion" class="h-10 px-5 rounded-xl bg-emerald-600 text-white text-xs font-bold"><i class="fa-solid fa-user-check mr-1.5"></i>确认合作并创建客户</button></div></div></div>

  <!-- Opening Provider Modal -->
  <div v-if="showProviderModal" class="fixed inset-0 z-[126] modal-backdrop flex items-center justify-center p-4" @click.self="showProviderModal=false"><div class="w-full max-w-4xl max-h-[92vh] bg-white rounded-3xl soft-shadow overflow-hidden flex flex-col"><div class="p-5 border-b border-slate-100 flex items-center justify-between"><div><h3 class="font-extrabold">{{ providerForm.id ? '编辑开户商' : '添加开户商' }}</h3><p class="text-[11px] text-slate-400 mt-1">每个开户商可维护多个对接人，并为不同对接人设置独立返点政策和历史生效时间。</p></div><button @click="showProviderModal=false"><i class="fa-solid fa-xmark"></i></button></div><div class="p-5 overflow-y-auto scrollbar space-y-5"><div class="grid grid-cols-1 sm:grid-cols-2 gap-3"><form-field label="开户商名称 *"><input v-model.trim="providerForm.name" class="field" /></form-field><form-field label="主要平台"><select v-model="providerForm.platforms" class="field"><option value="FB">Facebook</option><option value="TK">TikTok</option><option value="FB+TK">Facebook + TikTok</option></select></form-field><form-field label="支持地区"><input v-model.trim="providerForm.region" class="field" placeholder="例如：北美 / 东南亚 / 全球" /></form-field><form-field label="主体 / 公司"><input v-model.trim="providerForm.company" class="field" /></form-field><div class="sm:col-span-2"><form-field label="开户政策 / 注意事项"><textarea v-model.trim="providerForm.policy" rows="3" class="w-full rounded-xl border border-slate-200 p-3 text-xs" placeholder="记录开户门槛、充值要求、返点结算、风控限制等"></textarea></form-field></div></div><div class="rounded-2xl border border-violet-100 bg-violet-50/30 p-4"><div class="flex items-center justify-between gap-3"><div><div class="text-xs font-extrabold text-violet-900">对接人 & 独立返点</div><div class="text-[10px] text-slate-400 mt-1">支持同一开户商多个对接人，每位对接人可维护多条历史返点政策；客户开户时必须明确选择对接人。</div></div><button type="button" @click="addProviderContactForm" class="h-8 px-3 rounded-lg bg-violet-600 text-white text-[10px] font-bold"><i class="fa-solid fa-user-plus mr-1"></i>添加对接人</button></div><div class="space-y-3 mt-4"><div v-for="(contact,idx) in providerForm.contacts" :key="contact.id" class="rounded-xl bg-white border border-violet-100 p-3.5"><div class="flex items-center justify-between gap-2"><div class="text-[10px] font-extrabold text-violet-700">对接人 {{ idx+1 }}</div><button v-if="providerForm.contacts.length>1" type="button" @click="removeProviderContactForm(contact)" class="w-7 h-7 rounded-lg bg-rose-50 text-rose-500"><i class="fa-regular fa-trash-can"></i></button></div><div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mt-3"><form-field label="姓名 *"><input v-model.trim="contact.name" class="field" placeholder="例如：Alice" /></form-field><form-field label="联系方式"><input v-model.trim="contact.contact" class="field" placeholder="微信 / 电话 / 邮箱" /></form-field><form-field label="职位 / 备注"><input v-model.trim="contact.title" class="field" placeholder="例如：北美渠道经理" /></form-field></div><div class="mt-4 rounded-xl border border-violet-100 bg-violet-50/20 p-3"><div class="flex items-center justify-between gap-3"><div><div class="text-[10px] font-extrabold text-violet-700">返点历史政策</div><div class="text-[9px] text-slate-400 mt-1">当前返点自动读取最新已生效政策；修改返点请新增一条生效记录，旧历史不会被覆盖。</div></div><button type="button" @click="addContactRebateHistory(contact)" class="h-7 px-2.5 rounded-lg bg-violet-600 text-white text-[9px] font-bold"><i class="fa-solid fa-plus mr-1"></i>新增政策</button></div><div class="mt-3 space-y-2"><div v-for="(rate,ridx) in contact.rebateHistory" :key="rate.id" class="grid grid-cols-1 sm:grid-cols-[120px_110px_1fr_auto] gap-2 items-end bg-white border border-violet-100 rounded-lg p-2.5"><form-field label="生效日期"><input v-model="rate.effectiveDate" type="date" class="field h-9" /></form-field><form-field label="返点比例 %"><input v-model.number="rate.rebateRate" type="number" min="0" step="0.01" class="field h-9" /></form-field><form-field label="返点政策"><input v-model.trim="rate.rebatePolicy" class="field h-9" placeholder="例如：月消耗≥2万 3.5%" /></form-field><button v-if="contact.rebateHistory.length>1" type="button" @click="removeContactRebateHistory(contact,rate)" class="w-8 h-8 rounded-lg bg-rose-50 text-rose-500 mb-0.5"><i class="fa-regular fa-trash-can"></i></button></div></div></div></div></div></div></div><div class="p-5 border-t border-slate-100 bg-slate-50 flex justify-end gap-2"><button @click="showProviderModal=false" class="h-10 px-4 rounded-xl border border-slate-200 bg-white text-xs font-bold">取消</button><button @click="saveProvider" class="h-10 px-5 rounded-xl bg-blue-600 text-white text-xs font-bold">保存开户商</button></div></div></div>

  <!-- Opening Deal Modal -->
  <div v-if="showOpeningModal" class="fixed inset-0 z-[127] modal-backdrop flex items-center justify-center p-4" @click.self="showOpeningModal=false"><div class="w-full max-w-3xl max-h-[92vh] bg-white rounded-3xl soft-shadow overflow-hidden flex flex-col"><div class="p-5 border-b border-slate-100 flex items-center justify-between"><div><h3 class="font-extrabold">{{ openingForm.id ? '编辑客户开户记录' : '新增客户开户' }}</h3><p class="text-[11px] text-slate-400 mt-1">为客户选择开户商和对接人；只有“已开户”状态才进入广告消耗、返点和财务归属，实际返点收入请到财务核算的“代理商返点对账”确认。</p></div><button @click="showOpeningModal=false"><i class="fa-solid fa-xmark"></i></button></div><div class="p-5 overflow-y-auto grid grid-cols-1 sm:grid-cols-2 gap-3"><form-field label="客户 *"><select v-model.number="openingForm.clientId" @change="syncOpeningClient" class="field"><option :value="0">请选择客户</option><option v-for="c in activeClients" :key="c.id" :value="c.id">{{ c.name }}</option></select></form-field><form-field label="开户平台 *"><select v-model="openingForm.platform" @change="syncOpeningClient" class="field"><option value="FB">Facebook</option><option value="TK">TikTok</option></select></form-field><form-field label="开户商 *"><select v-model="openingForm.providerId" @change="syncOpeningProvider" class="field"><option value="">请选择开户商</option><option v-for="p in openingProvidersForPlatform(openingForm.platform)" :key="p.id" :value="p.id">{{ p.name }}</option></select></form-field><form-field label="对接人 *"><select v-model="openingForm.contactId" @change="syncOpeningContact" class="field"><option value="">请选择对接人</option><option v-for="c in providerContacts(openingForm.providerId)" :key="c.id" :value="c.id">{{ c.name }} · 当前返点 {{ Number(contactCurrentRebateRate(c)||0).toFixed(2) }}%</option></select></form-field><form-field label="开户类型"><input v-model.trim="openingForm.accountType" class="field" placeholder="例如：标准账户 / 白名单户" /></form-field><form-field label="开户地区"><input v-model.trim="openingForm.region" class="field" placeholder="例如：美国" /></form-field><form-field label="开户费用"><div class="money-input-group"><select v-model="openingForm.currency" class="field money-currency"><option value="USD">USD</option><option value="CNY">CNY</option></select><input v-model.number="openingForm.fee" type="number" min="0" step="0.01" class="field money-amount" /></div></form-field><form-field label="开户数量"><input v-model.number="openingForm.quantity" type="number" min="1" class="field" /></form-field><form-field label="提交日期"><input v-model="openingForm.submitDate" type="date" class="field" /></form-field><form-field label="预计完成"><input v-model="openingForm.expectedDate" type="date" class="field" /></form-field><form-field label="状态"><select v-model="openingForm.status" class="field"><option value="PREPARE">资料准备</option><option value="SUBMITTED">已提交</option><option value="REVIEWING">审核中</option><option value="OPENED">已开户</option><option value="REJECTED">异常 / 驳回</option></select></form-field><form-field label="渠道归属生效日"><input v-model="openingForm.effectiveStartDate" type="date" class="field" /><div class="text-[9px] text-slate-400 mt-1">仅“已开户”记录生效；修改已开户渠道时请填写新生效日，避免影响历史返点。</div></form-field><form-field label="渠道归属结束日"><input v-model="openingForm.effectiveEndDate" type="date" class="field" /><div class="text-[9px] text-slate-400 mt-1">留空表示持续有效；切换渠道时可给旧记录填写结束日。</div></form-field><form-field label="广告账户范围"><select v-model="openingForm.accountScope" @change="syncOpeningAccountSelection" class="field"><option value="ALL">当前平台全部广告账户</option><option value="SELECTED">选择指定广告账户</option></select></form-field><div v-if="openingForm.accountScope==='SELECTED'" class="sm:col-span-2"><div class="text-[11px] font-semibold text-slate-500 mb-1.5">选择广告账户 *</div><div v-if="openingAvailableAccounts.length" class="grid grid-cols-1 md:grid-cols-2 gap-2 rounded-xl border border-slate-200 p-3 bg-slate-50/60"><label v-for="a in openingAvailableAccounts" :key="a.id" class="flex items-center gap-2 rounded-lg bg-white border border-slate-100 px-3 py-2 text-[11px] cursor-pointer"><input type="checkbox" v-model="openingForm.selectedAdAccountIds" :value="a.adAccountId" class="accent-blue-600"><span class="min-w-0"><span class="font-bold text-slate-700 block truncate">{{ a.accountName }}</span><span class="text-[9px] text-slate-400 font-mono block truncate">{{ a.adAccountId }}</span></span></label></div><div v-else class="rounded-xl border border-amber-200 bg-amber-50 px-3 py-3 text-[10px] text-amber-700">当前客户在该平台还没有已录入广告账户 ID。</div></div><form-field label="BM / BC ID"><input v-model.trim="openingForm.businessId" class="field" /></form-field><form-field label="广告账户 ID"><input v-model.trim="openingForm.adAccountIds" class="field" placeholder="多个 ID 可用逗号分隔" :disabled="openingForm.accountScope==='SELECTED'" /></form-field><div class="sm:col-span-2"><form-field label="备注"><textarea v-model.trim="openingForm.note" rows="3" class="w-full rounded-xl border border-slate-200 p-3 text-xs"></textarea></form-field></div><div class="sm:col-span-2 rounded-xl bg-violet-50 border border-violet-100 p-3"><div class="flex items-center justify-between gap-3 flex-wrap"><div><div class="text-[10px] font-extrabold text-violet-700">当前对接人返点</div><div class="text-xl font-black text-violet-700 mt-1">{{ Number(openingForm.rebateRate||0).toFixed(2) }}%</div></div><div class="text-right"><div class="text-[9px] text-slate-400">返点政策</div><div class="text-[10px] font-semibold text-violet-700 mt-1 max-w-[360px]">{{ openingForm.rebatePolicy || '当前对接人未设置返点政策' }}</div></div></div><div class="text-[9px] text-slate-400 mt-2">保存时会把当时的返点快照写入客户开户记录；后续开户商返点变更不会改写历史记录。</div></div></div><div class="p-5 border-t border-slate-100 bg-slate-50 flex justify-end gap-2"><button @click="showOpeningModal=false" class="h-10 px-4 rounded-xl border border-slate-200 bg-white text-xs font-bold">取消</button><button @click="saveOpeningDeal" class="h-10 px-5 rounded-xl bg-blue-600 text-white text-xs font-bold">保存开户记录</button></div></div></div>

  <!-- Rebate Reconciliation Modal -->
  <div v-if="showReconciliationModal && reconciliationTarget" class="fixed inset-0 z-[130] modal-backdrop flex items-center justify-center p-4" @click.self="showReconciliationModal=false"><div class="w-full max-w-xl bg-white rounded-3xl soft-shadow overflow-hidden"><div class="p-5 border-b border-slate-100 flex items-center justify-between"><div><h3 class="font-extrabold">代理商返点对账</h3><p class="text-[11px] text-slate-400 mt-1">{{ reconciliationTarget.providerName }} · {{ reconciliationTarget.contactName }} · {{ reconciliationTarget.currency }}</p></div><button @click="showReconciliationModal=false"><i class="fa-solid fa-xmark"></i></button></div><div class="p-5 space-y-4"><div class="grid grid-cols-2 gap-3"><div class="rounded-xl bg-amber-50 p-3"><div class="text-[10px] text-amber-600">已归属消耗</div><div class="font-black text-amber-700 mt-1">{{ formatMoney(reconciliationTarget.spend,reconciliationTarget.currency) }}</div></div><div class="rounded-xl bg-violet-50 p-3"><div class="text-[10px] text-violet-600">预计返点</div><div class="font-black text-violet-700 mt-1">{{ formatMoney(reconciliationTarget.expectedAmount,reconciliationTarget.currency) }}</div></div></div><form-field label="实际到账返点"><div class="money-input-group"><select v-model="reconciliationForm.currency" class="field money-currency" disabled><option :value="reconciliationForm.currency">{{ reconciliationForm.currency }}</option></select><input v-model.number="reconciliationForm.actualAmount" type="number" min="0" step="0.01" class="field money-amount" /></div></form-field><form-field label="对账状态"><select v-model="reconciliationForm.status" class="field"><option value="PENDING">待对账</option><option value="CONFIRMED">已确认</option></select></form-field><form-field label="备注"><textarea v-model.trim="reconciliationForm.note" rows="3" class="w-full rounded-xl border border-slate-200 p-3 text-xs" placeholder="例如：代理商月结单已核对，实际到账日期...">