
    function openClientForm(client=null){
      Object.assign(clientForm,{id:null,name:'',product:'',project:'',platform:'FB+TK',monthlyFee:0,currency:'USD',billingMode:'MONTHLY',startDate:localDateKey(),endDate:shiftDays(new Date(),90),renewalAlertDay:28,status:'ACTIVE',owner:'',fbAccounts:[emptyClientAccount('FB')],tkAccounts:[emptyClientAccount('TK')],networkEnvironments:[emptyNetworkEnvironment()],riskRules:''});
      if(client){Object.assign(clientForm,deepClone(client));clientForm.fbAccounts=deepClone(client.fbAccounts||[]);clientForm.tkAccounts=deepClone(client.tkAccounts||[]);clientForm.networkEnvironments=deepClone(client.networkEnvironments||[]);}
      showClientModal.value=true;
    }
    function closeClientModal(){showClientModal.value=false}
    function saveClient(){
      if(!clientForm.name.trim())return notify('请填写客户名称');
      if(!clientForm.startDate||!clientForm.endDate)return notify('请填写合同日期');
      const payload=deepClone(clientForm); normalizeClientRecord(payload);
      if(payload.id){const i=clients.findIndex(c=>c.id===payload.id);clients[i]={...clients[i],...payload};}
      else{payload.id=Date.now();payload.renewalHistory=[];clients.unshift(payload);selectedClientId.value=payload.id;}
      persistClients(); closeClientModal(); notify('客户资料已保存'); audit('CLIENT_SAVE',payload.name);
    }
    function archiveClient(client){
      if(!client || !canArchiveClients()) return notify('当前角色无归档权限');
      if(client.archived) return;
      requestConfirm({title:'归档客户',message:`归档“${client.name}”后将从当前运营客户中移除，不再生成合同 / IP / 广告余额提醒。\n历史广告、财务、开户、回款和成本数据会完整保留。`,confirmText:'归档客户',tone:'warning',onConfirm:()=>{
        backupBeforeDestructive(`归档客户 ${client.name}`); client.archived=true; client.archivedAt=nowText(); client.archivedBy=currentUser.name||currentUser.username||'SYSTEM'; client.status='PAUSED'; persistClients();
        if(selectedClientId.value===client.id){selectedClientId.value=null;currentPage.value='clients';}
        if(selectedAssetsClientId.value===client.id)selectedAssetsClientId.value=activeClients.value[0]?.id||null;
        if(selectedSopClientId.value===client.id){selectedSopClientId.value=activeClients.value[0]?.id||null;selectedSopAccountKey.value='';syncSopAccountSelection(false);}
        if(selectedAnalyticsClientId.value===client.id){selectedAnalyticsClientId.value=0;syncAnalyticsAccountSelection();}
        if(selectedAdsClientId.value===client.id){selectedAdsClientId.value=0;syncAdsAccountSelection();}
        notify('客户已归档，历史数据已保留');audit('CLIENT_ARCHIVE',`${client.name} · 保留历史财务与投放数据`);
      }});
    }
    function restoreClient(client){
      if(!client || !canArchiveClients()) return notify('当前角色无恢复权限');
      client.archived=false;client.archivedAt='';client.archivedBy='';if(client.status==='PAUSED')client.status='ACTIVE';persistClients();notify('客户已恢复到当前运营客户');audit('CLIENT_RESTORE',client.name);
    }
    function deleteClient(client){
      if(!client)return;
      if(currentUser.role!=='ADMIN')return notify('只有管理员可永久删除客户');
      if(!client.archived)return notify('请先归档客户，再执行永久删除');
      requestConfirm({title:'永久删除归档客户',message:`此操作会永久删除“${client.name}”客户资料，以及与其直接关联的潜客转换标记、应收、手工成本、开户记录和 SOP 进度。\n历史投放 / 财务数据将无法恢复，建议先导出备份。`,confirmText:'永久删除',onConfirm:()=>{
        backupBeforeDestructive(`永久删除客户 ${client.name}`); const clientId=client.id; const clientName=client.name;
        const removeByClientId=arr=>{for(let i=arr.length-1;i>=0;i--)if(Number(arr[i].clientId)===Number(clientId))arr.splice(i,1);};
        const ci=clients.findIndex(c=>c.id===clientId);if(ci>=0)clients.splice(ci,1);
        removeByClientId(openingDeals);removeByClientId(financeReceivables);removeByClientId(financeCosts);removeByClientId(financeActualRebates);removeByClientId(standaloneAlerts);
        leads.forEach(lead=>{if(Number(lead.convertedClientId)===Number(clientId)){lead.convertedClientId=null;lead.convertedAt='';}});
        Object.keys(sopProgressStore).forEach(k=>{if(String(k).startsWith(`${clientId}:`))delete sopProgressStore[k];});
        persistClients();persistOpeningDeals();persistLeads();persistFinance();writeStorage('growthops_standalone_alerts_v1',standaloneAlerts);writeStorage('growthops_sop_progress_v4',sopProgressStore);
        selectedClientId.value=null;if(selectedAssetsClientId.value===clientId)selectedAssetsClientId.value=activeClients.value[0]?.id||null;if(selectedSopClientId.value===clientId)selectedSopClientId.value=activeClients.value[0]?.id||null;if(selectedAnalyticsClientId.value===clientId)selectedAnalyticsClientId.value=0;if(selectedAdsClientId.value===clientId)selectedAdsClientId.value=0;
        currentPage.value='clients';notify('归档客户已永久删除');audit('CLIENT_DELETE',`${clientName} · 级联清理直接关联记录`);
      }});
    }
    function openLeadModal(lead=null){Object.assign(leadForm,{id:'',company:'',contact:'',contactInfo:'',source:'',platformInterest:'FB+TK',expectedBudget:0,budgetCurrency:'USD',adQuote:0,quoteCurrency:'USD',stage:'NEW',nextFollowUp:shiftDays(new Date(),2),owner:'',notes:'',createdAt:localDateKey()});if(lead)Object.assign(leadForm,deepClone(lead));showLeadModal.value=true}
    function saveLead(){if(!leadForm.company.trim())return notify('请填写公司 / 客户名称');const payload=normalizeLeadRecord(deepClone(leadForm));if(payload.id){const i=leads.findIndex(l=>l.id===payload.id);leads[i]={...leads[i],...payload};}else{payload.id=uid('lead');leads.unshift(payload);}persistLeads();showLeadModal.value=false;notify('潜在客户已保存');audit('LEAD_SAVE',payload.company)}
    function deleteLead(lead){requestConfirm({title:'删除潜在客户',message:`确认删除“${lead.company}”这条潜客记录吗？`,confirmText:'删除潜客',onConfirm:()=>{backupBeforeDestructive(`潜客 ${lead.company}`);const idx=leads.findIndex(l=>l.id===lead.id);if(idx>=0)leads.splice(idx,1);persistLeads();notify('潜在客户已删除');audit('LEAD_DELETE',lead.company);}})}
    function convertLeadToClient(lead){
      if(lead.convertedClientId){const linked=clients.find(c=>c.id===lead.convertedClientId);if(linked)return openClientDetail(linked.id);}
      const start=localDateKey();const end=shiftDays(new Date(),90);
      leadConvertSource.value=lead;Object.assign(leadConvertForm,{name:lead.company||'',product:'',project:'',owner:lead.owner||'',platform:lead.platformInterest||'FB+TK',monthlyFee:Number(lead.adQuote||0),currency:lead.quoteCurrency||lead.budgetCurrency||'USD',billingMode:'MONTHLY',renewalAlertDay:28,startDate:start,endDate:end,status:'ACTIVE',riskRules:lead.notes||''});showLeadConvertModal.value=true;
    }
    function saveLeadConversion(){
      const lead=leadConvertSource.value;if(!lead)return;
      if(!leadConvertForm.name.trim())return notify('请填写正式客户名称');
      if(!leadConvertForm.product.trim())return notify('请补充产品 / 品牌');
      if(!leadConvertForm.project.trim())return notify('请补充项目名称');
      if(!leadConvertForm.owner.trim())return notify('请补充负责人');
      if(Number(leadConvertForm.monthlyFee||0)<=0)return notify('请填写有效的月服务费');
      if(!leadConvertForm.startDate||!leadConvertForm.endDate)return notify('请填写合同开始与到期日');
      const payload={id:Date.now(),name:leadConvertForm.name.trim(),product:leadConvertForm.product.trim(),project:leadConvertForm.project.trim(),owner:leadConvertForm.owner.trim(),platform:leadConvertForm.platform,monthlyFee:Number(leadConvertForm.monthlyFee||0),currency:leadConvertForm.currency,billingMode:normalizeBillingMode(leadConvertForm.billingMode),startDate:leadConvertForm.startDate,endDate:leadConvertForm.endDate,renewalAlertDay:Number(leadConvertForm.renewalAlertDay||28),status:leadConvertForm.status||'ACTIVE',riskRules:leadConvertForm.riskRules||'',fbAccounts:leadConvertForm.platform.includes('FB')?[emptyClientAccount('FB')]:[],tkAccounts:leadConvertForm.platform.includes('TK')?[emptyClientAccount('TK')]:[],googleAccounts:[],instagramAccounts:[],networkEnvironments:[emptyNetworkEnvironment()],renewalHistory:[],sourceLeadId:lead.id};
      normalizeClientRecord(payload);clients.unshift(payload);lead.stage='WON';lead.convertedClientId=payload.id;lead.convertedAt=nowText();lead.nextFollowUp='';lead.notes=[lead.notes,`已于 ${localDateKey()} 确认合作并创建正式客户`].filter(Boolean).join('\n');persistClients();persistLeads();selectedClientId.value=payload.id;selectedAssetsClientId.value=payload.id;showLeadConvertModal.value=false;leadConvertSource.value=null;leadPoolFilter.value='ACTIVE';leadQuickFilter.value='ALL';currentPage.value='client-detail';notify('合作已确认，正式客户已创建');audit('LEAD_CONVERT',`${lead.company} → ${payload.name}`);
    }
    function openConvertedLeadClient(lead){const linked=clients.find(c=>c.id===lead.convertedClientId);if(linked)return openClientDetail(linked.id);notify('对应的正式客户资料已不存在')}
    function openProviderModal(provider=null){Object.assign(providerForm,{id:'',name:'',company:'',platforms:'FB+TK',region:'',policy:'',contacts:[]});if(provider)Object.assign(providerForm,deepClone(provider));providerForm.contacts=(providerForm.contacts||[]).map(c=>{const copy=deepClone(c);copy.rebateHistory=Array.isArray(copy.rebateHistory)?copy.rebateHistory:[];if(!copy.rebateHistory.length)copy.rebateHistory=[{id:uid('rate'),effectiveDate:'2000-01-01',rebateRate:0,rebatePolicy:''}];return copy;});if(!providerForm.contacts.length)providerForm.contacts=[{id:uid('contact'),name:'',contact:'',title:'',rebateHistory:[{id:uid('rate'),effectiveDate:'2000-01-01',rebateRate:0,rebatePolicy:''}]}];showProviderModal.value=true}
    function addProviderContactForm(){providerForm.contacts.push({id:uid('contact'),name:'',contact:'',title:'',rebateHistory:[{id:uid('rate'),effectiveDate:localDateKey(),rebateRate:0,rebatePolicy:''}]})}
    function removeProviderContactForm(contact){const idx=providerForm.contacts.findIndex(c=>c.id===contact.id);if(idx>=0)providerForm.contacts.splice(idx,1)}
    function addContactRebateHistory(contact){contact.rebateHistory=Array.isArray(contact.rebateHistory)?contact.rebateHistory:[];contact.rebateHistory.push({id:uid('rate'),effectiveDate:localDateKey(),rebateRate:contactCurrentRebateRate(contact),rebatePolicy:''})}
    function removeContactRebateHistory(contact,rate){const idx=contact.rebateHistory.findIndex(r=>r.id===rate.id);if(idx>=0)contact.rebateHistory.splice(idx,1)}
    function saveProvider(){
      if(!providerForm.name.trim())return notify('请填写开户商名称'); if(!(providerForm.contacts||[]).length)return notify('请至少添加一位对接人'); if(providerForm.contacts.some(c=>!c.name.trim()))return notify('请补全对接人姓名');
      providerForm.contacts.forEach(c=>{c.rebateHistory=(c.rebateHistory||[]).filter(r=>r.effectiveDate).sort((a,b)=>String(a.effectiveDate).localeCompare(String(b.effectiveDate)));if(!c.rebateHistory.length)c.rebateHistory=[{id:uid('rate'),effectiveDate:'2000-01-01',rebateRate:0,rebatePolicy:''}]});
      const payload=deepClone(providerForm);normalizeProviderRecord(payload);if(payload.id){const i=openingProviders.findIndex(p=>p.id===payload.id);openingProviders[i]=payload;}else{payload.id=uid('provider');openingProviders.unshift(payload);}persistProviders();showProviderModal.value=false;notify('开户商资料已保存');audit('PROVIDER_SAVE',payload.name);
    }
    function openingAvailableAccountsFor(clientId,platform){const c=clients.find(x=>x.id===Number(clientId));return clientAdAccounts(c,platform)}
    const openingAvailableAccounts=computed(()=>openingAvailableAccountsFor(openingForm.clientId,openingForm.platform));
    function syncOpeningAccountSelection(){ if(openingForm.accountScope==='ALL'){openingForm.selectedAdAccountIds=[];const c=clients.find(x=>x.id===openingForm.clientId);openingForm.adAccountIds=(openingForm.platform==='FB'?(c?.fbAccounts||[]): (c?.tkAccounts||[])).map(a=>a.adAccountId).filter(Boolean).join(', ');} else {const available=new Set(openingAvailableAccounts.value.map(a=>a.adAccountId));openingForm.selectedAdAccountIds=(openingForm.selectedAdAccountIds||[]).filter(id=>available.has(id));openingForm.adAccountIds=openingForm.selectedAdAccountIds.join(', ');} }
    function syncOpeningClient(){const c=clients.find(x=>x.id===openingForm.clientId);if(!c)return;openingForm.region='';openingForm.businessId=openingForm.platform==='FB'?(c.fbAccounts?.[0]?.bmId||''):(c.tkAccounts?.[0]?.bcId||'');syncOpeningAccountSelection();if(openingForm.providerId&&!openingProvidersForPlatform(openingForm.platform).some(p=>p.id===openingForm.providerId)){openingForm.providerId='';openingForm.contactId='';openingForm.rebateRate=0;openingForm.rebatePolicy='';}}
    function syncOpeningProvider(){const p=openingProviders.find(x=>x.id===openingForm.providerId);openingForm.providerName=p?.name||'';openingForm.region=openingForm.region||p?.region||'';openingForm.contactId=p?.contacts?.[0]?.id||'';syncOpeningContact()}
    function syncOpeningContact(){const contact=providerContacts(openingForm.providerId).find(c=>c.id===openingForm.contactId);openingForm.contactName=contact?.name||'';const policy=rebatePolicyForContact(contact,openingForm.effectiveStartDate||openingForm.submitDate||localDateKey());openingForm.rebateRate=Number(policy?.rebateRate||0);openingForm.rebatePolicy=policy?.rebatePolicy||''}
    function openOpeningModal(deal=null){Object.assign(openingForm,{id:'',clientId:activeClients.value[0]?.id||0,providerId:'',contactId:'',providerName:'',contactName:'',platform:'FB',accountType:'标准广告账户',region:'',fee:0,currency:'USD',quantity:1,rebateRate:0,rebatePolicy:'',submitDate:localDateKey(),expectedDate:shiftDays(new Date(),2),status:'PREPARE',businessId:'',adAccountIds:'',accountScope:'ALL',selectedAdAccountIds:[],effectiveStartDate:'',effectiveEndDate:'',note:''});if(deal)Object.assign(openingForm,deepClone(deal));normalizeOpeningDealRecord(openingForm);syncOpeningClient();if(openingForm.providerId)syncOpeningProvider();if(deal){openingForm.contactId=deal.contactId||openingForm.contactId;openingForm.contactName=deal.contactName||openingForm.contactName;openingForm.effectiveStartDate=deal.effectiveStartDate||openingDealEffectiveStart(deal);openingForm.effectiveEndDate=deal.effectiveEndDate||'';syncOpeningContact();}showOpeningModal.value=true}
    function saveOpeningDeal(){
      if(!openingForm.clientId)return notify('请选择客户');if(!openingForm.providerId)return notify('请选择开户商');if(!openingForm.contactId)return notify('请选择对接人');if(openingForm.accountScope==='SELECTED'&&!(openingForm.selectedAdAccountIds||[]).length)return notify('请选择至少一个广告账户');
      syncOpeningContact();syncOpeningAccountSelection(); const payload=deepClone(openingForm); payload.fee=Number(payload.fee||0);payload.quantity=Math.max(1,Number(payload.quantity||1));payload.rebateRate=Number(payload.rebateRate||0);if(payload.status==='OPENED'&&!payload.effectiveStartDate)payload.effectiveStartDate=payload.submitDate||localDateKey();normalizeOpeningDealRecord(payload);
      if(payload.id){const existing=openingDeals.find(d=>d.id===payload.id);const channelChanged=existing&&(String(existing.providerId)!==String(payload.providerId)||String(existing.contactId)!==String(payload.contactId)||String(existing.platform)!==String(payload.platform)||JSON.stringify(openingDealAccountIds(existing).sort())!==JSON.stringify(openingDealAccountIds(payload).sort()));if(channelChanged&&existing.status==='OPENED'&&payload.status==='OPENED'&&openingDealEffectiveStart(existing)&&payload.effectiveStartDate&&payload.effectiveStartDate<openingDealEffectiveStart(existing))return notify('切换开户渠道时，新生效日不能早于原渠道生效日');const i=openingDeals.findIndex(d=>d.id===payload.id);openingDeals[i]=payload;}else{payload.id=uid('open');openingDeals.unshift(payload);}persistOpeningDeals();showOpeningModal.value=false;notify('客户开户记录已保存');audit('OPENING_SAVE',`${openingClientName(payload)} · ${openingProviderName(payload)} · ${openingContactName(payload)}`);
    }
    function deleteOpeningDeal(deal){requestConfirm({title:'删除开户记录',message:`确认删除“${openingClientName(deal)} · ${openingProviderName(deal)}”这条开户记录吗？\n历史返点归属可能因此改变。`,confirmText:'删除开户记录',onConfirm:()=>{backupBeforeDestructive(`开户记录 ${openingClientName(deal)}`);const idx=openingDeals.findIndex(d=>d.id===deal.id);if(idx>=0)openingDeals.splice(idx,1);persistOpeningDeals();notify('开户记录已删除');audit('OPENING_DELETE',`${openingClientName(deal)} · ${openingProviderName(deal)}`);}})}
    function exportRebateExcel(){
      if(typeof XLSX==='undefined')return notify('Excel 组件加载失败，请刷新后重试');
      const providerMap=new Map(openingProviders.map(p=>[p.id,p])); const sheets=[];
      const deals=filteredProviderDeals.value;
      const dealRows=deals.map(deal=>{const client=clients.find(c=>c.id===deal.clientId);const provider=providerMap.get(deal.providerId);const contact=contactForDeal(deal);const spendGroups=openingSpendGroupsForDeals([deal],openingPeriodRange.value);const rebateGroups=openingRebateGroupsForDeals([deal],openingPeriodRange.value);return {客户:client?.name||'已删除客户',平台:deal.platform==='FB'?'Facebook':'TikTok',开户商:provider?.name||deal.providerName||'已删除开户商',对接人:contact?.name||deal.contactName||'未绑定',生效日期:openingDealEffectiveStart(deal)||'',结束日期:deal.effectiveEndDate||'',广告账户:openingDealAccountIds(deal).join(', '),统计周期:openingSpendPeriodLabel.value,广告消耗:currencyGroupsText(spendGroups),预计返点:currencyGroupsText(rebateGroups)};});
      const contactRows=[]; openingProviderSummaryRows.value.filter(row=>openingProviderFilter.value==='ALL'||row.provider.id===openingProviderFilter.value).forEach(row=>row.contactRows.forEach(cr=>contactRows.push({开户商:row.provider.name,对接人:cr.contact.name,职位:cr.contact.title||'',联系方式:cr.contact.contact||'',当前返点比例:`${Number(contactCurrentRebateRate(cr.contact)||0).toFixed(2)}%`,当前政策:rebatePolicyForContact(cr.contact,localDateKey())?.rebatePolicy||'',统计周期:openingSpendPeriodLabel.value,广告消耗:cr.spendText,预计返点:cr.rebateText})));
      const policyRows=[];openingProviders.filter(p=>openingProviderFilter.value==='ALL'||p.id===openingProviderFilter.value).forEach(provider=>(provider.contacts||[]).forEach(contact=>(contact.rebateHistory||[]).forEach(rate=>policyRows.push({开户商:provider.name,对接人:contact.name,生效日期:rate.effectiveDate,返点比例:`${Number(rate.rebateRate||0).toFixed(2)}%`,返点政策:rate.rebatePolicy||''}))));
      const wb=XLSX.utils.book_new();XLSX.utils.book_append_sheet(wb,XLSX.utils.json_to_sheet(dealRows.length?dealRows:[{说明:'当前筛选下暂无客户开户返点数据'}]),'客户返点');XLSX.utils.book_append_sheet(wb,XLSX.utils.json_to_sheet(contactRows.length?contactRows:[{说明:'暂无对接人数据'}]),'对接人汇总');XLSX.utils.book_append_sheet(wb,XLSX.utils.json_to_sheet(policyRows.length?policyRows:[{说明:'暂无返点历史政策'}]),'返点政策历史');XLSX.writeFile(wb,`GrowthOps_Rebate_${openingSpendPeriodLabel.value}_${localDateKey()}.xlsx`);audit('REBATE_EXPORT',`${openingSpendPeriodLabel.value} · ${openingSelectedProviderName.value}`);notify('返点 Excel 已导出');
    }

    function accountSpendText(a){ const records=a?.adDataRecords||[]; if(records.length){const groups=groupCurrencyValues(records.map(r=>({currency:r.currency||'USD',amount:Number(r.spend||0)})));return currencyGroupsText(groups);}return formatMoney(a?.adSpend||0,accountPrimaryCurrency(a)); }
    function clientSpendText(c){return currencyGroupsText(groupCurrencyValues([...(c.fbAccounts||[]),...(c.tkAccounts||[])].flatMap(a=>{const records=a?.adDataRecords||[];return records.length?records.map(r=>({currency:r.currency||'USD',amount:r.spend||0})):[{currency:accountPrimaryCurrency(a),amount:a.adSpend||0}]})))}
    function platformSpendText(c,p){const arr=p==='FB'?(c.fbAccounts||[]): (c.tkAccounts||[]);return currencyGroupsText(groupCurrencyValues(arr.flatMap(a=>{const records=a?.adDataRecords||[];return records.length?records.map(r=>({currency:r.currency||'USD',amount:r.spend||0})):[{currency:accountPrimaryCurrency(a),amount:a.adSpend||0}]})))}
    function accountRechargeText(a){const groups=(a?.rechargeHistory||[]).reduce((o,r)=>{const cur=r.currency||'USD';o[cur]=(o[cur]||0)+Number(r.amount||0);return o;},{});return currencyGroupsText(groups)}
    function clientRechargeText(c){return currencyGroupsText([...(c.fbAccounts||[]),...(c.tkAccounts||[])].flatMap(a=>a.rechargeHistory||[]).reduce((o,r)=>{const cur=r.currency||'USD';o[cur]=(o[cur]||0)+Number(r.amount||0);return o;},{}))}
    function latestRechargeDate(a){const rows=(a?.rechargeHistory||[]).slice().sort((x,y)=>String(y.date).localeCompare(String(x.date)));return rows[0]?.date||'暂无'}
    function latestRechargeLabel(a){const rows=(a?.rechargeHistory||[]).slice().sort((x,y)=>String(y.date).localeCompare(String(x.date)));const r=rows[0];return r?`${r.date} · ${formatMoney(r.amount,r.currency)}`:'暂无记录'}
    function usdAdSpend(account){return (account?.adDataRecords||[]).filter(r=>(r.currency||'USD')==='USD').reduce((s,r)=>s+Number(r.spend||0),0)}
    function usdRecharge(account){return (account?.rechargeHistory||[]).filter(r=>(r.currency||'USD')==='USD').reduce((s,r)=>s+Number(r.amount||0),0)}
    function hasUsdBalanceData(account){return (account?.rechargeHistory||[]).some(r=>(r.currency||'USD')==='USD')}
    function accountBalanceUSD(account){if(!hasUsdBalanceData(account))return 0;return usdRecharge(account)-usdAdSpend(account)}
    function accountBalanceText(account){return hasUsdBalanceData(account)?formatMoney(accountBalanceUSD(account),'USD'):'未开始监控'}
    function isLowBalance(account){return hasUsdBalanceData(account)&&accountBalanceUSD(account)<=100}
    function isCriticalBalance(account){return hasUsdBalanceData(account)&&accountBalanceUSD(account)<=30}
    function openRechargeModal(client,platform,account){rechargeTarget.clientName=client.name;rechargeTarget.clientId=client.id;rechargeTarget.platform=platform;rechargeTarget.account=account;Object.assign(rechargeForm,{date:localDateKey(),amount:0,currency:'USD',note:''});showRechargeModal.value=true}
    function closeRechargeModal(){showRechargeModal.value=false;rechargeTarget.account=null}
    function saveRecharge(){if(!rechargeTarget.account||Number(rechargeForm.amount||0)<=0)return notify('请输入有效的充值金额');rechargeTarget.account.rechargeHistory=Array.isArray(rechargeTarget.account.rechargeHistory)?rechargeTarget.account.rechargeHistory:[];rechargeTarget.account.rechargeHistory.unshift({id:uid('recharge'),date:rechargeForm.date||localDateKey(),amount:Number(rechargeForm.amount),currency:rechargeForm.currency,note:rechargeForm.note||'广告账户充值'});persistClients();closeRechargeModal();notify('广告充值已登记并记录日期');audit('AD_RECHARGE',`${rechargeTarget.clientName} · ${formatMoney(rechargeForm.amount,rechargeForm.currency)}`)}

    function syncSopAccountSelection(reset=false){
      if(!selectedSopClientId.value||!activeClients.value.some(c=>c.id===selectedSopClientId.value))selectedSopClientId.value=activeClients.value[0]?.id||null;
      const options=selectedSopAccounts.value;
      if(reset || !options.some(x=>x.key===selectedSopAccountKey.value)) selectedSopAccountKey.value='';
      onSopAccountChange();
    }
    function onSopAccountChange(){
      const date=selectedSopDate.value||localDateKey(); selectedSopDate.value=date;
      if(selectedSopClient.value&&selectedSopAccount.value){ const cfg=selectedSopConfig.value; if(!Array.isArray(cfg.dailyTasks[date]))cfg.dailyTasks[date]=deepClone(cfg.steps||[]).map(step=>({...step,id:uid('sop')})); persistClients(); }
      loadSopProgress();
    }
    function onSopDateChange(){ if(selectedSopClient.value&&selectedSopAccount.value){const cfg=selectedSopConfig.value,date=selectedSopDate.value||localDateKey();if(!Array.isArray(cfg.dailyTasks[date]))cfg.dailyTasks[date]=deepClone(cfg.steps||[]).map(step=>({...step,id:uid('sop')}));persistClients();} loadSopProgress(); }
    function setSopDateToday(){ selectedSopDate.value=localDateKey(); onSopDateChange(); }
    function sopDateBadge(date){ if(!date)return ''; const d=new Date(date+'T00:00:00'),today=localDateKey(); const base=new Intl.DateTimeFormat('zh-CN',{month:'short',day:'numeric',weekday:'short'}).format(d); return date===today?`${base} · 今天`:date<today?`${base} · 历史`:`${base} · 未来`; }
    function loadSopProgress(){Object.keys(sopChecked).forEach(k=>delete sopChecked[k]);const saved=sopProgressStore[selectedSopProgressKey.value]||{};selectedSopSteps.value.forEach(step=>{sopChecked[step.id]=!!saved[step.id]});}
    function saveSopProgress(){sopProgressStore[selectedSopProgressKey.value]=Object.fromEntries(selectedSopSteps.value.map(s=>[s.id,!!sopChecked[s.id]]));writeStorage('growthops_sop_progress_v4',sopProgressStore);}
    function resetSopProgress(){requestConfirm({title:'重置 SOP 完成状态',message:`确认重置 ${sopSelectedDateBadge.value} 的全部完成状态吗？\n任务内容不会被删除。`,confirmText:'重置状态',tone:'warning',onConfirm:()=>{selectedSopSteps.value.forEach(s=>sopChecked[s.id]=false);saveSopProgress();notify('当前日期 SOP 完成状态已重置')}})}
    function toggleSopTask(id){sopExpandedTasks[id]=!sopExpandedTasks[id]}
    function openSopTaskModal(step=null){ if(!selectedSopClient.value||!selectedSopAccount.value)return notify('请先选择客户和账号'); Object.assign(sopTaskForm,{id:step?.id||'',text:step?.text||'',plan:step?.plan||'',note:step?.note||''}); showSopTaskModal.value=true; }
    function closeSopTaskModal(){showSopTaskModal.value=false;Object.assign(sopTaskForm,{id:'',text:'',plan:'',note:''})}
    function saveSopTask(){
      const text=sopTaskForm.text.trim();if(!text)return notify('请填写任务内容');const arr=selectedSopSteps.value;if(sopTaskForm.id){const idx=arr.findIndex(s=>s.id===sopTaskForm.id);if(idx>=0)arr[idx]={...arr[idx],text,plan:sopTaskForm.plan.trim(),note:sopTaskForm.note.trim()};}else{const item={id:uid('sop'),text,plan:sopTaskForm.plan.trim(),note:sopTaskForm.note.trim()};arr.push(item);sopChecked[item.id]=false;}
      persistClients();saveSopProgress();closeSopTaskModal();notify(sopTaskForm.id?'SOP 任务已修改':'SOP 任务已添加');
    }
    function removeSopStep(index){const step=selectedSopSteps.value[index];if(!step)return;requestConfirm({title:'删除 SOP 任务',message:`确认删除“${step.text}”吗？\n只会删除 ${sopSelectedDateBadge.value} 当前账号的这条任务。`,confirmText:'删除任务',onConfirm:()=>{backupBeforeDestructive(`SOP ${step.text}`);selectedSopSteps.value.splice(index,1);delete sopChecked[step.id];delete sopExpandedTasks[step.id];persistClients();saveSopProgress();notify('SOP 任务已删除');audit('SOP_DELETE',`${selectedSopClient.value?.name||''} · ${step.text}`);}})}
    function saveSopSettings(){persistClients();notify('当前账号执行计划已保存')}

    function handleAlertComplete(item){
      if(item.typeKey==='CONTRACT'){renewalTarget.value=item;renewalForm.newEndDate=shiftDays(new Date(item.dueDate+'T00:00:00'),365);renewalForm.note='年度续费完成';showRenewalModal.value=true;return;}
      if(item.typeKey==='IP'){
        const c=clients.find(x=>x.id===item.clientId);const env=c?.networkEnvironments?.find(x=>x.id===item.networkId);if(env){env.ipDueDate=shiftDays(new Date(env.ipDueDate+'T00:00:00'),30);normalizeClientRecord(c);persistClients();notify('IP / 代理续费已完成并顺延 30 天');audit('RENEW_IP',`${c.name} · ${env.networkName}`);}return;
      }
      if(item.typeKey==='AD_RECHARGE'){
        const c=clients.find(x=>x.id===item.clientId);const list=item.platform==='FB'?(c?.fbAccounts||[]): (c?.tkAccounts||[]);const account=list.find(a=>a.id===item.accountId);if(c&&account)openRechargeModal(c,item.platform,account);return;
      }
      if(item.typeKey==='RECEIVABLE'){const row=financeReceivables.find(r=>r.id===item.receivableId);if(row)openCollectionModal(receivableView(row));return;}
      if(item.isStandalone) deleteStandalone(item.id);
    }
    function completeRenewal(){const c=clients.find(x=>x.id===renewalTarget.value.clientId);if(!c)return;c.endDate=renewalForm.newEndDate;c.renewalHistory=c.renewalHistory||[];c.renewalHistory.unshift({date:localDateKey(),newEndDate:renewalForm.newEndDate,note:renewalForm.note||'续费完成'});persistClients();showRenewalModal.value=false;notify('续费完成，客户合同已更新');audit('RENEW_CONTRACT',c.name)}
    function saveStandaloneAlert(){if(!alertForm.clientName||!alertForm.dueDate)return notify('请填写提醒对象和日期');standaloneAlerts.unshift({id:uid('alert'),clientName:alertForm.clientName,type:alertForm.type,dueDate:alertForm.dueDate,cost:alertForm.cost,target:alertForm.target});writeStorage('growthops_standalone_alerts_v1',standaloneAlerts);showAddAlertModal.value=false;Object.assign(alertForm,{clientName:'',type:'合同续费',dueDate:localDateKey(),cost:'',target:''});notify('独立提醒已添加')}
    function deleteStandalone(id){const i=standaloneAlerts.findIndex(x=>x.id===id);if(i>=0)standaloneAlerts.splice(i,1);writeStorage('growthops_standalone_alerts_v1',standaloneAlerts)}
    function alertDismissKey(item){return item?.id||''}
    function deleteAlert(item){
      if(!item)return;
      if(item.isStandalone){requestConfirm({title:'删除独立提醒',message:`确认删除“${item.clientName} · ${item.type}”这条独立提醒吗？`,confirmText:'删除提醒',onConfirm:()=>{backupBeforeDestructive(`提醒 ${item.clientName}`);deleteStandalone(item.id);notify('独立提醒已删除');audit('ALERT_DELETE',`${item.clientName} · ${item.type}`);}});return;}
      requestConfirm({title:'忽略本次提醒',message:`确认忽略“${item.clientName} · ${item.type}”当前这条提醒吗？\n不会删除客户 / 合同 / IP / 应收数据；后续如到期日期变化，会按新记录重新生成提醒。`,confirmText:'忽略提醒',tone:'warning',onConfirm:()=>{dismissedAlerts[alertDismissKey(item)]=true;notify('已忽略本次提醒');audit('ALERT_DISMISS',`${item.clientName} · ${item.type}`);}});
    }
    function restoreDismissedAlerts(){const count=activeDismissedAlertCount.value;Object.keys(dismissedAlerts).forEach(k=>delete dismissedAlerts[k]);notify(count?`已恢复 ${count} 条被忽略提醒`:'没有已忽略提醒');audit('ALERT_RESTORE',`恢复 ${count} 条提醒`)}
    async function copyText(text){try{await navigator.clipboard.writeText(text);notify('已复制到剪贴板')}catch{const ta=document.createElement('textarea');ta.value=text;document.body.appendChild(ta);ta.select();document.execCommand('copy');ta.remove();notify('已复制到剪贴板')}}
    function individualNotice(item){
      if(item.typeKey==='AD_RECHARGE')return `【${item.balanceStage==='CRITICAL'?'广告费二次紧急充值提醒':'广告费充值提醒'}】\n客户：${item.clientName}\n账户：${item.target}\n当前 USD 余额：${item.balanceText}\n${item.balanceStage==='CRITICAL'?'余额已到 $30 或以下，请尽快再次补充预算。':'余额已到 $100 或以下，请安排补充广告预算。'}\n日期：${localDateKey()}`;
      if(item.typeKey==='RECEIVABLE')return `【收入应收回款提醒】\n客户：${item.clientName}\n账单：${item.target}\n到期：${item.dueDate}\n${item.cost}\n请跟进本期回款。`;
      return `【${item.type}提醒】\n客户：${item.clientName}\n到期：${item.dueDate}\n剩余：${daysLeftLabel(item.daysLeft)}\n费用：${item.cost||'—'}\n目标：${item.target||'—'}`;
    }
    function copyIndividualNotice(i){copyText(individualNotice(i))}
    function copyNoticeSummary(){copyText(alertList.value.map(individualNotice).join('\n\n'))}

    function fullBackupPayload(){return {version:'4.2',exportedAt:nowText(),clients:deepClone(clients),leads:deepClone(leads),openingProviders:deepClone(openingProviders),openingDeals:deepClone(openingDeals),financeActualRebates:deepClone(financeActualRebates),financeReceivables:deepClone(financeReceivables),financeCosts:deepClone(financeCosts),financeReconciliations:deepClone(financeReconciliations),financeMonthLocks:deepClone(financeMonthLocks),financeMonthSnapshots:deepClone(financeMonthSnapshots),standaloneAlerts:deepClone(standaloneAlerts),mediaTools:deepClone(mediaTools),sopProgressStore:deepClone(sopProgressStore),users:deepClone(users),auditLogs:deepClone(auditLogs)}}
    function downloadFullBackup(){const data=fullBackupPayload();const blob=new Blob([JSON.stringify(data,null,2)],{type:'application/json'}),url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download=`growthops_crm_backup_${localDateKey()}.json`;a.click();URL.revokeObjectURL(url);audit('BACKUP_EXPORT','导出完整 JSON 备份');notify('完整 JSON 备份已导出')}
    function createLocalSnapshot(customLabel=''){const data=fullBackupPayload();backupSnapshots.unshift({id:uid('snap'),label:customLabel||`本地快照 ${localDateKey()}`,createdAt:nowText(),data});writeStorage('growthops_backup_snapshots_v1',backupSnapshots);audit('SNAPSHOT','创建本地快照');if(!customLabel)notify('本地快照已创建')}
    function applyBackup(data,source='BACKUP_RESTORE'){
      if(!data||!Array.isArray(data.clients))throw new Error('备份格式无效');
      clients.splice(0,clients.length,...deepClone(data.clients).map(normalizeClientRecord));leads.splice(0,leads.length,...deepClone(data.leads||[]).map(normalizeLeadRecord));openingProviders.splice(0,openingProviders.length,...deepClone(data.openingProviders||[]));openingProviders.forEach(normalizeProviderRecord);openingDeals.splice(0,openingDeals.length,...deepClone(data.openingDeals||[]));openingDeals.forEach(normalizeOpeningDealRecord);financeActualRebates.splice(0,financeActualRebates.length,...deepClone(data.financeActualRebates||[]));financeReceivables.splice(0,financeReceivables.length,...deepClone(data.financeReceivables||[]));financeCosts.splice(0,financeCosts.length,...deepClone(data.financeCosts||[]));financeReconciliations.splice(0,financeReconciliations.length,...deepClone(data.financeReconciliations||[]));financeMonthLocks.splice(0,financeMonthLocks.length,...deepClone(data.financeMonthLocks||[]));financeMonthSnapshots.splice(0,financeMonthSnapshots.length,...deepClone(data.financeMonthSnapshots||[]));standaloneAlerts.splice(0,standaloneAlerts.length,...deepClone(data.standaloneAlerts||[]));mediaTools.splice(0,mediaTools.length,...deepClone(data.mediaTools||[]));Object.keys(sopProgressStore).forEach(k=>delete sopProgressStore[k]);Object.assign(sopProgressStore,deepClone(data.sopProgressStore||{}));if(Array.isArray(data.users)&&data.users.length){users.splice(0,users.length,...deepClone(data.users));writeStorage('growthops_users_v4',users);}persistClients();persistLeads();persistProviders();persistOpeningDeals();persistFinance();writeStorage('growthops_standalone_alerts_v1',standaloneAlerts);writeStorage('growthops_media_tools_v1',mediaTools);writeStorage('growthops_sop_progress_v4',sopProgressStore);syncSopAccountSelection(false);syncAnalyticsAccountSelection();syncAdsAccountSelection();audit(source,'恢复完整数据');notify('数据已恢复');
    }
    function restoreSnapshot(snap){requestConfirm({title:'恢复本地快照',message:`确认恢复“${snap.label}”吗？\n当前数据会先自动生成一个恢复前备份。`,confirmText:'恢复快照',tone:'warning',onConfirm:()=>{backupBeforeDestructive(`恢复快照前 ${snap.label}`);applyBackup(snap.data,'SNAPSHOT_RESTORE');}})}
    async function restoreBackup(e){const file=e.target.files?.[0];if(!file)return;requestConfirm({title:'导入并恢复备份',message:`确认使用“${file.name}”覆盖当前业务数据吗？\n恢复前会自动生成本地快照。`,confirmText:'导入并恢复',tone:'warning',onConfirm:async()=>{try{backupBeforeDestructive(`导入备份前 ${file.name}`);const data=JSON.parse(await file.text());applyBackup(data,'BACKUP_RESTORE')}catch(err){notify('备份文件解析失败')}finally{e.target.value=''}}});}

    async function openUserModal(u=null){
      if(currentUser.role!=='ADMIN')return notify('仅管理员可维护用户');
      try{ const rows=await CLOUD.rpc('crm_list_users',{p_token:CLOUD.token}); users.splice(0,users.length,...(rows||[]).map(x=>({id:x.id,name:x.name,username:x.username,role:x.role,enabled:x.enabled,password:''}))); }catch{}
      Object.assign(userForm,{id:'',name:'',username:'',password:'',role:'OPS',enabled:true});if(u)Object.assign(userForm,{id:u.id,name:u.name,username:u.username,password:'',role:u.role,enabled:u.enabled});showUserModal.value=true;
    }
    async function saveUser(){
      if(currentUser.role!=='ADMIN')return notify('仅管理员可维护用户'); if(!userForm.name||!userForm.username)return notify('请填写姓名和账号'); if(!userForm.id && String(userForm.password||'').length<10)return notify('新用户密码至少 10 位'); if(userForm.password && String(userForm.password).length<10)return notify('密码至少 10 位');
      try{ await CLOUD.rpc('crm_upsert_user',{p_token:CLOUD.token,p_user_id:userForm.id||null,p_name:userForm.name,p_username:userForm.username,p_password:userForm.password||null,p_role:userForm.role,p_enabled:!!userForm.enabled}); const rows=await CLOUD.rpc('crm_list_users',{p_token:CLOUD.token});users.splice(0,users.length,...(rows||[]).map(x=>({id:x.id,name:x.name,username:x.username,role:x.role,enabled:x.enabled,password:''})));showUserModal.value=false;notify('云端用户已保存');audit('USER_SAVE',userForm.username); }catch(error){notify(`保存失败：${error?.message||error}`)}
    }
    function deleteUser(u){ if(currentUser.role!=='ADMIN')return notify('仅管理员可删除用户'); requestConfirm({title:'删除用户',message:`确认删除用户“${u.name}（${u.username}）”吗？`,confirmText:'删除用户',onConfirm:async()=>{try{await CLOUD.rpc('crm_delete_user',{p_token:CLOUD.token,p_user_id:u.id});const idx=users.findIndex(x=>x.id===u.id);if(idx>=0)users.splice(idx,1);notify('用户已删除');audit('USER_DELETE',u.username);}catch(error){notify(`删除失败：${error?.message||error}`)}}}); }

    watch(()=>selectedAssetsClientId.value,()=>{credentialsVisible.value=false;});
    watch(()=>selectedSopClientId.value,()=>syncSopAccountSelection(true));
    watch(()=>selectedSopAccountKey.value,()=>onSopAccountChange());
    watch(()=>selectedSopDate.value,()=>loadSopProgress());
    watch(()=>selectedAnalyticsFbAccountId.value,()=>{selectedAnalyticsFbDataDate.value='ALL';});
    watch(()=>selectedAnalyticsTkAccountId.value,()=>{selectedAnalyticsTkDataDate.value='ALL';});
    watch(()=>financeMonthKey.value,()=>{ if(financePeriod.value==='MONTH') syncAutoReceivables(); });

    onMounted(async()=>{
      const resumed=await CLOUD.resume();
      if(resumed?.user){
        const u=resumed.user;Object.assign(currentUser,{id:u.id||'',name:u.name||u.username,username:u.username||'',role:u.role||'OPS',enabled:u.enabled!==false});users.splice(0,users.length,...[{...currentUser,password:''}]);loadCloudStateIntoReactive();
      }
      selectedAssetsClientId.value=activeClients.value[0]?.id||null;selectedSopClientId.value=activeClients.value[0]?.id||null;selectedAnalyticsClientId.value=0;selectedAdsClientId.value=0;syncSopAccountSelection(false);syncAnalyticsAccountSelection();syncAdsAccountSelection();syncAutoReceivables();
    });

    return {
      currentUser,loginForm,users,clients,activeClients,leads,openingProviders,openingDeals,financeActualRebates,financeReceivables,financeCosts,financeReconciliations,financeMonthLocks,financeMonthSnapshots,mediaTools,standaloneAlerts,backupSnapshots,auditLogs,currentPage,mobileMenuOpen,searchQuery,globalSearchQuery,globalSearchOpen,platformFilter,showArchivedClients,filteredClients,selectedClientId,selectedClient,selectedAssetsClientId,selectedAssetsClient,credentialsVisible,assetPager,selectedSopClientId,selectedSopClient,selectedSopAccounts,selectedSopAccountKey,selectedSopAccount,selectedSopDate,selectedSopSteps,sopChecked,sopExpandedTasks,selectedSopConfig,completedSopCount,sopChecklistTitle,sopSelectedDateBadge,selectedAnalyticsClientId,selectedAnalyticsClient,selectedAnalyticsFbAccountId,selectedAnalyticsTkAccountId,selectedAnalyticsFbAccount,selectedAnalyticsTkAccount,selectedAnalyticsFbMetrics,selectedAnalyticsTkMetrics,selectedAnalyticsFbDataDate,selectedAnalyticsTkDataDate,analyticsAllFbAccountCount,analyticsAllTkAccountCount,analyticsAllFbSpendText,analyticsAllTkSpendText,analyticsAllSpendText,analyticsAllRechargeText,analyticsAllFbMetrics,analyticsAllTkMetrics,analyticsAllClientRows,roasBars,analyticsAdvice,selectedAdsClientId,selectedAdsClient,selectedAdsPlatform,selectedAdsAccountId,selectedAdsAccounts,selectedAdsAccount,adsAllAccountCount,adsAllSavedPlanCount,adsAllDataRecordCount,adsAllClientRows,savedAdsCampaignsForAccount,draftAdsCampaignsForAccount,accountAdDataRecords,adDataAdSets,adDataAds,adDataFormMetricPreview,alertList,alertFilters,filteredAlerts,alertTypeFilter,dashboardCards,todayText,pageTitle,pageEyebrow,visibleMenuItems,currentRoleLabel,toastMessage,showArchivedClients,activeDismissedAlertCount,confirmDialog,
      showClientModal,clientForm,showRenewalModal,renewalTarget,renewalForm,showAddAlertModal,alertForm,showRechargeModal,rechargeTarget,rechargeForm,showAdDataModal,adDataForm,showAdsPlanDetail,adsPlanDetail,showSopTaskModal,sopTaskForm,showLeadModal,leadSearch,leadPoolFilter,leadQuickFilter,leadForm,leadStats,filteredLeads,showLeadConvertModal,leadConvertSource,leadConvertForm,showProviderModal,providerForm,showOpeningModal,openingForm,openingSearch,openingProviderFilter,openingPlatformFilter,openingStatusFilter,openingSpendPeriod,openingMonthKey,openingQuarterYear,openingQuarter,openingYear,openingContactSelections,openingAvailableAccounts,openingAvailableYears,openingPeriodRange,openingSpendPeriodLabel,openingMonthLabel,openingQuarterLabel,openingYearLabel,openingSelectedProviderName,openingProviderSummaryRows,filteredOpeningDeals,openingStats,openingTotalSpendText,openingTotalRebateText,unboundOpeningDealCount,financePeriod,financeMonthKey,financeQuarterYear,financeQuarter,financeYear,financeClientFilter,financeAvailableYears,financePeriodLabel,financeTotalAdSpendGroups,financeAttributedSpendGroups,financeUnassignedSpendGroups,financeExpectedRebateGroups,financeActualRebateGroups,financeRevenueGroups,financeReceivedGroups,financeOutstandingGroups,financeCostGroups,financeNetProfitGroups,financeCollectionRate,financeCollectionRateText,financeSpendAttributionRate,financeSpendAttributionRateText,financeOutstandingInvoiceCount,financePendingReconciliationCount,financeReceivableRows,financeCostRows,financeChannelRows,financeClientSummaryRows,financeReconciliationRows,financeMonthCheck,showReceivableModal,receivableForm,showCollectionModal,collectionTarget,collectionForm,showCostModal,costForm,showReconciliationModal,reconciliationTarget,reconciliationForm,showExternalAssetModal,externalAssetForm,showUserModal,userForm,formatMoney,daysUntil,contractStatusText,daysLeftLabel,billingModeText,alertStyle,roleName,roleScopeText,canViewCredentials,canManageAssets,canManageProviders,canArchiveClients,canManageFinance,login,logout,navigateTo,openClientDetail,openClientForm,closeClientModal,saveClient,archiveClient,restoreClient,deleteClient,addClientAccount,removeClientAccount,addNetworkEnvironment,removeNetworkEnvironment,copyIndividualNotice,copyNoticeSummary,handleAlertComplete,completeRenewal,saveStandaloneAlert,deleteStandalone,deleteAlert,restoreDismissedAlerts,openRechargeModal,closeRechargeModal,saveRecharge,accountSpendText,accountRechargeText,clientSpendText,platformSpendText,clientRechargeText,latestRechargeDate,latestRechargeLabel,accountBalanceText,hasUsdBalanceData,isLowBalance,isCriticalBalance,accountRebateModeText,maskAccount,accountDataDates,accountDataSummary,percentText,selectedAnalyticsFbDataDate,selectedAnalyticsTkDataDate,addAdCampaign,addAdSet,addCreative,removeAdCampaign,removeAdSet,removeCreative,saveAdsPlan,editAdCampaign,openAdsPlanDetail,closeAdsPlanDetail,objectiveLabel,campaignAdCount,campaignBudgetText,campaignDataSpendText,campaignDataRecordCount,adSetDataSpendText,openAdDataModal,openAdDataFromAnalytics,closeAdDataModal,editAdDataRecord,saveAdDataRecord,deleteAdDataRecord,syncAdDataHierarchy,selectAnalyticsClient,selectAdsClient,syncAnalyticsAccountSelection,syncAdsAccountSelection,genderLabel,ctaLabel,toggleSopTask,openSopTaskModal,closeSopTaskModal,saveSopTask,removeSopStep,saveSopProgress,resetSopProgress,saveSopSettings,setSopDateToday,onSopDateChange,onSopAccountChange,openLeadModal,saveLead,deleteLead,convertLeadToClient,saveLeadConversion,openConvertedLeadClient,leadStageText,leadStageStyle,leadFollowupClass,followupLabel,openProviderModal,addProviderContactForm,removeProviderContactForm,addContactRebateHistory,removeContactRebateHistory,saveProvider,providerContacts,providerContactText,providerRateRangeText,contactCurrentRebateRate,rebatePolicyForContact,visibleProviderContactRows,openOpeningModal,syncOpeningClient,syncOpeningProvider,syncOpeningContact,syncOpeningAccountSelection,saveOpeningDeal,deleteOpeningDeal,exportRebateExcel,openingClientName,openingProviderName,openingContactName,openingDealEffectiveStart,openingDealSpendText,openingDealRebateText,openingDealAccountMatchText,openingDealUnmatchedIds,openingStatusText,openingStatusStyle,openingProvidersForPlatform,downloadFullBackup,createLocalSnapshot,restoreSnapshot,restoreBackup,openUserModal,saveUser,deleteUser,cancelConfirmDialog,runConfirmDialog,financeMoneyRows,financeMoneyGroupsSummary,openReceivableModal,saveReceivable,openCollectionModal,saveCollection,openCostModal,saveCost,deleteCost,openReconciliationModal,saveReconciliation,isMonthLocked,toggleFinanceMonthLock,financeClientName,financeReceivableStatusText,financeReceivableStatusStyle,receivableServiceTypeText,financeCostTypeText,exportFinanceExcel,openExternalAssetModal,closeExternalAssetModal,saveExternalAsset,deleteExternalAsset,globalSearchResults,openGlobalSearchResult,openFirstGlobalSearchResult,globalSearchResultIcon,globalSearchResultIconClass,clampedAssetPagerIndex,setAssetPagerIndex,changeAssetPager,getPagedItem
