>
        <!-- Dashboard -->
        <section v-if="currentPage==='dashboard'" key="dashboard" class="space-y-6">
          <div class="rounded-3xl overflow-hidden bg-slate-950 text-white soft-shadow relative">
            <div class="absolute inset-0 metric-grid opacity-40"></div>
            <div class="relative p-6 md:p-8 flex flex-col xl:flex-row xl:items-end xl:justify-between gap-6">
              <div class="max-w-2xl">
                <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full bg-white/10 border border-white/10 text-[11px] font-semibold text-slate-300">
                  <span class="w-1.5 h-1.5 bg-emerald-400 rounded-full"></span>运营数据实时概览
                </div>
                <h1 class="text-2xl md:text-3xl font-extrabold tracking-tight mt-4">客户、合同、资产和投放数据，集中在一个工作台。</h1>
                <p class="text-sm text-slate-400 mt-3 leading-relaxed">快速识别临期合同、账号资产风险和投放表现，把续费、交付与优化动作放在同一条运营链路里。</p>
              </div>
              <div class="flex gap-2 flex-wrap">
                <button @click="navigateTo('alerts')" class="px-4 h-10 rounded-xl bg-white text-slate-950 text-xs font-bold"><i class="fa-regular fa-bell mr-1.5"></i>处理 {{ alertList.length }} 个预警</button>
                <button @click="navigateTo('clients')" class="px-4 h-10 rounded-xl bg-white/10 border border-white/10 text-xs font-bold"><i class="fa-solid fa-users mr-1.5"></i>查看客户</button>
              </div>
            </div>
          </div>

          <div class="grid grid-cols-2 xl:grid-cols-4 gap-3 sm:gap-4">
            <div v-for="card in dashboardCards" :key="card.label" class="bg-white border border-slate-200 rounded-2xl p-4 sm:p-5 soft-shadow">
              <div class="flex items-start justify-between gap-3">
                <div>
                  <div class="text-[11px] sm:text-xs font-semibold text-slate-500">{{ card.label }}</div>
                  <div class="text-xl sm:text-2xl font-extrabold tracking-tight mt-2" :class="card.valueClass">{{ card.value }}</div>
                  <div class="text-[10px] sm:text-[11px] text-slate-400 mt-1">{{ card.hint }}</div>
                </div>
                <div class="w-10 h-10 rounded-xl flex items-center justify-center" :class="card.iconBg"><i :class="card.icon"></i></div>
              </div>
            </div>
          </div>

          <div class="grid grid-cols-1 xl:grid-cols-3 gap-5">
            <div class="xl:col-span-2 bg-white border border-slate-200 rounded-2xl soft-shadow overflow-hidden">
              <div class="p-5 flex items-center justify-between border-b border-slate-100">
                <div>
                  <h3 class="font-extrabold text-sm">近期客户与合作状态</h3>
                  <p class="text-[11px] text-slate-400 mt-1">点击客户可直接进入详情页</p>
                </div>
                <button @click="navigateTo('clients')" class="text-xs font-semibold text-indigo-600">查看全部 <i class="fa-solid fa-arrow-right ml-1"></i></button>
              </div>
              <div class="overflow-x-auto scrollbar">
                <table class="w-full min-w-[780px] text-xs">
                  <thead class="bg-slate-50 text-slate-500">
                    <tr><th class="p-3.5 text-left font-semibold">客户</th><th class="p-3.5 text-left font-semibold">平台</th><th class="p-3.5 text-left font-semibold">服务费</th><th class="p-3.5 text-left font-semibold">合同</th><th class="p-3.5 text-left font-semibold">投放状态</th><th class="p-3.5 text-right font-semibold">操作</th></tr>
                  </thead>
                  <tbody class="divide-y divide-slate-100">
                    <tr v-for="client in clients.slice(0,6)" :key="client.id" class="hover:bg-slate-50/70">
                      <td class="p-3.5"><button @click="openClientDetail(client.id)" class="text-left"><div class="font-bold text-slate-900">{{ client.name }}</div><div class="text-[10px] text-slate-400 mt-0.5">{{ client.product }}</div></button></td>
                      <td class="p-3.5"><platform-badges :platform="client.platform"></platform-badges></td>
                      <td class="p-3.5 font-bold">{{ formatMoney(client.monthlyFee, client.currency) }}</td>
                      <td class="p-3.5"><span class="font-mono">{{ client.endDate }}</span><div class="text-[10px] mt-0.5" :class="daysUntil(client.endDate)<=7 ? 'text-amber-600 font-bold' : 'text-slate-400'">{{ contractStatusText(client) }}</div></td>
                      <td class="p-3.5"><span class="inline-flex px-2 py-1 rounded-full text-[10px] font-bold" :class="client.status==='ACTIVE' ? 'bg-emerald-50 text-emerald-700' : 'bg-slate-100 text-slate-600'">{{ client.status==='ACTIVE'?'合作中':'暂停' }}</span></td>
                      <td class="p-3.5 text-right"><button @click="openClientDetail(client.id)" class="w-8 h-8 rounded-lg hover:bg-slate-100 text-slate-500"><i class="fa-solid fa-chevron-right"></i></button></td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>

            <div class="bg-white border border-slate-200 rounded-2xl soft-shadow overflow-hidden">
              <div class="p-5 border-b border-slate-100">
                <div class="flex items-center justify-between">
                  <h3 class="font-extrabold text-sm">运营预警</h3>
                  <span class="text-[10px] font-black px-2 py-1 rounded-full bg-amber-50 text-amber-700">{{ alertList.length }}</span>
                </div>
                <p class="text-[11px] text-slate-400 mt-1">按紧急程度自动排序</p>
              </div>
              <div class="p-3 space-y-2 max-h-[385px] overflow-y-auto scrollbar">
                <button v-for="item in alertList.slice(0,7)" :key="item.id" @click="navigateTo('alerts')" class="w-full text-left p-3 rounded-xl border border-slate-100 hover:border-slate-200 hover:bg-slate-50 transition">
                  <div class="flex items-start gap-3">
                    <div class="w-8 h-8 rounded-lg flex items-center justify-center shrink-0" :class="alertStyle(item.typeKey).bg"><i :class="alertStyle(item.typeKey).icon" :class="alertStyle(item.typeKey).text"></i></div>
                    <div class="min-w-0 flex-1"><div class="font-bold text-xs truncate">{{ item.clientName }}</div><div class="text-[10px] text-slate-400 mt-1 truncate">{{ item.type }} · {{ item.typeKey==='AD_RECHARGE' ? item.balanceText : item.dueDate }}</div></div>
                    <span class="text-[10px] font-black whitespace-nowrap" :class="item.typeKey==='AD_RECHARGE'?'text-rose-600':item.daysLeft<0?'text-rose-600':item.daysLeft<=3?'text-amber-600':'text-slate-500'">{{ item.typeKey==='AD_RECHARGE' ? (item.balanceStage==='CRITICAL' ? '再次提醒' : '余额不足') : daysLeftLabel(item.daysLeft) }}</span>
                  </div>
                </button>
                <div v-if="!alertList.length" class="py-12 text-center text-xs text-slate-400"><i class="fa-regular fa-circle-check text-3xl text-emerald-500 block mb-2"></i>当前暂无到期或低余额事项</div>
              </div>
            </div>
          </div>
        </section>

        <!-- Clients -->
        <section v-else-if="currentPage==='clients'" key="clients" class="space-y-5">
          <div class="flex flex-col xl:flex-row xl:items-center justify-between gap-4">
            <div>
              <h2 class="text-2xl font-extrabold tracking-tight">客户管理</h2>
              <p class="text-xs text-slate-500 mt-1">统一管理客户资料、平台账号、合同周期和服务状态。</p>
            </div>
            <div class="flex flex-col sm:flex-row gap-2">
              <div class="relative"><i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i><input v-model="searchQuery" class="h-10 w-full sm:w-72 pl-9 pr-3 rounded-xl border border-slate-200 bg-white text-xs outline-none focus:ring-2 focus:ring-indigo-100 focus:border-indigo-400" placeholder="搜索客户 / 产品 / BM / BC / 广告账号" /></div>
              <select v-model="platformFilter" class="h-10 rounded-xl border border-slate-200 bg-white px-3 text-xs font-semibold outline-none"><option value="ALL">全部平台</option><option value="FB">Facebook</option><option value="TK">TikTok</option><option value="DUAL">FB + TK</option></select>
              <button @click="showArchivedClients=!showArchivedClients" type="button" class="h-10 px-3 rounded-xl border text-xs font-bold transition" :class="showArchivedClients?'border-slate-400 bg-slate-900 text-white':'border-slate-200 bg-white text-slate-600 hover:bg-slate-50'"><i class="fa-solid fa-box-archive mr-1.5"></i>{{ showArchivedClients?'隐藏归档':'查看归档' }}</button>
              <button @click="openClientForm()" class="h-10 px-4 rounded-xl bg-indigo-600 text-white text-xs font-bold"><i class="fa-solid fa-plus mr-1.5"></i>新增客户</button>
            </div>
          </div>

          <div class="bg-white border border-slate-200 rounded-2xl soft-shadow overflow-hidden">
            <div class="p-4 border-b border-slate-100 flex items-center justify-between"><div class="text-xs text-slate-500">共 <strong class="text-slate-900">{{ filteredClients.length }}</strong> 家客户</div><div class="text-[10px] text-slate-400">支持本地实时搜索与筛选</div></div>
            <div class="hidden md:block overflow-x-auto scrollbar">
              <table class="w-full min-w-[1100px] text-xs">
                <thead class="bg-slate-50 text-slate-500"><tr><th class="p-4 text-left">客户 / 产品</th><th class="p-4 text-left">平台</th><th class="p-4 text-left">项目 / 月服务费</th><th class="p-4 text-left">BM / BC</th><th class="p-4 text-left">广告账号</th><th class="p-4 text-left">合同到期</th><th class="p-4 text-left">状态</th><th class="p-4 text-right">操作</th></tr></thead>
                <tbody class="divide-y divide-slate-100">
                  <tr v-for="client in filteredClients" :key="client.id" class="hover:bg-slate-50/60">
                    <td class="p-4"><button @click="openClientDetail(client.id)" class="text-left"><div class="font-extrabold text-slate-900">{{ client.name }}</div><div class="text-[10px] text-slate-400 mt-1">{{ client.product }}</div></button></td>
                    <td class="p-4"><platform-badges :platform="client.platform"></platform-badges></td>
                    <td class="p-4"><div class="font-semibold">{{ client.project }}</div><div class="font-extrabold text-emerald-600 mt-1">{{ formatMoney(client.monthlyFee, client.currency) }}/月</div></td>
                    <td class="p-4 font-mono text-[11px]"><div v-if="client.fbBmId"><span class="text-slate-400">BM</span> {{ client.fbBmId }}</div><div v-if="client.tkBcId" class="mt-1"><span class="text-slate-400">BC</span> {{ client.tkBcId }}</div><span v-if="!client.fbBmId&&!client.tkBcId" class="text-slate-300">—</span></td>
                    <td class="p-4 font-mono text-[11px]"><div v-if="client.fbAdAccountId">{{ client.fbAdAccountId }}</div><div v-if="client.tkAdAccountId" class="mt-1">{{ client.tkAdAccountId }}</div><span v-if="!client.fbAdAccountId&&!client.tkAdAccountId" class="text-slate-300">—</span></td>
                    <td class="p-4"><div class="font-mono">{{ client.endDate }}</div><div class="text-[10px] font-semibold mt-1" :class="daysUntil(client.endDate)<=7?'text-amber-600':'text-slate-400'">{{ contractStatusText(client) }}</div></td>
                    <td class="p-4"><span class="inline-flex px-2 py-1 rounded-full text-[10px] font-bold" :class="client.archived?'bg-slate-200 text-slate-600':client.status==='ACTIVE'?'bg-emerald-50 text-emerald-700':'bg-slate-100 text-slate-600'">{{ client.archived?'已归档':(client.status==='ACTIVE'?'合作中':'暂停') }}</span></td>
                    <td class="p-4 text-right"><div class="flex justify-end gap-1"><button type="button" @click="openClientDetail(client.id)" class="h-8 px-2.5 rounded-lg bg-slate-100 text-slate-700 font-semibold">详情</button><button v-if="!client.archived" type="button" @click="openClientForm(client)" class="w-8 h-8 rounded-lg hover:bg-indigo-50 text-indigo-600" title="编辑客户"><i class="fa-solid fa-pen"></i></button><button v-if="!client.archived && canArchiveClients()" type="button" @click="archiveClient(client)" class="w-8 h-8 rounded-lg hover:bg-amber-50 text-amber-600" title="归档客户"><i class="fa-solid fa-box-archive"></i></button><button v-if="client.archived && canArchiveClients()" type="button" @click="restoreClient(client)" class="w-8 h-8 rounded-lg hover:bg-emerald-50 text-emerald-600" title="恢复客户"><i class="fa-solid fa-box-open"></i></button><button v-if="client.archived && currentUser?.role==='ADMIN'" type="button" @click="deleteClient(client)" class="w-8 h-8 rounded-lg hover:bg-rose-50 text-rose-500" title="永久删除归档客户"><i class="fa-regular fa-trash-can"></i></button></div></td>
                  </tr>
                </tbody>
              </table>
            </div>
            <div class="md:hidden p-3 space-y-3">
              <div v-for="client in filteredClients" :key="client.id" class="p-4 rounded-2xl border border-slate-200">
                <div class="flex justify-between gap-3"><div><div class="font-extrabold text-sm">{{ client.name }}</div><div class="text-[11px] text-slate-400 mt-1">{{ client.product }}</div></div><platform-badges :platform="client.platform"></platform-badges></div>
                <div class="grid grid-cols-2 gap-3 mt-4 text-[11px]"><div><div class="text-slate-400">月服务费</div><div class="font-bold mt-1">{{ formatMoney(client.monthlyFee,client.currency) }}</div></div><div><div class="text-slate-400">合同到期</div><div class="font-mono font-bold mt-1">{{ client.endDate }}</div></div></div>
                <button @click="openClientDetail(client.id)" class="w-full h-9 mt-4 rounded-xl bg-slate-950 text-white text-xs font-bold">查看客户详情</button>
              </div>
            </div>
          </div>
        </section>

        <!-- Client Detail -->
        <section v-else-if="currentPage==='client-detail' && selectedClient" key="client-detail" class="space-y-5">
          <div v-if="selectedClient.archived" class="rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 flex flex-col sm:flex-row sm:items-center justify-between gap-3"><div><div class="text-xs font-extrabold text-slate-700"><i class="fa-solid fa-box-archive mr-1.5"></i>该客户已归档</div><div class="text-[10px] text-slate-400 mt-1">历史广告、财务、开户与回款数据仍完整保留，不参与当前运营预警。</div></div><button v-if="canArchiveClients()" type="button" @click="restoreClient(selectedClient)" class="h-8 px-3 rounded-lg bg-emerald-600 text-white text-[10px] font-bold">恢复客户</button></div>
          <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
            <div class="flex items-start gap-3"><button @click="navigateTo('clients')" class="w-10 h-10 rounded-xl border border-slate-200 bg-white"><i class="fa-solid fa-arrow-left"></i></button><div><div class="flex items-center gap-2 flex-wrap"><h2 class="text-2xl font-extrabold tracking-tight">{{ selectedClient.name }}</h2><platform-badges :platform="selectedClient.platform"></platform-badges></div><p class="text-xs text-slate-500 mt-1">{{ selectedClient.product }} · {{ selectedClient.project }}</p></div></div>
            <div class="flex gap-2 flex-wrap"><button v-if="!selectedClient.archived" type="button" @click="openClientForm(selectedClient)" class="h-10 px-4 rounded-xl border border-slate-200 bg-white text-xs font-bold"><i class="fa-solid fa-pen mr-1.5"></i>编辑资料</button><button v-if="!selectedClient.archived && canArchiveClients()" type="button" @click="archiveClient(selectedClient)" class="h-10 px-4 rounded-xl border border-amber-200 bg-amber-50 text-amber-700 text-xs font-bold"><i class="fa-solid fa-box-archive mr-1.5"></i>归档</button><button v-if="!selectedClient.archived" type="button" @click="selectedSopClientId=selectedClient.id; navigateTo('sop')" class="h-10 px-4 rounded-xl bg-slate-950 text-white text-xs font-bold"><i class="fa-solid fa-list-check mr-1.5"></i>执行 SOP</button></div>
          </div>

          <div class="grid grid-cols-2 xl:grid-cols-4 gap-3">
            <div class="bg-white border border-slate-200 rounded-2xl p-4"><div class="text-[11px] text-slate-400">月服务费</div><div class="text-xl font-extrabold text-emerald-600 mt-2">{{ formatMoney(selectedClient.monthlyFee, selectedClient.currency) }}</div><div class="text-[10px] text-slate-400 mt-1">{{ billingModeText(selectedClient.billingMode) }}</div></div>
            <div class="bg-white border border-slate-200 rounded-2xl p-4"><div class="text-[11px] text-slate-400">合同周期</div><div class="text-sm font-bold mt-2">{{ selectedClient.startDate }} → {{ selectedClient.endDate }}</div></div>
            <div class="bg-white border border-slate-200 rounded-2xl p-4"><div class="text-[11px] text-slate-400">付款到期日</div><div class="text-xl font-extrabold text-amber-600 mt-2">每月 {{ selectedClient.renewalAlertDay }} 号</div></div>
            <div class="bg-white border border-slate-200 rounded-2xl p-4"><div class="text-[11px] text-slate-400">合作状态</div><div class="mt-2"><span class="inline-flex px-2.5 py-1 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700">合作中</span></div></div>
          </div>

          <div class="grid grid-cols-1 xl:grid-cols-3 gap-5">
            <div class="xl:col-span-2 space-y-5">
              <div class="bg-white border border-slate-200 rounded-2xl soft-shadow overflow-hidden">
                <div class="p-5 border-b border-slate-100 flex items-center justify-between"><div><h3 class="font-extrabold text-sm">平台资产与账号</h3><p class="text-[11px] text-slate-400 mt-1">BM / BC / 广告账号 / 登录资料集中归档；费用数据在投放分析维护</p></div><button v-if="canViewCredentials()" @click="credentialsVisible=!credentialsVisible" class="text-xs font-semibold text-indigo-600"><i :class="credentialsVisible?'fa-regular fa-eye-slash':'fa-regular fa-eye'" class="mr-1"></i>{{ credentialsVisible?'隐藏登录资料':'查看登录资料' }}</button><span v-else class="text-[10px] font-bold text-slate-400"><i class="fa-solid fa-lock mr-1"></i>登录凭证仅管理员 / 运营可见</span></div>
                <div class="p-5 grid grid-cols-1 md:grid-cols-2 gap-4">
                  <div v-if="selectedClient.platform.includes('FB') || (selectedClient.fbAccounts || []).length" class="rounded-2xl border border-blue-100 bg-blue-50/40 p-4">
                    <div class="flex items-center justify-between gap-3 flex-wrap">
                      <div class="flex items-center gap-2 font-extrabold text-sm text-blue-900"><i class="fa-brands fa-facebook text-blue-600"></i>Facebook</div>
                      <div class="flex items-center gap-2 flex-wrap justify-end">
                        <span class="text-[10px] font-bold bg-white text-blue-700 border border-blue-100 px-2 py-1 rounded-full">{{ (selectedClient.fbAccounts || []).length }} 个账号</span>
                        <div v-if="(selectedClient.fbAccounts || []).length>1" class="inline-flex items-center gap-1.5">
                          <select :value="clampedAssetPagerIndex('detail','FB',(selectedClient.fbAccounts||[]).length)" @change="setAssetPagerIndex('detail','FB',$event.target.value,(selectedClient.fbAccounts||[]).length)" class="h-7 max-w-[150px] rounded-lg border border-blue-100 bg-white px-2 text-[10px] font-bold text-blue-700 outline-none focus:ring-2 focus:ring-blue-100" tit