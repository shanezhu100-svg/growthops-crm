le="直接选择 Facebook 账号"><option v-for="(a,i) in (selectedClient.fbAccounts||[])" :key="a.id || i" :value="i">{{ a.accountName || `Facebook 账号 ${i+1}` }}</option></select>
                          <button type="button" @click="changeAssetPager('detail','FB',-1,(selectedClient.fbAccounts||[]).length)" class="w-7 h-7 rounded-lg border border-blue-100 bg-white text-blue-700 disabled:opacity-40" :disabled="clampedAssetPagerIndex('detail','FB',(selectedClient.fbAccounts||[]).length)===0"><i class="fa-solid fa-chevron-left text-[10px]"></i></button>
                          <span class="text-[10px] font-bold text-blue-700 min-w-[52px] text-center">{{ clampedAssetPagerIndex('detail','FB',(selectedClient.fbAccounts||[]).length)+1 }} / {{ (selectedClient.fbAccounts || []).length }}</span>
                          <button type="button" @click="changeAssetPager('detail','FB',1,(selectedClient.fbAccounts||[]).length)" class="w-7 h-7 rounded-lg border border-blue-100 bg-white text-blue-700 disabled:opacity-40" :disabled="clampedAssetPagerIndex('detail','FB',(selectedClient.fbAccounts||[]).length)>=(selectedClient.fbAccounts||[]).length-1"><i class="fa-solid fa-chevron-right text-[10px]"></i></button>
                        </div>
                      </div>
                    </div>
                    <div v-if="selectedClient.fbAccounts && selectedClient.fbAccounts.length" class="mt-4 space-y-3">
                      <template v-for="(account,idx) in [getPagedItem(selectedClient.fbAccounts,'detail','FB')]" :key="account?.id || 'fb-single'">
                        <div v-if="account" class="rounded-xl bg-white border border-blue-100 p-3.5">
                          <div class="flex items-center justify-between mb-3"><span class="text-[10px] font-extrabold text-blue-700">{{ account.accountName || `Facebook 账号 ${clampedAssetPagerIndex('detail','FB',(selectedClient.fbAccounts||[]).length) + 1}` }}</span><span class="text-[10px] text-slate-400 font-mono">{{ account.adAccountId || '未录入广告账号' }}</span></div>
                          <div class="space-y-2.5 text-xs"><info-row label="账号名称" :value="account.accountName || `Facebook 账号 ${clampedAssetPagerIndex('detail','FB',(selectedClient.fbAccounts||[]).length) + 1}`"></info-row><info-row label="BM ID" :value="account.bmId"></info-row><info-row label="广告账号" :value="account.adAccountId"></info-row><info-row label="返点类型" :value="accountRebateModeText(account)"></info-row><template v-if="canViewCredentials()"><info-row label="登录账号" :value="credentialsVisible?account.loginAccount:'••••••••'"></info-row><info-row label="密码 / 2FA" :value="credentialsVisible?account.loginPassword:'••••••••'"></info-row></template></div>
                        </div>
                      </template>
                    </div>
                    <div v-else class="mt-4 rounded-xl bg-white border border-dashed border-blue-200 p-5 text-center text-[11px] text-slate-400">暂未添加 Facebook 账号</div>
                  </div>
                  <div v-if="selectedClient.platform.includes('TK') || (selectedClient.tkAccounts || []).length" class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
                    <div class="flex items-center justify-between gap-3 flex-wrap">
                      <div class="flex items-center gap-2 font-extrabold text-sm"><i class="fa-brands fa-tiktok"></i>TikTok</div>
                      <div class="flex items-center gap-2 flex-wrap justify-end">
                        <span class="text-[10px] font-bold bg-white text-slate-700 border border-slate-200 px-2 py-1 rounded-full">{{ (selectedClient.tkAccounts || []).length }} 个账号</span>
                        <div v-if="(selectedClient.tkAccounts || []).length>1" class="inline-flex items-center gap-1.5">
                          <select :value="clampedAssetPagerIndex('detail','TK',(selectedClient.tkAccounts||[]).length)" @change="setAssetPagerIndex('detail','TK',$event.target.value,(selectedClient.tkAccounts||[]).length)" class="h-7 max-w-[150px] rounded-lg border border-slate-200 bg-white px-2 text-[10px] font-bold text-slate-700 outline-none focus:ring-2 focus:ring-slate-100" title="直接选择 TikTok 账号"><option v-for="(a,i) in (selectedClient.tkAccounts||[])" :key="a.id || i" :value="i">{{ a.accountName || `TikTok 账号 ${i+1}` }}</option></select>
                          <button type="button" @click="changeAssetPager('detail','TK',-1,(selectedClient.tkAccounts||[]).length)" class="w-7 h-7 rounded-lg border border-slate-200 bg-white text-slate-700 disabled:opacity-40" :disabled="clampedAssetPagerIndex('detail','TK',(selectedClient.tkAccounts||[]).length)===0"><i class="fa-solid fa-chevron-left text-[10px]"></i></button>
                          <span class="text-[10px] font-bold text-slate-700 min-w-[52px] text-center">{{ clampedAssetPagerIndex('detail','TK',(selectedClient.tkAccounts||[]).length)+1 }} / {{ (selectedClient.tkAccounts || []).length }}</span>
                          <button type="button" @click="changeAssetPager('detail','TK',1,(selectedClient.tkAccounts||[]).length)" class="w-7 h-7 rounded-lg border border-slate-200 bg-white text-slate-700 disabled:opacity-40" :disabled="clampedAssetPagerIndex('detail','TK',(selectedClient.tkAccounts||[]).length)>=(selectedClient.tkAccounts||[]).length-1"><i class="fa-solid fa-chevron-right text-[10px]"></i></button>
                        </div>
                      </div>
                    </div>
                    <div v-if="selectedClient.tkAccounts && selectedClient.tkAccounts.length" class="mt-4 space-y-3">
                      <template v-for="(account,idx) in [getPagedItem(selectedClient.tkAccounts,'detail','TK')]" :key="account?.id || 'tk-single'">
                        <div v-if="account" class="rounded-xl bg-white border border-slate-200 p-3.5">
                          <div class="flex items-center justify-between mb-3"><span class="text-[10px] font-extrabold text-slate-700">{{ account.accountName || `TikTok 账号 ${clampedAssetPagerIndex('detail','TK',(selectedClient.tkAccounts||[]).length) + 1}` }}</span><span class="text-[10px] text-slate-400 font-mono">{{ account.adAccountId || '未录入广告账号' }}</span></div>
                          <div class="space-y-2.5 text-xs"><info-row label="账号名称" :value="account.accountName || `TikTok 账号 ${clampedAssetPagerIndex('detail','TK',(selectedClient.tkAccounts||[]).length) + 1}`"></info-row><info-row label="BC ID" :value="account.bcId"></info-row><info-row label="广告账号" :value="account.adAccountId"></info-row><info-row label="返点类型" :value="accountRebateModeText(account)"></info-row><template v-if="canViewCredentials()"><info-row label="登录账号" :value="credentialsVisible?account.loginAccount:'••••••••'"></info-row><info-row label="密码 / 2FA" :value="credentialsVisible?account.loginPassword:'••••••••'"></info-row></template></div>
                        </div>
                      </template>
                    </div>
                    <div v-else class="mt-4 rounded-xl bg-white border border-dashed border-slate-300 p-5 text-center text-[11px] text-slate-400">暂未添加 TikTok 账号</div>
                  </div>
                </div>
              </div>

              <div class="bg-white border border-slate-200 rounded-2xl soft-shadow overflow-hidden">
                <div class="p-5 border-b border-slate-100"><h3 class="font-extrabold text-sm">合同续费记录</h3><p class="text-[11px] text-slate-400 mt-1">从预警页执行续费后会自动写入记录</p></div>
                <div class="p-5">
                  <div v-if="selectedClient.renewalHistory && selectedClient.renewalHistory.length" class="space-y-3">
                    <div v-for="(record,idx) in selectedClient.renewalHistory" :key="idx" class="flex gap-3 p-3 rounded-xl bg-slate-50 border border-slate-100"><div class="w-8 h-8 shrink-0 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center"><i class="fa-solid fa-check"></i></div><div><div class="text-xs font-bold">{{ record.note }}</div><div class="text-[10px] text-slate-400 mt-1">{{ record.date }} · 新到期日 {{ record.newEndDate }}</div></div></div>
                  </div>
                  <div v-else class="text-center py-8 text-xs text-slate-400">暂无续费历史</div>
                </div>
              </div>
            </div>

            <div class="space-y-5">
              <div class="bg-white border border-slate-200 rounded-2xl soft-shadow p-5">
                <div class="flex items-center justify-between gap-3"><h3 class="font-extrabold text-sm">网络与环境</h3><span class="text-[10px] font-bold bg-emerald-50 text-emerald-700 px-2 py-1 rounded-full">{{ (selectedClient.networkEnvironments || []).length }} 个环境</span></div>
                <div v-if="selectedClient.networkEnvironments && selectedClient.networkEnvironments.length" class="mt-4 space-y-3">
                  <div v-for="(env,idx) in selectedClient.networkEnvironments" :key="env.id || idx" class="rounded-xl bg-slate-50 border border-slate-100 p-3.5">
                    <div class="flex items-center justify-between mb-3"><span class="text-[10px] font-extrabold text-slate-700">网络环境 {{ idx + 1 }}</span><span class="text-[10px] text-slate-400 font-mono">{{ env.ipEnvironment || '未录入 Profile' }}</span></div>
                    <div class="space-y-2.5 text-xs"><info-row label="网络环境" :value="env.networkName"></info-row><info-row label="指纹 Profile" :value="env.ipEnvironment"></info-row><info-row label="IP 到期" :value="env.ipDueDate"></info-row><info-row label="IP 月费" :value="env.ipMonthlyFee ? formatMoney(env.ipMonthlyFee, env.ipCurrency) + '/月' : '—'"></info-row></div>
                  </div>
                </div>
                <div v-else class="mt-4 rounded-xl bg-slate-50 border border-dashed border-slate-300 p-5 text-center text-[11px] text-slate-400">暂未添加网络环境</div>
              </div>
              <div class="bg-slate-950 text-white rounded-2xl soft-shadow p-5"><div class="text-[11px] text-slate-400">当前账户风险规则</div><p class="text-xs leading-relaxed text-slate-200 mt-3">{{ selectedClient.riskRules || '暂无单独风控规则。' }}</p></div>
            </div>
          </div>
        </section>
