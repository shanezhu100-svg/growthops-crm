 <div v-else class="mt-4 rounded-xl bg-slate-50 border border-dashed border-slate-300 p-5 text-center text-[11px] text-slate-400">暂未添加网络环境</div>
              </div>
              <div class="bg-slate-950 text-white rounded-2xl soft-shadow p-5"><div class="text-[11px] text-slate-400">当前账户风险规则</div><p class="text-xs leading-relaxed text-slate-200 mt-3">{{ selectedClient.riskRules || '暂无单独风控规则。' }}</p></div>
            </div>
          </div>
        </section>

        <!-- Alerts -->
        <section v-else-if="currentPage==='alerts'" key="alerts" class="space-y-5">
          <div class="flex flex-col xl:flex-row xl:items-center justify-between gap-4"><div><h2 class="text-2xl font-extrabold tracking-tight">提醒中心</h2><p class="text-xs text-slate-500 mt-1">统一汇总合同、IP、收入应收回款与广告账户低余额提醒，并支持独立添加提醒。</p></div><div class="flex gap-2 flex-wrap"><button v-if="activeDismissedAlertCount" type="button" @click="restoreDismissedAlerts" class="h-10 px-4 rounded-xl border border-amber-200 bg-amber-50 text-amber-700 text-xs font-bold"><i class="fa-solid fa-rotate-left mr-1.5"></i>恢复已忽略 {{ activeDismissedAlertCount }}</button><button @click="showAddAlertModal=true" class="h-10 px-4 rounded-xl border border-slate-200 bg-white text-xs font-bold"><i class="fa-solid fa-plus mr-1.5"></i>独立提醒</button><button @click="copyNoticeSummary" class="h-10 px-4 rounded-xl bg-slate-950 text-white text-xs font-bold"><i class="fa-regular fa-copy mr-1.5"></i>复制汇总</button></div></div>
          <div class="flex flex-wrap gap-2"><button v-for="f in alertFilters" :key="f.key" @click="alertTypeFilter=f.key" class="h-9 px-3 rounded-xl text-xs font-bold border transition" :class="alertTypeFilter===f.key?'bg-slate-950 text-white border-slate-950':'bg-white text-slate-600 border-slate-200'">{{ f.label }} <span class="ml-1 opacity-70">{{ f.count }}</span></button></div>
          <div v-if="filteredAlerts.length" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
            <div v-for="item in filteredAlerts" :key="item.id" class="bg-white border border-slate-200 rounded-2xl p-5 soft-shadow">
              <div class="flex items-start justify-between gap-3"><div class="flex items-center gap-2"><div class="w-9 h-9 rounded-xl flex items-center justify-center" :class="alertStyle(item.typeKey).bg"><i :class="alertStyle(item.typeKey).icon" class="text-sm" :class="alertStyle(item.typeKey).text"></i></div><div><div class="text-[10px] text-slate-400">{{ item.type }}</div><div class="font-extrabold text-sm mt-0.5">{{ item.clientName }}</div></div></div><span class="text-[10px] font-black px-2 py-1 rounded-full" :class="item.typeKey==='AD_RECHARGE' ? (item.balanceStage==='CRITICAL'?'bg-red-100 text-red-700':'bg-rose-50 text-rose-600') : item.daysLeft<0?'bg-rose-50 text-rose-600':item.daysLeft<=3?'bg-amber-50 text-amber-700':'bg-slate-100 text-slate-600'">{{ item.typeKey==='AD_RECHARGE' ? (item.balanceStage==='CRITICAL' ? '再次提醒 · ≤ $30' : '首次提醒 · ≤ $100') : daysLeftLabel(item.daysLeft) }}</span></div>
              <div v-if="item.typeKey==='AD_RECHARGE'" class="mt-5 p-3.5 rounded-xl border space-y-2.5 text-xs" :class="item.balanceStage==='CRITICAL'?'bg-red-50/70 border-red-200':'bg-rose-50/50 border-rose-100'"><div class="flex justify-between gap-3"><span class="text-slate-500">当前 USD 余额</span><span class="font-black" :class="item.balanceStage==='CRITICAL'?'text-red-700':'text-rose-600'">{{ item.balanceText }}</span></div><div class="flex justify-between gap-3"><span class="text-slate-500">当前提醒阶段</span><span class="font-bold" :class="item.balanceStage==='CRITICAL'?'text-red-700':'text-amber-700'">{{ item.balanceStage==='CRITICAL' ? '二次紧急提醒 · ≤ $30' : '首次低余额提醒 · ≤ $100' }}</span></div><div class="flex justify-between gap-3"><span class="text-slate-500">广告账户</span><span class="font-semibold text-right truncate max-w-[180px]">{{ item.target || '—' }}</span></div></div>
              <div v-else class="mt-5 p-3.5 rounded-xl bg-slate-50 border border-slate-100 space-y-2.5 text-xs"><div class="flex justify-between gap-3"><span class="text-slate-400">到期日期</span><span class="font-mono font-bold">{{ item.dueDate }}</span></div><div class="flex justify-between gap-3"><span class="text-slate-400">费用</span><span class="font-bold text-amber-600 text-right">{{ item.cost || '—' }}</span></div><div class="flex justify-between gap-3"><span class="text-slate-400">{{ item.typeKey==='CONTRACT' ? '产品 / 服务' : item.typeKey==='RECEIVABLE' ? '账单 / 已收' : '环境 / 平台' }}</span><span class="font-semibold text-right truncate max-w-[180px]">{{ item.target || '—' }}</span></div></div>
              <div class="mt-4 flex flex-wrap gap-2"><button @click="copyIndividualNotice(item)" class="flex-1 min-w-[110px] h-9 rounded-xl border border-slate-200 text-xs font-semibold hover:bg-slate-50 transition"><i class="fa-regular fa-copy mr-1"></i>提醒文案</button><button @click="handleAlertComplete(item)" class="flex-1 min-w-[110px] h-9 rounded-xl bg-emerald-600 text-white text-xs font-bold"><i class="fa-solid fa-check mr-1"></i>{{ item.typeKey==='AD_RECHARGE'?'登记充值':item.typeKey==='RECEIVABLE'?'登记回款':'完成续费' }}</button><button v-if="item.typeKey!=='AD_RECHARGE'" type="button" @click="deleteAlert(item)" class="w-9 h-9 rounded-xl bg-slate-100 text-slate-500 hover:bg-amber-50 hover:text-amber-600" :title="item.isStandalone?'删除独立提醒':'忽略本次提醒'"><i :class="item.isStandalone?'fa-regular fa-trash-can':'fa-regular fa-eye-slash'"></i></button></div>
            </div>
          </div>
          <div v-else class="bg-white border border-slate-200 rounded-2xl py-16 text-center text-xs text-slate-400"><i class="fa-regular fa-circle-check text-4xl text-emerald-500 block mb-3"></i>当前筛选下没有需要处理的预警</div>
        </section>

        <!-- Assets -->
        <section v-else-if="currentPage==='assets'" key="assets" class="space-y-5">
          <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-4">
            <div>
              <h2 class="text-2xl font-extrabold tracking-tight">账号与商业资产</h2>
              <p class="text-xs text-slate-500 mt-1">按客户独立管理 Facebook、TikTok、Google、Instagram 账号资产与登录资料。</p>
            </div>
            <div class="flex flex-col sm:flex-row sm:items-center gap-2">
              <div class="text-[11px] font-bold text-slate-500 sm:mr-1">当前客户</div>
              <select v-model.number="selectedAssetsClientId" class="h-10 min-w-[240px] rounded-xl border border-slate-200 bg-white px-3 text-xs font-bold text-slate-800 outline-none focus:ring-2 focus:ring-indigo-100 focus:border-indigo-400">
                <option v-for="c in clients" :key="c.id" :value="c.id">{{ c.name }}</option>
              </select>
              <button v-if="selectedAssetsClient" @click="openClientDetail(selectedAssetsClient.id)" class="h-10 px-4 rounded-xl border border-slate-200 bg-white text-xs font-bold hover:bg-slate-50 transition">
                <i class="fa-regular fa-folder-open mr-1.5"></i>客户详情
              </button>
            </div>
          </div>

          <div class="bg-white border border-slate-200 rounded-2xl soft-shadow p-3.5 sm:p-4 relative z-20">
            <div class="flex flex-col xl:flex-row xl:items-center gap-3 xl:gap-4">
              <div class="flex items-center gap-3 shrink-0 xl:w-[245px]">
                <div class="w-10 h-10 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center border border-indigo-100 shrink-0">
                  <i class="fa-solid fa-magnifying-glass text-sm"></i>
                </div>
                <div class="min-w-0">
                  <div class="text-xs font-extrabold text-slate-900">资产全局搜索</div>
                  <div class="text-[10px] text-slate-400 mt-0.5 whitespace-nowrap">快速定位客户与平台账号资产</div>
                </div>
              </div>

              <div class="relative flex-1 min-w-0">
                <div class="relative">
                  <i class="fa-solid fa-magnifying-glass absolute left-4 top-1/2 -translate-y-1/2 text-indigo-400 text-xs pointer-events-none"></i>
                  <input v-model="globalSearchQuery" @focus="globalSearchOpen=true" @input="globalSearchOpen=true" @keydown.enter.prevent="openFirstGlobalSearchResult" @keydown.esc="globalSearchOpen=false" @blur="setTimeout(()=>globalSearchOpen=false,180)" type="search" class="h-12 w-full rounded-xl border border-slate-200 bg-slate-50/70 pl-11 pr-4 text-xs font-semibold text-slate-800 outline-none transition focus:border-indigo-300 focus:bg-white focus:ring-4 focus:ring-indigo-50" placeholder="搜索客户、广告账号、BM / BC、Google Ads、MCC、Instagram…" />
                </div>
                <div v-if="globalSearchOpen && globalSearchQuery.trim()" class="absolute left-0 right-0 top-full z-[90] mt-2 rounded-2xl border border-slate-200 bg-white shadow-2xl overflow-hidden">
                  <div class="px-3.5 py-2.5 border-b border-slate-100 bg-slate-50/80 flex items-center justify-between gap-2"><span class="text-[10px] font-extrabold text-slate-600">资产搜索结果</span><span class="text-[9px] font-bold text-indigo-500 bg-indigo-50 px-2 py-0.5 rounded-full">{{ globalSearchResults.length }} 条</span></div>
                  <div v-if="globalSearchResults.length" class="max-h-80 overflow-y-auto scrollbar p-1.5">
                    <button v-for="result in globalSearchResults" :key="result.key" type="button" @mousedown.prevent="openGlobalSearchResult(result)" class="w-full rounded-xl px-3 py-2.5 text-left hover:bg-indigo-50 transition flex items-start gap-3">
                      <span class="mt-0.5 w-8 h-8 rounded-lg flex items-center justify-center shrink-0" :class="globalSearchResultIconClass(result)"><i :class="globalSearchResultIcon(result)"></i></span>
                      <span class="min-w-0 flex-1"><span class="block text-xs font-extrabold truncate">{{ result.title }}</span><span class="block text-[10px] text-slate-400 mt-0.5 truncate">{{ result.subtitle }}</span><span v-if="result.matchLabel" class="inline-flex mt-1 px-1.5 py-0.5 rounded-md bg-slate-100 text-[9px] font-bold text-slate-500">{{ result.matchLabel }} · {{ result.matchValue }}</span></span>
                      <i class="fa-solid fa-arrow-right text-[9px] text-slate-300 mt-2"></i>
                    </button>
                  </div>
                  <div v-else class="px-4 py-8 text-center text-xs text-slate-400">没有找到匹配的客户或账号资产</div>
                </div>
              </div>
