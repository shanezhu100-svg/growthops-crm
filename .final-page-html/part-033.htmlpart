 '••••••••••••' : '未录入') }}</div></div>
                    </div>
                  </div>
                  </template>
                </div>
                <div v-else class="py-14 px-5 text-center text-xs text-slate-400"><i class="fa-brands fa-facebook text-3xl text-slate-200 block mb-3"></i>当前客户暂无 Facebook 账号资产</div>
              </div>

              <div class="bg-white border border-slate-200 rounded-2xl soft-shadow overflow-hidden">
                <div class="p-5 border-b border-slate-100 flex items-center justify-between gap-3 flex-wrap">
                  <div class="font-extrabold text-sm flex items-center gap-2"><i class="fa-brands fa-tiktok"></i>TikTok 资产</div>
                  <div class="flex items-center gap-2 flex-wrap justify-end"><span class="text-[10px] font-bold bg-slate-100 text-slate-700 px-2 py-1 rounded-full">{{ (selectedAssetsClient.tkAccounts || []).length }} 个账号</span><div v-if="(selectedAssetsClient.tkAccounts || []).length>1" class="inline-flex items-center gap-1.5"><select :value="clampedAssetPagerIndex('assets','TK',(selectedAssetsClient.tkAccounts||[]).length)" @change="setAssetPagerIndex('assets','TK',$event.target.value,(selectedAssetsClient.tkAccounts||[]).length)" class="h-7 max-w-[150px] rounded-lg border border-slate-200 bg-white px-2 text-[10px] font-bold text-slate-700 outline-none focus:ring-2 focus:ring-slate-100" title="直接选择 TikTok 账号"><option v-for="(a,i) in (selectedAssetsClient.tkAccounts||[])" :key="a.id || i" :value="i">{{ a.accountName || `TikTok 账号 ${i+1}` }}</option></select><button type="button" @click="changeAssetPager('assets','TK',-1,(selectedAssetsClient.tkAccounts||[]).length)" class="w-7 h-7 rounded-lg border border-slate-200 bg-white text-slate-700 disabled:opacity-40" :disabled="clampedAssetPagerIndex('assets','TK',(selectedAssetsClient.tkAccounts||[]).length)===0"><i class="fa-solid fa-chevron-left text-[10px]"></i></button><span class="text-[10px] font-bold text-slate-700 min-w-[52px] text-center">{{ clampedAssetPagerIndex('assets','TK',(selectedAssetsClient.tkAccounts||[]).length)+1 }} / {{ (selectedAssetsClient.tkAccounts || []).length }}</span><button type="button" @click="changeAssetPager('assets','TK',1,(selectedAssetsClient.tkAccounts||[]).length)" class="w-7 h-7 rounded-lg border border-slate-200 bg-white text-slate-700 disabled:opacity-40" :disabled="clampedAssetPagerIndex('assets','TK',(selectedAssetsClient.tkAccounts||[]).length)>=(selectedAssetsClient.tkAccounts||[]).length-1"><i class="fa-solid fa-chevron-right text-[10px]"></i></button></div></div>
                </div>
                <div v-if="selectedAssetsClient.tkAccounts && selectedAssetsClient.tkAccounts.length" class="p-4 space-y-3">
                  <template v-for="(account,idx) in [getPagedItem(selectedAssetsClient.tkAccounts,'assets','TK')]" :key="account?.id || 'assets-tk'">
                  <div v-if="account" class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
                    <div class="flex items-center justify-between mb-3"><div><div class="text-xs font-extrabold text-slate-900">{{ account.accountName || `TikTok 账号 ${clampedAssetPagerIndex('assets','TK',(selectedAssetsClient.tkAccounts||[]).length)+1}` }}</div><div class="text-[10px] text-slate-400 mt-0.5">TikTok 账号 {{ clampedAssetPagerIndex('assets','TK',(selectedAssetsClient.tkAccounts||[]).length)+1 }}</div></div><span class="text-[10px] font-bold text-slate-700 bg-white border border-slate-200 px-2 py-1 rounded-full">TK</span></div>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                      <div class="rounded-xl bg-white border border-slate-100 p-3 sm:col-span-2"><div class="text-[10px] text-slate-400">账号名称</div><div class="text-xs font-extrabold text-slate-900 mt-1 break-all">{{ account.accountName || `TikTok 账号 ${clampedAssetPagerIndex('assets','TK',(selectedAssetsClient.tkAccounts||[]).length)+1}` }}</div></div>
                      <div class="rounded-xl bg-white border border-slate-100 p-3"><div class="text-[10px] text-slate-400">BC ID</div><div class="font-mono text-xs font-bold mt-1 break-all select-all">{{ account.bcId || '未录入' }}</div></div>
                      <div class="rounded-xl bg-white border border-slate-100 p-3"><div class="text-[10px] text-slate-400">广告账号 ID</div><div class="font-mono text-xs font-bold mt-1 break-all select-all">{{ account.adAccountId || '未录入' }}</div></div>
                      <div class="rounded-xl bg-white border border-slate-100 p-3"><div class="text-[10px] text-slate-400">登录账号</div><div class="font-mono text-xs mt-1 break-all select-all">{{ credentialsVisible ? (account.loginAccount || '未录入') : (account.loginAccount ? maskAccount(account.loginAccount) : '未录入') }}</div></div>
          