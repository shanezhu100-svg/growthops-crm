    const objectKeys=['financeMonthLocks','financeMonthSnapshots','sopProgress'];
    const required=[...arrayKeys,...objectKeys,'exportedAt'];
    const missing=required.filter(k=>!(k in p));if(missing.length)throw new Error(`备份缺少顶层字段：${missing.join('、')}`);
    for(const k of arrayKeys)if(!Array.isArray(p[k]))throw new Error(`${k} 必须是数组`);
