clients:arr(p.clients).length,leads:arr(p.leads).length,opening:arr(p.openingDeals).length,receivables:arr(p.financeReceivables).length,costs:arr(p.financeCosts).length};
    return `导入会覆盖当前业务数据。\n客户 ${before.clients} → ${after.clients}\n线索 ${before.leads} → ${after.leads}\n开户记录 ${before.opening} → ${after.opening}\n收入/应收 ${before.receivables} → ${after.receivables}\n成本 ${before.costs} → ${after.costs}\n系统会先创建保护快照；服务器登录账号与权限不会被备份覆盖。`;
  }

  function wrap(vm,name,fn){const old=vm[name];if(typeof old!=='function'||old.__p0)return false;const w=function(...args){return fn.call(this,old.bind(this),...args)};w.__p0=true;w.__p0Original=old;vm[name]=w;return true}

