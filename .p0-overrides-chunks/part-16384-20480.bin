      if(financeChanged&&(confirmedReconciliationForRecord(this,client,account,editing)||confirmedReconciliationForRecord(this,client,account,targetFinance))){notify(this,'该广告消耗已进入已确认返点对账，不能新增、移动或修改消耗金额/币种；如需调整请先处理对应返点对账');return}
