      if(targetMonth&&locked(this,targetMonth)){notify(this,`${targetMonth} 已月结锁定，不能保存广告数据`);return}
      const identity=[this.adDataForm?.date||'',this.adDataForm?.campaignId||'',this.adDataForm?.adSetId||'',this.adDataForm?.adId||''].join('|');
      const collision=arr(account.adDataRecords).find(r=>sid(r.id)!==sid(editing?.id)&&[r.date||'',r.campaignId||'',r.adSetId||'',r.adId||''].join('|')===identity);
      if(collision){notify(this,'该日期 / 广告系列 / 广告组 / 广告组合已存在记录，请编辑现有记录，已阻止覆盖其他历史数据');return}
      const targetFinance={date:this.adDataForm?.date||this.localDateKey?.()||localToday(this),currency:this.adDataForm?.currency||account.adSpendCurrency||'USD',spend:num(this.adDataForm?.spend)};
