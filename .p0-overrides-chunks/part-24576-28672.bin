(sid(f[k])!==sid(prev[k])){notify(this,`已有历史消耗，不能修改历史归属字段：${k}`);return}const last=dates[dates.length-1];if(f.effectiveEndDate&&String(f.effectiveEndDate)<last){notify(this,`渠道结束日期不能早于最后历史消耗日 ${last}`);return}}}return old()});
    wrap(vm,'removeContactRebatePolicy',function(old,contact,index){const providerId=this.providerForm?.id,policy=arr(contact?.rebatePolicies)[index];if(providerId&&policy){const dates=providerUsedDates(this,providerId,contact.id);if(dates.some(d=>sid(policyForDate(contact.rebatePolicies,d)?.id)===sid(policy.id))){notify(this,'该返点政策已用于历史消耗，不能删除；请新增未来生效政策');return}}return old(contact,index)});
    wrap(vm,'removeProviderContact',function(old,index,contact){const providerId=this.providerForm?.id;if(providerId&&providerUsedDates(this,providerId,contact?.id).length){notify(this,'该对接人已有历史消耗/返点或月结记录，不能删除');return}return old(index,contact)});
    wrap(vm,'saveOpeningProvider',function(old){
      const oldP=arr(this.openingProviders).find(p=>sid(p.id)===sid(this.providerForm?.id));if(oldP){for(const oldC of arr(oldP.contacts)){const used=providerUsedDates(this,oldP.id,oldC.id);if(!used.length)continue;const newC=arr(this.providerForm?.contacts).find(c=>sid(c.id)===sid(oldC.id));if(!newC){notify(this,`对接人【${oldC.name||oldC.id}】已有历史归属，不能删除`);return}const last=used[used.length-1];for(const d of used){const before=policyForDate(oldC.rebatePolicies,d),after=policyForDate(newC.rebatePolicies,d);if(!samePolicy(before,after)){notify(this,`返点政策变更会改写 ${d} 的历史归属，已阻止；请仅新增未来生效政策`);return}}for(const op of arr(oldC.rebatePolicies)){const usedBy=used.some(d=>sid(policyForDate(oldC.rebatePolicies,d)?.id)===sid(op.id));if(!usedBy)continue;const np=arr(newC.rebatePolicies).find(p=>sid(p.id)===sid(op.id));if(!np||!samePolicy(op,np)){notify(this,`返点政策 ${op.effectiveDate||''} 已用于历史消耗，不能修改或删除`);return}}
          for(const np of arr(newC.rebatePolicies)){if(!arr(oldC.rebatePolicies).some(p=>sid(p.id)===sid(np.id))&&String(np.effectiveDate||'')<=last){notify(this,`不能新增追溯到已使用历史 (${last}) 的返点政策；新政策请从未来日期生效`);return}}
        }}return old();
    });
    wrap(vm,'deleteOpeningProvider',function(old,p){if(providerUsedDates(this,p?.id,null).length){notify(this,'该开户商存在历史消耗/返点/月结引用，不能删除');return}return old(p)});

    // P0-08: permanent client delete protects converted leads and confirmed rebate allocation.
    wrap(vm,'deleteClient',function(old,client){const id=sid(client?.id);if(arr(this.leads).some(l=>sid(l.convertedClientId)===id||sid(client?.sourceLeadId)===sid(l.id)&&String(l.stage||'')==='WON')){notify(this,'该客户由已转化线索产生，为保证转化审计链不能永久删除；请保持归档');return}let confirmed=false;if(typeof this.financeActualRebateClientShare==='function'){confirmed=arr(this.financeReconciliations).some(r=>r.status!=='VOID'&&num(this.financeActualRebateClientShare(r,client))>0.000001)}if(!confirmed){const deals=arr(this.openingDeals).filter(d=>sid(d.clientId)===id);confirmed=deals.some(d=>arr(this.financeReconciliations).some(r=>r.status!=='VOID'&&sid(r.providerId)===sid(d.providerId)&&sid(r.contactId)===sid(d.contactId)&&dealSpendDates(this,d).some(date=>monthOf(date)===sid(r.settlementMonth))))}if(confirmed){notify(this,'该客户存在已确认返点分摊历史，不能永久删除；请保持归档');return}return old(client)});

    // P0-09: automatic service fees are ACTIVE-only, unique by client+month regardless of currency.
