    // P0-10: never rewrite already-existing historical automatic IP/network cost rows.
    wrap(vm,'ensureAutomaticAssetCosts',function(old,options={}){const current=monthOf(this.localDateKey?.()||nowDate());const snapshots=new Map(arr(this.financeCosts).filter(c=>c?.autoGenerated&&(c.category==='IP'||String(c.sourceType||'').includes('IP_ENV')||String(c.sourceType||'').includes('NETWORK'))&&(monthOf(c.date)<current||locked(this,monthOf(c.date)))).map(c=>[sid(c.id),clone(c)]));const result=old(options);for(const [id,s] of snapshots){const idx=arr(this.financeCosts).findIndex(c=>sid(c.id)===id);if(idx>=0)this.financeCosts[idx]=s;else this.financeCosts.push(s)}return result});

    // P0-11: first USD recharge establishes the balance baseline; pre-baseline legacy spend is excluded.
    vm.hasUsdBalanceData=function(account){return arr(account?.rechargeHistory).some(r=>(r.currency||'USD')==='USD')};
    vm.accountRechargeUsd=function(account){return arr(account?.rechargeHistory).filter(r=>(r.currency||'USD')==='USD').reduce((s,r)=>s+num(r.amount),0)};
    vm.accountSpendUsd=function(account){const usd=arr(account?.rechargeHistory).filter(r=>(r.currency||'USD')==='USD'&&r.date).sort((a,b)=>String(a.date).localeCompare(String(b.date)));if(!usd.length)return 0;const baseline=String(usd[0].date);return arr(account?.adDataRecords).filter(r=>(r.currency||account?.adSpendCurrency||'USD')==='USD'&&String(r.date||'')>=baseline).reduce((s,r)=>s+num(r.spend),0)};
    vm.accountBalanceUsd=function(account){return this.accountRechargeUsd(account)-this.accountSpendUsd(account)};

