RVICE_FEE')==='SERVICE_FEE'&&r.billSource==='AUTO_SERVICE_FEE');
      if(existing){if(client?.currency&&existing.currency&&client.currency!==existing.currency){existing.p0CurrencyDrift=true;existing.p0CurrencyDriftExpected=client.currency}return 0}
