      return result;
    });
    wrap(vm,'getFinanceMonthCheck',function(old,month){
      const check=old(month)||{issues:[]};check.issues=arr(check.issues);
      const rows=arr(this.financeReceivables).filter(r=>r.billSource==='AUTO_SERVICE_FEE'&&sid(r.settlementMonth)===sid(month));
      const drift=rows.filter(r=>{const c=findClient(this,r.clientId);return !!(c?.currency&&r.currency&&c.currency!==r.currency)});
      if(drift.length){check.currencyDriftCount=drift.length;check.issues.push(`有 ${drift.length} 条自动服务费账单币种与当前客户币种不一致，请人工核对历史账单，系统未重复出账`)}
      const counts=new Map();for(const r of rows){const key=sid(r.clientId);counts.set(key,(counts.get(key)||0)+1)}const duplicateGroups=[...counts.values()].filter(n=>n>1).length;
      if(duplicateGroups){check.duplicateAutoBillCount=duplicateGroups;check.issues.push(`有 ${duplicateGroups} 个客户在 ${month} 存在重复自动服务费历史账单；系统已阻止继续重复出账，请人工核对后处理`)}
      return check;
